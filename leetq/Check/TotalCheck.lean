/-
  The end check of `doc/qrel-total-plan.md` §6: every op and program answers its payload bare.
  It reads the elaborated environment, never the source text, and enumerates obligations, not records:
  (1) every required op and program must resolve and its result must not be `Except`/`Option`, and no `Prog`
  constructor may take an `Except`-typed argument; (2) every declaration of every module under `roots` must not
  use `Except`/`ExceptT` in its type or value, nor answer `Option` unless it is a selector of `optionOk`.
  The modules swept are read from the directories, so a module nothing imports here is an error, not a skip.
  It is its own lib `Check`, outside the `LeetQ` glob and the default targets: while an offender remains,
  building it fails, and a targetless `lake build` stays green. Run it with `lake build Check.TotalCheck`.
-/
import LeetQ.Rel.Algebra
import LeetQ.Rel.Blocks
import LeetQ.Rel.Chess
import LeetQ.Rel.Circuit
import LeetQ.Rel.Core
import LeetQ.Rel.Ew
import LeetQ.Rel.Find
import LeetQ.Rel.Group
import LeetQ.Rel.Norm
import LeetQ.Rel.Parted
import LeetQ.Rel.Prog
import LeetQ.Rel.QSort
import LeetQ.Rel.Scan
import LeetQ.Rel.Spec
import LeetQ.Rel.SpecAmend
import LeetQ.Rel.SpecFind
import LeetQ.Rel.SpecKey
import LeetQ.Rel.SpecScan
import LeetQ.Rel.SpecStruct
import LeetQ.Rel.Struct
import LeetQ.Rel.Wumpus
import LeetQ.Rel.KernelWF.Dyad
import LeetQ.Rel.KernelWF.DyadCmpWF
import LeetQ.Rel.KernelWF.DyadValWF
import LeetQ.Rel.KernelWF.Gather
import LeetQ.Rel.KernelWF.Raze
import LeetQ.Rel.KernelWF.Reduce
import LeetQ.Rel.KernelWF.Search
import LeetQ.Rel.KernelWF.Shape
import Bench.Main

open Lean Elab Command Meta

namespace LeetQ.Rel.TotalCheck

/-- The swept modules: every module under one of these. -/
def roots : List Name := [`LeetQ.Rel, `Bench]

/-- Part 1: the algebra of `leetq/CLAUDE.md` and the programs, as names resolved from `LeetQ.Rel`. -/
def ops : List Name :=
  [`le, `inter, `union, `zero, `top, `idU, `conv, `comp, `dom, `ran, `antiJoin, `diff, `corefl, `isCorefl,
   `leftDiv, `rightDiv, `symDiv, `transpose, `mem, `existsImage, `pair, `prod, `junc, `injConv, `mapVal,
   `foldOver, `foldGroups, `uncons, `hylo, `est, `thin, `entire, `simple, `isMap, `injective, `surjective].map
    (`Alg ++ ·)
  ++ [`Prog.run, `Prog.exec]  -- §6's `Norm.exec`: `exec` is declared in module `Norm`, namespace `Prog`
  ++ [`T, `K, `W, `B, `P, `M, `isMate, `mateIn1].map (`Chess ++ ·)
  ++ [`T, `R, `M, `move, `same, `plan].map (`Blocks ++ ·)
  ++ [`uniq, `views, `tell, `agent].map (`Wumpus ++ ·)
  ++ [`adder, `answer].map (`Circuit ++ ·)

/-- The one hand-written record: the `Option` selectors of approval Ap7 option S, and `Parted.ofBoxes`, the
    q-data parser of Ap3 G. Resolved like `ops`, so a renamed entry is an error, not a silent pass. -/
def optionOk : List Name :=
  [`Alg.rangeOffsets, `Find.direct, `Alg.laneKind, `Prog.asTest, `Prog.asFn, `Parted.ofBoxes]

/-- A constant of the `Except` family: the type, its constructors, `bind`, its instances, `ExceptT`. -/
def exceptish (c : Name) : Bool := [``Except, ``ExceptT].any (·.isPrefixOf c)

/-- The name a reader knows a declaration by: a private name without its `_private` wrapper. -/
def userName (n : Name) : Name := (privateToUserName? n).getD n

/-- A declaration Lean generated as part of another (`match_`, `proof_`, `_unsafe_rec`, `eq_1`, a constructor's
    `inj`): its owner, the nearest prefix that is neither internal nor a constructor's appendix. -/
partial def owner (env : Environment) (n : Name) : Option Name :=
  let p := n.getPrefix
  if p.isAnonymous then none
  else if (userName n).isInternalDetail || (userName p).isInternalDetail then
    if (userName p).isInternalDetail then owner env p else some p
  else if (env.find? p).any (·.isCtor) then some p
  else none

/-- Generated by an inductive declaration from its constructors, which are swept themselves. -/
def fromInductive (env : Environment) (n : Name) (ci : ConstantInfo) : Bool :=
  (ci matches .recInfo _) || isAuxRecursor env n || isNoConfusion env n

/-- Every reason `n` fails the check, empty when it passes. `aux` is the generated declarations it owns. -/
def reasons (ok : NameSet) (aux : Array Name) (n : Name) (ci : ConstantInfo) : MetaM (Array String) := do
  let env ← getEnv
  let hs ← forallTelescopeReducing ci.type fun _ b => do
    return [b, ← whnfR b, ← whnf b].filterMap (·.getAppFn.constName?) |>.eraseDups
  let names (es : List Expr) : List Name :=
    (es.flatMap fun e => e.getUsedConstants.toList.filter exceptish).eraseDups.mergeSort (·.toString ≤ ·.toString)
  let auxE := aux.toList.flatMap fun d => (env.find? d).toList.flatMap fun c => c.type :: (c.value? true).toList
  let ty := names [ci.type]
  let val := names ((ci.value? true).toList ++ auxE)
  return (hs.filter (fun h => exceptish h || (h == ``Option && !ok.contains n))).toArray.map (s!"result={·}")
    ++ (if ty.isEmpty then #[] else #[s!"type={",".intercalate (ty.map toString)}"])
    ++ (if val.isEmpty then #[] else #[s!"value={",".intercalate (val.map toString)}"])

/-- `n` resolved as a global constant from the current scope; an error names a missing or ambiguous one. -/
def resolve (n : Name) : CommandElabM (Except String Name) := do
  match ((← resolveGlobalName n).filterMap fun (c, fs) => if fs.isEmpty then some c else none).eraseDups with
  | [c] => return .ok c
  | [] => return .error "missing"
  | cs => return .error s!"ambiguous={",".intercalate (cs.map toString)}"

/-- The module that declares `n`. -/
def moduleOf (env : Environment) (n : Name) : Option Name :=
  (env.getModuleIdxFor? n).bind fun i => env.header.moduleNames[i.toNat]?

/-- The modules under `roots` on disk, read from the package directory this file sits in. -/
def diskModules : CommandElabM (Array Name) := do
  let file ← IO.FS.realPath (← getFileName)
  let k := (← getMainModule).components.length
  let root ← (List.range k).foldlM (fun (p : System.FilePath) _ => match p.parent with
    | some q => pure q
    | none => throwError "TotalCheck: {file} has fewer than {k} directories above it") file
  let mut ms := #[]
  for r in roots do
    let dir := (modToFilePath root r "lean").withExtension ""
    unless ← dir.isDir do throwError "TotalCheck: the swept module prefix {r} has no directory {dir}"
    for f in ← dir.walkDir do
      if f.extension == some "lean" then
        let m ← moduleNameOfFileName f root
        if m != (← getMainModule) then ms := ms.push m
  return ms

def run : CommandElabM Unit := do
  let env ← getEnv
  let mut bad : Std.HashMap (String × String) (Array String) := {}
  let add (b : Std.HashMap (String × String) (Array String)) (m n : String) (rs : Array String) :=
    if rs.isEmpty then b else b.insert (m, n) ((b.getD (m, n) #[] ++ rs).toList.eraseDups.toArray)
  -- the modules: every file under `roots` must be in the environment
  let imported := env.header.moduleNames
  for m in ← diskModules do
    unless imported.contains m do bad := add bad m.toString "-" #["module-not-imported"]
  -- the allow list, resolved
  let mut ok : NameSet := {}
  for n in optionOk do
    match ← resolve n with
    | .ok c => ok := ok.insert c
    | .error e => bad := add bad "?" ("optionOk:" ++ n.toString) #[e]
  -- part 2: every declaration of every swept module; generated ones count against their owner
  -- a constant realized here for a declaration of an unswept module (`Except.map.match_1.splitter`) is that one's
  let inRoots (n : Name) := (moduleOf env n).any fun m => roots.any (·.isPrefixOf m)
  let foreign (n : Name) := let cs := (userName n).components
    (List.range (cs.length - 1)).any fun k =>
      let p := (cs.take (k + 1)).foldl Name.append .anonymous
      env.contains p && !inRoots p
  let swept := env.constants.map₁.fold (init := #[]) fun acc n ci =>
    if inRoots n && !foreign n then acc.push (n, ci) else acc
  let mut aux : NameMap (Array Name) := {}
  for (n, ci) in swept do
    if let some o := owner env n then aux := aux.insert o (((aux.get? o).getD #[]).push n)
  let top := swept.filter fun (n, ci) => (owner env n).isNone && !fromInductive env n ci
  for (n, ci) in top do
    let rs ← liftTermElabM <| reasons ok ((aux.get? n).getD #[]) n ci
    bad := add bad ((moduleOf env n).getD .anonymous).toString (userName n).toString rs
  -- part 1: the required ops and programs resolve and answer bare; `Prog`'s constructors take no `Except`
  for n in ops do
    match ← resolve n with
    | .error e => bad := add bad "?" n.toString #[e]
    | .ok c =>
      let ci ← getConstInfo c
      let rs ← liftTermElabM <| reasons ok ((aux.get? c).getD #[]) c ci
      bad := add bad ((moduleOf env c).getD .anonymous).toString (userName c).toString rs
  match ← resolve `Prog with
  | .error e => bad := add bad "?" "Prog" #[e]
  | .ok p =>
    for c in (← getConstInfoInduct p).ctors do
      let args ← liftTermElabM <| forallTelescope (← getConstInfo c).type fun xs _ =>
        xs.toList.filterMapM fun x => do
          let t ← inferType x
          if t.getUsedConstants.any exceptish then return some s!"ctor-arg={← ppExpr t}" else return none
      bad := add bad ((moduleOf env c).getD .anonymous).toString (userName c).toString args.toArray
  -- the report: one line per offender, sorted; then a count per module and the total
  let lines := (bad.toList.map fun ((m, n), rs) => s!"{m} {n} {";".intercalate rs.toList}").mergeSort
  let counts := (bad.toList.map (·.1.1)).eraseDups.mergeSort.map fun m =>
    s!"count {m} {(bad.toList.filter (·.1.1 == m)).length}"
  logInfo m!"TotalCheck: Option allowed for {optionOk}"
  let report := "\n".intercalate (lines ++ counts ++ [s!"total {bad.size}"])
  if bad.isEmpty then logInfo m!"TotalCheck: no offender\n{report}"
  else throwError m!"TotalCheck: {bad.size} offenders\n{report}"

end TotalCheck

#eval TotalCheck.run
