-- B&dM §10.2 "The detab-entab problem" (diag/aop/10-greedy.typ:79-266): detab, the specification
-- entab ⊑ Λ(detab°)est(R) (entab_laws, 10:148) and the derived program entab = triple assocl π₁ (𝟙×blanks) cat
-- (entab_triple, 10:259), on arrays of characters. The μ form of entab_laws is not written: no μ (§d).
obj 1 = {∗}                                   -- the type 1: its one value
obj Ch = {a,b,c,d,BL,TB,NL}                   -- the characters: letters, the book's BL, TB, NL
obj N = 0…24                                  -- columns and counts: detab of 5 characters reaches column 20
obj K = 30…34                                 -- one round per character of a candidate: lengths ≤ 5

e ≜ nil(1,[Ch])                               -- the empty string
m ≜ {(4,4)}                                   -- the tab width, the note's n (a name the language reserves)
bl ≜ {(BL,BL)}
tb ≜ {(TB,TB)}
nl ≜ {(NL,NL)}
z ≜ ⊤{(0,0)}                                  -- the constant 0

-- S(r,A): the strings over the characters A, one round of r per character (each round keeps or appends one)
S(r,A) ≜ ran(r⦇ran(e), π₂ ∪ (⟨π₂,π₁⊤A⟩snoc)⦈)
-- blanks k = k blanks: the converse of length on the all-blank strings, which step needs up to m of
B ≜ S(Λ(⊤(1,N)dom(<m)),bl)
blanks ≜ (B length)°
-- detab tupled with col, run as the left loop from base = ([],0) (detab_tupled, detab_loop, 10:187-202):
-- step((x,c),a) = (a=NL → (x⧺[NL],0), a=TB → (x⧺blanks(w),c+w), (x⧺[a],c+1)), w = n − c mod n
step ≜ dom(π₂nl)⟨⟨π₁π₁,π₂⟩snoc,z⟩ ∪ (dom(π₂tb)⟨⟨π₁π₁,w blanks⟩cat,⟨π₁π₂,w⟩plus⟩) ∪ (dom(π₂(𝟙(Ch) − nl − tb))⟨⟨π₁π₁,π₂⟩snoc,π₁π₂ succ⟩) where w ≜ ⟨⊤m,⟨π₁π₂,⊤m⟩mod⟩minus
detab ≜ ⟨⟨nil,z⟩,𝟙⟩loop(step)π₁

-- the specification Λ(detab°)est(R), R ≜ length ≤ length° (entab_laws, 10:148), on the candidates C: every
-- string of length ≤ 5 over {a,BL,TB}. detab never shortens, so C holds every preimage of a string of D.
-- H ≜ detab° and R are restricted to C: the converse of a fold does not run on demand
C ≜ S(Λ(⊤(1,K)), {(a,a),(BL,BL),(TB,TB)})
H ≜ (C detab)°
R ≜ C length ≤(N,N) (C length)°
D ≜ ran(C detab)C                             -- the outputs of detab that are candidates

-- the derived program (triple_fold 10:247, entab_triple 10:259): triple ≜ ⦇[base,op]⦈ on snoc-lists, run as the
-- left loop of op from base = ([],(0,0)); h: the character a is a blank off a tab stop, on ((t,c),a); tc: ⟨tbc,col⟩'s step
h ≜ dom(π₂bl) ∩ dom(π₁π₂ succ⟨𝟙,⊤m⟩mod(𝟙(N) − {(0,0)}))
tc ≜ h⟨π₁π₁ succ,k⟩ ∪ ((dom(π₂bl) − h)⟨z,k⟩) ∪ (dom(π₂nl)⟨z,z⟩) ∪ (dom(π₂(𝟙(Ch) − bl − nl))⟨z,k⟩) where k ≜ π₁π₂ succ
-- op((x,(t,c)),a): hold the blank, or emit a tab on a tab stop, or cash the t held blanks in and append a
op ≜ ⟨g π₁π₁ ∪ ((dom(π₂bl) − g)⟨π₁π₁,⊤tb⟩snoc) ∪ (dom(π₂(𝟙(Ch) − bl))⟨⟨π₁π₁,π₁π₂π₁ blanks⟩cat,π₂⟩snoc),⟨π₁π₂,π₂⟩tc⟩ where g ≜ dom(⟨π₁π₂,π₂⟩h)
triple ≜ ⟨⟨nil,⟨z,z⟩⟩,𝟙⟩loop(op)
assocl ≜ ⟨⟨π₁,π₂π₁⟩,π₂π₂⟩
entab ≜ triple assocl π₁ (𝟙×blanks) cat

-- the note's run (10:268): ab, a tab, c d; and three candidates' outputs, a tie among them (q)
x ≜ ⟨{(∗,a)}, ⟨{(∗,b)}, ⟨{(∗,TB)}, ⟨{(∗,c)}, ⟨{(∗,BL)}, ⟨{(∗,d)}, e⟩cons⟩cons⟩cons⟩cons⟩cons⟩cons
p ≜ ⟨{(∗,a)}, ⟨{(∗,BL)}, ⟨{(∗,BL)}, ⟨{(∗,BL)}, e⟩cons⟩cons⟩cons⟩cons
q ≜ ⟨{(∗,a)}, ⟨{(∗,a)}, ⟨{(∗,a)}, ⟨{(∗,BL)}, ⟨{(∗,a)}, e⟩cons⟩cons⟩cons⟩cons⟩cons
y ≜ ⟨{(∗,BL)}, ⟨{(∗,BL)}, ⟨{(∗,BL)}, ⟨{(∗,BL)}, ⟨{(∗,BL)}, e⟩cons⟩cons⟩cons⟩cons⟩cons

print x detab
print x detab entab
print p Λ(H)est(R)
print q Λ(H)est(R)
print y Λ(H)est(R)
print p entab
print q entab
print y entab
check D entab ⊑ D Λ(H)est(R)                  -- entab_laws, 10:148: the program is a shortest preimage
check D entab detab = D                       -- detab entab = 𝟙 on detab's outputs
