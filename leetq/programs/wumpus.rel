obj C = {11,12,13,14,21,22,23,24,31,32,33,34,41,42,43,44}   -- the cells [x,y], written xy
obj 1 = {∗}                                   -- the type 1: its one value
obj N = 0…5                                   -- the steps of the route

a ≜ {(11,12),(12,13),(13,14),(21,22),(22,23),(23,24),(31,32),(32,33),(33,34),(41,42),(42,43),(43,44),(11,21),(21,31),(31,41),(12,22),(22,32),(32,42),(13,23),(23,33),(33,43),(14,24),(24,34),(34,44)}   -- each cell to the next along a column or a row
adj ≜ a ∪ a°                                  -- the cells beside each cell

-- the views of one KB: V visited, B breeze, S stench; R(𝟙 − X) keeps the rows of R whose value is not in X
uniq(R : α ⟶ β) ≜ R ∩ (R°\𝟙)                  -- the rows whose key has one value
noB(V : C ⟶ C, B : C ⟶ C) ≜ V(𝟙 − B)
noPit(V : C ⟶ C, B : C ⟶ C) ≜ V ∪ ran(noB(V,B) adj)
cand(V : C ⟶ C, B : C ⟶ C) ≜ B adj(𝟙 − noPit(V,B))
pit(V : C ⟶ C, B : C ⟶ C) ≜ ran(uniq(cand(V,B)))
noS(V : C ⟶ C, S : C ⟶ C) ≜ V(𝟙 − S)
noW(V : C ⟶ C, S : C ⟶ C) ≜ V ∪ ran(noS(V,S) adj)
wmay(S : C ⟶ C) ≜ S⊤(C,1) \ adj               -- 1 ⟶ C: the cells beside every stench
wcand(V : C ⟶ C, S : C ⟶ C) ≜ wmay(S)(𝟙 − noW(V,S))
wumpus(V : C ⟶ C, S : C ⟶ C) ≜ ran(uniq(wcand(V,S)))
noWumpus(V : C ⟶ C, S : C ⟶ C) ≜ 𝟙 − ran(wcand(V,S))
safe(V : C ⟶ C, B : C ⟶ C, S : C ⟶ C) ≜ noPit(V,B) ∩ noWumpus(V,S)
frontier(V : C ⟶ C) ≜ ran(V adj)(𝟙 − V)
next(V : C ⟶ C, B : C ⟶ C, S : C ⟶ C) ≜ frontier(V) ∩ safe(V,B,S)

-- the world and the route walked through it
pits ≜ {(31,31),(33,33),(44,44)}
w ≜ {(13,13)}                                 -- the wumpus
g ≜ {(23,23)}                                 -- the gold
route ≜ {(0,11),(1,21),(2,11),(3,12),(4,22),(5,23)}   -- N ⟶ C: the cell of each step

-- the KB after each step, a family N ⟶ C×C: the route's cells up to step k where the percept p held
K(p) ≜ ((route p)°≤)°⟨𝟙,𝟙⟩
V ≜ K(𝟙)
B ≜ K(dom(adj pits))                          -- breeze beside a pit
S ≜ K(dom(adj w))                             -- stench beside the wumpus
G ≜ K(g)                                      -- glitter on the gold

print next(V,B,S)
