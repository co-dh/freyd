obj B = 0…1                                   -- a bit
obj I = B×(B×B)                               -- the adder's three inputs

g(d) ≜ d⊤{(1,1)} ∪ ((𝟙 − d)⊤{(0,0)})          -- B×B ⟶ B: the gate whose output is 1 on the inputs d
⊕ ≜ g(dom(π₁ − π₂))                           -- xor: 1 where the inputs differ
∧ ≜ g(dom((π₁ ∩ π₂){(1,1)}))                  -- and: 1 where both are 1
∨ ≜ g(dom((π₁ ∪ π₂){(1,1)}))                  -- or: 1 where one is 1

π₃ ≜ π₂π₂                                     -- I ⟶ B: the third input
π₂ ≜ π₂π₁                                     -- I ⟶ B: the second input; π₁ is the first

q ≜ ⟨π₁,π₂⟩                                   -- I ⟶ B×B: the first two inputs
x₂ ≜ ⟨q⊕,π₃⟩                                  -- I ⟶ B×B: their xor, and the third input
F ≜ ⟨x₂⊕,⟨q∧,x₂∧⟩∨⟩                           -- I ⟶ B×B: (sum, carry)
p ≜ ⟨{(0,0)},{(0,1)}⟩                         -- 1 ⟶ B×B: the point (0,1), 1 the bit 0
answer ≜ Fp°                                  -- I ⟶ 1: the inputs giving sum 0, carry 1

print answer
