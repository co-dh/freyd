p:{-1 x,": ",.Q.s1 y}
d:`a`b`c!1 2 3
e:`b`c`d!10 20 30
t:([] k:`a`b`a`c; v:1 2 3 4)
kt:([k:`a`b`d] w:10 20 40)
kt3:`k xkey ([] k:`a`a`b; w:1 2 3)
t2:([] k:`b`e; u:5 6)
tr:([] s:`x`x`y; tm:2 5 4)
qr:([] s:`x`x`x`y; tm:1 3 3 5; p:10 20 21 30)
p["bang";d]
p["key";key d]
p["value";value d]
p["dk";d`b]
p["dmiss";d`z]
p["dat";d`a`c]
p["plus";d+e]
p["minus";d-e]
p["times";d*e]
p["max";d|e]
p["min";d&e]
p["inf";(-0W;0W)]
p["rep+";(`a`a`b!1 2 3)+`a`c!10 20]
p["rep+r";(`a`c!10 20)+`a`a`b!1 2 3]
p["d+bb";d+`b`b!10 20]
p["cc";(`a`b!1 2)+`c`c!10 20]
p["cc-";(`a`b!1 2)-`c`c!10 20]
p["aba";(`a`b`a!1 2 3)+`a`c!10 20]
p["nullmax";(`a`b!0N 1)|`b`c!5 0N]
p["comma";d,e]
p["take";`a`c#d]
p["drop";`a`c _ d]
p["drop1";d _ `a]
p["flip";flip `a`b!(1 2;3 4)]
p["flipt";flip ([] a:1 2; b:3 4)]
p["xkey";`k xkey t]
p["keykt";key kt]
p["valkt";value kt]
p["selw";select from t where v>1]
p["selby";select sum v by k from t]
p["exec";exec v from t where k=`a]
p["upd";update v:v*10 from t where k=`a]
p["del";delete from t where k=`a]
p["xasc";`k xasc t]
p["xdesc";`k xdesc t]
p["xgroup";`k xgroup t]
p["ungroup";ungroup `k xgroup t]
p["ij";t ij kt]
p["lj";t lj kt]
p["ij3";t ij kt3]
p["lj3";t lj kt3]
p["uj";t uj t2]
p["ujk";kt uj ([k:`b`e] w:22 50)]
p["ej";ej[`k;t;([] k:`a`a`b; w:1 2 3)]]
p["aj";aj[`s`tm;tr;qr]]
p["asof";qr asof `s`tm!(`x;3)]
p["asofb";qr asof `s`tm!(`x;2)]
w:-2 0+\:tr`tm
p["wj";wj[w;`s`tm;tr;(qr;(sum;`p))]]
p["wj1";wj1[w;`s`tm;tr;(qr;(sum;`p))]]
p["pj";t pj ([k:`a`b] v:100 200)]
p["upsk";kt upsert ([k:`b`e] w:22 50)]
p["upst";t upsert ([] k:enlist`z; v:enlist 9)]
`t insert (`z;9)
p["ins";t]
p["insk";@[{`kt insert (`b;99)};::;{"error: ",x}]]
exit 0
