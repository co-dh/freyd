/ Each verb of LeetQ/Rel/Verbs.lean on each container q allows it on; the #guard of the same expression is
/ in LeetQ/Rel/Test.lean, in the same order.  A dict reads back there as its (key, value) pairs, a table as
/ its rows, a keyed table as (key, value-row) pairs, an atom as a one-element list ([] for null).
p:{[s] -1 s," -> ",.Q.s1 value s;}
x:3 1 4 1 5
d:`a`b`c`d!3 1 3 2
e:`a`b`c!1 2 3
f:`b`c`d!10 20 30
t:([] k:`a`b`a`c; v:1 2 3 4)
kt:([k:`a`b`d] w:10 20 40)
tr:([] s:`x`x`y; tm:2 5 4)
qr:([] s:`x`x`x`y; tm:1 3 3 5; p:10 20 21 30)
w:-2 0+\:tr`tm
/ reindexing
p "reverse x"
p "reverse d"
p "reverse t"
p "reverse kt"
p "first x"
p "last x"
p "first d"
p "last d"
p "first t"
p "last t"
p "first kt"
p "last kt"
p "first 0#0"
p "2#x"
p "-2#x"
p "7#x"
p "2#d"
p "-1#d"
p "2#t"
p "2#kt"
p "1_x"
p "-1_x"
p "1_d"
p "1_t"
p "1_kt"
p "2 sublist x"
p "-2 sublist x"
p "10 sublist x"
p "1 2 sublist x"
p "2 rotate x"
p "-1 rotate x"
p "1 rotate t"
p "next x"
p "prev x"
p "2 xprev x"
p "til 5"
p "x,1 2"
p "t,([] k:enlist`z; v:enlist 9)"
p "raze (1 2;enlist 3;4 5 6)"
p "1 2 cross 3 4 5"
p "flip `a`b!(1 2;3 4)"
/ search
p "x 2 0"
p "x 7"
p "d`b`d"
p "d`z"
p "t 1"
p "kt`b"
p "kt`z"
p "x?1 5 7"
p "d?3 1 7"
p "t?([] k:`a`z; v:3 0)"
p "kt?([] w:enlist 20)"
p "where 01101b"
p "where `a`b`c!101b"
p "where 2 0 1"
p "distinct x"
p "distinct d"
p "distinct ([] k:`a`a`b; v:1 1 2)"
p "group x"
p "group d"
p "1 2 3 2 union 2 4 1 5"
p "1 2 3 2 inter 2 3 4"
p "1 2 3 2 except 2"
p "t except enlist first t"
p "1 2 5 in 2 3 5"
p "3 1 7 within 2 5"
p "1 3 5 7 bin 0 1 4 9"
p "1 3 5 7 binr 0 1 4 9"
p "0 2 4 cut til 6"
p "1 3 cut til 6"
/ sort
p "rank x"
p "iasc x"
p "idesc x"
p "asc x"
p "desc x"
p "iasc d"
p "idesc d"
p "asc d"
p "desc d"
p "`k xasc t"
p "`k xdesc t"
/ each, neighbours, nulls
p "differ 1 1 2 2 2 3 1"
p "differ `a`b`c!1 1 2"
p "null 1 0N 3"
p "fills 0N 1 0N 0N 3 0N"
p "fills `a`b`c!1 0N 3"
p "d*10"
p "-7 7 -7 7 div 2 2 -2 -2"
/ aggregates
p "count x"
p "count d"
p "count t"
p "count kt"
p "sum x"
p "sum d"
p "sum kt"
p "prd x"
p "min x"
p "max x"
p "max d"
p "all 101b"
p "any 101b"
p "avg 1 2 3 4"
p "avg d"
p "med 1 3 2 4"
p "med x"
p "med d"
p "var 1 2 3 4"
p "dev 2 4 4 4 5 5 7 9"
p "1 3 wavg 2 6"
p "1 2 3 wsum 4 5 6"
p "1 2 3 4 cov 2 4 6 8"
p "1 2 3 4 cor 2 4 6 8"
p "-/[1 2 3]"
p "10-/1 2 3"
/ running and moving
p "sums x"
p "sums d"
p "prds x"
p "mins x"
p "maxs x"
p "maxs d"
p "-\\[1 2 3]"
p "10-\\1 2 3"
p "deltas x"
p "deltas d"
p "ratios 1 2 8 4"
p "2 msum x"
p "2 msum d"
p "2 mavg x"
p "3 mmin x"
p "3 mmax x"
p "3 mcount x"
p "0.5 ema 1 2 3"
/ dicts and keyed tables
p "key d"
p "value d"
p "key x"
p "key kt"
p "value kt"
p "`a`c#e"
p "`a`c _ e"
p "delete from kt where k=`b"
p "e,f"
p "kt,([k:`b`e] w:22 50)"
p "e+f"
p "e-f"
/ qSQL
p "`k xkey t"
p "select from t where v>1"
p "select from kt where w>15"
p "exec v from t where k=`a"
p "update v:v*10 from t where k=`a"
p "delete from t where k=`a"
p "`k xgroup t"
p "select sum v by k from t"
p "select count v by k from ([] k:`b`a`b; v:1 2 3)"
p "ungroup `k xgroup t"
/ joins
p "t ij kt"
p "t lj kt"
p "ej[`k;t;([] k:`a`a`b; w:1 2 3)]"
p "t pj ([k:`a`b] v:100 200)"
p "t uj ([] k:enlist`z; v:enlist 9)"
p "aj[`s`tm;tr;qr]"
p "wj1[w;`s`tm;tr;(qr;(sum;`p))]"
p "wj[w;`s`tm;tr;(qr;(sum;`p))]"
exit 0
