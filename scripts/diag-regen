#!/bin/sh
# diag-regen — redraw every picture the notes draw, and nothing else.
#
#     ./scripts/diag-regen              redraw all of them
#     ./scripts/diag-regen --missing    draw only the ones with no file in diag/generated/
#
# The notes THEMSELVES are the list: `scripts/notesplit.py` reads every `#lean(...)` selector out of
# the note's own metadata and every surviving `#import` as a path from the file making it.  A second
# copy of that list in a header comment is how the two drifted — three declarations were renamed and
# the comment went on naming the old ones — and a pattern written for the note's own
# `generated/x.typ` never saw a chapter's `../generated/x.typ` and redrew fewer pictures, exiting 0.
#
# BOTH notes are scanned.  allegory-axioms.typ states the laws and allegory2.typ works the proofs,
# and a picture named by only one of them is still a picture that has to be redrawn.
#
# ONE LEAN PROCESS PER ROUTE, three at most: a `#lean(...)` name is drawn by `--string` (the panel
# the note imports), a `<decl>.proof` by `--proof`, and what is left by the term walk.  The route is
# not a property of the name, so the two lists are asked for separately rather than guessed at here.
cd "$(dirname "$0")/.." || exit 1
missing=
[ "$1" = "--missing" ] && { missing=1; shift; }
[ $# -eq 0 ] || { echo "usage: diag-regen [--missing]" >&2; exit 2; }

# Only the names with no picture on disk, under --missing; the name IS the file's stem, `.proof` and
# all, so one test answers for every route.  A `#lean(a, b)` call arrives as one `a+b` line and is
# redrawn WHOLE when either of its pictures is missing: the two share a box, so drawing one of them
# alone would give it a depth of its own and leave the pair standing at two heights.
filter() {
  if [ -z "$missing" ]; then cat; else
    while IFS= read -r n; do
      [ -n "$n" ] || continue
      for p in $(printf '%s\n' "$n" | tr '+' ' '); do
        [ -f "diag/generated/$p.typ" ] || { printf '%s\n' "$n"; break; }
      done
    done
    return 0
  fi
}

all=$(./scripts/note-files --generated) || exit 1
lean=$(./scripts/note-files --lean) || exit 1
# The `#import`ed pictures: the whole list less the ones the note draws with `#lean`.  An empty
# pattern file matches every line, so with no `#lean` at all the difference is the whole list.
if [ -n "$lean" ]; then
  tmp=$(mktemp) || exit 1
  trap 'rm -f "$tmp"' EXIT
  # The SELECTORS, one per line: the difference is over files, and a `#lean(a, b)` call is two of
  # them.  Left joined, `a+b` matched no line of the full list and both pictures were drawn twice,
  # once by the string route and once as an import that does not exist.
  printf '%s\n' "$lean" | tr '+' '\n' > "$tmp"
  imports=$(printf '%s\n' "$all" | grep -Fxv -f "$tmp")
else
  imports=$all
fi

# Unquoted on purpose: the names carry no spaces, and quoting would pass a whole list as one word.
leans=$(printf '%s\n' "$lean" | filter)
plain=$(printf '%s\n' "$imports" | grep -v '\.proof$' | filter)
proofs=$(printf '%s\n' "$imports" | filter | sed -n 's|\.proof$||p')
[ -n "$plain" ] && { ./scripts/diag-export $plain || exit 1; }
[ -n "$proofs" ] && { ./scripts/diag-export --proof $proofs || exit 1; }
[ -n "$leans" ] && { ./scripts/diag-export --string $leans || exit 1; }
exit 0
