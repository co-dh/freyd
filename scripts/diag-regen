#!/bin/sh
# diag-regen — redraw every picture the notes draw, and nothing else.
#
#     ./scripts/diag-regen              redraw all of them
#     ./scripts/diag-regen --missing    draw only the ones that need it: no file in
#                                       diag/generated/, or a file drawn from a statement the
#                                       declaration no longer has, citing a `lean:` key the
#                                       index no longer has, or drawn by another build of the
#                                       exporter (`diag-export --stale`)
#     ./scripts/diag-regen --verify     draw every picture and write none: fail naming each one
#                                       `--stale` calls fresh that draws otherwise, which is a
#                                       read the drawing made and did not record
#
# The notes THEMSELVES are the list: `diag-export --list` reads every `#lean(...)`/`#leanc(...)`
# selector out of the note's own metadata, and `note-files --generated` every proof `#import`
# as a path from the file making it.  A second
# copy of that list in a header comment is how the two drifted — three declarations were renamed and
# the comment went on naming the old ones — and a pattern written for the note's own
# `generated/x.typ` never saw a chapter's `../generated/x.typ` and redrew fewer pictures, exiting 0.
#
# BOTH notes are scanned.  allegory-axioms.typ states the laws and allegory2.typ works the proofs,
# and a picture named by only one of them is still a picture that has to be redrawn.
#
# EIGHT ROUTES: a `#lean(...)` name is drawn by `--string` (the panel
# the note imports), a `#leanc(...)` name by `--circuit` (the same declaration under the monoidal
# reading), a `#leancd(...)` name by `--commutative` (the statement as a graph), a `#leang(...)` name by `--graph`
# (a concrete relation decided pair by pair), a `#leanf(...)`
# name by `--formula` (the statement in the note's spelling), a `#leant(...)` name by `--type` (the
# hom its arrows share), a `#leanv(...)` name by `--value` (a tree-valued `def` drawn as a tree), a `#leanw(...)` name by
# the term walk (no flag: strands per letter of a monoidal word, `circuit.typ`), and a `<decl>.proof` import by `--proof`.  The route is not a property of the name, so the lists are asked
# for separately rather than guessed at here.
cd "$(dirname "$0")/.." || exit 1
missing=
failed=
verify=
[ "$1" = "--missing" ] && { missing=1; shift; }
[ "$1" = "--verify" ] && { verify=--verify; shift; }
# TWO STAGES for `make`: a chapter's listing needs `make ref-ids`'s file, whose whole-note query needs
# the `#import`s drawn.  `--imports` stops after them; `--listed` follows it in the same run, prepared.
stage=
[ "$1" = "--imports" ] && { stage=imports; shift; }
[ "$1" = "--listed" ] && { stage=listed; prepared=1; shift; }
[ $# -eq 0 ] || { echo "usage: diag-regen [--missing | --verify] [--imports | --listed]" >&2; exit 2; }

# Only the names that NEED DRAWING, under --missing — and a picture whose Lean statement has changed
# needs it as much as one that was never drawn: every generated file carries the `cert:` key it was
# drawn from, and `diag-export --stale` prints the selectors whose key is no longer the
# declaration's.  A file test here could only see the file's ABSENCE, so a panel of a statement
# somebody had since edited kept its old drawing until the next whole redraw (minutes, under the
# note lock) and every gate in between passed on a picture of something else.  The same holds for
# the EXPORTER and for the theorems a dot cites: a chapter gate after an exporter change otherwise
# kept every red stub and old dot of the chapter it was meant to check.
# The arguments are the ROUTE'S FLAGS, exactly as `draw` takes them: the exporter owns the output
# path and the `+` rule (the string route's `#lean(a, b)` is two files sharing a box, the
# commutative route's `A+B` one file drawn from two declarations), so neither is guessed at here.
# The BLANK LINES GO FIRST: `printf '%s\n' "$list"` writes one empty line for an EMPTY list, and
# `xargs -d '\n'` hands that on as an empty ARGUMENT — a selector naming no declaration, which ends
# the run.  A chapter with no panel of some route (`CH=16` has no commutative one) is exactly that.
filter() {
  if [ -z "$missing" ]; then cat; else
    grep -v '^[[:space:]]*$' | xargs -d '\n' -r ./scripts/diag-export --prepared --stale "$@" \
      || exit 1
  fi
}

# Half the cores at a time, because a panel with a long naturality search holds 1.6 GiB.  Batches
# are drawn one call after another inside a process (`draw`): drawn as tasks over the one shared
# environment they contended on it.  The build and the index are done ONCE, before
# the first picture and only when there is one: the index is refreshed under a lock.
# `$1` is the list, a call to a line; the rest is the route's flag.
prepare() {
  [ -n "$prepared" ] || ./scripts/diag-export --prepare || exit 1
  prepared=1
}

# The staleness tests of several lists AT ONCE, each `$ls/<list>` into `$ls/<list>.stale`: pairs of
# a list and its route flag ('' for none).  Each test is a process importing the environment, and
# nine of them one after another were most of an unchanged chapter's `make c`.
tests() {
  pids=
  while [ $# -gt 0 ]; do
    filter $2 < "$ls/$1" > "$ls/$1.stale" &
    pids="$pids $!"; shift 2
  done
  for p in $pids; do wait "$p" || exit 1; done
}

draw() {
  names=$1; shift
  [ -n "$names" ] || return 0
  prepare
  # A BATCH OF CALLS PER PROCESS, about four batches per slot so a slow batch does not hold the
  # rest: one call per process paid the import, the environment's hash and a cold verdict cache
  # 1281 times, a third of a whole redraw's CPU.  The exporter draws its arguments one by one.
  p=$(( ($(nproc) + 1) / 2 ))
  n=$(printf '%s\n' "$names" | wc -l)
  printf '%s\n' "$names" \
    | xargs -d '\n' -n "$(( (n + 4 * p - 1) / (4 * p) ))" -P "$p" \
        ./scripts/diag-export --prepared $verify "$@" || failed=1
}

all=$(./scripts/note-files --generated) || exit 1
# The STALENESS TEST reads the index, so under --missing the build and the index come first: a test
# against an index older than the sources would keep a picture whose statement has changed, and exit
# 0.  Without --missing nothing is tested and `draw` prepares on its own, before the first picture.
[ -z "$missing" ] || prepare
# The `#import`s are drawn BEFORE the metadata is asked for: the listings below compile the note, and
# a note whose import has no file yet does not compile, so a new import could never be drawn.
# The `.proof` suffix comes off FIRST: it is the route's, not the selector's, and `--proof` is what
# puts it back — on the file the exporter writes and on the one `--stale` reads.
ls=$(mktemp -d) || exit 1
trap 'rm -rf "$ls"' EXIT
# A PICTURE is a `#lean(...)` call and nothing else; an `#import` draws only a PROOF (`branches`, data
# a call cannot return beside its metadata) or a CALC (the steps `lean-calc` reads), so a picture
# imported under an alias is refused by name.
plain=$(printf '%s\n' "$all" | grep -v '\.proof$' | grep -v '\.calc$' | grep -v '^$')
[ -z "$plain" ] || { printf 'diag-regen: a picture imported, not drawn by #lean("<sel>"):\n%s\n' "$plain" >&2; exit 1; }
printf '%s\n' "$all" | sed -n 's|\.proof$||p' > "$ls/proof"
printf '%s\n' "$all" | sed -n 's|\.calc$||p' > "$ls/calc"
if [ "$stage" != listed ]; then
  tests proof --proof calc --calc
  draw "$(cat "$ls/proof.stale")" --proof
  draw "$(cat "$ls/calc.stale")" --calc
fi
[ "$stage" != imports ] || { [ -z "$failed" ] || exit 1; exit 0; }

# The two metadata listings are the EXPORTER's: it is the process that draws them, and asking it
# keeps the route and its list in one place.
# ONE listing for every label, a file each: every typst query lays the note out again.
prepare
./scripts/diag-export --prepared --list "$ls" \
  lean-panel lean-circuit lean-walk lean-cd lean-graph lean-formula lean-cited lean-type lean-value || exit 1
# `lean-cited`: a law only CITED (a reference, a calc step) is drawn by the formula route too, but under
# its own label, because `row-keys`/`disp-keys` read `<lean-formula>` as what a row STATES.
sort -u -o "$ls/lean-formula" "$ls/lean-formula" "$ls/lean-cited" || exit 1
# The three lists are DISJOINT by construction — `--generated` is the `#import`s alone and
# `--list` the metadata calls — so nothing is subtracted here.  The union they once shared is what
# drew a picture twice, once by its own route and once as an import that does not exist.
tests lean-panel --string lean-circuit --circuit lean-walk '' lean-cd --commutative lean-graph --graph \
  lean-formula --formula lean-type --type lean-value --value
draw "$(cat "$ls/lean-panel.stale")" --string
draw "$(cat "$ls/lean-circuit.stale")" --circuit
draw "$(cat "$ls/lean-walk.stale")"
draw "$(cat "$ls/lean-cd.stale")" --commutative
draw "$(cat "$ls/lean-graph.stale")" --graph
draw "$(cat "$ls/lean-formula.stale")" --formula
draw "$(cat "$ls/lean-type.stale")" --type
draw "$(cat "$ls/lean-value.stale")" --value
# EVERY ROUTE IS DRAWN BEFORE THE RUN FAILS: a red stub in one route stopped the run before the next,
# and the gate then failed on a formula file that was never drawn instead of on the panel.
[ -z "$failed" ] || { echo "diag-regen: a drawing above failed (its message names it); every route was still drawn" >&2; exit 1; }
exit 0
