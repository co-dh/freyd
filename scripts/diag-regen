#!/bin/sh
# diag-regen — redraw every picture the notes draw, and nothing else.
#
#     ./scripts/diag-regen              redraw all of them
#     ./scripts/diag-regen --missing    draw only the ones with no file in diag/generated/
#
# The notes THEMSELVES are the list: `diag-export --list` reads every `#lean(...)`/`#leanc(...)`
# selector out of the note's own metadata, and `note-files --generated` every surviving `#import`
# as a path from the file making it.  A second
# copy of that list in a header comment is how the two drifted — three declarations were renamed and
# the comment went on naming the old ones — and a pattern written for the note's own
# `generated/x.typ` never saw a chapter's `../generated/x.typ` and redrew fewer pictures, exiting 0.
#
# BOTH notes are scanned.  allegory-axioms.typ states the laws and allegory2.typ works the proofs,
# and a picture named by only one of them is still a picture that has to be redrawn.
#
# SEVEN ROUTES: a `#lean(...)` name is drawn by `--string` (the panel
# the note imports), a `#leanc(...)` name by `--circuit` (the same declaration under the monoidal
# reading), a `#leancd(...)` name by `--commutative` (the statement as a graph), a `#leanf(...)`
# name by `--formula` (the statement in the note's spelling), a `#leant(...)` name by `--type` (the
# hom its arrows share), a `<decl>.proof` by `--proof`, and what is left by the term walk.  The route is not a property of the name, so the lists are asked
# for separately rather than guessed at here.
cd "$(dirname "$0")/.." || exit 1
missing=
[ "$1" = "--missing" ] && { missing=1; shift; }
[ $# -eq 0 ] || { echo "usage: diag-regen [--missing]" >&2; exit 2; }

# Only the names with no picture on disk, under --missing; the name IS the file's stem, `.proof` and
# all, so one test answers for every route.  A `#lean(a, b)` call arrives as one `a+b` line and is
# redrawn WHOLE when either of its pictures is missing: the two share a box, so drawing one of them
# alone would give it a depth of its own and leave the pair standing at two heights.
# `$1` is the route's output directory: the string route writes diag/generated/, the circuit route
# one level down, and a test against the wrong one reports every picture missing.
# `$2` = `whole` keeps a `+`-joined name as ONE file to test: the commutative route's `+` joins two
# DIFFERENT statements on one page (not a shared box like the string route's `#lean(a, b)`), and its
# output file is named after the whole selector, `A+B.typ`, never split into `A.typ`/`B.typ`.
filter() {
  dir=$1
  if [ -z "$missing" ]; then cat; else
    while IFS= read -r n; do
      [ -n "$n" ] || continue
      if [ "$2" = "whole" ]; then
        [ -f "$dir/$n.typ" ] || printf '%s\n' "$n"
      else
        for p in $(printf '%s\n' "$n" | tr '+' ' '); do
          [ -f "$dir/$p.typ" ] || { printf '%s\n' "$n"; break; }
        done
      fi
    done
    return 0
  fi
}

# ONE PROCESS PER CALL, half the cores at a time.  The exe draws its arguments as tasks over one
# shared environment, and a whole route in one process contends on it: 176 circuits cost 2011 CPU
# seconds that way and 184 as a process each, the strings 3301 against 1201.  Half the cores because
# a panel with a long naturality search holds 1.6 GiB.  The build and the index are done ONCE, before
# the first picture and only when there is one: the index is refreshed under a lock.
# `$1` is the list, a call to a line; the rest is the route's flag.
draw() {
  names=$1; shift
  [ -n "$names" ] || return 0
  [ -n "$prepared" ] || ./scripts/diag-export --prepare || exit 1
  prepared=1
  printf '%s\n' "$names" \
    | xargs -d '\n' -n 1 -P "$(( ($(nproc) + 1) / 2 ))" ./scripts/diag-export --prepared "$@" || exit 1
}

all=$(./scripts/note-files --generated) || exit 1
# The `#import`s are drawn BEFORE the metadata is asked for: the listings below compile the note, and
# a note whose import has no file yet does not compile, so a new import could never be drawn.
plain=$(printf '%s\n' "$all" | grep -v '\.proof$' | filter diag/generated)
proofs=$(printf '%s\n' "$all" | filter diag/generated | sed -n 's|\.proof$||p')
draw "$plain"
draw "$proofs" --proof

# The two metadata listings are the EXPORTER's: it is the process that draws them, and asking it
# keeps the route and its list in one place.
lean=$(./scripts/diag-export --list lean-panel) || exit 1
circuit=$(./scripts/diag-export --list lean-circuit) || exit 1
cd=$(./scripts/diag-export --list lean-cd) || exit 1
formula=$(./scripts/diag-export --list lean-formula) || exit 1
type=$(./scripts/diag-export --list lean-type) || exit 1
# The three lists are DISJOINT by construction — `--generated` is the `#import`s alone and
# `--list` the metadata calls — so nothing is subtracted here.  The union they once shared is what
# drew a picture twice, once by its own route and once as an import that does not exist.

leans=$(printf '%s\n' "$lean" | filter diag/generated)
circuits=$(printf '%s\n' "$circuit" | filter diag/generated/circuit)
cds=$(printf '%s\n' "$cd" | filter diag/generated/commutative whole)
formulas=$(printf '%s\n' "$formula" | filter diag/generated/formula)
draw "$leans" --string
draw "$circuits" --circuit
draw "$cds" --commutative
draw "$formulas" --formula
draw "$(printf '%s\n' "$type" | filter diag/generated/type)" --type
exit 0
