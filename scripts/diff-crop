#!/usr/bin/env python3
"""diff-crop — the before/after pictures for a review, cut to what actually changed.

    ./scripts/diff-crop                       # HEAD's PDF vs the working tree's, for both notes
    ./scripts/diff-crop BEFORE.pdf AFTER.pdf [OUTDIR]

One image per CONNECTED REGION of change, not one per page: a page-wide bounding box is a whole table,
and the chamfer that vanished inside it is invisible once a phone scales the pair down.  `before` is
stacked ABOVE `after` so each half keeps the full screen width, and a small crop is blown up to MINW.
A page whose pixels are identical produces nothing — a pair the reader cannot tell apart costs him the
whole review.
"""
import os, re, shutil, subprocess, sys, tempfile

DPI, PAD, MINW, MAXH = 150, 26, 1000, 1500
MINAREA = 40                     # ignore antialiasing specks
GAP = 90                         # change regions closer than this are one edit
NOTES = ("diag/allegory-axioms.pdf", "diag/allegory2.pdf")


def run(*a):
    return subprocess.run(a, capture_output=True, text=True)


def size(png):
    return tuple(int(x) for x in run("magick", "identify", "-format", "%wx%h", png).stdout.split("x"))


def components(diff):
    """Bounding boxes of the changed blobs in an `compare -metric AE` difference image."""
    r = run("magick", diff, "-fuzz", "20%", "-fill", "white", "-opaque", "red", "-threshold", "50%",
            "-define", "connected-components:verbose=true",
            "-define", f"connected-components:area-threshold={MINAREA}",
            "-connected-components", "8", "null:")
    out = []
    for ln in r.stdout.splitlines():
        m = re.match(r"\s*\d+:\s+(\d+)x(\d+)([+-]\d+)([+-]\d+)\s+[\d.,-]+\s+(\S+)", ln)
        if not m:
            continue
        w, h, x, y = (int(v) for v in m.groups()[:4])
        if m.group(5).startswith(("gray(0)", "srgb(0,0,0)")):
            continue             # the unchanged black background, not an edit
        if w > 1200 and w * h > 600000:
            continue             # a whole-page blob: the layout moved, crop by page instead
        out.append((x, y, x + w, y + h))
    return out


def merge(boxes):
    boxes, again = list(boxes), True
    while again:
        again, res = False, []
        for b in boxes:
            for i, r in enumerate(res):
                if (b[0] < r[2] + GAP and r[0] < b[2] + GAP
                        and b[1] < r[3] + GAP and r[1] < b[3] + GAP):
                    res[i] = (min(b[0], r[0]), min(b[1], r[1]), max(b[2], r[2]), max(b[3], r[3]))
                    again = True
                    break
            else:
                res.append(b)
        boxes = res
    return sorted(boxes, key=lambda b: (b[1], b[0]))


def label(src, out, text, tmp, scale):
    run("magick", src, *scale, "-bordercolor", "white", "-border", "6", "-background", "white",
        "-splice", "0x30", "-gravity", "northwest", "-pointsize", "22", "-fill", "red",
        "-annotate", "+8+4", text, out)


def crops(before_pdf, after_pdf, out, tag=""):
    tmp = tempfile.mkdtemp(prefix="diff-crop.")
    os.makedirs(out, exist_ok=True)
    os.makedirs(tmp + "/b"), os.makedirs(tmp + "/a")
    run("pdftoppm", "-r", str(DPI), "-png", before_pdf, tmp + "/b/p")
    run("pdftoppm", "-r", str(DPI), "-png", after_pdf, tmp + "/a/p")
    bs, as_ = sorted(os.listdir(tmp + "/b")), sorted(os.listdir(tmp + "/a"))
    if len(bs) != len(as_):
        print(f"{tag}page count differs: before {len(bs)}, after {len(as_)}")
    made = []
    for i in range(min(len(bs), len(as_))):
        n, b, a, d = i + 1, f"{tmp}/b/{bs[i]}", f"{tmp}/a/{as_[i]}", f"{tmp}/d.png"
        m = re.match(r"([\d.e+]+)", run("compare", "-metric", "AE", b, a, d).stderr.strip())
        if not m or float(m.group(1)) <= 0:
            continue
        W, H = size(b)
        for j, (x0, y0, x1, y1) in enumerate(merge(components(d)), 1):
            x0, y0, x1, y1 = max(0, x0 - PAD), max(0, y0 - PAD), min(W, x1 + PAD), min(H, y1 + PAD)
            geo = f"{x1 - x0}x{y1 - y0}+{x0}+{y0}"
            run("magick", b, "-crop", geo, "+repage", f"{tmp}/cb.png")
            run("magick", a, "-crop", geo, "+repage", f"{tmp}/ca.png")
            scale = ["-resize", f"{MINW}x"] if x1 - x0 < MINW else []
            label(f"{tmp}/cb.png", f"{tmp}/lb.png", f"{tag}p{n} BEFORE", tmp, scale)
            label(f"{tmp}/ca.png", f"{tmp}/la.png", f"{tag}p{n} AFTER", tmp, scale)
            pair = os.path.join(out, f"{tag.strip('- ')}p{n}-{j}.png".lstrip("-"))
            run("magick", f"{tmp}/lb.png", f"{tmp}/la.png", "-background", "gray70", "-append", pair)
            if size(pair)[1] > MAXH:
                run("magick", pair, "-resize", f"x{MAXH}", pair)
            print(f"{tag}page {n} region {j}: {geo} -> {pair}")
            made.append(pair)
    shutil.rmtree(tmp, ignore_errors=True)
    return made


def main(argv):
    if len(argv) >= 2:
        crops(argv[0], argv[1], argv[2] if len(argv) > 2 else "review")
        return
    # No arguments: the usual review, HEAD's committed PDF against the one `make p` just built.
    out = os.path.join(tempfile.gettempdir(), "diff-crop")
    shutil.rmtree(out, ignore_errors=True)
    made = []
    for note in NOTES:
        if not os.path.exists(note):
            continue
        old = os.path.join(tempfile.gettempdir(), "head-" + os.path.basename(note))
        r = subprocess.run(["git", "show", f"HEAD:{note}"], capture_output=True)
        if r.returncode:
            print(f"git show HEAD:{note}: {r.stderr.decode().strip()}")
            continue
        open(old, "wb").write(r.stdout)
        made += crops(old, note, out, tag=os.path.basename(note).replace(".pdf", "") + "-")
    if not made:
        print("nothing changed since HEAD")


if __name__ == "__main__":
    main(sys.argv[1:])
