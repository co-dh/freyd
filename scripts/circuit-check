#!/bin/sh
# circuit-check — the circuit diagrams' gate.  Every panel the note draws is an obligation, and the
# record answering it is a line of `diag/circuit-panels.txt`.
#
#   ./scripts/circuit-check
#
# ENUMERATED FROM THE NOTE, NOT FROM THE FILE.  The panel list comes from the NOTE: `cpanel` emits
# one `metadata((kind: "circuit", cert: …))` per panel, so `typst query` hands back every panel the
# note draws, in document order, with its own cert.  `diag/circuit-panels.txt` is then read in that
# same order and must answer panel for panel — deleting a line does not drop an obligation, it
# leaves a panel with no record and fails the gate.
#
# NOTHING HERE READS THE `.typ` AS TEXT.  Both halves of every comparison are drawn, not parsed:
#   the note's half   `scripts/circuit` rebuilt from the panel's OWN cert — the same rebuild
#                     `circuit --compare` gates at 0 drift, so it IS the note's picture;
#   the generated half `diag-export --circuit <selector>`, from the elaborated Lean statement;
#   the comparison    `scripts/svg-diff` over the two compiled SVGs — path data, not labels.
# Both halves render through `diag/cpanel.typ`, so a difference is a difference of CONTENT.
#
# ONE LINE PER PANEL:
#   ok            the two pictures carry the same primitives
#   DIFF          they do not; the report is under .lake/build/circuit-check/
#   NO-DECL       the line names no declaration (`-`) — a calculation step, which is no statement
#   CANNOT-DRAW   the exe refused the selector — its record's error follows — or wrote no record
#                 for it, or one of the two pictures does not compile
#   CANNOT-CHECK  the panel's worker died before writing its row
# Exit is non-zero on anything but ok and NO-DECL.  NO-DECL is reported, not failed: it is a panel
# waiting for a lemma, and the count is what says how much of the note the generator can reach.
#
# THE PER-PANEL WORK RUNS `$(nproc)` AT A TIME: `--gen <selector> <file>` compiles one picture the
# export drew and `--panel <i>` answers panel `i` into `$OUT/rows/<i>`; the rows are then printed
# in panel order, and the exit status is read off them, never off xargs's.
set -e
cd "$(dirname "$0")/.." || exit 1
OUT=.lake/build/circuit-check
NOTE=diag/allegory-axioms.typ
PANELS=diag/circuit-panels.txt

row() { printf '%s\n' "$1" > "$OUT/rows/$i"; }
panel() {
  i=$1
  sel=$(sed -n "${i}p" "$OUT/sel")
  lab=$(sed -n "${i}p" "$OUT/lab")
  exp=$(sed -n "${i}p" "$OUT/expect")
  head="$lab  $exp"
  if [ "$sel" = "-" ]; then row "NO-DECL      $head"; return; fi
  # Whether it drew, and why not, is the selector's own RECORD — never a search of the run's text.
  rec=$(jq -c --arg s "$sel" 'select(.selector == $s)' "$OUT/records.jsonl")
  if [ -z "$rec" ]; then
    row "CANNOT-DRAW  $head  --  ./scripts/diag-export --circuit --records wrote no record for $sel"
    return
  fi
  err=$(printf '%s\n' "$rec" | jq -r '.error // empty')
  if [ -n "$err" ]; then row "CANNOT-DRAW  $head  --  $sel: $err"; return; fi
  {
    echo '#import "/diag/cpanel.typ": cpanel'
    echo '#set page(width: auto, height: auto, margin: 12pt)'
    echo '#set text(size: 10pt)'
  } > "$OUT/note/$i.typ"
  if ! eval "./scripts/circuit $(sed -n "${i}p" "$OUT/args")" >> "$OUT/note/$i.typ" \
       2> "$OUT/note/$i.err"; then
    row "CANNOT-DRAW  $head  --  the NOTE's own cert no longer draws: $(head -1 "$OUT/note/$i.err")"
    return
  fi
  if ! typst compile --root . "$OUT/note/$i.typ" "$OUT/note/$i.svg" > "$OUT/note/$i.log" 2>&1; then
    row "CANNOT-DRAW  $head  --  the note's panel does not compile, see $OUT/note/$i.log"
    return
  fi
  # typst writes no SVG for a page that does not compile, and `$OUT` starts empty.
  if [ ! -f "$OUT/gen/$sel.svg" ]; then
    row "CANNOT-DRAW  $head  --  $sel does not compile, see $OUT/gen/$sel.log"
    return
  fi
  if ./scripts/svg-diff "$OUT/note/$i.svg" "$OUT/gen/$sel.svg" > "$OUT/note/$i.diff" 2>&1; then
    row "ok           $head"
  else
    row "DIFF         $head  --  $sel: $(wc -l < "$OUT/note/$i.diff") lines in $OUT/note/$i.diff"
  fi
}
if [ "$1" = --gen ]; then typst compile --root . "$3" "$OUT/gen/$2.svg" > "$OUT/gen/$2.log" 2>&1; exit; fi
if [ "$1" = --panel ]; then panel "$2"; exit 0; fi

rm -rf "$OUT"
mkdir -p "$OUT/note" "$OUT/gen" "$OUT/rows"
rc=0

typst query --root . "$NOTE" metadata --field value > "$OUT/meta.json"
CERTS='[.[] | select(type == "object" and .kind == "circuit") | .cert] | .[]'
jq -r "$CERTS | .expect" "$OUT/meta.json" > "$OUT/expect"
# The cert's own fields as `scripts/circuit`'s arguments, shell-quoted by jq: `--at` takes the keys
# that are neither the formula nor the ports nor the three named options — the table constants the
# row instantiates, which `draw` merges back into the cert it emits.
jq -r "$CERTS"' | ["--src", .src, "--tgt", .tgt]
  + (if .sigs then ["--sigs", .sigs] else [] end)
  + (if .mu then ["--mu", .mu] else [] end)
  + (if .polys then ["--polys", .polys] else [] end)
  + ((del(.expect, .src, .tgt, .sigs, .mu, .polys) | to_entries
      | map(.key + ":" + .value)) as $at
     | if ($at | length) > 0 then ["--at", ($at | join(" "))] else [] end)
  + [.expect] | @sh' "$OUT/meta.json" > "$OUT/args"

# `scripts/panels.py`, not an `awk -F` here and another in `scripts/string-check`: the two manifests
# have one form, so they have one reader, and a column added to the form reaches both gates at once.
./scripts/panels.py "$PANELS" 1 > "$OUT/sel"
./scripts/panels.py "$PANELS" 2 > "$OUT/lab"
./scripts/panels.py "$PANELS" 3 > "$OUT/want"
diff -u "$OUT/want" "$OUT/expect" || {
  echo "circuit-check: $PANELS does not answer the note panel for panel — a minus line is a record" \
    "for a panel the note no longer draws, a plus line a panel with no record at all" >&2
  exit 1
}

# One `diag-export` run for all of them: the exe holds ONE imported environment for its whole life,
# so a second invocation pays for the whole `Freyd` import again.  Its RECORDS say what drew: one
# JSON line per selector, the file it wrote or the error it drew none for.
awk '$1 != "-" { print $1 }' "$OUT/sel" | sort -u > "$OUT/draw"
exrc=0
# shellcheck disable=SC2046
./scripts/diag-export --circuit --records $(cat "$OUT/draw") > "$OUT/records.jsonl" \
  2> "$OUT/export.log" || exrc=$?

# Each drawn picture compiled ONCE, however many panels share it; then every panel's own work.
xrc=
jq -r 'select(.file) | .selector, .file' "$OUT/records.jsonl" > "$OUT/drawn"
xargs -r -d '\n' -n 2 -P "$(nproc)" ./scripts/circuit-check --gen < "$OUT/drawn" || xrc="$xrc $?"
n=$(wc -l < "$OUT/expect")
seq "$n" | xargs -r -n 1 -P "$(nproc)" ./scripts/circuit-check --panel || xrc="$xrc $?"

i=0
while [ "$i" -lt "$n" ]; do
  i=$((i + 1))
  if [ ! -f "$OUT/rows/$i" ]; then
    echo "CANNOT-CHECK $(sed -n "${i}p" "$OUT/lab")  $(sed -n "${i}p" "$OUT/expect")  --  panel $i's" \
      "worker wrote no row; ./scripts/circuit-check --panel $i says why"
    rc=1
    continue
  fi
  cat "$OUT/rows/$i"
  read -r v _ < "$OUT/rows/$i"
  case $v in ok|NO-DECL) ;; *) rc=1 ;; esac
done
# A selector with no record, or an export that exited nonzero while every record names a file, is
# explained by NO row above — the last lines of the export's stderr say what it was.
jq -r '.selector' "$OUT/records.jsonl" | sort -u > "$OUT/answered"
jq -r 'select(.error) | .selector' "$OUT/records.jsonl" > "$OUT/refused"
comm -23 "$OUT/draw" "$OUT/answered" > "$OUT/lack"
if [ -s "$OUT/lack" ] || { [ "$exrc" != 0 ] && [ ! -s "$OUT/refused" ]; }; then
  echo "circuit-check: ./scripts/diag-export --circuit --records exited $exrc; its last lines:" >&2
  tail -20 "$OUT/export.log" >&2
  rc=1
fi
# A compile that fails is a row above; a worker that fails with every row passing is not.
if [ -n "$xrc" ] && [ "$rc" = 0 ]; then
  echo "circuit-check: xargs exited$xrc while every row passed" >&2
  rc=1
fi
exit $rc
