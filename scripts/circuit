#!/usr/bin/env python3
"""circuit — the CIRCUIT picture a formula denotes, drawn mechanically.

`scripts/diagram` runs the note's formula through the Hinze–Marsden reading; this runs it through
the MONOIDAL one.  Same input — the formula in the note's notation plus the source and target
objects, which a formula alone does not fix — and the same self-certifying `cert:`, but the picture
downstream is the other language: a WIRE is an object, a BOX is a morphism, composition runs left to
right, and a product is TWO wires, never one wire labelled `A×B`.  A `#cpanel(...)` call goes out,
ready to paste beside the row it draws; once pasted, `--compare` rebuilds every literal the note
holds from its own `cert:` and fails on any drift, and `--write` splices the rebuilt ones over them.

The design is diag/CIRCUIT-GEN.md and this is its §5 slice.  Typing is §1.3: every subterm carries
its source and target OBJECT, read off diag/circuit-sigs.json by unification with the port in hand,
and `wires(X)` is the list of strands a port at `X` carries: its ×-factors, none for the unit, and
a `polys` functor's product summand.  Drawing is §3: one clause of `walk` per operator, each
primitive placed once.  Widths are deliberately absent — `cpanel` measures its own labels at
render time (§4f), so this never guesses font metrics.

`∩`, `(g→x,y)` and `⦇x⦈` are real nodes in the shared grammar now, with a drawing rule each: a meet
is copy / both lanes / merge (§3 row 12), a conditional is ONE box carrying the note's own spelling
(row 16 — the expanded `∪` of guarded branches was unreadable, user 2026-09-01), and a fold is
MELLIÈS' FUNCTORIAL BOX — the algebra's own circuit between two bars, which is how the note already
draws it (row 17).  `⊸` is still an atom, and §3 row 14 reads it where it stands, as the constant it is.
`⟨x,y⟩` is the fork (row 20): copy, both lanes, outputs stacked — a meet less its merge.

WHAT IT STILL REFUSES, each where it is written: an `∩` of more than two operands, a fold whose
carrier neither the panel nor the algebra's row declares, and `°` on a composite (row 8's frame —
over a PRODUCT it distributes, one flipped box per wire).
"""
import difflib, functools, importlib.machinery, importlib.util, json, os, re, sys

sys.dont_write_bytecode = True                 # no `scripts/__pycache__` beside the other scripts
_P = os.path.join(os.path.dirname(os.path.abspath(__file__)), "scanline")
_S = importlib.util.spec_from_loader("scanline", importlib.machinery.SourceFileLoader("scanline", _P))
sl = importlib.util.module_from_spec(_S)
_S.loader.exec_module(sl)
parse, norm, spell, Unhandled = sl.parse, sl.norm, sl.spell, sl.Unhandled

SIGS = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "diag",
                    "circuit-sigs.json")
OUT = os.path.join(os.path.dirname(SIGS), "circuit-slice.typ")      # what `--slice` writes
KONST = "⊸"
PROJ = {"π₁": 0, "π₂": 1}       # §3 row 3: which ×-factor survives; the others end at a dot
# CIRCUIT-GEN §5's rows, in dependency order: `--slice` is the acceptance test.  The last three are
# the operators §1.5 added — one demonstration each, every one a term the note itself writes.
SLICE = [("13.3.3d r1", "S%∋ est(R°)", "F([A])", "[A]"),
         ("13.3.3c r1", "(𝟙×R°)(⊸ nil ∪ (p×𝟙) cons)", "A×[A]", "[A]"),
         ("13.3.3b r2", "F(prefix) [nil,⊸ nil ∪ cons] list(p)", "F([A])", "[A]"),
         ("∩ (13.3.3b)", "prefix° prefix∩R", "[A]", "[A]"),
         ("→ (13.3.3c)", "(π₁p→cons,⊸ nil)", "A×[A]", "[A]"),
         ("⦇⦈ (13.3.3b)", "⦇[nil,⊸ nil ∪ cons]⦈", "[A]", "[A]"),
         ("⦇⦈ (13.4.4a)", "⦇S⦈", "tree(A)", "[A]×[A]"),
         ("⟨⟩ (12.1e)", "[nil 𝟙%∋,⟨(𝟙×∋)%∋ E(cons),π₂⟩ cup]", "F(E[A])", "E[A]"),
         ("13.4.4a r2", "𝟙%∋ E(⦇S⦈)E(choose)est(R°)", "tree(A)", "[A]"),
         ("13.4.4a r4", "𝟙%∋ E(⦇S⦈)est((R×R)°)𝟙%∋ E(choose)est(R°)", "tree(A)", "[A]"),
         # rows 10–39: named `<section> :<note line> <helper>`; the ports were read off the note's own
         # type labels (t60-ports sweep), so a row here draws exactly the display at that line
         ("subseq :2932 sbA4", "[nil%∋,((𝟙×∋)(cons ∪ π₂))%∋]", "F(E[A])", "E[A]"),
         ("subseq :2936 sbA5", "[nil 𝟙%∋,((𝟙×∋)(cons ∪ π₂))%∋]", "F(E[A])", "E[A]"),
         ("greedy :3920 mbp", "R°R°", "A", "A"),
         ("greedy :3925 mbp", "R°", "A", "A"),
         ("takewhile :4230 twp", "α prefix list(p)", "F([A])", "[A]"),
         ("takewhile :4239 twp", "F(prefix) [nil,⊸ nil ∪ (p×list(p)) cons]", "F([A])", "[A]"),
         ("takewhile :4244 twp", "[nil,⊸ nil ∪ (p×(prefix list(p))) cons]", "F([A])", "[A]"),
         ("takewhile :4247 twp", "F(prefix list(p))S", "F([A])", "[A]"),
         ("takewhile :4294 twp", "(𝟙×R°)⊸ nil ∪ (p×R°) cons", "A×[A]", "[A]"),
         ("takewhile :4299 twp", "⊸ nil ∪ (p×R°) cons", "A×[A]", "[A]"),
         ("takewhile :4303 twp", "⊸ nil ∪ (p×𝟙) cons R°", "A×[A]", "[A]"),
         ("takewhile :4307 twp", "⊸ nil R° ∪ (p×𝟙) cons R°", "A×[A]", "[A]"),
         ("takewhile :4312 twp", "(⊸ nil ∪ (p×𝟙) cons)R°", "A×[A]", "[A]"),
         ("takewhile :4345 twp", "[nil%∋ est(R°),(⊸ nil ∪ (p×𝟙) cons)%∋ est(R°)]", "F([A])", "[A]"),
         ("takewhile :4348 twp", "[nil,(⊸ nil ∪ (p×𝟙) cons)%∋ est(R°)]", "F([A])", "[A]"),
         ("takewhile :4351 twp", "[nil,(π₁p→cons,⊸ nil)]", "F([A])", "[A]"),
         ("takewhile :4422 twp", "(prefix list(p))%∋ est(R°)", "[A]", "[A]"),
         ("takewhile :4433 :5120 twp", "⦇S%∋ est(R°)⦈", "[A]", "[A]"),
         ("takewhile :4440 twp", "⦇[nil,(π₁p→cons,⊸ nil)]⦈", "[A]", "[A]"),
         ("mss :4528 :4925 mss-pic", "(segment sum)%∋ est(≥)", "[A]", "A"),
         ("mss :4530 mss-pic", "(suffix (prefix sum))%∋ est(≥)", "[A]", "A"),
         ("mss :4533 mss-pic", "suffix%∋ E(prefix sum) est(≥)", "[A]", "A"),
         ("mss :4536 mss-pic", "suffix%∋ E((prefix sum)%∋)union est(≥)", "[A]", "A"),
         ("mss :4541 mss-pic", "suffix%∋ E((prefix sum)%∋)E(est(≥)) est(≥)", "[A]", "A"),
         ("mss :4544 :4933 mss-pic", "suffix%∋ E((prefix sum)%∋ est(≥))est(≥)", "[A]", "A"),
         ("filter :5025 twp", "(𝟙×R°)(π₂ ∪ (p×𝟙) cons)", "A×[A]", "[A]"),
         ("filter :5027 twp", "(π₂ ∪ (p×𝟙) cons)R°", "A×[A]", "[A]"),
         ("filter :5052 twp", "[nil,(π₂ ∪ (p×𝟙) cons)%∋ est(R°)]", "F([A])", "[A]"),
         ("filter :5055 twp", "[nil,(π₁p→cons,π₂)]", "F([A])", "[A]"),
         ("filter :5128 fpic", "⦇[nil,(π₁p→cons,π₂)]⦈", "[A]", "[A]")]


AT = {}     # the table constants the cert in hand instantiates, `A: "Int"`, while its circuit is drawn
OWN = {}    # and the signatures it declares itself, laid over the table: a §14 name it has never heard
            # of, or a letter the table binds to another section's meaning.
MU = {}     # and the initial algebra it folds from, laid over the table's `mu` the same way: §15's
            # `T` is an object no functor in the file names, and its carrier `E(A)` no row declares.
POLYS = {}  # and the coproduct its `F` is: §15's snoc-lists put the recursive factor FIRST, where
            # the file's cons-list `A×x` has it last, and §14's dp leaves `F` a summand with none.


@functools.lru_cache(maxsize=None)
def raw():
    """diag/circuit-sigs.json — what each atom is an arrow between, and whether it is a map.
    Read once: `wires` asks for the polynomials at every node, and nobody writes to the table."""
    return json.load(open(SIGS, encoding="utf-8"))


def sigs():
    """The table at `AT`: B&dM leave the element type `A` a parameter, and the mss rows fix it at
    `Int` — one key on the cert, not a second table over `Int`.  Any constant, any object.
    `OWN` lies over the result: what the panel declares itself beats what the file says."""
    t = inst(raw(), AT)
    if MU:
        t = {**t, "mu": {**t["mu"], **{f: inst(o, AT) for f, (o, _) in MU.items()}}}
    if POLYS:
        # An EMPTY branch list drops the row: an abstract summand functor is one wire, not a fork.
        p = {**t["polys"], **inst(POLYS, AT)}
        t = {**t, "polys": {f: bs for f, bs in p.items() if bs}}
    if not OWN:
        return t
    # An own row types the head's ATOM use; the file's rows for the head as an OPERATOR keep their
    # argument scheme, which `head:src⟶tgt` has no room to state.
    own = {k: v + [r for r in rows(t["sigs"], k) if "arg" in r] for k, v in inst(OWN, AT).items()}
    return {**t, "sigs": {**t["sigs"], **own}}


def parse_sigs(s):
    """`--sigs "sort:E(A)⟶[A] S:F(A)⟶A"` — space-separated `head:src⟶tgt` pairs, keyed by the
    label's HEAD (`sort`, never `sort(P)`); the cert carries the string back verbatim.
    The ARROW says which box: `⟶` a relation, chamfered, and `⟼` — maps to — a MAP, square.  The
    marker belongs here because these are the SECTION-LOCAL names, declared per panel and nowhere
    else (`pick`, `schedule`, `snoc` at `[Job]` and at `String`); without it every local map would
    have to enter diag/circuit-sigs.json for no reason but to be drawn square.
    A head may be given TWICE, as the file's own table gives one: §15's `nil` is `𝟏⟼[Code]` in the
    algebra and `𝟏⟼[Char]` in the bracket beside it, and the port in hand picks the row — the one
    an unknown target cannot choose between goes FIRST."""
    out = {}
    for p in s.split():
        head, _, arrow = p.partition(":")
        is_map = "⟼" in arrow
        src, sep, tgt = arrow.partition("⟼" if is_map else "⟶")
        if not (head and sep and src and tgt):
            raise Unhandled(f"--sigs: `{p}` is not a `head:src⟶tgt` pair (`⟼` for a map)")
        out.setdefault(head, []).append({"src": src, "tgt": tgt, "map": is_map})
    return out


def parse_polys(s):
    """`--polys "F:𝟏+x×Code"` — space-separated `functor:branch+branch` pairs, the coproduct a
    `[x,y]` forks and the fusion law puts its `𝟙` and `R` on, laid over diag/circuit-sigs.json's
    `polys`.  §15's lists are built by `snoc`, so the recursive factor comes FIRST and the file's
    cons-list `A×x` has the product the wrong way round; §14's dp leaves `F` an abstract summand
    functor, and an EMPTY right side — `--polys "F:"` — drops the row, which is the one wire the
    `Fᵢ` beside it draws."""
    out = {}
    for p in s.split():
        f, sep, bs = p.partition(":")
        if not (f and sep):
            raise Unhandled(f"--polys: `{p}` is not a `functor:branch+branch` pair")
        out[f] = [b for b in bs.split("+") if b]
    return out


def parse_mu(s):
    """`--mu "F:T⟶E(A)"` — space-separated `functor:object[⟶carrier]` triples.  The object is the
    functor's INITIAL ALGEBRA, laid over diag/circuit-sigs.json's `mu`; the optional carrier is what
    a fold takes when the panel's target does not reach it and the algebra is a composite, so no row
    of its own declares it (§15's `⦇(F(∋)S)%∋ thin Q⦈`, whose carrier is `E(A)` and not the `A` the
    panel ends at)."""
    out = {}
    for p in s.split():
        f, sep, rest = p.partition(":")
        o, _, c = rest.partition("⟶")
        if not (f and sep and o):
            raise Unhandled(f"--mu: `{p}` is not a `functor:object[⟶carrier]` triple")
        out[f] = (o, c or None)
    return out


def parse_at(s):
    """`--at "A:Int"` — space-separated `key:object` pairs, the table constants this row fixes.
    The cert already carries them (`draw` merges `AT` into it), so this is what lets a hand run
    reach the instantiation `--compare` reads back."""
    out = {}
    for p in s.split():
        key, sep, val = p.partition(":")
        if not (key and sep and val):
            raise Unhandled(f"--at: `{p}` is not a `key:object` pair")
        out[key] = val
    return out


def inst(t, env):
    if isinstance(t, dict):
        return {k: v if k == "//" else inst(v, env) for k, v in t.items()}
    if isinstance(t, list):
        return [inst(v, env) for v in t]
    return re.sub(r'\w+', lambda m: env.get(m[0], m[0]), t) if env and isinstance(t, str) else t


# ---------------------------------------------------------------- objects
# An object is normalised on the way in — `[A]` is `list(A)`, `×` flat — so unification is
# structural; `oshow` puts the brackets back, because `[A]` is what the note prints on a port.
def obj(s):
    return norm(parse(s)) if isinstance(s, str) else norm(s)


def oshow(e):
    if e[0] == 'app':
        return f"[{oshow(e[2])}]" if e[1] == 'list' else f"{e[1]}({oshow(e[2])})"
    return '×'.join(oshow(x) for x in e[1]) if e[0] == 'prod' else spell(e)


SUP = str.maketrans("0123456789", "⁰¹²³⁴⁵⁶⁷⁸⁹")


def head(e):
    """The name `e`'s label opens with — `[` for a list or a power of lists — which sets the spacing."""
    return '[' if e[0] == 'app' and e[1] == 'list' else e[1] if e[0] in ('app', 'atom') else head(e[1][0])


def lshow(e):
    """A type label: application is juxtaposition, spaced only beside a multi-letter name (`E tree A`,
    `EF[A]`, `FA`); n equal ×-factors are a power (`E[A]²`); `F(A,B)`, `F(A×B)` keep the parentheses."""
    if e[0] == 'prod':
        if any(x != e[1][0] for x in e[1]):
            return '×'.join(lshow(x) for x in e[1])
        s = lshow(e[1][0])
        return (f"({s})" if ' ' in s else s) + str(len(e[1])).translate(SUP)
    if e[0] != 'app':
        return spell(e)
    s = lshow(e[2])
    if e[1] == 'list':
        return f"[{s}]"
    if e[2][0] == 'atom' and ',' in s or e[2][0] == 'prod' and '×' in s:
        return f"{e[1]}({s})"
    return e[1] + ('' if s[0] == '[' or len(e[1]) == 1 == len(head(e[2])) else ' ') + s


def wires(X):
    """The strands a port at `X` has: its ×-factors, none for `𝟏`, and for a `polys` functor the
    strands of its one product summand — `F([A])` at a box is the `cons` branch's `A`,`[A]`, the
    note's §13.3.3b decision that `𝟏+` is not drawn (`E(F([A]))` stays one wire: only a
    polynomial head opens).  The tape alone keeps the coproduct as one wire, and says so itself."""
    if X == ('atom', '𝟏'):
        return []
    if X[0] == 'prod':
        return [w for x in X[1] for w in wires(x)]
    ps = sigs()["polys"].get(X[1]) if X[0] == 'app' else None
    if ps is None:
        return [X]
    ss = [b for b in (subst(obj(p), {'x': X[2]}) for p in ps) if b != ('atom', '𝟏')]
    if len(ss) != 1:
        raise Unhandled(f"`{oshow(X)}` has {len(ss)} summands besides `𝟏` in {X[1]}'s polynomial"
                        f" ({', '.join(oshow(b) for b in ss)}): a case split, which only a tape"
                        f" draws — not a port's wires")
    return wires(ss[0])


def var(e):
    return e[0] == 'atom' and len(e[1]) == 1 and e[1].islower()


def ground(e):
    """No variable left: an end still holding one is not a port a walk can be started from."""
    seen = []

    def scan(x):
        seen.append(var(x))
        return sl.rec(x, scan)
    scan(e)
    return not any(seen)


def unify(scheme, X, env):
    """Bind the scheme's variables so it becomes `X`; the port in hand is always concrete."""
    if var(scheme):
        if env.setdefault(scheme[1], X) != X:
            raise Unhandled(f"{scheme[1]} is {oshow(env[scheme[1]])} and {oshow(X)} at once")
        return
    if scheme[0] != X[0] or (scheme[0] in ('atom', 'app') and scheme[1] != X[1]) \
            or (scheme[0] == 'prod' and len(scheme[1]) != len(X[1])):
        raise Unhandled(f"the object {oshow(X)} is not a {oshow(scheme)}")
    if scheme[0] == 'app':
        unify(scheme[2], X[2], env)
    elif scheme[0] == 'prod':
        for a, b in zip(scheme[1], X[1]):
            unify(a, b, env)


def subst(scheme, env):
    return env[scheme[1]] if var(scheme) and scheme[1] in env \
        else sl.rec(scheme, lambda x: subst(x, env))


# ---------------------------------------------------------------- the circuit normalizer (§1.4)
BRACKETS = ('union', 'case', 'cap', 'cond', 'cata', 'fork')


def mk(tag, ops):
    """A bracket node the normalizer MANUFACTURES: `spell` reads the third element verbatim, so a
    rebuilt node needs a spelling of its own instead of the stale one it inherited."""
    if tag == 'cond':                  # guard, body, …; an odd operand out is the default branch
        ts = [f"{spell(a)}→{spell(b)}" for a, b in zip(ops[::2], ops[1::2])]
        return (tag, ops, '(' + ','.join(ts + ([spell(ops[-1])] if len(ops) % 2 else [])) + ')')
    return (tag, ops, {'union': ' ∪ '.join(spell(x) for x in ops),
                       'cap': '∩'.join(spell(x) for x in ops),
                       'case': '[' + ','.join(spell(x) for x in ops) + ']',
                       'cata': '⦇' + spell(ops[0]) + '⦈',
                       'fork': '⟨' + ','.join(spell(x) for x in ops) + '⟩'}[tag])


def crec(e, f):
    """`sl.rec` stops AT a bracket node — the spider side never looks inside one, and that is what
    keeps `[x,y]` one bead over there.  A circuit opens all of them, so this walks in."""
    if e[0] not in BRACKETS:
        return sl.rec(e, f)
    ops = [f(x) for x in e[1]]
    return e if ops == list(e[1]) else mk(e[0], ops)


def cnorm(e):
    """CIRCUIT-GEN §1.4, applied before drawing on trust, exactly as scanline's `norm` trusts
    `F(R)F(S)=F(RS)`.  It is NOT that `norm`: this one keeps the `°` where the formula writes it,
    which `norm` pushes to the atoms, erasing the distinction §3 rows 7/8 draw."""
    e = crec(e, cnorm)
    d = sl.dun(e)                          # `R%∋=𝟙%∋ E(R)`, shared with `scanline.norm`
    if d is not None:
        return sl.rec(d, cnorm)
    if e[0] != 'comp':
        return e
    xs = [y for x in e[1] for y in (x[1] if x[0] == 'comp' else [x])]   # rule 1: flatten,
    xs = juxta(xs)
    xs = fuse(xs) or xs
    xs = [x for x in xs if x != ('atom', sl.UNIT)] or [('atom', sl.UNIT)]   # and `𝟙` is a wire
    return xs[0] if len(xs) == 1 else ('comp', xs)


def juxta(xs, tbl=None):
    """Application by juxtaposition (`bare` above is the printer's): an atom the table knows only WITH
    an argument takes the next one, keeping the note's `thin Q` — no rule tells it from `est(R)`."""
    tbl = sigs()["sigs"] if tbl is None else tbl
    out, i = [], 0
    while i < len(xs):
        rs = rows(tbl, xs[i][1]) if xs[i][0] == 'atom' else []
        if rs and all('arg' in r for r in rs) and i + 1 < len(xs) and xs[i + 1][0] == 'atom':
            # A hole, not a finished spelling: `rec` rewrites the argument and the context follows it.
            out.append(('app', xs[i][1], xs[i + 1], f"{xs[i][1]} −")); i += 2
        else:
            out.append(xs[i]); i += 1
    return out


def fuse(xs, polys=None):
    """Rule 3, tape fusion: `F(R)[f,g]=[f,(𝟙×R)g]` at `FX=𝟏+A×X`.  Without it a compositional draw
    of `F(prefix)[nil,body]` is two tapes in series where the note draws one (§4b).  Keyed on the
    polynomial, so the `𝟙` lands on the constant branch factor and `R` on the recursive one."""
    polys = sigs()["polys"] if polys is None else polys
    for i, (x, y) in enumerate(zip(xs, xs[1:])):
        if x[0] != 'app' or y[0] != 'case' or x[1] not in polys:
            continue
        rc = obj(polys[x[1]][-1])                        # `A×x`: the branch the functor recurses on
        if len(polys[x[1]]) != len(y[1]) or rc[0] != 'prod':
            continue
        f = ('prod', [x[2] if var(k) else ('atom', sl.UNIT) for k in rc[1]])
        br = list(y[1]); br[-1] = ('comp', [f, br[-1]])
        return xs[:i] + [mk('case', br)] + xs[i + 2:]
    return None


# ---------------------------------------------------------------- one clause per operator (§3)
def pic(k, src, tgt, is_map, _in=None, _out=None, **kw):
    """A layout node.  `_in`/`_out` are the strands its ports carry — the objects' `wires`, unless
    a tape keeps its coproduct whole or a composite takes its children's — and `nin`/`nout` their
    counts, which `cpanel` lays out over.  A `_`-prefixed field is the elaborator's, not emitted."""
    _in = wires(src) if _in is None else _in
    _out = wires(tgt) if _out is None else _out
    return dict(k=k, nin=len(_in), nout=len(_out), _in=_in, _out=_out, **kw), src, tgt, is_map


def box(label, src, tgt, is_map, frac=False, flip=False, **kw):
    return pic("box", src, tgt, is_map, label=label, chamfer=not is_map, frac=frac, flip=flip, **kw)


def walk(e, tbl, src=None, tgt=None, typing=False):
    """`(node, src, tgt, is_map)`.  One end of the arrow is always known — the panel's own port at
    the top, the previous factor's target inside a composite — and the signature says the other.
    `typing` is set where `typed` walks an OPERATOR's argument: that node is thrown away and only
    its two ends are kept, so a term with no picture of its own still has to type."""
    if e[0] == 'hc':
        raise Unhandled(f"`∘` composes ACROSS a functor wire, which is the spider reading;"
                        f" a circuit has no such direction (CIRCUIT-GEN §3 row 19): {spell(e)}")
    if e[0] == 'comp':
        return seq(e[1], tbl, src, tgt)
    if e[0] == 'conv':
        # `(R×S)°=R°×S°`: over a PRODUCT the `°` distributes, one flipped box per wire.  Rewritten
        # here and not in `cnorm`, so the label a box carrying `(R×S)°` prints stays the note's.
        if e[1][0] == 'prod':
            return stack([('conv', x) for x in e[1][1]], tbl, src)
        n, s, t, _ = walk(e[1], tbl, src=tgt, tgt=src, typing=typing)
        if n["k"] != "box":
            # Under `E(−)`/`P(−)` the node is discarded and only the swapped ends are wanted, so a
            # bracket's `°` — `[wrap,cat]°`, which has no box to flip — still types.
            if typing:
                return pic("conv", t, s, False, _in=[t], _out=[s])
            raise Unhandled(f"`{spell(e)}` writes `°` on a composite, which is the cup/cap frame of"
                            f" CIRCUIT-GEN §3 row 8 — not in the slice")
        return box(n["label"], t, s, False, frac=n["frac"], flip=not n["flip"])
    if e[0] == 'prod':
        return stack(e[1], tbl, src)
    if e[0] == 'union':
        return fan(e, tbl, src)
    if e[0] == 'case':
        return tape(e, tbl, src, tgt)
    if e[0] == 'cap':
        return meet(e, tbl, src)
    if e[0] == 'fork':
        return fork(e, tbl, src)
    if e[0] == 'cond':
        return test(e, tbl, src)
    if e[0] == 'cata':
        return fold(e, tbl, src, tgt)
    if e[0] == 'atom' and e[1] in PROJ:               # §3 row 3: a projection is a discard
        return proj(e[1], src)
    if e[0] == 'atom' and e[1] == sl.UNIT:            # §3 row 4: the identity is bare wires
        if src is None and tgt is None:
            raise Unhandled("`𝟙` is the identity on the object at its port, and neither is known")
        return pic("seq", src or tgt, src or tgt, True, items=[], seams=[], _objs=[src or tgt])
    if e[0] == 'atom' and e[1].endswith('%∋'):       # §3 row 15: the transpose, always a map
        n, s, t, _ = walk(parse(e[1][:-2]), tbl, src=src)
        return box(spell(parse(e[1][:-2])), s, ('app', 'E', t), True, frac=True)
    return leaf(e, tbl, src, tgt)


def rows(tbl, key):
    """The arrows a key names.  A letter the note reuses across sections carries several, as a
    list, and nothing but the port in hand tells them apart."""
    r = tbl.get(key)
    return [] if r is None else r if isinstance(r, list) else [r]


def leaf(e, tbl, src, tgt):
    """An atom (§3 rows 1-2) or an application read as one box (§3 row 10): the signature's `src`
    and `tgt` are schemes, and the port in hand binds their variables."""
    key = e[1] if e[0] in ('atom', 'app') else None
    # A whole-spelling row is ONE opaque box only when the head has no `arg` row: `listcp(F)` applies
    # an operator to a FUNCTOR, where `E(…)`/`P(…)`/`thin` state an ARROW and must type their argument.
    if (e[0] == 'app' and rows(tbl, spell(e))
            and not any('arg' in r for r in rows(tbl, e[1]))):
        e, key = ('atom', spell(e)), spell(e)
    # A letter may be both a preorder and an operator (`P`, `P(f)`): an application takes the rows
    # with an `arg` scheme and an atom the rows without, so neither ever reads the other's.
    rs = [r for r in rows(tbl, key) if ('arg' in r) == (e[0] == 'app')]
    if not rs:
        raise Unhandled(f"no signature for `{key or spell(e)}` in diag/circuit-sigs.json")
    for i, row in enumerate(rs):
        try:
            return typed(e, row, tbl, src, tgt)
        except Unhandled:
            if i + 1 == len(rs):
                raise


def typed(e, row, tbl, src, tgt):
    env = {}
    unify(obj(row["src"]) if src is not None else obj(row["tgt"]), src if src is not None else tgt,
          env)
    if e[0] == 'app':                                # the argument is TYPED, not drawn: one box
        a, b = obj(row["arg"].split('⟶')[0]), obj(row["arg"].split('⟶')[1])
        sa, sb = subst(a, env), subst(b, env)
        # `E(R): E(a)⟶E(b)` binds `b` from the ARGUMENT's target, not from the port in hand, so the
        # argument's own ends come back and go into `env` before the entry's scheme is substituted.
        _, s2, t2, _ = walk(e[2], tbl, src=sa if ground(sa) else None,
                            tgt=sb if ground(sb) else None, typing=True)
        unify(a, s2, env), unify(b, t2, env)
    return box(spell(e), subst(obj(row["src"]), env), subst(obj(row["tgt"]), env), row["map"])


def proj(name, src):
    """§3 row 3: a projection is a DISCARD on the factors it drops, never a box.  The product is
    already two wires, so `π₁` costs one dot per wire it ends and no notation at all."""
    i = PROJ[name]
    if src is None or src[0] != 'prod' or i >= len(src[1]):
        raise Unhandled(f"`{name}` projects out of a product of {i + 1} factors or more, and its"
                        f" port is {oshow(src) if src else 'not known here'}")
    return pic("proj", src, src[1][i], True, at=i, label=name,
               keep=[len(wires(x)) for x in src[1]])


def lane(t):
    """One branch or one strand of a stack is always a run, so a single box becomes a one-box run
    and every consumer below has exactly one shape to place."""
    n, s, t2, m = t
    return n if n["k"] == "seq" else \
        pic("seq", s, t2, m, _in=n["_in"], _out=n["_out"], items=[n], seams=[], _objs=[s, t2])[0]


def seq(xs, tbl, src, tgt=None):
    """§3 row 5: juxtaposition, ports glued.  The objects between the factors are kept — the seam
    rule below decides which get printed — and a nested composite splices in rather than nesting.
    Only the LAST factor gets the stated target: a fold needs it, having no carrier in the term."""
    items, objs, mp, i = [], [src], True, 0
    while i < len(xs):
        if xs[i] == ('atom', KONST):                  # §3 row 14: `⊸ x`, the constant `x`
            if i + 1 == len(xs):
                raise Unhandled("`⊸` with nothing after it: a constant needs the thing it creates")
            b = walk(xs[i + 1], tbl, src=obj("𝟏"), tgt=tgt if i + 2 == len(xs) else None)
            items.append(pic("konst", objs[-1], b[2], b[3], body=lane(b))[0])
            objs.append(b[2]); mp = mp and b[3]; i += 2
            continue
        n, s, t, m = walk(xs[i], tbl, src=objs[-1], tgt=tgt if i + 1 == len(xs) else None)
        if items and items[-1]["_out"] != n["_in"] and n["k"] == "case" \
                and items[-1]["k"] == "box" and n["_in"] == [objs[-1]]:
            # A box handing over to a tape hands the coproduct WHOLE — `est(Q)[nil,snoc]` is not a
            # fusion, and the fork is what opens it, so the box before it ends on the one wire.
            items[-1] = dict(items[-1], nout=1, _out=[objs[-1]])
        if items and items[-1]["_out"] != n["_in"]:
            raise Unhandled(f"`{spell(xs[i])}` takes {oshow(objs[-1])} as one coproduct wire where"
                            f" the factor before leaves it as the strands"
                            f" {', '.join(oshow(w) for w in items[-1]['_out'])}: only the tape"
                            f" fusion `F(R)[f,g]=[f,(𝟙×R)g]` puts a box before a tape")
        if n["k"] == "seq":
            items += n["items"]; objs += n["_objs"][1:]
        else:
            items.append(n); objs.append(t)
        mp = mp and m; i += 1
    # a pair's strands are typed nowhere else — its lanes END at them — so the seam after a fork
    # is printed whole, as `armed` prints the one after the wire an arm opens
    sm = seams(objs) + [[i, [lshow(w) for w in it["_out"]]]
                        for i, it in enumerate(items[:-1]) if it["k"] == "fork"]
    return pic("seq", objs[0], objs[-1], mp, items=items, seams=sorted(sm), _objs=objs,
               _in=items[0]["_in"] if items else None, _out=items[-1]["_out"] if items else None)


def stack(xs, tbl, src):
    """§3 row 6: a product is a vertical stack, one wire per factor.  The general split of the src
    object's ×-factors between the factors is not needed while every factor takes exactly one."""
    ws = wires(src)
    if len(ws) != len(xs):
        raise Unhandled(f"`{spell(('prod', xs))}` has {len(xs)} factors over the {len(ws)} wires of"
                        f" {oshow(src)}: §3 row 6's general split is not in the slice")
    ls = [walk(x, tbl, src=w) for x, w in zip(xs, ws)]
    t = ls[0][2] if len(ls) == 1 else ('prod', [b[2] for b in ls])
    lanes = [lane(b) for b in ls]
    return pic("stack", src, t, all(b[3] for b in ls), lanes=lanes,
               _in=[w for l in lanes for w in l["_in"]], _out=[w for l in lanes for w in l["_out"]])


def branches(ops, tbl, srcs, what, join=True):
    """A `∪`, a `[x,y]` and a `→`'s two sides differ in where their branches START, never in where
    they end: all close by merging, so every branch lands on the one object the region leaves at.
    A fork's lanes (`join=False`) end apart, stacked, so only their starts are checked."""
    bs = [walk(x, tbl, src=s) for x, s in zip(ops, srcs)]
    if join and len({oshow(b[2]) for b in bs}) > 1:
        raise Unhandled(f"`{what}` merges branches at {', '.join(oshow(b[2]) for b in bs)}")
    ins = {tuple(oshow(w) for w in b[0]["_in"]) for b in bs}
    if len({oshow(s) for s in srcs}) == 1 and len(ins) > 1:    # a tape's branches start apart
        raise Unhandled(f"`{what}`'s branches take the one input as different strands:"
                        f" {'; '.join(','.join(oshow(w) for w in b[0]['_in']) for b in bs)}")
    return bs


def fan(e, tbl, src):
    """§3 row 11: the `∪` region — the input arrives once, a dashed fan hands it to both bodies."""
    bs = branches(e[1], tbl, [src] * len(e[1]), spell(e))
    return pic("union", src, bs[0][2], False, _in=bs[0][0]["_in"], bodies=[lane(b) for b in bs])


def meet(e, tbl, src):
    """§3 row 12: `x∩y` — the input is COPIED, both lanes run, and the results MERGE.  `∇=Δ°`
    forces the two strands to carry the same value, which is what makes the merge an intersection
    (circuit.typ's `nabla`); nothing here is a box labelled `∩`."""
    if len(e[1]) != 2:
        raise Unhandled(f"`{spell(e)}` meets {len(e[1])} operands where a copy has TWO outputs:"
                        f" bracket it, `a∩(b∩c)`, and the copies nest")
    bs = branches(e[1], tbl, [src] * 2, spell(e))
    return pic("cap", src, bs[0][2], False, _in=bs[0][0]["_in"], lanes=[lane(b) for b in bs])


def fork(e, tbl, src):
    """§3 row 20: `⟨x,y⟩` — the input is COPIED, both lanes run, and the outputs are STACKED, `x`'s
    wires over `y`'s: row 12 less its merge.  At a product the per-wire copy crosses the middle two
    strands, and `cpanel` draws that crossing rather than routing round it."""
    if len(e[1]) != 2:
        raise Unhandled(f"`{spell(e)}` pairs {len(e[1])} operands where a copy has TWO outputs:"
                        f" bracket it, `⟨a,⟨b,c⟩⟩`, and the copies nest")
    bs = branches(e[1], tbl, [src] * 2, spell(e), join=False)
    lanes = [lane(b) for b in bs]
    t = ('prod', [y for b in bs for y in (b[2][1] if b[2][0] == 'prod' else [b[2]])])
    return pic("fork", src, t, all(b[3] for b in bs), _in=lanes[0]["_in"],
               _out=[w for l in lanes for w in l["_out"]], lanes=lanes)


def test(e, tbl, src):
    """§3 row 16: `(g→x,y)` is ONE box carrying the note's own spelling — the expanded `∪` of guarded
    branches was unreadable (user, 2026-09-01).  Guards are typed, not drawn; maps stay maps."""
    ops = e[1]
    gs, xs = (ops[:-1:2], ops[1::2] + ops[-1:]) if len(ops) % 2 else (ops[::2], ops[1::2])
    for g in gs:
        walk(g, tbl, src=src)
    bs = branches(xs, tbl, [src] * len(xs), spell(e))
    return box(spell(e), src, bs[0][2], all(b[3] for b in bs))


def base(f, c, polys):
    """The object the algebra meets: the functor at the carrier.  A coproduct of ONE branch IS that
    branch, so its algebra takes the branch's own ×-factors as separate strands; a several-branch
    one stays folded, because the `[x,y]` inside is what forks it."""
    bs = polys.get(f)
    return subst(obj(bs[0]), {'x': c}) if bs and len(bs) == 1 else ('app', f, c)


def declared(alg, tbl, f, env, polys):
    """A fold inside a functor gets no target from the panel, so the carrier is READ OFF the
    algebra's own row — `scripts/diagram` reads the same declaration for the spider side. `f`'s
    algebra is the row whose source is `f` at its target, which is also what picks between the
    arrows a reused letter carries; `env` binds the letters `mu`'s scheme wrote the source over."""
    cs = [t for r in rows(tbl, alg[1] if alg[0] in ('atom', 'app') else None)
          for t in [subst(obj(r["tgt"]), env)]
          if ground(t) and subst(obj(r["src"]), env) == base(f, t, polys)]
    if len(cs) != 1:
        raise Unhandled(f"`{spell(alg)}` is {len(cs)} algebras for {f} in diag/circuit-sigs.json:"
                        f" a fold inside a functor takes its carrier from the one row declaring it")
    return cs[0]


def fold(e, tbl, src, tgt):
    """§3 row 17: `⦇α⦈` as MELLIÈS' FUNCTORIAL BOX — the algebra's own circuit between two bars,
    the note's own `banana` (allegory-axioms.typ).  Nothing crosses the LEFT bar: the input arrives
    at it and the algebra's strands start there, and that break is the recursion.  The carrier is
    never inferred: the panel's target declares it, or the algebra's row does, and the box is
    LABELLED with it — the term names the algebra and the source, so this is what it cannot say."""
    cfg = sigs()
    hits = []
    for f, o in cfg.get("mu", {}).items():
        env = {}
        try:
            unify(obj(o), src, env)
        except Unhandled:
            continue
        hits.append((f, env))
    if len(hits) != 1:
        raise Unhandled(f"`{spell(e)}` folds {oshow(src)}, which diag/circuit-sigs.json gives"
                        f" {len(hits)} initial algebras for — a fold needs exactly one")
    f, env = hits[0]
    own = MU.get(f, (None, None))[1]
    if tgt is not None:
        c = tgt
    elif own is not None:
        c = obj(inst(own, AT))
    else:
        c = declared(e[1][0], tbl, f, env, cfg["polys"])
    a = base(f, c, cfg["polys"])
    b = walk(e[1][0], tbl, src=a)
    if b[2] != c:
        raise Unhandled(f"the algebra `{spell(e[1][0])}` lands on {oshow(b[2])}, not the carrier"
                        f" {oshow(c)} the fold is stated at")
    # A product carrier is drawn as its wires, never as a label (§13.4.4a: `[A]×[A]` is two wires
    # each `[A]`).  A single-wire carrier is drawn only when it differs from that wire's own label.
    cw = wires(c)
    show = len(cw) == 1 and oshow(cw[0]) != oshow(c)
    body = lane(b)          # the port labels are the algebra's own strands: one per wire it takes
    return pic("cata", src, c, b[3], body=body, label=lshow(c) if show else None,
               port=[lshow(w) for w in body["_in"]])


def tape(e, tbl, src, tgt=None):
    """§3 row 13: the bracket at a polynomial object — tape fork, branches, tape join.  The source
    is opened by the functor's own polynomial, which is the object-level unfold of §1.3.
    A `°` swaps the ends and hands the bracket only its TARGET, so with no source the branches are
    typed from where they all land and the coproduct is read back off their sources."""
    polys = sigs()["polys"]
    if src is None:
        if tgt is None:
            raise Unhandled(f"`{spell(e)}` forks a coproduct neither port names")
        bs = [walk(x, tbl, tgt=tgt) for x in e[1]]
        if len({oshow(b[2]) for b in bs}) > 1:
            raise Unhandled(f"`{spell(e)}` merges branches at"
                            f" {', '.join(oshow(b[2]) for b in bs)}")
        ss = [b[1] for b in bs]
        return taped(e, coproduct(ss, polys, spell(e)), ss, bs)
    if src[0] != 'app' or src[1] not in polys:
        raise Unhandled(f"`{spell(e)}` forks {oshow(src)}, which diag/circuit-sigs.json gives no"
                        f" polynomial for — a case needs the coproduct it splits")
    env = {}
    unify(obj(f"{src[1]}(x)"), src, env)
    ss = [subst(obj(p), env) for p in polys[src[1]]]
    if len(ss) != len(e[1]):
        raise Unhandled(f"`{spell(e)}` has {len(e[1])} branches over {oshow(src)}'s {len(ss)}")
    bs = branches(e[1], tbl, ss, spell(e))
    return taped(e, src, ss, bs)


def coproduct(ss, polys, what):
    """Which `F(c)` has exactly these branch objects.  `[nil,extend]°` gives the branches' sources
    and wants the object they sum to, the one thing a converse cannot read off the port it has."""
    hits = []
    for f, ps in polys.items():
        if len(ps) != len(ss):
            continue
        env = {}
        try:
            for p, s in zip(ps, ss):
                unify(obj(p), s, env)
        except Unhandled:
            continue
        if 'x' in env:
            hits.append(('app', f, env['x']))
    # Two rows of one shape would label the tape by table order, which is not a reading of the cell.
    if len(hits) > 1:
        raise Unhandled(f"ambiguous coproduct for `{what}`: {', '.join(h[1] for h in hits)} all sum"
                        f" {', '.join(oshow(s) for s in ss)} — drop all but one from `--polys`")
    if hits:
        return hits[0]
    raise Unhandled(f"`{what}` sums {', '.join(oshow(s) for s in ss)}, which no `polys` functor has"
                    f" as its branches — `--polys \"F:{'+'.join(oshow(s) for s in ss)}\"` names it")


def taped(e, src, ss, bs):
    if len(ss) != 2:
        raise Unhandled(f"`{spell(e)}` forks {len(ss)} summands, and the tape fork draws two")
    # The coproduct arrives as ONE wire, the fork being what opens it; each arm opens that wire
    # into the summand's strands (`wires`).
    return pic("case", src, bs[0][2], all(b[3] for b in bs), _in=[src],
               bodies=[armed(src, s, lane(b)) for s, b in zip(ss, bs)])


def armed(src, s, body):
    """11.2a, `[R,S] = l°R ∪ r°S`: the arm opens with the coproduct wire itself, not with a box —
    a generator whose shape the summand fixes (`𝟏` ends the wire, a pair splits it), so the picture
    says which summand this is without naming the injection.  The seam after it names the strands."""
    ws = [lshow(w) for w in wires(s)]
    if len(ws) > 2:
        raise Unhandled(f"a case arm at {oshow(s)} opens {len(ws)} strands, and the generators"
                        f" `!`, `Δ` open none, one or two")
    op = pic("open", src, s, True, _in=[src])[0]
    body["items"].insert(0, op); body["_objs"].insert(0, src)
    body["seams"] = ([[0, ws]] if ws else []) + [[i + 1, l] for i, l in body["seams"]]
    body["nin"], body["_in"] = 1, [src]
    return body


# ---------------------------------------------------------------- seams and the panel
def seams(objs):
    """Which interior objects the picture prints, as one label per strand.  The ports always; an
    interior seam exactly when its object is ONE wire and differs from both printed neighbours
    (CIRCUIT-GEN §3); a bracket's arm adds the seam after the wire it opens (`armed`)."""
    out, prev = [], objs[0]
    for i, o in enumerate(objs[1:-1]):
        if len(wires(o)) == 1 and o != prev and o != objs[i + 2]:
            out.append([i, [lshow(o)]]); prev = o
    return out


def draw(formula, src, tgt, at=None):
    """The circuit a formula denotes, typed, with its ports checked against the stated ones.  `at`
    is the cert's other keys, table constants instantiated for this row, and the cert keeps them;
    its `sigs:` is the row's OWN signatures, the sibling of those constants — a §14 name the file
    has never heard of, or a letter the file binds to another section's arrow."""
    global AT, OWN, MU, POLYS
    at = dict(at or {})
    own, ini, pol = at.pop("sigs", ""), at.pop("mu", ""), at.pop("polys", "")
    AT, OWN, MU = at, parse_sigs(own) if own else {}, parse_mu(ini) if ini else {}
    POLYS = parse_polys(pol) if pol else {}
    e = cnorm(parse(formula))
    tree, s, t, _ = walk(e, sigs()["sigs"], src=obj(src), tgt=obj(tgt))
    if t != obj(tgt):
        raise Unhandled(f"{spell(e)} lands on {oshow(t)}, not the stated {tgt}")
    tree["src"] = [lshow(w) for w in tree["_in"]]
    tree["tgt"] = [lshow(w) for w in tree["_out"]]
    tree["cert"] = ({"expect": formula, "src": src, "tgt": tgt, **AT}
                    | ({"mu": ini} if ini else {}) | ({"polys": pol} if pol else {})
                    | ({"sigs": own} if own else {}))
    return tree


# ---------------------------------------------------------------- the typst call
def tv(v, ind=2):
    """A layout node as Typst source.  A label rides as a STRING and `cpanel` wraps it in `raw` —
    one spelling of `[`x`]`, in the file that also decides which of them becomes a fraction."""
    p = " " * ind
    if isinstance(v, dict):
        return "(" + ", ".join(f"{k}: {tv(x, ind + 2)}"
                               for k, x in v.items() if not k.startswith("_")) + ")"
    if isinstance(v, list):
        return "(\n" + "".join(f"{p}{tv(x, ind + 2)},\n" for x in v) + " " * (ind - 2) + ")" \
            if any(isinstance(x, (dict, list)) for x in v) \
            else "(" + "".join(f"{tv(x, ind)}, " for x in v) + ")"
    return "none" if v is None else \
        str(v).lower() if isinstance(v, bool) else \
        '"' + v + '"' if isinstance(v, str) else str(v)


def emit(t):
    t = dict(t)
    cert = t.pop("cert")
    return f"#cpanel({tv(t)},\n  cert: {tv(cert)})"


# ---------------------------------------------------------------- the note's own literals
def literals(text):
    """Every `#cpanel(…)` in a file as (start, end, cert).  A `"…"` is opaque and ends at the next
    `"` — `tv` never escapes one — because a label or an `expect` carries brackets of its own."""
    out, i = [], text.find("#cpanel(")
    while i >= 0:
        j, depth = i + 7, 0
        while True:
            c = text[j]
            if c == '"':
                j = text.index('"', j + 1)
            elif c in "([{":
                depth += 1
            elif c in ")]}":
                depth -= 1
                if not depth:
                    break
            j += 1
        k = text.rfind("cert: (", i, j)
        out.append((i, j + 1, dict(re.findall(r'(\w+): "([^"]*)"', text[k:j])) if k >= 0 else {}))
        i = text.find("#cpanel(", j)
    return out


def regen(path, write):
    """Each literal rebuilt from its own `cert:` and held against the text: `--compare` prints the
    drift as a diff and fails, `--write` splices the rebuilt literal over it, last to first."""
    text = open(path, encoding="utf-8").read()
    lits = [x for x in literals(text) if all(x[2].get(k) for k in ("expect", "src", "tgt"))]
    fail, drift, msgs = 0, 0, []
    for i, j, c in reversed(lits):
        ln = text.count("\n", 0, i) + 1
        head = f"{path}:{ln}  {c['expect']}   [{c['src']} ⟶ {c['tgt']}]"
        try:
            new = emit(draw(c["expect"], c["src"], c["tgt"],
                            {k: v for k, v in c.items() if k not in ("expect", "src", "tgt")}))
        except (Unhandled, ValueError, KeyError) as ex:
            fail += 1; msgs.append(f"{head}\n  {ex}"); continue
        if new == text[i:j]:
            continue
        drift += 1
        if write:
            text = text[:i] + new + text[j:]; msgs.append(f"{head}\n  rewritten")
        else:
            msgs.append("\n".join([head] + list(difflib.unified_diff(
                text[i:j].splitlines(), new.splitlines(), "note", "generated", lineterm=""))))
    if write:
        open(path, "w", encoding="utf-8").write(text)
    if msgs:
        print(*reversed(msgs), sep="\n")
    print(f"circuit: {len(lits)} literals in {path}, {len(lits) - drift - fail} verbatim, {drift}"
          f" {'rewritten' if write else 'drifted'}, {fail} undrawable", file=sys.stderr)
    sys.exit((fail or drift and not write)
             and f"circuit: {path} does not hold what the generator draws")


def read_back(t):
    """The composite the drawn boxes spell, in the note's own notation — the circuit's answer to
    `scripts/diagram`'s sweep.  Every node was built from one operator, so the picture reads back as
    the normalised term or the walk dropped something."""
    k = t["k"]
    if k == "box":
        e = parse(t["label"] + ("%∋" if t["frac"] else ""))
        return ('conv', e) if t["flip"] else e
    if k == "seq":
        xs = [read_back(x) for x in t["items"]]
        return ('atom', sl.UNIT) if not xs else xs[0] if len(xs) == 1 else ('comp', xs)
    if k == "stack":
        return ('prod', [read_back(x) for x in t["lanes"]])
    if k == "konst":
        return ('comp', [('atom', KONST), read_back(t["body"])])
    if k == "proj":
        return ('atom', t["label"])
    if k == "cap":
        return mk("cap", [read_back(x) for x in t["lanes"]])
    if k == "cata":
        return mk("cata", [read_back(t["body"])])
    if k == "union":
        return mk("union", [read_back(x) for x in t["bodies"]])
    if k == "fork":
        return mk("fork", [read_back(x) for x in t["lanes"]])
    # a bracket's arms open with the injections `armed` put there: the bracket's own drawing of `[f,g]`
    return mk("case", [read_back(dict(x, items=x["items"][1:])) for x in t["bodies"]])


_HELP_BODY = ('usage: circuit --src "F([A])" --tgt "[A]" "S%∋ est(R°)"'
              '\n       circuit --src "E(A)" --tgt "[A]" --sigs "sort:E(A)⟶[A]" "sort(P)"'
              '\n       circuit --slice'
              '\n       circuit --compare [diag/allegory-axioms.typ]'
              '\n       circuit --write [diag/allegory-axioms.typ]'
              '\n\n--src/--tgt   the panel'"'"'s source/target objects; required in default mode — a'
              " formula alone does not fix the ports"
              '\n--sigs        extra bead signatures beyond diag/circuit-sigs.json, `NAME:SRC⟶TGT`'
              " pairs separated by spaces; the key is left of the FIRST colon.  The ARROW says which"
              " box: `⟶` a relation, drawn chamfered, `⟼` a MAP, drawn square —"
              ' `--sigs "snoc:[Job]×Job⟼[Job]"`.  These are the section-local names, declared here'
              " and nowhere else, so without the marker every local map would enter the global table"
              " for no reason but to be drawn square"
              '\n--at          the table constants this row fixes, `KEY:OBJECT` pairs — `--at "A:Int"`'
              " instantiates diag/circuit-sigs.json's parameter `A`, so `nil:𝟏⟶[A]` types at `[Int]`."
              " The cert carries them back, which is how --compare rebuilds the same picture"
              '\n--mu          the initial algebra this row folds from, `FUNCTOR:OBJECT[⟶CARRIER]`'
              ' pairs — `--mu "F:T⟶E(A)"` folds the abstract `T` §15 writes, which no `mu` row in'
              " diag/circuit-sigs.json names, and gives the carrier when the algebra is a composite"
              " with no row of its own and the panel's target does not reach it"
              '\n--polys       the coproduct this row'"'"'s functor is, `FUNCTOR:BRANCH+BRANCH` pairs —'
              ' `--polys "F:𝟏+x×Code"` gives §15 the snoc order the file'"'"'s cons-list `A×x` has'
              " backwards, and an EMPTY right side drops the row, leaving an abstract summand functor"
              " the one wire it draws"
              '\n--slice       regenerate CIRCUIT-GEN §5'"'"'s whole acceptance file'
              " (diag/circuit-slice.typ) from the built-in SLICE table, header included — never hand-edit it"
              '\n--compare     rebuild every `cpanel(` literal in the note from its own `cert:` and'
              " fail on any drift from the note's text"
              '\n--write       like --compare, but splices the rebuilt literals back over the note'
              '\n\nDefault mode prints one `#cpanel(...)` call on stdout, ready to paste beside the row'
              " it draws; a mismatch between the run and the note's own spelling of the formula goes"
              " to stderr as a comment, not a failure.")


def main(argv):
    sl.help_if(argv, __doc__, _HELP_BODY)
    src, tgt, own = sl.opt(argv, "--src"), sl.opt(argv, "--tgt"), sl.opt(argv, "--sigs")
    at, ini, pol = sl.opt(argv, "--at"), sl.opt(argv, "--mu"), sl.opt(argv, "--polys")
    taken = {i for o in ("--src", "--tgt", "--sigs", "--at", "--mu", "--polys") if o in argv
             for i in (argv.index(o), argv.index(o) + 1)}
    free = [a for i, a in enumerate(argv) if i not in taken and not a.startswith("-")]
    if "--slice" in argv:
        # The whole file is written here, header included: a hand-kept header above a `>` redirect
        # was lost three times over, so nothing about circuit-slice.typ is edited by hand any more.
        bad, out = 0, [
            "// The acceptance render for CIRCUIT-GEN §5's slice, written whole by `./scripts/circuit"
            " --slice`.",
            "// Everything here is generator output, so a redraw is a re-run of that line — never a"
            " hand edit.",
            "// `make slice` regenerates and compiles it; `make p` runs that too.",
            '#import "cpanel.typ": cpanel',
            "#set page(width: auto, height: auto, margin: 0.8cm, fill: white)",
            "#set par(spacing: 20pt)", ""]
        for name, f, s, t in SLICE:
            out.append(f"// {name}  {f}   [{s} ⟶ {t}]")
            try:
                out.append(emit(draw(f, s, t)))
            except (Unhandled, ValueError, KeyError) as ex:
                bad += 1; print(f"circuit: {name}: {ex}", file=sys.stderr)
            out.append("")
        with open(OUT, "w", encoding="utf-8") as fh:
            fh.write("\n".join(out))
        print(f"circuit: {len(SLICE)} rows in CIRCUIT-GEN §5, {len(SLICE) - bad} drawn,"
              f" {bad} blocked → {os.path.relpath(OUT)}", file=sys.stderr)
        sys.exit(bad and f"circuit: {bad} row{'s' * (bad > 1)} did not draw")
    if "--compare" in argv or "--write" in argv:
        regen(next((a for a in free if a.endswith(".typ")), "diag/allegory-axioms.typ"),
              "--write" in argv)
        return
    formula = next(iter(free), None)
    if not (formula and src and tgt):
        sys.exit(__doc__.strip().splitlines()[0]
                 + '\nusage: circuit --src "F([A])" --tgt "[A]" "S%∋ est(R°)"'
                 + '\n       circuit --src "E(A)" --tgt "[A]" --sigs "sort:E(A)⟶[A]" "sort(P)"'
                 + '\n       circuit --slice'
                 + '\n       circuit --compare [diag/allegory-axioms.typ]'
                 + '\n       circuit --write [diag/allegory-axioms.typ]')
    t = draw(formula, src, tgt, (parse_at(at) if at else {}) | ({"mu": ini} if ini else {})
             | ({"polys": pol} if pol else {}) | ({"sigs": own} if own else {}))
    print(emit(t))
    # The boxes spell the NORMALISED term, up to spacing: a `union`/`case` keeps the note's own
    # spelling verbatim, and a rebuilt one cannot know that this bracket was written `(p×𝟙) cons`.
    if spell(read_back(t)).replace(" ", "") != spell(cnorm(parse(formula))).replace(" ", ""):
        print(f"// the run reads back as {spell(read_back(t))}", file=sys.stderr)


if __name__ == "__main__":
    main(sys.argv[1:])
