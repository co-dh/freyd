#!/usr/bin/env python3
"""circuit — the CIRCUIT picture a formula denotes, drawn mechanically.

`scripts/diagram` runs the note's formula through the Hinze–Marsden reading; this runs it through
the MONOIDAL one.  Same input — the formula in the note's notation plus the source and target
objects, which a formula alone does not fix — and the same self-certifying `cert:`, but the picture
downstream is the other language: a WIRE is an object, a BOX is a morphism, composition runs left to
right, and a product is TWO wires, never one wire labelled `A×B`.  A `#cpanel(...)` call goes out,
ready to paste beside the row it draws.

The design is diag/CIRCUIT-GEN.md and this is its §5 slice.  Typing is §1.3: every subterm carries
its source and target OBJECT, read off diag/circuit-sigs.json by unification with the port in hand,
and `wires(X)` is the list of strands a port at `X` carries: its ×-factors, none for the unit, and
a `polys` functor's product summand.  Drawing is §3: one clause of `walk` per operator, each
primitive placed once.  Widths are deliberately absent — `cpanel` measures its own labels at
render time (§4f), so this never guesses font metrics.

`∩`, `(g→x,y)` and `⦇x⦈` are real nodes in the shared grammar now, with a drawing rule each: a meet
is copy / both lanes / merge (§3 row 12), a conditional is the `∪` of two guarded branches with the
`else` guard inside a Peirce cut (row 16), and a fold is MELLIÈS' FUNCTORIAL BOX — the algebra's own
circuit between two bars, which is how the note already draws it (row 17).  `⊸` is still an atom,
and §3 row 14 reads it where it stands, as the constant it is.

WHAT IT STILL REFUSES, each where it is written: an `∩` of more than two operands, a conditional of
more than one test, a fold whose carrier neither the panel nor the algebra's row declares, a guard
that is not boxes and wires (a region's own colours do not invert inside a cut), and `°` on a
composite (row 8's frame — over a PRODUCT it distributes, one flipped box per wire).
"""
import functools, importlib.machinery, importlib.util, json, os, sys

sys.dont_write_bytecode = True                 # no `scripts/__pycache__` beside the other scripts
_P = os.path.join(os.path.dirname(os.path.abspath(__file__)), "scanline")
_S = importlib.util.spec_from_loader("scanline", importlib.machinery.SourceFileLoader("scanline", _P))
sl = importlib.util.module_from_spec(_S)
_S.loader.exec_module(sl)
parse, norm, spell, Unhandled = sl.parse, sl.norm, sl.spell, sl.Unhandled

SIGS = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "diag",
                    "circuit-sigs.json")
OUT = os.path.join(os.path.dirname(SIGS), "circuit-slice.typ")      # what `--slice` writes
KONST = "⊸"
PROJ = {"π₁": 0, "π₂": 1}       # §3 row 3: which ×-factor survives; the others end at a dot
# CIRCUIT-GEN §5's rows, in dependency order: `--slice` is the acceptance test.  The last three are
# the operators §1.5 added — one demonstration each, every one a term the note itself writes.
SLICE = [("13.3.3d r1", "S%∋ est(R°)", "F([A])", "[A]"),
         ("13.3.3c r1", "(𝟙×R°)(⊸ nil ∪ (p×𝟙) cons)", "A×[A]", "[A]"),
         ("13.3.3b r2", "F(prefix) [nil,⊸ nil ∪ cons] list(p)", "F([A])", "[A]"),
         ("∩ (13.3.3b)", "prefix° prefix∩R", "[A]", "[A]"),
         ("→ (13.3.3c)", "(π₁p→cons,⊸ nil)", "A×[A]", "[A]"),
         ("⦇⦈ (13.3.3b)", "⦇[nil,⊸ nil ∪ cons]⦈", "[A]", "[A]"),
         ("⦇⦈ (13.4.4a)", "⦇S⦈", "tree(A)", "[A]×[A]"),
         ("13.4.4a r2", "𝟙%∋ E(⦇S⦈)E(choose)est(R°)", "tree(A)", "[A]"),
         ("13.4.4a r4", "𝟙%∋ E(⦇S⦈)est((R×R)°)𝟙%∋ E(choose)est(R°)", "tree(A)", "[A]")]


@functools.lru_cache(maxsize=None)
def sigs():
    """diag/circuit-sigs.json — what each atom is an arrow between, and whether it is a map.
    Read once: `wires` asks for the polynomials at every node, and nobody writes to the table."""
    return json.load(open(SIGS, encoding="utf-8"))


# ---------------------------------------------------------------- objects
# An object is normalised on the way in — `[A]` is `list(A)`, `×` flat — so unification is
# structural; `oshow` puts the brackets back, because `[A]` is what the note prints on a port.
def obj(s):
    return norm(parse(s)) if isinstance(s, str) else norm(s)


def oshow(e):
    if e[0] == 'app':
        return f"[{oshow(e[2])}]" if e[1] == 'list' else f"{e[1]}({oshow(e[2])})"
    return '×'.join(oshow(x) for x in e[1]) if e[0] == 'prod' else spell(e)


SUP = str.maketrans("0123456789", "⁰¹²³⁴⁵⁶⁷⁸⁹")


def head(e):
    """The name `e`'s label opens with — `[` for a list or a power of lists — which sets the spacing."""
    return '[' if e[0] == 'app' and e[1] == 'list' else e[1] if e[0] in ('app', 'atom') else head(e[1][0])


def lshow(e):
    """A type label: application is juxtaposition, spaced only beside a multi-letter name (`E tree A`,
    `EF[A]`, `FA`); n equal ×-factors are a power (`E[A]²`); `F(A,B)`, `F(A×B)` keep the parentheses."""
    if e[0] == 'prod':
        if any(x != e[1][0] for x in e[1]):
            return '×'.join(lshow(x) for x in e[1])
        s = lshow(e[1][0])
        return (f"({s})" if ' ' in s else s) + str(len(e[1])).translate(SUP)
    if e[0] != 'app':
        return spell(e)
    s = lshow(e[2])
    if e[1] == 'list':
        return f"[{s}]"
    if e[2][0] == 'atom' and ',' in s or e[2][0] == 'prod' and '×' in s:
        return f"{e[1]}({s})"
    return e[1] + ('' if s[0] == '[' or len(e[1]) == 1 == len(head(e[2])) else ' ') + s


def wires(X):
    """The strands a port at `X` has: its ×-factors, none for `𝟏`, and for a `polys` functor the
    strands of its one product summand — `F([A])` at a box is the `cons` branch's `A`,`[A]`, the
    note's §13.3.3b decision that `𝟏+` is not drawn (`E(F([A]))` stays one wire: only a
    polynomial head opens).  The tape alone keeps the coproduct as one wire, and says so itself."""
    if X == ('atom', '𝟏'):
        return []
    if X[0] == 'prod':
        return [w for x in X[1] for w in wires(x)]
    ps = sigs()["polys"].get(X[1]) if X[0] == 'app' else None
    if ps is None:
        return [X]
    ss = [b for b in (subst(obj(p), {'x': X[2]}) for p in ps) if b != ('atom', '𝟏')]
    if len(ss) != 1:
        raise Unhandled(f"`{oshow(X)}` has {len(ss)} summands besides `𝟏` in {X[1]}'s polynomial"
                        f" ({', '.join(oshow(b) for b in ss)}): a case split, which only a tape"
                        f" draws — not a port's wires")
    return wires(ss[0])


def var(e):
    return e[0] == 'atom' and len(e[1]) == 1 and e[1].islower()


def ground(e):
    """No variable left: an end still holding one is not a port a walk can be started from."""
    seen = []

    def scan(x):
        seen.append(var(x))
        return sl.rec(x, scan)
    scan(e)
    return not any(seen)


def unify(scheme, X, env):
    """Bind the scheme's variables so it becomes `X`; the port in hand is always concrete."""
    if var(scheme):
        if env.setdefault(scheme[1], X) != X:
            raise Unhandled(f"{scheme[1]} is {oshow(env[scheme[1]])} and {oshow(X)} at once")
        return
    if scheme[0] != X[0] or (scheme[0] in ('atom', 'app') and scheme[1] != X[1]) \
            or (scheme[0] == 'prod' and len(scheme[1]) != len(X[1])):
        raise Unhandled(f"the object {oshow(X)} is not a {oshow(scheme)}")
    if scheme[0] == 'app':
        unify(scheme[2], X[2], env)
    elif scheme[0] == 'prod':
        for a, b in zip(scheme[1], X[1]):
            unify(a, b, env)


def subst(scheme, env):
    return env[scheme[1]] if var(scheme) and scheme[1] in env \
        else sl.rec(scheme, lambda x: subst(x, env))


# ---------------------------------------------------------------- the circuit normalizer (§1.4)
BRACKETS = ('union', 'case', 'cap', 'cond', 'cata')


def mk(tag, ops):
    """A bracket node the normalizer MANUFACTURES: `spell` reads the third element verbatim, so a
    rebuilt node needs a spelling of its own instead of the stale one it inherited."""
    if tag == 'cond':                  # guard, body, …; an odd operand out is the default branch
        ts = [f"{spell(a)}→{spell(b)}" for a, b in zip(ops[::2], ops[1::2])]
        return (tag, ops, '(' + ','.join(ts + ([spell(ops[-1])] if len(ops) % 2 else [])) + ')')
    return (tag, ops, {'union': ' ∪ '.join(spell(x) for x in ops),
                       'cap': '∩'.join(spell(x) for x in ops),
                       'case': '[' + ','.join(spell(x) for x in ops) + ']',
                       'cata': '⦇' + spell(ops[0]) + '⦈'}[tag])


def crec(e, f):
    """`sl.rec` stops AT a bracket node — the spider side never looks inside one, and that is what
    keeps `[x,y]` one bead over there.  A circuit opens all of them, so this walks in."""
    if e[0] not in BRACKETS:
        return sl.rec(e, f)
    ops = [f(x) for x in e[1]]
    return e if ops == list(e[1]) else mk(e[0], ops)


def cnorm(e):
    """CIRCUIT-GEN §1.4, applied before drawing on trust, exactly as scanline's `norm` trusts
    `F(R)F(S)=F(RS)`.  It is NOT that `norm`: this one keeps the `°` where the formula writes it,
    which `norm` pushes to the atoms, erasing the distinction §3 rows 7/8 draw."""
    e = crec(e, cnorm)
    # `R%∋=𝟙%∋ E(R)`, the note's own `DUN` (allegory-axioms.typ): a row writes ONE fraction where
    # the picture draws two — the unit opens `E` outside `R`.  Guarded at `𝟙`, the rewrite's own
    # fixed point, which would otherwise regress for ever.
    if e[0] == 'atom' and e[1].endswith('%∋') and e[1][:-2] != sl.UNIT:
        return ('comp', [('atom', sl.UNIT + '%∋'), ('app', 'E', cnorm(parse(e[1][:-2])))])
    if e[0] != 'comp':
        return e
    xs = [y for x in e[1] for y in (x[1] if x[0] == 'comp' else [x])]   # rule 1: flatten,
    xs = fuse(xs) or xs
    xs = [x for x in xs if x != ('atom', sl.UNIT)] or [('atom', sl.UNIT)]   # and `𝟙` is a wire
    return xs[0] if len(xs) == 1 else ('comp', xs)


def fuse(xs, polys=None):
    """Rule 3, tape fusion: `F(R)[f,g]=[f,(𝟙×R)g]` at `FX=𝟏+A×X`.  Without it a compositional draw
    of `F(prefix)[nil,body]` is two tapes in series where the note draws one (§4b).  Keyed on the
    polynomial, so the `𝟙` lands on the constant branch factor and `R` on the recursive one."""
    polys = sigs()["polys"] if polys is None else polys
    for i, (x, y) in enumerate(zip(xs, xs[1:])):
        if x[0] != 'app' or y[0] != 'case' or x[1] not in polys:
            continue
        rc = obj(polys[x[1]][-1])                        # `A×x`: the branch the functor recurses on
        if len(polys[x[1]]) != len(y[1]) or rc[0] != 'prod':
            continue
        f = ('prod', [x[2] if var(k) else ('atom', sl.UNIT) for k in rc[1]])
        br = list(y[1]); br[-1] = ('comp', [f, br[-1]])
        return xs[:i] + [mk('case', br)] + xs[i + 2:]
    return None


# ---------------------------------------------------------------- one clause per operator (§3)
def pic(k, src, tgt, is_map, _in=None, _out=None, **kw):
    """A layout node.  `_in`/`_out` are the strands its ports carry — the objects' `wires`, unless
    a tape keeps its coproduct whole or a composite takes its children's — and `nin`/`nout` their
    counts, which `cpanel` lays out over.  A `_`-prefixed field is the elaborator's, not emitted."""
    _in = wires(src) if _in is None else _in
    _out = wires(tgt) if _out is None else _out
    return dict(k=k, nin=len(_in), nout=len(_out), _in=_in, _out=_out, **kw), src, tgt, is_map


def box(label, src, tgt, is_map, frac=False, flip=False):
    return pic("box", src, tgt, is_map, label=label, chamfer=not is_map, frac=frac, flip=flip)


def walk(e, tbl, src=None, tgt=None):
    """`(node, src, tgt, is_map)`.  One end of the arrow is always known — the panel's own port at
    the top, the previous factor's target inside a composite — and the signature says the other."""
    if e[0] == 'hc':
        raise Unhandled(f"`∘` composes ACROSS a functor wire, which is the spider reading;"
                        f" a circuit has no such direction (CIRCUIT-GEN §3 row 19): {spell(e)}")
    if e[0] == 'comp':
        return seq(e[1], tbl, src, tgt)
    if e[0] == 'conv':
        # `(R×S)°=R°×S°`: over a PRODUCT the `°` distributes, one flipped box per wire.  Rewritten
        # here and not in `cnorm`, so the label a box carrying `(R×S)°` prints stays the note's.
        if e[1][0] == 'prod':
            return stack([('conv', x) for x in e[1][1]], tbl, src)
        n, s, t, _ = walk(e[1], tbl, src=tgt, tgt=src)
        if n["k"] != "box":
            raise Unhandled(f"`{spell(e)}` writes `°` on a composite, which is the cup/cap frame of"
                            f" CIRCUIT-GEN §3 row 8 — not in the slice")
        return box(n["label"], t, s, False, frac=n["frac"], flip=not n["flip"])
    if e[0] == 'prod':
        return stack(e[1], tbl, src)
    if e[0] == 'union':
        return fan(e, tbl, src)
    if e[0] == 'case':
        return tape(e, tbl, src)
    if e[0] == 'cap':
        return meet(e, tbl, src)
    if e[0] == 'cond':
        return test(e, tbl, src)
    if e[0] == 'cata':
        return fold(e, tbl, src, tgt)
    if e[0] == 'atom' and e[1] in PROJ:               # §3 row 3: a projection is a discard
        return proj(e[1], src)
    if e[0] == 'atom' and e[1] == sl.UNIT:            # §3 row 4: the identity is bare wires
        if src is None and tgt is None:
            raise Unhandled("`𝟙` is the identity on the object at its port, and neither is known")
        return pic("seq", src or tgt, src or tgt, True, items=[], seams=[], _objs=[src or tgt])
    if e[0] == 'atom' and e[1].endswith('%∋'):       # §3 row 15: the transpose, always a map
        n, s, t, _ = walk(parse(e[1][:-2]), tbl, src=src)
        return box(spell(parse(e[1][:-2])), s, ('app', 'E', t), True, frac=True)
    return leaf(e, tbl, src, tgt)


def rows(tbl, key):
    """The arrows a key names.  A letter the note reuses across sections carries several, as a
    list, and nothing but the port in hand tells them apart."""
    r = tbl.get(key)
    return [] if r is None else r if isinstance(r, list) else [r]


def leaf(e, tbl, src, tgt):
    """An atom (§3 rows 1-2) or an application read as one box (§3 row 10): the signature's `src`
    and `tgt` are schemes, and the port in hand binds their variables."""
    key = e[1] if e[0] in ('atom', 'app') else None
    rs = rows(tbl, key)
    if not rs:
        raise Unhandled(f"no signature for `{key or spell(e)}` in diag/circuit-sigs.json")
    for i, row in enumerate(rs):
        try:
            return typed(e, row, tbl, src, tgt)
        except Unhandled:
            if i + 1 == len(rs):
                raise


def typed(e, row, tbl, src, tgt):
    env = {}
    unify(obj(row["src"]) if src is not None else obj(row["tgt"]), src if src is not None else tgt,
          env)
    if e[0] == 'app':                                # the argument is TYPED, not drawn: one box
        a, b = obj(row["arg"].split('⟶')[0]), obj(row["arg"].split('⟶')[1])
        sa, sb = subst(a, env), subst(b, env)
        # `E(R): E(a)⟶E(b)` binds `b` from the ARGUMENT's target, not from the port in hand, so the
        # argument's own ends come back and go into `env` before the entry's scheme is substituted.
        _, s2, t2, _ = walk(e[2], tbl, src=sa if ground(sa) else None,
                            tgt=sb if ground(sb) else None)
        unify(a, s2, env), unify(b, t2, env)
    return box(spell(e), subst(obj(row["src"]), env), subst(obj(row["tgt"]), env), row["map"])


def proj(name, src):
    """§3 row 3: a projection is a DISCARD on the factors it drops, never a box.  The product is
    already two wires, so `π₁` costs one dot per wire it ends and no notation at all."""
    i = PROJ[name]
    if src is None or src[0] != 'prod' or i >= len(src[1]):
        raise Unhandled(f"`{name}` projects out of a product of {i + 1} factors or more, and its"
                        f" port is {oshow(src) if src else 'not known here'}")
    return pic("proj", src, src[1][i], True, at=i, label=name,
               keep=[len(wires(x)) for x in src[1]])


def lane(t):
    """One branch or one strand of a stack is always a run, so a single box becomes a one-box run
    and every consumer below has exactly one shape to place."""
    n, s, t2, m = t
    return n if n["k"] == "seq" else \
        pic("seq", s, t2, m, _in=n["_in"], _out=n["_out"], items=[n], seams=[], _objs=[s, t2])[0]


def seq(xs, tbl, src, tgt=None):
    """§3 row 5: juxtaposition, ports glued.  The objects between the factors are kept — the seam
    rule below decides which get printed — and a nested composite splices in rather than nesting.
    Only the LAST factor gets the stated target: a fold needs it, having no carrier in the term."""
    items, objs, mp, i = [], [src], True, 0
    while i < len(xs):
        if xs[i] == ('atom', KONST):                  # §3 row 14: `⊸ x`, the constant `x`
            if i + 1 == len(xs):
                raise Unhandled("`⊸` with nothing after it: a constant needs the thing it creates")
            b = walk(xs[i + 1], tbl, src=obj("𝟏"), tgt=tgt if i + 2 == len(xs) else None)
            items.append(pic("konst", objs[-1], b[2], b[3], body=lane(b))[0])
            objs.append(b[2]); mp = mp and b[3]; i += 2
            continue
        n, s, t, m = walk(xs[i], tbl, src=objs[-1], tgt=tgt if i + 1 == len(xs) else None)
        if items and items[-1]["_out"] != n["_in"]:
            raise Unhandled(f"`{spell(xs[i])}` takes {oshow(objs[-1])} as one coproduct wire where"
                            f" the factor before leaves it as the strands"
                            f" {', '.join(oshow(w) for w in items[-1]['_out'])}: only the tape"
                            f" fusion `F(R)[f,g]=[f,(𝟙×R)g]` puts a box before a tape")
        if n["k"] == "seq":
            items += n["items"]; objs += n["_objs"][1:]
        else:
            items.append(n); objs.append(t)
        mp = mp and m; i += 1
    return pic("seq", objs[0], objs[-1], mp, items=items, seams=seams(objs), _objs=objs,
               _in=items[0]["_in"] if items else None, _out=items[-1]["_out"] if items else None)


def stack(xs, tbl, src):
    """§3 row 6: a product is a vertical stack, one wire per factor.  The general split of the src
    object's ×-factors between the factors is not needed while every factor takes exactly one."""
    ws = wires(src)
    if len(ws) != len(xs):
        raise Unhandled(f"`{spell(('prod', xs))}` has {len(xs)} factors over the {len(ws)} wires of"
                        f" {oshow(src)}: §3 row 6's general split is not in the slice")
    ls = [walk(x, tbl, src=w) for x, w in zip(xs, ws)]
    t = ls[0][2] if len(ls) == 1 else ('prod', [b[2] for b in ls])
    lanes = [lane(b) for b in ls]
    return pic("stack", src, t, all(b[3] for b in ls), lanes=lanes,
               _in=[w for l in lanes for w in l["_in"]], _out=[w for l in lanes for w in l["_out"]])


def branches(ops, tbl, srcs, what):
    """A `∪`, a `[x,y]` and a `→`'s two sides differ in where their branches START, never in where
    they end: all close by merging, so every branch lands on the one object the region leaves at."""
    bs = [walk(x, tbl, src=s) for x, s in zip(ops, srcs)]
    if len({oshow(b[2]) for b in bs}) > 1:
        raise Unhandled(f"`{what}` merges branches at {', '.join(oshow(b[2]) for b in bs)}")
    ins = {tuple(oshow(w) for w in b[0]["_in"]) for b in bs}
    if len({oshow(s) for s in srcs}) == 1 and len(ins) > 1:    # a tape's branches start apart
        raise Unhandled(f"`{what}`'s branches take the one input as different strands:"
                        f" {'; '.join(','.join(oshow(w) for w in b[0]['_in']) for b in bs)}")
    return bs


def fan(e, tbl, src):
    """§3 row 11: the `∪` region — the input arrives once, a dashed fan hands it to both bodies."""
    bs = branches(e[1], tbl, [src] * len(e[1]), spell(e))
    return pic("union", src, bs[0][2], False, _in=bs[0][0]["_in"], bodies=[lane(b) for b in bs])


def meet(e, tbl, src):
    """§3 row 12: `x∩y` — the input is COPIED, both lanes run, and the results MERGE.  `∇=Δ°`
    forces the two strands to carry the same value, which is what makes the merge an intersection
    (circuit.typ's `nabla`); nothing here is a box labelled `∩`."""
    if len(e[1]) != 2:
        raise Unhandled(f"`{spell(e)}` meets {len(e[1])} operands where a copy has TWO outputs:"
                        f" bracket it, `a∩(b∩c)`, and the copies nest")
    bs = branches(e[1], tbl, [src] * 2, spell(e))
    return pic("cap", src, bs[0][2], False, _in=bs[0][0]["_in"], lanes=[lane(b) for b in bs])


FLAT = ('box', 'proj', 'stack', 'seq')


def flat(n):
    """Whether a lane may be drawn inside a Peirce cut: `cpanel` inverts a wire, a box and a dot,
    but a tape and a seam label keep their own colours, so neither is in the slice."""
    return n["k"] in FLAT and not n.get("seams") \
        and all(flat(x) for x in n.get("items", []) + n.get("lanes", []))


def test(e, tbl, src):
    """§3 row 16: `(g→x,y)` is `x` where `g` is DEFINED and `y` where it is not, so it is the `∪` of
    two restricted branches.  Each copies the input, runs `g` on one copy and ends it at a discard —
    that composite is `dom(g)` — and runs its body on the other; the `else` guard sits in a cut."""
    if len(e[1]) != 3:
        raise Unhandled(f"`{spell(e)}` states {len(e[1]) // 2} tests where row 16 draws ONE and its"
                        f" two sides: a chain of tests is not in the slice")
    g = lane(walk(e[1][0], tbl, src=src))
    if not flat(g):
        raise Unhandled(f"the guard `{spell(e[1][0])}` draws a region, and a region's own colours"
                        f" do not invert: row 16's cut is drawn round boxes and wires only")
    bs = branches(e[1][1:], tbl, [src] * 2, spell(e))
    return pic("cond", src, bs[0][2], False, _in=bs[0][0]["_in"], guard=g,
               bodies=[lane(b) for b in bs])


def base(f, c, polys):
    """The object the algebra meets: the functor at the carrier.  A coproduct of ONE branch IS that
    branch, so its algebra takes the branch's own ×-factors as separate strands; a several-branch
    one stays folded, because the `[x,y]` inside is what forks it."""
    bs = polys.get(f)
    return subst(obj(bs[0]), {'x': c}) if bs and len(bs) == 1 else ('app', f, c)


def declared(alg, tbl, f, env, polys):
    """A fold inside a functor gets no target from the panel, so the carrier is READ OFF the
    algebra's own row — `scripts/diagram` reads the same declaration for the spider side. `f`'s
    algebra is the row whose source is `f` at its target, which is also what picks between the
    arrows a reused letter carries; `env` binds the letters `mu`'s scheme wrote the source over."""
    cs = [t for r in rows(tbl, alg[1] if alg[0] in ('atom', 'app') else None)
          for t in [subst(obj(r["tgt"]), env)]
          if ground(t) and subst(obj(r["src"]), env) == base(f, t, polys)]
    if len(cs) != 1:
        raise Unhandled(f"`{spell(alg)}` is {len(cs)} algebras for {f} in diag/circuit-sigs.json:"
                        f" a fold inside a functor takes its carrier from the one row declaring it")
    return cs[0]


def fold(e, tbl, src, tgt):
    """§3 row 17: `⦇α⦈` as MELLIÈS' FUNCTORIAL BOX — the algebra's own circuit between two bars,
    the note's own `banana` (allegory-axioms.typ).  Nothing crosses the LEFT bar: the input arrives
    at it and the algebra's strands start there, and that break is the recursion.  The carrier is
    never inferred: the panel's target declares it, or the algebra's row does, and the box is
    LABELLED with it — the term names the algebra and the source, so this is what it cannot say."""
    cfg = sigs()
    hits = []
    for f, o in cfg.get("mu", {}).items():
        env = {}
        try:
            unify(obj(o), src, env)
        except Unhandled:
            continue
        hits.append((f, env))
    if len(hits) != 1:
        raise Unhandled(f"`{spell(e)}` folds {oshow(src)}, which diag/circuit-sigs.json gives"
                        f" {len(hits)} initial algebras for — a fold needs exactly one")
    f, env = hits[0]
    c = tgt if tgt is not None else declared(e[1][0], tbl, f, env, cfg["polys"])
    a = base(f, c, cfg["polys"])
    b = walk(e[1][0], tbl, src=a)
    if b[2] != c:
        raise Unhandled(f"the algebra `{spell(e[1][0])}` lands on {oshow(b[2])}, not the carrier"
                        f" {oshow(c)} the fold is stated at")
    # A product carrier is drawn as its wires, never as a label (§13.4.4a: `[A]×[A]` is two wires
    # each `[A]`).  A single-wire carrier is drawn only when it differs from that wire's own label.
    cw = wires(c)
    show = len(cw) == 1 and oshow(cw[0]) != oshow(c)
    body = lane(b)          # the port labels are the algebra's own strands: one per wire it takes
    return pic("cata", src, c, b[3], body=body, label=lshow(c) if show else None,
               port=[lshow(w) for w in body["_in"]])


def tape(e, tbl, src):
    """§3 row 13: the bracket at a polynomial object — tape fork, branches, tape join.  The source
    is opened by the functor's own polynomial, which is the object-level unfold of §1.3."""
    polys = sigs()["polys"]
    if src[0] != 'app' or src[1] not in polys:
        raise Unhandled(f"`{spell(e)}` forks {oshow(src)}, which diag/circuit-sigs.json gives no"
                        f" polynomial for — a case needs the coproduct it splits")
    env = {}
    unify(obj(f"{src[1]}(x)"), src, env)
    ss = [subst(obj(p), env) for p in polys[src[1]]]
    if len(ss) != len(e[1]):
        raise Unhandled(f"`{spell(e)}` has {len(e[1])} branches over {oshow(src)}'s {len(ss)}")
    bs = branches(e[1], tbl, ss, spell(e))
    # The coproduct arrives as ONE wire, the fork being what opens it; a box at the same object
    # takes the product summand's strands (`wires`).
    return pic("case", src, bs[0][2], all(b[3] for b in bs), _in=[src],
               bodies=[lane(b) for b in bs], ports=[[lshow(w) for w in wires(s)] for s in ss])


# ---------------------------------------------------------------- seams and the panel
def seams(objs):
    """Which interior objects the picture prints.  The ports always; an interior seam exactly when
    its object is ONE wire and differs from both printed neighbours (CIRCUIT-GEN §3)."""
    out, prev = [], objs[0]
    for i, o in enumerate(objs[1:-1]):
        if len(wires(o)) == 1 and o != prev and o != objs[i + 2]:
            out.append([i, lshow(o)]); prev = o
    return out


def draw(formula, src, tgt, table=None):
    """The circuit a formula denotes, typed, with its ports checked against the stated ones."""
    e = cnorm(parse(formula))
    tree, s, t, _ = walk(e, (table or sigs())["sigs"], src=obj(src), tgt=obj(tgt))
    if t != obj(tgt):
        raise Unhandled(f"{spell(e)} lands on {oshow(t)}, not the stated {tgt}")
    tree["src"] = [lshow(w) for w in tree["_in"]]
    tree["tgt"] = [lshow(w) for w in tree["_out"]]
    tree["cert"] = {"expect": formula, "src": src, "tgt": tgt}
    return tree


# ---------------------------------------------------------------- the typst call
def tv(v, ind=2):
    """A layout node as Typst source.  A label rides as a STRING and `cpanel` wraps it in `raw` —
    one spelling of `[`x`]`, in the file that also decides which of them becomes a fraction."""
    p = " " * ind
    if isinstance(v, dict):
        return "(" + ", ".join(f"{k}: {tv(x, ind + 2)}"
                               for k, x in v.items() if not k.startswith("_")) + ")"
    if isinstance(v, list):
        return "(\n" + "".join(f"{p}{tv(x, ind + 2)},\n" for x in v) + " " * (ind - 2) + ")" \
            if any(isinstance(x, (dict, list)) for x in v) \
            else "(" + "".join(f"{tv(x, ind)}, " for x in v) + ")"
    return "none" if v is None else \
        str(v).lower() if isinstance(v, bool) else \
        '"' + v + '"' if isinstance(v, str) else str(v)


def emit(t):
    t = dict(t)
    cert = t.pop("cert")
    return f"#cpanel({tv(t)},\n  cert: {tv(cert)})"


def read_back(t):
    """The composite the drawn boxes spell, in the note's own notation — the circuit's answer to
    `scripts/diagram`'s sweep.  Every node was built from one operator, so the picture reads back as
    the normalised term or the walk dropped something."""
    k = t["k"]
    if k == "box":
        e = parse(t["label"] + ("%∋" if t["frac"] else ""))
        return ('conv', e) if t["flip"] else e
    if k == "seq":
        xs = [read_back(x) for x in t["items"]]
        return ('atom', sl.UNIT) if not xs else xs[0] if len(xs) == 1 else ('comp', xs)
    if k == "stack":
        return ('prod', [read_back(x) for x in t["lanes"]])
    if k == "konst":
        return ('comp', [('atom', KONST), read_back(t["body"])])
    if k == "proj":
        return ('atom', t["label"])
    if k == "cap":
        return mk("cap", [read_back(x) for x in t["lanes"]])
    if k == "cata":
        return mk("cata", [read_back(t["body"])])
    if k == "cond":
        return mk("cond", [read_back(t["guard"])] + [read_back(x) for x in t["bodies"]])
    return mk("union" if k == "union" else "case", [read_back(x) for x in t["bodies"]])


def main(argv):
    src, tgt = sl.opt(argv, "--src"), sl.opt(argv, "--tgt")
    taken = {i for o in ("--src", "--tgt") if o in argv
             for i in (argv.index(o), argv.index(o) + 1)}
    free = [a for i, a in enumerate(argv) if i not in taken and not a.startswith("-")]
    tbl = sigs()
    if "--slice" in argv:
        # The whole file is written here, header included: a hand-kept header above a `>` redirect
        # was lost three times over, so nothing about circuit-slice.typ is edited by hand any more.
        bad, out = 0, [
            "// The acceptance render for CIRCUIT-GEN §5's slice, written whole by `./scripts/circuit"
            " --slice`.",
            "// Everything here is generator output, so a redraw is a re-run of that line — never a"
            " hand edit.",
            "// `make slice` regenerates and compiles it; `make p` runs that too.",
            '#import "cpanel.typ": cpanel',
            "#set page(width: auto, height: auto, margin: 0.8cm, fill: white)",
            "#set par(spacing: 20pt)", ""]
        for name, f, s, t in SLICE:
            out.append(f"// {name}  {f}   [{s} ⟶ {t}]")
            try:
                out.append(emit(draw(f, s, t, tbl)))
            except (Unhandled, ValueError, KeyError) as ex:
                bad += 1; print(f"circuit: {name}: {ex}", file=sys.stderr)
            out.append("")
        with open(OUT, "w", encoding="utf-8") as fh:
            fh.write("\n".join(out))
        print(f"circuit: {len(SLICE)} rows in CIRCUIT-GEN §5, {len(SLICE) - bad} drawn,"
              f" {bad} blocked → {os.path.relpath(OUT)}", file=sys.stderr)
        sys.exit(bad and f"circuit: {bad} row{'s' * (bad > 1)} did not draw")
    formula = next(iter(free), None)
    if not (formula and src and tgt):
        sys.exit(__doc__.strip().splitlines()[0]
                 + '\nusage: circuit --src "F([A])" --tgt "[A]" "S%∋ est(R°)"'
                 + '\n       circuit --slice')
    t = draw(formula, src, tgt, tbl)
    print(emit(t))
    # The boxes spell the NORMALISED term, up to spacing: a `union`/`case` keeps the note's own
    # spelling verbatim, and a rebuilt one cannot know that this bracket was written `(p×𝟙) cons`.
    if spell(read_back(t)).replace(" ", "") != spell(cnorm(parse(formula))).replace(" ", ""):
        print(f"// the run reads back as {spell(read_back(t))}", file=sys.stderr)


if __name__ == "__main__":
    main(sys.argv[1:])
