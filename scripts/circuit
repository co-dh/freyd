#!/usr/bin/env python3
"""circuit — the CIRCUIT picture a formula denotes, drawn mechanically.

`scripts/diagram` runs the note's formula through the Hinze–Marsden reading; this runs it through
the MONOIDAL one.  Same input — the formula in the note's notation plus the source and target
objects, which a formula alone does not fix — and the same self-certifying `cert:`, but the picture
downstream is the other language: a WIRE is an object, a BOX is a morphism, composition runs left to
right, and a product is TWO wires, never one wire labelled `A×B`.  A `#cpanel(...)` call goes out,
ready to paste beside the row it draws.

The design is diag/CIRCUIT-GEN.md and this is its §5 slice.  Typing is §1.3: every subterm carries
its source and target OBJECT, read off diag/circuit-sigs.json by unification with the port in hand,
and `wires(X)` is the list of ×-factors of `X` (the unit object has none).  Drawing is §3: one
clause of `walk` per operator, each primitive placed once.  Widths are deliberately absent —
`cpanel` measures its own labels at render time (§4f), so this never guesses font metrics.

WHAT IT STILL REFUSES.  `∩`, `(g→x,y)` and `⦇x⦈` are `('cap', …)`, `('cond', …)` and `('cata', …)`
in CIRCUIT-GEN §1.5 and are not in the shared grammar, so they arrive MIS-PARSED rather than
rejected — `∩` as an atom standing in the composite, a `⦇…⦈` bracket as one atom.  Drawing either
would draw a `∩` box sitting on a wire, so `guard` refuses them by name.  `∪` and `[x,y]` are real
nodes now; `⊸` is still an atom, and §3 row 14 reads it where it stands, as the constant it is.
"""
import importlib.machinery, importlib.util, json, os, sys

sys.dont_write_bytecode = True                 # no `scripts/__pycache__` beside the other scripts
_P = os.path.join(os.path.dirname(os.path.abspath(__file__)), "scanline")
_S = importlib.util.spec_from_loader("scanline", importlib.machinery.SourceFileLoader("scanline", _P))
sl = importlib.util.module_from_spec(_S)
_S.loader.exec_module(sl)
parse, norm, spell, Unhandled = sl.parse, sl.norm, sl.spell, sl.Unhandled

SIGS = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "diag",
                    "circuit-sigs.json")
KONST = "⊸"
# CIRCUIT-GEN §5's three rows, in dependency order: `--slice` is the acceptance test.
SLICE = [("13.3.3d r1", "S%∋ est(R°)", "F([A])", "[A]"),
         ("13.3.3c r1", "(𝟙×R°)(⊸ nil ∪ (p×𝟙) cons)", "A×[A]", "[A]"),
         ("13.3.3b r2", "F(prefix) [nil,⊸ nil ∪ cons] list(p)", "F([A])", "[A]")]


def sigs():
    """diag/circuit-sigs.json — what each atom is an arrow between, and whether it is a map."""
    return json.load(open(SIGS, encoding="utf-8"))


# ---------------------------------------------------------------- objects
# An object is normalised on the way in — `[A]` is `list(A)`, `×` flat — so unification is
# structural; `oshow` puts the brackets back, because `[A]` is what the note prints on a port.
def obj(s):
    return norm(parse(s)) if isinstance(s, str) else norm(s)


def oshow(e):
    if e[0] == 'app':
        return f"[{oshow(e[2])}]" if e[1] == 'list' else f"{e[1]}({oshow(e[2])})"
    return '×'.join(oshow(x) for x in e[1]) if e[0] == 'prod' else spell(e)


def wires(X):
    """The ×-factors of `X` — the strands a port at `X` has.  A functor application is ONE wire and
    the unit is NONE: `𝟏` is the empty product, which is why the note's `nil` has no left port."""
    return [] if X == ('atom', '𝟏') else \
        [w for x in X[1] for w in wires(x)] if X[0] == 'prod' else [X]


def var(e):
    return e[0] == 'atom' and len(e[1]) == 1 and e[1].islower()


def ground(e):
    """No variable left: an end still holding one is not a port a walk can be started from."""
    seen = []

    def scan(x):
        seen.append(var(x))
        return sl.rec(x, scan)
    scan(e)
    return not any(seen)


def unify(scheme, X, env):
    """Bind the scheme's variables so it becomes `X`; the port in hand is always concrete."""
    if var(scheme):
        if env.setdefault(scheme[1], X) != X:
            raise Unhandled(f"{scheme[1]} is {oshow(env[scheme[1]])} and {oshow(X)} at once")
        return
    if scheme[0] != X[0] or (scheme[0] in ('atom', 'app') and scheme[1] != X[1]) \
            or (scheme[0] == 'prod' and len(scheme[1]) != len(X[1])):
        raise Unhandled(f"the object {oshow(X)} is not a {oshow(scheme)}")
    if scheme[0] == 'app':
        unify(scheme[2], X[2], env)
    elif scheme[0] == 'prod':
        for a, b in zip(scheme[1], X[1]):
            unify(a, b, env)


def subst(scheme, env):
    return env[scheme[1]] if var(scheme) and scheme[1] in env \
        else sl.rec(scheme, lambda x: subst(x, env))


# ---------------------------------------------------------------- the circuit normalizer (§1.4)
def mk(tag, ops):
    """A `union`/`case` the normalizer MANUFACTURES: `spell` reads the third element verbatim, so a
    rebuilt node needs a spelling of its own instead of the stale one it inherited."""
    return (tag, ops, ' ∪ '.join(spell(x) for x in ops) if tag == 'union'
            else '[' + ','.join(spell(x) for x in ops) + ']')


def crec(e, f):
    """`sl.rec` stops AT a `union`/`case` — the spider side never looks inside one, and that is what
    keeps `[x,y]` one bead over there.  A circuit opens both, so this walks in."""
    if e[0] not in ('union', 'case'):
        return sl.rec(e, f)
    ops = [f(x) for x in e[1]]
    return e if ops == list(e[1]) else mk(e[0], ops)


def cnorm(e):
    """CIRCUIT-GEN §1.4, applied before drawing on trust, exactly as scanline's `norm` trusts
    `F(R)F(S)=F(RS)`.  It is NOT that `norm`: this one keeps the `°` where the formula writes it,
    which `norm` pushes to the atoms, erasing the distinction §3 rows 7/8 draw."""
    e = crec(e, cnorm)
    # `R%∋=𝟙%∋ E(R)`, the note's own `DUN` (allegory-axioms.typ): a row writes ONE fraction where
    # the picture draws two — the unit opens `E` outside `R`.  Guarded at `𝟙`, the rewrite's own
    # fixed point, which would otherwise regress for ever.
    if e[0] == 'atom' and e[1].endswith('%∋') and e[1][:-2] != sl.UNIT:
        return ('comp', [('atom', sl.UNIT + '%∋'), ('app', 'E', cnorm(parse(e[1][:-2])))])
    if e[0] != 'comp':
        return e
    xs = [y for x in e[1] for y in (x[1] if x[0] == 'comp' else [x])]   # rule 1: flatten,
    xs = fuse(xs) or xs
    xs = [x for x in xs if x != ('atom', sl.UNIT)] or [('atom', sl.UNIT)]   # and `𝟙` is a wire
    return xs[0] if len(xs) == 1 else ('comp', xs)


def fuse(xs, polys=None):
    """Rule 3, tape fusion: `F(R)[f,g]=[f,(𝟙×R)g]` at `FX=𝟏+A×X`.  Without it a compositional draw
    of `F(prefix)[nil,body]` is two tapes in series where the note draws one (§4b).  Keyed on the
    polynomial, so the `𝟙` lands on the constant branch factor and `R` on the recursive one."""
    polys = sigs()["polys"] if polys is None else polys
    for i, (x, y) in enumerate(zip(xs, xs[1:])):
        if x[0] != 'app' or y[0] != 'case' or x[1] not in polys:
            continue
        rc = obj(polys[x[1]][-1])                        # `A×x`: the branch the functor recurses on
        if len(polys[x[1]]) != len(y[1]) or rc[0] != 'prod':
            continue
        f = ('prod', [x[2] if var(k) else ('atom', sl.UNIT) for k in rc[1]])
        br = list(y[1]); br[-1] = ('comp', [f, br[-1]])
        return xs[:i] + [mk('case', br)] + xs[i + 2:]
    return None


# ---------------------------------------------------------------- the grammar guard
# CIRCUIT-GEN §1.5's remaining productions are not in the shared parser, so the terms that need them
# arrive MIS-PARSED rather than rejected: `∩` as an atom beside its operands, `⦇x⦈` as one atom.
# Refusing them by name is the whole reason this is a guard and not a missing clause.
STOP = {'∩': ("x∩y", "('cap', …)"), '→': ("(g→x,y)", "('cond', …)"), '⦇': ("⦇x⦈", "('cata', …)")}


def guard(e):
    """Every term §13.3.x draws that today's `parse` cannot open, refused where it is written."""
    for c, (surface, node) in STOP.items():
        if e[0] == 'atom' and c in e[1]:
            raise Unhandled(
                f"`{c}` is an ATOM to today's `parse`, not an operator: `{e[1]}` arrives whole."
                f"  CIRCUIT-GEN §1.5 adds `{node}` for `{surface}` to scripts/scanline's grammar;"
                f" until it lands the circuit generator cannot open it")
    crec(e, guard)          # `crec` rebuilds, so the visit has to hand every subterm back
    return e


# ---------------------------------------------------------------- one clause per operator (§3)
def pic(k, src, tgt, is_map, **kw):
    """A layout node.  `nin`/`nout` are the strand counts its ports carry, which is what `cpanel`
    lays the picture out over; a `_`-prefixed field is the elaborator's and is not emitted."""
    return dict(k=k, nin=len(wires(src)), nout=len(wires(tgt)), **kw), src, tgt, is_map


def box(label, src, tgt, is_map, frac=False, flip=False):
    return pic("box", src, tgt, is_map, label=label, chamfer=not is_map, frac=frac, flip=flip)


def walk(e, tbl, src=None, tgt=None):
    """`(node, src, tgt, is_map)`.  One end of the arrow is always known — the panel's own port at
    the top, the previous factor's target inside a composite — and the signature says the other."""
    if e[0] == 'hc':
        raise Unhandled(f"`∘` composes ACROSS a functor wire, which is the spider reading;"
                        f" a circuit has no such direction (CIRCUIT-GEN §3 row 19): {spell(e)}")
    if e[0] == 'comp':
        return seq(e[1], tbl, src)
    if e[0] == 'conv':
        n, s, t, _ = walk(e[1], tbl, src=tgt, tgt=src)
        if n["k"] != "box":
            raise Unhandled(f"`{spell(e)}` writes `°` on a composite, which is the cup/cap frame of"
                            f" CIRCUIT-GEN §3 row 8 — not in the slice")
        return box(n["label"], t, s, False, frac=n["frac"], flip=not n["flip"])
    if e[0] == 'prod':
        return stack(e[1], tbl, src)
    if e[0] == 'union':
        return fan(e, tbl, src)
    if e[0] == 'case':
        return tape(e, tbl, src)
    if e[0] == 'atom' and e[1] == sl.UNIT:            # §3 row 4: the identity is bare wires
        if src is None and tgt is None:
            raise Unhandled("`𝟙` is the identity on the object at its port, and neither is known")
        return pic("seq", src or tgt, src or tgt, True, items=[], seams=[], _objs=[src or tgt])
    if e[0] == 'atom' and e[1].endswith('%∋'):       # §3 row 15: the transpose, always a map
        n, s, t, _ = walk(parse(e[1][:-2]), tbl, src=src)
        return box(spell(parse(e[1][:-2])), s, ('app', 'E', t), True, frac=True)
    return leaf(e, tbl, src, tgt)


def leaf(e, tbl, src, tgt):
    """An atom (§3 rows 1-2) or an application read as one box (§3 row 10): the signature's `src`
    and `tgt` are schemes, and the port in hand binds their variables."""
    key = e[1] if e[0] in ('atom', 'app') else None
    row = tbl.get(key)
    if row is None:
        raise Unhandled(f"no signature for `{key or spell(e)}` in diag/circuit-sigs.json")
    env = {}
    unify(obj(row["src"]) if src is not None else obj(row["tgt"]), src if src is not None else tgt,
          env)
    if e[0] == 'app':                                # the argument is TYPED, not drawn: one box
        a, b = obj(row["arg"].split('⟶')[0]), obj(row["arg"].split('⟶')[1])
        sa, sb = subst(a, env), subst(b, env)
        # `E(R): E(a)⟶E(b)` binds `b` from the ARGUMENT's target, not from the port in hand, so the
        # argument's own ends come back and go into `env` before the entry's scheme is substituted.
        _, s2, t2, _ = walk(e[2], tbl, src=sa if ground(sa) else None,
                            tgt=sb if ground(sb) else None)
        unify(a, s2, env), unify(b, t2, env)
    return box(spell(e), subst(obj(row["src"]), env), subst(obj(row["tgt"]), env), row["map"])


def lane(t):
    """One branch or one strand of a stack is always a run, so a single box becomes a one-box run
    and every consumer below has exactly one shape to place."""
    n, s, t2, m = t
    return n if n["k"] == "seq" else \
        pic("seq", s, t2, m, items=[n], seams=[], _objs=[s, t2])[0]


def seq(xs, tbl, src):
    """§3 row 5: juxtaposition, ports glued.  The objects between the factors are kept — the seam
    rule below decides which get printed — and a nested composite splices in rather than nesting."""
    items, objs, mp, i = [], [src], True, 0
    while i < len(xs):
        if xs[i] == ('atom', KONST):                  # §3 row 14: `⊸ x`, the constant `x`
            if i + 1 == len(xs):
                raise Unhandled("`⊸` with nothing after it: a constant needs the thing it creates")
            b = walk(xs[i + 1], tbl, src=obj("𝟏"))
            items.append(pic("konst", objs[-1], b[2], b[3], body=lane(b))[0])
            objs.append(b[2]); mp = mp and b[3]; i += 2
            continue
        n, s, t, m = walk(xs[i], tbl, src=objs[-1])
        if n["k"] == "seq":
            items += n["items"]; objs += n["_objs"][1:]
        else:
            items.append(n); objs.append(t)
        mp = mp and m; i += 1
    return pic("seq", objs[0], objs[-1], mp, items=items, seams=seams(objs), _objs=objs)


def stack(xs, tbl, src):
    """§3 row 6: a product is a vertical stack, one wire per factor.  The general split of the src
    object's ×-factors between the factors is not needed while every factor takes exactly one."""
    ws = wires(src)
    if len(ws) != len(xs):
        raise Unhandled(f"`{spell(('prod', xs))}` has {len(xs)} factors over the {len(ws)} wires of"
                        f" {oshow(src)}: §3 row 6's general split is not in the slice")
    ls = [walk(x, tbl, src=w) for x, w in zip(xs, ws)]
    t = ls[0][2] if len(ls) == 1 else ('prod', [b[2] for b in ls])
    return pic("stack", src, t, all(b[3] for b in ls), lanes=[lane(b) for b in ls])


def branches(e, tbl, srcs):
    """A `∪` and a `[x,y]` differ in where their branches START, never in where they end: both close
    by merging, so every branch has to land on the one object the region leaves at."""
    bs = [walk(x, tbl, src=s) for x, s in zip(e[1], srcs)]
    if len({oshow(b[2]) for b in bs}) > 1:
        raise Unhandled(f"`{spell(e)}` merges branches at {', '.join(oshow(b[2]) for b in bs)}")
    return bs


def fan(e, tbl, src):
    """§3 row 11: the `∪` region — the input arrives once, a dashed fan hands it to both bodies."""
    bs = branches(e, tbl, [src] * len(e[1]))
    return pic("union", src, bs[0][2], False, bodies=[lane(b) for b in bs])


def tape(e, tbl, src):
    """§3 row 13: the bracket at a polynomial object — tape fork, branches, tape join.  The source
    is opened by the functor's own polynomial, which is the object-level unfold of §1.3."""
    polys = sigs()["polys"]
    if src[0] != 'app' or src[1] not in polys:
        raise Unhandled(f"`{spell(e)}` forks {oshow(src)}, which diag/circuit-sigs.json gives no"
                        f" polynomial for — a case needs the coproduct it splits")
    env = {}
    unify(obj(f"{src[1]}(x)"), src, env)
    ss = [subst(obj(p), env) for p in polys[src[1]]]
    if len(ss) != len(e[1]):
        raise Unhandled(f"`{spell(e)}` has {len(e[1])} branches over {oshow(src)}'s {len(ss)}")
    bs = branches(e, tbl, ss)
    return pic("case", src, bs[0][2], all(b[3] for b in bs),
               bodies=[lane(b) for b in bs], ports=[[oshow(w) for w in wires(s)] for s in ss])


# ---------------------------------------------------------------- seams and the panel
def seams(objs):
    """Which interior objects the picture prints.  The ports always; an interior seam exactly when
    its object is ONE wire and differs from both printed neighbours (CIRCUIT-GEN §3)."""
    out, prev = [], objs[0]
    for i, o in enumerate(objs[1:-1]):
        if len(wires(o)) == 1 and o != prev and o != objs[i + 2]:
            out.append([i, oshow(o)]); prev = o
    return out


def draw(formula, src, tgt, table=None):
    """The circuit a formula denotes, typed, with its ports checked against the stated ones."""
    e = cnorm(parse(formula))
    guard(e)
    tree, s, t, _ = walk(e, (table or sigs())["sigs"], src=obj(src))
    if t != obj(tgt):
        raise Unhandled(f"{spell(e)} lands on {oshow(t)}, not the stated {tgt}")
    tree["src"] = [oshow(w) for w in wires(s)]
    tree["tgt"] = [oshow(w) for w in wires(t)]
    tree["cert"] = {"expect": formula, "src": src, "tgt": tgt}
    return tree


# ---------------------------------------------------------------- the typst call
def tv(v, ind=2):
    """A layout node as Typst source.  A label rides as a STRING and `cpanel` wraps it in `raw` —
    one spelling of `[`x`]`, in the file that also decides which of them becomes a fraction."""
    p = " " * ind
    if isinstance(v, dict):
        return "(" + ", ".join(f"{k}: {tv(x, ind + 2)}"
                               for k, x in v.items() if not k.startswith("_")) + ")"
    if isinstance(v, list):
        return "(\n" + "".join(f"{p}{tv(x, ind + 2)},\n" for x in v) + " " * (ind - 2) + ")" \
            if any(isinstance(x, (dict, list)) for x in v) \
            else "(" + "".join(f"{tv(x, ind)}, " for x in v) + ")"
    return str(v).lower() if isinstance(v, bool) else \
        '"' + v + '"' if isinstance(v, str) else str(v)


def emit(t):
    t = dict(t)
    cert = t.pop("cert")
    return f"#cpanel({tv(t)},\n  cert: {tv(cert)})"


def read_back(t):
    """The composite the drawn boxes spell, in the note's own notation — the circuit's answer to
    `scripts/diagram`'s sweep.  Every node was built from one operator, so the picture reads back as
    the normalised term or the walk dropped something."""
    k = t["k"]
    if k == "box":
        e = parse(t["label"] + ("%∋" if t["frac"] else ""))
        return ('conv', e) if t["flip"] else e
    if k == "seq":
        xs = [read_back(x) for x in t["items"]]
        return ('atom', sl.UNIT) if not xs else xs[0] if len(xs) == 1 else ('comp', xs)
    if k == "stack":
        return ('prod', [read_back(x) for x in t["lanes"]])
    if k == "konst":
        return ('comp', [('atom', KONST), read_back(t["body"])])
    return mk("union" if k == "union" else "case", [read_back(x) for x in t["bodies"]])


def main(argv):
    src, tgt = sl.opt(argv, "--src"), sl.opt(argv, "--tgt")
    taken = {i for o in ("--src", "--tgt") if o in argv
             for i in (argv.index(o), argv.index(o) + 1)}
    free = [a for i, a in enumerate(argv) if i not in taken and not a.startswith("-")]
    tbl = sigs()
    if "--slice" in argv:
        bad = 0
        for name, f, s, t in SLICE:
            print(f"// {name}  {f}   [{s} ⟶ {t}]")
            try:
                print(emit(draw(f, s, t, tbl)))
            except (Unhandled, ValueError, KeyError) as ex:
                bad += 1; print(f"circuit: {name}: {ex}", file=sys.stderr)
            print()
        print(f"circuit: {len(SLICE)} rows in CIRCUIT-GEN §5, {len(SLICE) - bad} drawn,"
              f" {bad} blocked", file=sys.stderr)     # stdout is the pasteable file, nothing else
        sys.exit(bad and f"circuit: {bad} row{'s' * (bad > 1)} need the §1.5 grammar extension")
    formula = next(iter(free), None)
    if not (formula and src and tgt):
        sys.exit(__doc__.strip().splitlines()[0]
                 + '\nusage: circuit --src "F([A])" --tgt "[A]" "S%∋ est(R°)"'
                 + '\n       circuit --slice')
    t = draw(formula, src, tgt, tbl)
    print(emit(t))
    # The boxes spell the NORMALISED term, up to spacing: a `union`/`case` keeps the note's own
    # spelling verbatim, and a rebuilt one cannot know that this bracket was written `(p×𝟙) cons`.
    if spell(read_back(t)).replace(" ", "") != spell(cnorm(parse(formula))).replace(" ", ""):
        print(f"// the run reads back as {spell(read_back(t))}", file=sys.stderr)


if __name__ == "__main__":
    main(sys.argv[1:])
