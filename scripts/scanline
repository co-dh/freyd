#!/usr/bin/env python3
"""scanline — the scan-line reading of the note's Hinze–Marsden panels, run mechanically.

Every table-driven panel emits the lists it DRAWS FROM as `#metadata` (`hm-meta` in the note), so
the structure read here cannot drift from the ink.  `typst query` hands them over; this sweeps each
panel from the top edge down, maintains the cut — the live wires in `x` order, leftmost = outermost
functor, the object wire rightmost — and prints the composite the picture denotes in the note's
notation: diagram order, juxtaposition, `°`, `F(R)`, `𝟙`.

What it PROVES about a panel: every cut is constant between beads, every bead's source is the cut
above it and its target the cut below, the endpoints are the panel's ports, and one bead label has
one signature everywhere in its display.  What it only CHECKS: the `cert:` a call site declares —
`expect:` the row's formula, `src:`/`tgt:` the stated endpoints, `branch:` which case the panel
draws, `alias:` the abbreviations the display's key list asks the reader to supply.  Applying a
declared law is mechanical; its truth stays the author's certificate, as in `scripts/cite-check`.
"""
import glob, hashlib, json, math, os, re, subprocess, sys, time

CACHE = ".lake/build/scanline-cache.json"

EPS = 1e-6
DY = 1.5                                       # one row: `scripts/diagram`'s bead pitch

# The note's relation notation is not this file's subject — `scripts/circuit` reads the same
# language to draw the OTHER convention — so it lives in `relexpr.py` and is bound here under the
# names this file and `scripts/diagram` use.
sys.dont_write_bytecode = True                 # no `scripts/__pycache__` beside the other scripts
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from relexpr import (alias, BREAK, CARRIER, CLOSERS, DVAR, INTERVAL, IVAR, OPENERS, PROJ, TERM,
                     UNIT, Unhandled, VARS, VEC, act, canon, deindex, defns, dmatch, dput, dun,
                     fill, fuse,
                     help_if, hole_last, hole_slot, ibind, idxhead, interchange, is_index, isub,
                     listable, matching, norm, opt, p_prim, p_prod, parse, quot, rec,
                     require_hole_last, spell, split_top, squeeze, tidy, unabbrev, unit_ctx,
                     varsof)

# ---------------------------------------------------------------- the ink
# `hm.typ`'s own constants and the knees the note's panel helpers hand `hm-wire`.  The adapters
# below build THE SAME `pts` those helpers build and hand them to `poly`, which is `hm-seg`; the
# curve maths lives here once, so a crossing is looked for in the shape actually drawn.
HMK, HMQ, DY = 0.618, 0.3915, 1.1              # `DY` is one ROW — `scripts/diagram`'s own, and
# the knee is 0.3 of it: a knee measured in absolute units does not shrink when the row does, and a
# row-and-a-bit of knee is what braids two strands falling on one bead.
NEAR = 0.06                      # a hit this close to a junction IS that junction, not a crossing


def seg(a, b, n=16, k=HMK, ha=False, hb=False):
    """`hm-seg` sampled: a straight run, or its bezier — vertical tangents, except that `ha`/`hb`
    lay an end along the row instead, where it lands on a dot.  A quarter turn takes the SAME
    handle at both ends, `HMQ` times its own CHORD, capped at the shorter side, as `hm-seg` does —
    uncapped, a long sideways run bows the turn BACK past its own end and crosses what it left."""
    if abs(a[0] - b[0]) < EPS or abs(a[1] - b[1]) < EPS:
        return [a, b]
    dx, dy = b[0] - a[0], b[1] - a[1]
    if ha == hb:
        hx, hy = k * dx, k * dy
    else:
        q = min(HMQ * math.hypot(dx, dy), abs(dx), abs(dy))
        hx, hy = q * (-1 if dx < 0 else 1), q * (-1 if dy < 0 else 1)
    c = (a[0] + hx, a[1]) if ha else (a[0], a[1] + hy)
    e = (b[0] - hx, b[1]) if hb else (b[0], b[1] - hy)
    return [tuple(u ** 3 * a[i] + 3 * u * u * t * c[i] + 3 * u * t * t * e[i] + t ** 3 * b[i]
                  for i in (0, 1))
            for t, u in ((j / n, 1 - j / n) for j in range(n + 1))]


def obez(a, b, k, y):
    """`obez`: where the object wire's own bezier stands at a height.  Its handles are VERTICAL, so
    the x-controls ARE the endpoints and x(t) is the smoothstep `3t²-2t³`; y(t) is inverted by the
    same 40-step bisection the note takes, so both languages land on one number."""
    u = (y - a[1]) / (b[1] - a[1])
    lo, hi = 0.0, 1.0
    for _ in range(40):
        m = (lo + hi) / 2
        f = 3 * k * m * (1 - m) ** 2 + 3 * (1 - k) * m * m * (1 - m) + m ** 3
        lo, hi = (m, hi) if f < u else (lo, m)
    t = (lo + hi) / 2
    return a[0] + (b[0] - a[0]) * (3 * t * t - 2 * t * t * t)


def poly(pts, k=HMK, hs=()):
    """`hm-path` sampled: the polyline one strand's ink follows.  `hs` is `hm-path`'s — the POINT
    indices where the path lands on a dot, and so leaves along the dot's row instead of down."""
    out = []
    for i, (a, b) in enumerate(zip(pts, pts[1:])):
        s = seg(a, b, k=k, ha=(i in hs), hb=(i + 1 in hs))
        out += s[1:] if out else s
    return out


def meet(a, b, c, d):
    """Where `ab` and `cd` cross, or `None`; parallel, and touching at an end, are not crossings."""
    den = (b[0] - a[0]) * (d[1] - c[1]) - (b[1] - a[1]) * (d[0] - c[0])
    if abs(den) < 1e-12:
        return None
    t = ((c[0] - a[0]) * (d[1] - c[1]) - (c[1] - a[1]) * (d[0] - c[0])) / den
    s = ((c[0] - a[0]) * (b[1] - a[1]) - (c[1] - a[1]) * (b[0] - a[0])) / den
    return None if not (0 < t < 1 and 0 < s < 1) else \
        (a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1]))


# ---------------------------------------------------------------- the panel model
class Wire:
    def __init__(self, x, ytop, ybot, label, born=None, pts=None, dips=(), hs=(), k=HMK):
        self.x, self.ytop, self.ybot, self.label, self.born = x, ytop, ybot, label, born
        # `dips` are the heights where the lane is DRAWN onto the object wire and back out — it
        # meets a bead there, so a wire arriving at that bead has not passed it.  `hs` and `k` are
        # the two things `hm-wire` was handed, so the sampled curve is the one drawn.
        self.pts, self.dips, self.hs, self.k = pts, dips, hs, k


class Bead:
    def __init__(self, y, x, label, reach=None, born=False, ink=None):
        # `reach` is how far left the bead reaches; the reach is ALWAYS drawn as arms the wires bend
        # into, never as a straight line past them — a bead is a point, so every arm is a bend.
        self.y, self.x, self.label, self.reach, self.born = y, x, label, reach, born
        # where the dot is DRAWN — off `(x, y)` only where a sloped `opath` carries the object wire
        self.ink = ink or (x, y)


class Panel:
    def __init__(self, r):
        self.id, self.helper, self.h, self.xo = r['id'], r['helper'], r['h'], r['xo']
        self.rec = r                       # the raw record, for checks over ink no `Wire` holds
        self.cert = r.get('cert') or {}
        self.top = [tuple(p) for p in r['top']]
        self.bot = [tuple(p) for p in r['bot']]
        # `strands` are the drawn curves no `Wire` stands for — `tw-hm`'s split, which the
        # sweep reads off `splits` instead of off a lane of its own.
        self.wires, self.beads, self.splits, self.strands, self.kdrift = [], [], [], [], []
        # `(name, x, y, box)` for every name DRAWN beside a wire — ink no `Wire` stands for.
        self.labels = []
        self.opath = [tuple(q) for q in r.get('opath') or []]
        # `ok` is the note's OWN `oknee(op)` result, carried on the rec like `opath` — re-deriving it
        # here is the exact bug this field exists to remove.
        self.ok = r.get('ok') or 0
        ADAPT[self.helper](self, r)
        # The object wire is drawn by `dpan` itself, so no helper lists it.  Its label may change
        # down the panel (`⦇R⦈ : T⟶A`), and a panel that was TYPED says where in `obj`.
        self.olabel, self.oblabel = self.at(self.top, self.xo), self.at(self.bot, self.xo)
        self.wires.append(Wire(self.xo, self.h, 0.0, self.olabel,
                               pts=self.opath or [(self.xo, self.h), (self.xo, 0.0)],
                               k=self.ok))
        # A hand-drawn panel says nothing, so the switch is GUESSED at the lowest bead on the wire.
        # A widening NAMES the object over its range, so where it opens the bottom port's name the
        # object already carries it — the lowest bead cannot tell WHICH bead renames the object.
        sw = [s[0] for s in self.splits if s[3] == self.oblabel]
        os = [b.y for b in self.beads if abs(self.col(b) - self.xo) < EPS]
        self.oseam = sorted((y, l) for (y, l) in r.get('obj') or
                            [(max(sw) if sw else (min(os) if os else 0.0), self.oblabel)])

    def at(self, ports, x):
        return next((l for (px, l) in ports if abs(px - x) < EPS), None)

    def olab(self, z):
        """What the object wire carries at a height: the lowest seam still above it."""
        return next((l for (y, l) in self.oseam if z < y - EPS), self.olabel)

    def col(self, b):
        """The COLUMN a bead is keyed on: the object column for one riding that wire, wherever the
        slope draws it, and its own x for every other.  `xat` says where the ink is, `col` what the
        cut calls it, and the two part company the moment the object edge leans."""
        return self.xo if abs(b.x - self.xat(b.y)) < EPS else b.x

    def xat(self, y):
        """The object wire's x at a height — `xo` unless a sloped `opath` carries it.  A sloped one
        is DRAWN as `hm-seg`'s bezier, so the height is read off that curve and not off its chord,
        exactly as `dpanel`'s `xat` does; a chord would hang every dot off the wire it rides."""
        ok = self.ok
        for a, b in zip(self.opath, self.opath[1:]):
            if b[1] - EPS <= y <= a[1] + EPS:
                return b[0] if a[1] - b[1] < EPS else \
                    obez(a, b, ok, y) if ok and abs(a[0] - b[0]) > EPS else \
                    b[0] + (a[0] - b[0]) * (y - b[1]) / (a[1] - b[1])
        return self.xo


def dipys(r, X, x, yt, yb):
    """`dpanel`'s own rule for which bead heights a lane bends down to: every bead whose reach
    spans this column, and which the lane is live across.  The reach ends at the object wire where
    it actually is — `X(y)`, not `xo` — or an `opath` would give the note a dip the sweep misses."""
    return sorted((b[0] for b in r['beads']
                   if len(b) > 3 and b[3] is not None
                   and b[3] <= x < X(b[0]) and yt > b[0] > yb), reverse=True)


def dknees(r, X, h):
    """`dknees` in the note: ONE knee per bead-and-side — `('d', y)` above the dot, `('b', y)` below
    it — for the arms, legs and dips alike, since equal knees on one bezier family nest and unequal
    ones braid.  It grows with the group's longest run, capped at HALF the gap to the nearest bend
    on a participating lane or bead on that side, so two bands never OVERLAP — they may share a
    midpoint, and there each strand is vertical, in its own column.  A unit row is off the object
    column: neither bend nor bead.  A first or last bend has no neighbour and keeps 0.55."""
    bys = [b[0] for b in r['beads']]
    run, cap = {}, {}
    for (x, y0, y1, nm, un) in r['lanes']:
        yt, yb = (h if y0 == 'top' else y0), (0.0 if y1 == 'bot' else y1)
        ds = dipys(r, X, x, yt, yb)
        if un is not None and ds:
            raise Unhandled(f"the unit lane at x={x:g} dips onto a bead — `ddip` draws no unit bead")
        es = ([(y0, ('b',))] if y0 != 'top' and un is None else []) \
            + [(y, ('b', 'd')) for y in ds] + ([(y1, ('d',))] if y1 != 'bot' else [])
        for i, (y, sides) in enumerate(es):
            for s in sides:
                nb = es[i - 1][0] if s == 'd' and i > 0 else \
                    es[i + 1][0] if s == 'b' and i + 1 < len(es) else None
                c = 0.55 * (yt - yb) if nb is None else 0.5 * abs(nb - y)
                o = [z for z in bys if (z > y + EPS if s == 'd' else z < y - EPS)]
                if o:
                    c = min(c, 0.5 * abs((min(o) if s == 'd' else max(o)) - y))
                run[(s, float(y))] = max(run.get((s, float(y)), 0.0), abs(X(y) - x))
                cap[(s, float(y))] = min(cap.get((s, float(y)), 99.0), c)
    return {k: min(0.3 * DY + 0.25 * run[k], cap[k]) for k in run}


def dippts(x, X, h, y0, y1, ybs, gk):
    """`ddip`'s points and its `hs`: one bend onto the dot and back out again per bead, at that
    bead's own two knees.  `X` is the object wire's x at a height, so every bend aims at the dot
    actually drawn; a point AT that dot is a contact, met along its row, hence recorded in `hs`."""
    t, b = (h if y0 == 'top' else y0), (0.0 if y1 == 'bot' else y1)
    pts, hs = [], []
    if y0 == 'top':
        pts.append((x, h))
    else:
        hs.append(len(pts))
        pts += [(X(t), t), (x, t - gk[('b', float(t))])]
    for yb in ybs:
        pts.append((x, yb + gk[('d', float(yb))]))
        hs.append(len(pts))
        pts += [(X(yb), yb), (x, yb - gk[('b', float(yb))])]
    if y1 == 'bot':
        pts.append((x, 0.0))
    else:
        pts.append((x, b + gk[('d', float(b))]))
        hs.append(len(pts))
        pts.append((X(b), b))
    return pts, hs


def a_dpanel(p, r):
    # A bead's 5th element is where its DOT sits: a transformation between FUNCTORS names no object,
    # so it never touches the object wire (IntroString p. 36).  `dx` is `dpanel`'s own `dx` — every
    # arm, leg and dip aims at the dot actually drawn, and only a bead without one aims at `xat`.
    dotx = {float(b[0]): b[4] for b in r['beads'] if len(b) > 4 and b[4] is not None}
    dx = lambda y: dotx.get(float(y), p.xat(y))
    gk = dknees(r, dx, p.h)
    # The note EMITS the `gk` it drew with, and the two implementations of one rule are the whole
    # risk here: a sweep with no crossings proves the model has none, never the ink.
    if 'knees' in r:
        drew = {(k[0], float(k[1:])): v for k, v in r['knees'].items()}
        for k in sorted(set(drew) | set(gk)):
            a, b = drew.get(k), gk.get(k)
            if a is None or b is None or abs(a - b) > 1e-9:
                p.kdrift.append(f"{p.id}: the knee {k[0]}@y={k[1]:g} is {a} in the note and {b} in"
                                f" the sweep — `dknees` states one rule twice, and they differ")
    for i, (x, y0, y1, nm, un) in enumerate(r['lanes']):
        yt, yb = (p.h if y0 == 'top' else y0), (0.0 if y1 == 'bot' else y1)
        ds = dipys(r, dx, x, yt, yb)
        if ds:                             # `ddip`'s points — the arms the crossed wires make
            (pts, hs), wk = dippts(x, dx, p.h, y0, y1, ds, gk), HMK
        else:                              # `dlane`'s own points
            kb = gk[('b', float(y0))] if y0 != 'top' and un is None else 0.0
            kd = gk[('d', float(y1))] if y1 != 'bot' else 0.0
            # `dlane`'s `flat`: the two knees eat the whole gap, the lane's column is reached for
            # zero height, and the note draws one bezier dot to dot instead of kinking there — only
            # where this lane is the ONLY one between those two beads and its column lies BETWEEN
            # the two dots, so the straight line sweeps the corridor the columned route already did.
            # ALONE IN THE CORRIDOR, `dpanel`'s own rule: a lane whose column lies between the two
            # dots and is live across the gap has ink there, and the straight line sweeps from one
            # side of that column to the other — two wires that meet have exchanged.
            corr = [] if y0 == 'top' or y1 == 'bot' else \
                [o for j, o in enumerate(r['lanes']) if j != i
                 and min(dx(y0), dx(y1)) + EPS < o[0] < max(dx(y0), dx(y1)) - EPS
                 and (o[1] == 'top' or o[1] >= y0 - EPS)
                 and (o[2] == 'bot' or o[2] <= y1 + EPS)]
            alone = not corr and sum(1 for o in r['lanes'] if o[1] == y0 and o[2] == y1) == 1
            if (alone and y0 != 'top' and y1 != 'bot' and un is None
                    and y0 - kb <= y1 + kd + EPS
                    and min(dx(y0), dx(y1)) - EPS <= x <= max(dx(y0), dx(y1)) + EPS):
                # Straight, dot to dot: the two ends need no vertical tangent to meet, so `k = 0`
                # and neither end is a contact met along a row.
                pts, hs, wk = [(dx(y0), y0), (dx(y1), y1)], [], 0
            else:
                pts = [(x, p.h)] if y0 == 'top' else ([(x, y0)] if un is not None else
                                                      [(dx(y0), y0), (x, y0 - kb)])
                pts += [(x, 0.0)] if y1 == 'bot' else [(x, y1 + kd), (dx(y1), y1)]
                # The end that lands ON a dot arrives along the bead's row, as the book's arcs do.
                hs = ([0] if y0 != 'top' and un is None else []) \
                    + ([len(pts) - 1] if y1 != 'bot' else [])
                wk = HMK
        lab = nm or p.at(p.top if y0 == 'top' else p.bot, x)      # `dnm`: its own name, else a port's
        p.wires.append(Wire(x, yt, yb, lab, un, pts, ds, hs, wk))
        # WHICH lanes write that name is the note's `dnamed`, and the panel emits its answer: the
        # rule is stated once and the boxes swept here are the boxes drawn.  A rec `scripts/diagram`
        # builds is not ink yet, so it names nothing.
        if i in r.get('named', ()):
            # `dpanel` writes it on the birth row, or half a name's height below the knee's end
            # where another strand — a lane born on the same bead west of this one, or one dying on
            # it — sweeps that row.  The drop is `dpanel`'s own, knee capped at 0.3.
            swept = any((o[1] == y0 or o[2] == y0) and o[0] < x for o in r['lanes'])
            yn = (y0 - min(gk[('b', float(y0))], 0.3) - LLH / 2
                  if swept and un is None and y0 != 'top' else y0)
            p.labels.append((lab, x, yn, lbox(x, yn, lab)))
        if un is not None:
            p.beads.append(Bead(yt, x, un, born=True))
    for b in r['beads']:
        p.beads.append(Bead(b[0], dx(b[0]), b[1], b[3] if len(b) > 3 else None,
                            ink=(dx(b[0]), b[0])))


def a_twhm(p, r):
    for (xf, yt, xt, y, k) in r['joins']:
        p.wires.append(Wire(xf, yt, y, p.at(p.top, xf), pts=[(xf, yt), (xf, y + k), (xt, y)]))
    for (x, y, l, c) in r['beads']:
        p.beads.append(Bead(y, x, l))
    p.splits = [tuple(s) for s in r['splits']]
    for (y0, y1, x, of, outer, inner) in p.splits:
        k = min(0.40, (y0 - y1) / 3)
        p.strands.append((outer, [(p.xo, y0), (x, y0 - k), (x, y1 + k), (p.xo, y1)]))


ADAPT = {'dpanel': a_dpanel, 'tw-hm': a_twhm}


# ---------------------------------------------------------------- the sweep
def live(p, z):
    """The cut at a height NO event stands at: the live wires in `x` order, object wire rightmost.
    A split reads the object wire as `outer` beside `inner` between its two heights."""
    ws = [(w.x, p.olab(z) if w.x == p.xo else w.label)
          for w in p.wires if w.ybot < z < w.ytop]
    for (y0, y1, x, of, outer, inner) in p.splits:
        if not y1 < z < y0:
            continue
        if (p.xo, of) not in ws:
            raise Unhandled(f"the split opens {of} but the object wire carries "
                            f"{dict(ws).get(p.xo)} at y={z:.3g}")
        ws = [(x, outer) if (a, b) == (p.xo, of) else (a, b) for (a, b) in ws] + [(p.xo, inner)]
    return sorted(ws)


def levels(p):
    ys = {p.h, 0.0} | {b.y for b in p.beads} | {y for s in p.splits for y in s[:2]}
    ys |= {w.ytop for w in p.wires if w.ytop < p.h - EPS}
    ys |= {w.ybot for w in p.wires if w.ybot > EPS}
    return sorted(ys, reverse=True)


def ports(p, top):
    """The panel's own endpoints.  A bead may sit ON the top edge (13.3.4g's unit), so the source is
    the wires drawn from that edge, not the cut just below it."""
    if top:
        return sorted((w.x, w.label) for w in p.wires if w.ytop > p.h - EPS and not w.born)
    return sorted((w.x, w.label if w.x != p.xo else p.oblabel) for w in p.wires if w.ybot < EPS)


def owner(p, w, y):
    """Which bead at height `y` a wire ending there belongs to — the nearest one across."""
    return min([b for b in p.beads if abs(b.y - y) < EPS], key=lambda b: abs(b.x - w.x))


def touched(p, b, above):
    """The wires the bead's dot reaches: its own lane, what it consumes and creates, and everything
    its reach spans — a bead reaches past a wire exactly where it is not `F(−)` of that wire."""
    # A dot ON the object wire is that wire's own point and the cut must account for it; a dot at the
    # midpoint of two arms sits on no column at all, and is no x the cut has to answer for.
    xs = {p.xo} if abs(p.col(b) - p.xo) < EPS else set()
    for w in p.wires:
        if (abs(w.ybot - b.y) < EPS or abs(w.ytop - b.y) < EPS) and owner(p, w, b.y) is b:
            xs.add(w.x)
    if b.reach is not None:
        xs |= {x for (x, _) in above if b.reach - EPS <= x <= b.x + EPS}
    # A lane DRAWN down to the dot is on the boundary as surely as one the reach spans: a lane's
    # `dips` and `dpanel`'s reach are the same declaration made two ways.
    if abs(p.col(b) - p.xo) < EPS:
        xs |= {w.x for w in p.wires if any(abs(d - b.y) < EPS for d in w.dips)}
    return xs


def factor(p, y, above, below):
    """The arrow one height denotes.  Beads at the SAME height are ONE factor (interchange), read
    right to left: the innermost is the rightmost, and each further bead wraps it through its wire."""
    bs = sorted([b for b in p.beads if abs(b.y - y) < EPS], key=lambda b: -b.x)
    carried = [b.x for b in bs]
    e = None
    for b in bs:
        lo = min(touched(p, b, above))
        ctx = [(x, l) for (x, l) in above
               if x < lo - EPS and not any(abs(x - c) < EPS for c in carried)]
        if e is None:
            e = parse(b.label)
        else:
            e = fill(next(l for (x, l) in above if abs(x - b.x) < EPS), b.label, e)
        for (_, l) in reversed(ctx):
            e = act(l, e)
    return tidy(e)


def sweep(p):
    """Top to bottom — downwards IS diagram order, so nothing is reversed at the end."""
    ys, bad = levels(p), []
    mids = [(ys[i] + ys[i + 1]) / 2 for i in range(len(ys) - 1)]
    cuts = [ports(p, True)] + [live(p, m) for m in mids] + [ports(p, False)]
    for w in p.wires:                      # every wire ends where a bead or a split boundary is
        for y, end in ((w.ytop, 'starts'), (w.ybot, 'ends')):
            if EPS < y < p.h - EPS and not any(abs(b.y - y) < EPS for b in p.beads) \
                    and not any(abs(y - s) < EPS for sp in p.splits for s in sp[:2]):
                bad.append(f"{p.id}: the {w.label} wire at x={w.x} {end} at y={y} with no bead"
                           f" and no split there — the cut changes with nothing to change it")
    facs, expr = [], []
    for y in sorted({b.y for b in p.beads}, reverse=True):
        i = next(k for k in range(len(ys)) if abs(ys[k] - y) < EPS)
        above, below = cuts[i], cuts[i + 1]
        for b in [b for b in p.beads if abs(b.y - y) < EPS]:
            # WHERE the dot sits.  A transformation between FUNCTORS names no object, so it may not
            # touch the object wire (IntroString p. 36); it sits at the midpoint of the arms it eats
            # — that is what makes a merge's two arms symmetric and drops its survivor vertically
            # from between them (p. 74).  A bead that does name the object stays on that wire.
            if not b.born:
                arms = [w.x for w in p.wires if abs(w.ybot - y) < EPS and owner(p, w, y) is b]
                legs = [w.x for w in p.wires if abs(w.ytop - y) < EPS and owner(p, w, y) is b]
                mid = arms or legs
                want = (min(mid) + max(mid)) / 2 if mid else p.xat(y)
                if abs(b.x - want) > EPS and abs(p.col(b) - p.xo) > EPS:
                    bad.append(f"{p.id}: bead {b.label} has its dot at x={b.x:g}, neither the"
                               f" midpoint x={want:g} of the wires it joins nor the object wire"
                               f" at x={p.xat(y):g}")
            if b.born and b.label.startswith(UNIT) and abs(p.col(b) - p.xo) < EPS:
                bad.append(f"{p.id}: the unit {b.label} sits on the object wire at x={p.xo} —"
                           f" a unit's source is Id, but the cut above it is"
                           f" ({', '.join(l for _, l in above)}); give it a lane of its own")
            miss = [x for x in touched(p, b, above) if not any(abs(x - a) < EPS for a, _ in above)
                    and not any(abs(x - a) < EPS for a, _ in below)]
            if miss:
                bad.append(f"{p.id}: the bead {b.label} at y={y} reaches x={miss} where no wire is"
                           f" live — the cut there is ({', '.join(l for _, l in above)})")
        e = factor(p, y, above, below)
        facs.append({"y": y, "beads": [b.label for b in p.beads if abs(b.y - y) < EPS],
                     "spelled": spell(e), "above": [l for _, l in above],
                     "below": [l for _, l in below]})
        expr.append(e)
    p.levels, p.cuts = ys, cuts
    # A panel with no bead at all is bare wires, and bare wires denote the identity.
    p.factors, p.expr = facs, expr[0] if len(expr) == 1 else \
        ('atom', UNIT) if not expr else ('comp', expr)
    return bad


# ---------------------------------------------------------------- the ink's own graph
# The sweep reads the LANE TABLE, so a panel can type perfectly and still be DRAWN in pieces: a
# strand stopping in mid-air, a bead covering a column nothing bends onto, a group of wires joined
# to nothing.  These ask the same questions of the ink the adapters build instead of of the table.
def arms(p, b):
    """The strands that MEET the dot — one that ends there, and a lane that bends down to it.
    Nothing else counts: an arm is ink the WIRE makes, not a line drawn beside it."""
    return [w for w in p.wires if w.pts
            and (any(abs(q[0] - b.ink[0]) < EPS and abs(q[1] - b.ink[1]) < EPS
                     for q in (w.pts[0], w.pts[-1]))
                 or any(abs(d - b.y) < EPS for d in w.dips))]


def pieces(p):
    """Reachability.  A component that reaches an edge is a wire the panel's own ports account for
    — p. 17's `F f` runs straight past, and §13.3.1's unit opens one that runs to the bottom.  A
    component that reaches no edge and joins nothing is a fragment, and a panel drawn in fragments
    is not one arrow however well it types."""
    up = {id(w): id(w) for w in p.wires}

    def find(k):
        while up[k] != k:
            up[k] = k = up[k]
        return k

    for b in p.beads:
        ws = arms(p, b) + [w for w in p.wires
              if abs(w.x - p.col(b)) < EPS and w.ybot < b.y < w.ytop]
        for w in ws[1:]:
            up[find(id(w))] = find(id(ws[0]))
    comps = {}
    for w in p.wires:
        comps.setdefault(find(id(w)), []).append(w)
    home = find(id(next(w for w in p.wires if abs(w.x - p.xo) < EPS and w.ytop > p.h - EPS)))
    return [f"{p.id}: the {', '.join(sorted(w.label or '?' for w in ws))} wire"
            f"{'s' * (len(ws) > 1)} reach neither an edge nor the object wire — one arrow is one"
            f" drawing"
            for k, ws in comps.items()
            if k != home and not any(w.ytop > p.h - EPS or w.ybot < EPS for w in ws)]


def connect(p):
    """Continuity, degree and reachability, of the ink.  `sweep` runs first: its cuts are what say
    what a bead's boundary IS, and these say whether the drawing has it."""
    bad = []
    for w in p.wires:
        for q, end in ((w.pts[0], 'starts'), (w.pts[-1], 'ends')):
            if EPS < q[1] < p.h - EPS \
                    and not any(abs(q[0] - b.ink[0]) < EPS and abs(q[1] - b.ink[1]) < EPS
                                for b in p.beads):
                bad.append(f"{p.id}: the {w.label} wire {end} in mid-air at ({q[0]:g}, {q[1]:g})"
                           f" — a strand ends on a bead or on an edge, nowhere else")
    for b in p.beads:
        i = next((k for k in range(len(p.levels)) if abs(p.levels[k] - b.y) < EPS), None)
        if i is None:
            continue
        want = touched(p, b, p.cuts[i])
        # A bead ON the object wire is DRAWN at `xat(y)` but keyed on the object column, the one the
        # cut names it by; every other bead is its own x.
        # `touched`'s own rule, from the other side: a dot at the arms' midpoint sits on no column
        # and is no x the cut answers for; only a dot on the object wire brings a column of its own.
        got = ({p.xo} if abs(p.col(b) - p.xo) < EPS else set()) | {w.x for w in arms(p, b)}
        for x in sorted(want - got, reverse=True):
            bad.append(f"{p.id}: the bead {b.label} at y={b.y:g} covers x={x:g} with no ink at all"
                       f" — an arm is a wire bent into the dot (IntroString p. 40)")
        for x in sorted(got - want, reverse=True):
            bad.append(f"{p.id}: the bead {b.label} at y={b.y:g} is met at x={x:g} by a wire its"
                       f" type neither consumes, creates nor spans — a strand touching the dot is"
                       f" an arm, and this one is not one")
    return bad + pieces(p)


# ---------------------------------------------------------------- crossings
# A CROSSING IS A SYMMETRY: two wires that cross have exchanged, so a picture that crosses claims a
# permutation the formula does not.  Two checks, and they answer different questions — `inversions`
# says a crossing is WRONG (the cut orders it the other way), `crossings` says one is THERE (the ink
# meets).  A wire that leaves its column and comes back satisfies both cuts and is seen only by the
# second; a lane the sweep re-routes where no ink model exists is seen only by the first.
def inversions(p):
    """Order against the cut.  A wire that ends in another column has moved across every column
    between the two, and a WIRE live on both sides of that height is passed — unless it dips onto
    that very bead, where the two are drawn to meet.  Live is asked of the wire INSTANCE, never of
    its column: two instances may share one column, one dying on the bead and one born on it, and
    the column is then live above and below while nothing at all is passed."""
    out = []
    for w in p.wires:
        if not w.pts:
            continue
        for (px, _), y, end in ((w.pts[0], w.ytop, 'is born'), (w.pts[-1], w.ybot, 'dies')):
            if abs(px - w.x) < EPS:
                continue
            lo, hi = min(px, w.x), max(px, w.x)
            # A unit lane BORN at exactly `y` is not live above it, so `> y + EPS` lets it through;
            # the ink check sees that one.
            for v in p.wires:
                if lo + EPS < v.x < hi - EPS and v.ytop > y + EPS and v.ybot < y - EPS \
                        and not any(abs(d - y) < EPS for d in v.dips):
                    out.append(f"{p.id}: {w.label}@{w.x:g} {end} at x={px:g}, y={y:g}, passing"
                               f" {v.label}@{v.x:g}, which is live above and below — the cut orders"
                               f" them {w.label} then {v.label}, the ink exchanges them")
            # A widening is a column of its own — `live` reads `outer` there — so it is passed like
            # a wire.  The ARC is the column, not the `splits` row: a widening states one row per bead
            # spanned and draws one arc, and a row boundary is inside it.  Its own two ends are
            # back on the object column, where the two are drawn to meet, hence the strict bounds.
            for (outer, q) in p.strands:
                sx, yt, yb = q[1][0], q[0][1], q[-1][1]
                if lo + EPS < sx < hi - EPS and yb + EPS < y < yt - EPS:
                    out.append(f"{p.id}: {w.label}@{w.x:g} {end} at x={px:g}, y={y:g}, passing the"
                               f" {outer} widening at x={sx:g}, live above and below — the cut"
                               f" orders them {w.label} then {outer}, the ink exchanges them")
    return out


def crossings(p):
    """Every wire–wire meeting in the ink, in the curves the note's own helpers draw.  A junction is
    not a crossing: a hit at a bead, or at either strand's own end, is where the two are DRAWN to
    meet.  A bead's reach is not ink of its own — it is the arms the crossed wires make."""
    ss = [(f"{w.label or '?'}@{w.x:g}", poly(w.pts, k=w.k, hs=w.hs)) for w in p.wires if w.pts] \
        + [(f"{l or '?'}@{q[1][0]:g}", poly(q)) for (l, q) in p.strands]
    js = [b.ink for b in p.beads] + [q[i] for (_, q) in ss for i in (0, -1)]
    hits = []
    for i, (la, qa) in enumerate(ss):
        for (lb, qb) in ss[i + 1:]:
            for a, b in zip(qa, qa[1:]):
                for c, e in zip(qb, qb[1:]):
                    z = meet(a, b, c, e)
                    if z is None or any(abs(z[0] - jx) < NEAR and abs(z[1] - jy) < NEAR
                                        for (jx, jy) in js):
                        continue
                    # One crossing is found in several sample segments; keep the first of a cluster.
                    if not any(k == (la, lb) and abs(z[0] - u) < 0.2 and abs(z[1] - v) < 0.2
                               for (k, u, v) in hits):
                        hits.append(((la, lb), z[0], z[1]))
    return [f"{p.id}: {la} crosses {lb} at (x={x:.2f}, y={y:.2f})" for ((la, lb), x, y) in hits]


# A drawn name is 9pt mono, so one character is 0.2039cm wide and a line 0.2573cm tall.  `dpan`'s
# `length: 0.8cm` turns those into the panel's own units; `P`'s `s` scales the drawn canvas whole,
# ink and coordinates together, so it cancels here.
LCW, LLH, LDX = 0.2039 / 0.8, 0.2573 / 0.8, 0.12


def lbox(x, y, nm):
    """`dpanel`'s box for a lane's own name: anchored east at `x - LDX`, centred on the bead row."""
    return (x - LDX - LCW * len(nm or '?'), y - LLH / 2, x - LDX, y + LLH / 2)


def labels(p):
    """A wire whose name is written nowhere else on the page — no port list, no other lane of the
    same wire — has it written beside the lane it is born on (`dnamed`, whose answer the panel
    emits).  That name is ink: a strand through its box is a collision, not a warning."""
    out = []
    ss = [(w.label or '?', poly(w.pts, k=w.k, hs=w.hs)) for w in p.wires if w.pts] \
        + [(l or '?', poly(q)) for (l, q) in p.strands]
    for (nm, x, y, bx) in p.labels:
        es = [((bx[0], bx[1]), (bx[2], bx[1])), ((bx[2], bx[1]), (bx[2], bx[3])),
              ((bx[2], bx[3]), (bx[0], bx[3])), ((bx[0], bx[3]), (bx[0], bx[1]))]
        for (l, q) in ss:
            if any(bx[0] <= a[0] <= bx[2] and bx[1] <= a[1] <= bx[3]
                   or any(meet(a, b, u, v) for (u, v) in es) for a, b in zip(q, q[1:])):
                out.append(f"{p.id}: the name {nm}@{x:g}, drawn west of the wire on the y={y:g}"
                           f" row, is struck through by {l}")
                break
    return out


def natframe(p):
    """A bead DECLARED natural is the panel's fixed point.  Naturality is exactly the freedom to
    slide an ordinary arrow past it (IntroString (1.15)), so the two sides of an equation must show
    that bead at ONE height and the arrow as the thing that moved; drawing both beads in the same
    two slots makes the reader hunt for what changed.  `layout` does it by shifting every row up by
    that bead's index, which lands it at one height above the frame's FLOOR whatever it stands in.
    What the frame then owes is only its own content: IT ENDS ONE ROW ABOVE THE TOPMOST BEAD.  The
    old rule made the bead the canvas horizon instead, which costs an empty row above for every bead
    below — half the box in §13.5.3a, whose first bead is the natural one.  Two panels either side of
    a step sign still need ONE box, and that is what a `frame:` in the cert says and `--pairs`
    checks; a panel that declares one is exempt here.  Declared, not guessed — a merge is off the
    object wire too and is not what this is about."""
    # The panel's OWN table, not the global one: a `sigs:` override that does not instantiate the
    # global row is a different arrow wearing the same letter (§11.4.2a's `S : B⟶C` against §13.3's
    # party `S`), and `typed` is where that is already decided.
    nat = {k for k, v in typed(sigs(), p.cert.get("sigs"))["sigs"].items()
           if isinstance(v, dict) and v.get("nat") not in (None, "no")}
    # The TOPMOST one: a panel may carry several, and they cannot all be the fixed point.  Anchoring
    # the first the composite meets is what makes the two sides of an equation agree, because a
    # reordering that moves an ordinary arrow past it leaves that bead first on both sides.
    bs = [b for b in p.beads if b.label in nat]
    # `layout`'s rule, so only what `layout` laid out: a panel that declares its own frame is one
    # half of a pair sharing a box (`--pairs` checks that), and a panel whose beads stand OFF the
    # row grid — §13.4.3c's `party-hm`, on its own `HMY` heights — states its own geometry.
    if not bs or p.helper != "dpanel" or p.cert.get("frame") is not None \
       or p.cert.get("top") is not None \
       or any(abs(b.y / (DY / 2) - round(b.y / (DY / 2))) > EPS for b in p.beads):
        return []
    # a unit heads its lane half a row below the row it stands on, so it counts back that half
    top = max(b.y + (DY / 2 if b.born else 0) for b in p.beads)
    return [] if abs(p.h - (top + DY)) <= EPS else \
        [f"{p.id}: the frame is {p.h:g} tall over a topmost bead at y={top:g}"
         f" — a panel's frame ends one row ({DY:g}) above it"]


def objhue(p):
    """A wire that changes OBJECT changes hue there.  One line running from an `A` port to a `B`
    port in a single colour says the object never changed; the bead that renames it is the seam, and
    the two bands are what make the rename visible without reading the ports."""
    c = p.rec.get("ocol")
    return [] if not c or p.olabel == p.oblabel or c[0] != c[1] else \
        [f"{p.id}: the object wire runs from {p.olabel} to {p.oblabel} in one colour {c[0]}"
         f" — an object wire changes hue where it changes object"]


def indexed(p):
    """A bead's index is the object wire UNDER it, and the FOLD is no exception (user, 2026-09-05,
    reversing the rule that the banana must carry its carrier): the panel draws `⦇α⦈` with `A` on the
    wire below, which says `⦇αᴀ⦈` and says it once.  A carrier written in the label as well spells one
    object twice, and the label is then free to drift from the wire the sweep actually reads."""
    out = []
    for b in p.beads:
        lab, idx = deindex(b.label or "")
        for k, v in idx.items():
            out.append(f"{p.id}: the fold {b.label} writes its carrier {v}, which is already the"
                       f" object wire under the bead — draw it {k}")
    return out


# ---------------------------------------------------------------- the declared tables
SIGS = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "diag",
                    "hm-sigs.json")
_TBL = None


def sigs():
    """`diag/hm-sigs.json` — what each bead's label is an arrow BETWEEN, keyed by the label's head."""
    global _TBL
    if _TBL is None:
        _TBL = json.load(open(SIGS, encoding="utf-8"))
    return _TBL


def instance(row, d):
    """Is the panel's signature `d` the ROW's arrow, written at this display's objects?
    `cons : Op×[Op]⟶[Op]` instantiates the row's `x×[x]⟶[x]` and is the same arrow; an `X : A⟶B`
    against a row that types some other `X` is not, and must not inherit its proof."""
    if not (row.get("src") and row.get("tgt")):
        return False
    try:
        ps, pt, es, et = (parse(row["src"]), parse(row["tgt"]), parse(d["src"]), parse(d["tgt"]))
        sub = {}
        bind(norm(ps), norm(es), sub)
        bind(norm(pt), norm(et), sub)
        return all(spell(inst(norm(p), sub)) == spell(norm(e))
                   for p, e in ((ps, es), (pt, et)))
    except Exception:
        return False


# What a `--sigs` word's `!<tag>` claims, in `hm-sigs.json`'s own `nat` spelling.
NATWORD = {"nat": "strict", "lax": "lax"}


def sigfields(v):
    """One `--sigs` value read as a `hm-sigs.json` ROW: the signature, then the `!`-tagged claims a
    signature cannot make.  `!nat`/`!lax` is the naturality the dot draws, `!lean` the declaration
    the row's type was read off, and `=<marker>` after either — several separated by `,` — names what
    proves it.  The field names are the table's own, so `hm-check --verify-sigs` audits a row a panel
    types itself exactly as it audits one the table states."""
    sig, _, rest = v.partition("!")
    d = dict(zip(("src", "tgt"), sig.split("⟶")))
    for f in rest.split("!") if rest else ():
        tag, _, mark = f.partition("=")
        # `lean:` is `cite-check`'s own prefix, written where the marker stands in the note; the row
        # keeps the bare `Mod.decl@key` the table keeps.
        ms = [m.removeprefix("lean:") for m in mark.split(",") if m]
        if tag == "lean" and len(ms) == 1:
            d["lean"] = ms[0]
        elif tag in NATWORD:
            d["nat"] = NATWORD[tag]
            if ms:
                d["nat-lean"] = ms
        else:
            raise Unhandled(f'`!{tag}={mark}` names no claim — write `!nat`/`!lax` for the'
                            f' naturality the dot draws, or `!lean=<marker>` for the declaration the'
                            f' row was read off')
    return d


def typed(table, own):
    """The table with a panel's own `sigs:` laid over it: `R: "F(A)⟶A"` types an abstract letter of
    one display, which no `hm-sigs.json` row could — there is no declaration to cite for it."""
    if not own:
        return table
    # `!<tag>` on the end is `hm-sigs.json`'s `"nat"`, which a signature cannot say: `α : F(x)⟶x`
    # and `τ : C(B(x))⟶B(C(x))` have the same shape and only one is natural.  `=<marker>` after it
    # names the theorem that says so, and `cite-check` verifies it where it stands, so the claim
    # stops being the author's word — the whole point of `LaxNatural` being a `Prop`.  `!lax` is the
    # weaker claim `hm-sigs.json` spells `"nat": "lax"` (B&dM 5.13, `G(R)φ⊑φF(R)` with equality
    # failing): still off the object wire, since it is a family and not an arrow at one object, but
    # drawn with a hollow dot.  Without it a one-letter `φ` falls through to the object wire, which
    # says it is an arrow of the base category — the one thing a LaT is not.
    def one(k, v):
        try:
            d = sigfields(v)
        except Unhandled as x:
            raise Unhandled(f"--sigs {k}: {x}") from None
        # A panel naming the global arrow — restating its signature, or INSTANTIATING it at this
        # display's objects (`cons : Op×[Op]⟶[Op]` for the row's `x×[x]⟶[x]`) — is that same arrow,
        # so what Lean proved of it still holds and the mark follows the proof, not the shape the
        # panel happens to write.  A signature that does not instantiate the row is a different
        # arrow wearing the same letter, and no proof of the name travels with it.
        old = table["sigs"].get(k, {})
        keep = {x: old[x] for x in ("lean", "nat", "nat-lean", "not-lax") if x in old} \
            if instance(old, d) else {}
        return {**keep, **d}
    return {**table, "sigs": {**table["sigs"], **{k: one(k, v) for k, v in own.items()}}}


def brname(e):
    """The name a branch goes by: the arrow its component ENDS in, which is what carries the
    summand — `(p×list(p))cons` is the `cons` branch and `(X×X)bin` the `bin` one."""
    return spell(e[1][-1] if e[0] == 'comp' else e)


def bind(pat, e, sub):
    """A signature's variables tied to a live object, so `cons : x×[x]⟶[x]` yields `A×−` where the
    display writes `F([A])`."""
    if pat[0] == 'atom' and pat[1] in VARS:
        sub[pat[1]] = e
    elif pat[0] == e[0]:
        if pat[0] in ('comp', 'prod', 'hc'):
            [bind(a, b, sub) for a, b in zip(pat[1], e[1])]
        elif pat[0] == 'conv':
            bind(pat[1], e[1], sub)
        elif pat[0] == 'app' and pat[1] == e[1]:
            bind(pat[2], e[2], sub)


def inst(e, sub):
    return sub.get(e[1], e) if e[0] == 'atom' else rec(e, lambda x: inst(x, sub))


def summand(br, table, arg=None):
    """The summand `F(X)` collapses to on the branch `b : S⟶A`, DERIVED from `b`'s row: `S` with
    every occurrence of the carrier `A` replaced by the hole.  `cons : A×[A]⟶[A]` gives `A×−`, and a
    branch with no row at all is a CONSTANT summand — `nil` and `zero` name none, which is
    hm-sigs.json's own reading of a label that touches the object wire alone."""
    row = ((table or {}).get("sigs") or {}).get(br[:br.find('(')] if br.find('(') > 0 else br)
    if not row:
        return TERM
    src, tgt, sub, hole = parse(row["src"]), parse(row["tgt"]), {}, ('atom', '−')
    if arg is not None:
        bind(norm(tgt), arg, sub)
    cut = subst(src, tgt, hole)            # the carrier as the DISPLAY writes it, brackets and all,
    if cut == src:                         # because `norm` flattens `Op×([C]×[C])` and hides it
        cut = subst(norm(src), norm(tgt), hole)
    return spell(inst(norm(cut), sub))


def take_branch(e, br, obj, table=None):
    """A display states the whole case split and the panel draws ONE branch: `[a,b]` keeps the
    component naming it, `x∪y` the operand naming it, `F` becomes that branch's summand.  A second
    bracket in the same formula names a DIFFERENT arrow — `[wrap,cat]°` beside `[tip,(X×X)bin]` —
    so it is matched by summand, which is the class a branch really is."""
    d = dun(e)
    if d is not None:                      # a choice inside a division: `([wrap,cat]°)%∋` is one
        t = take_branch(d, br, obj, table)             # token until the numerator is reparsed, and
        return t if t != d else e                      # left one bead where it holds no choice
    e = rec(e, lambda x: take_branch(x, br, obj, table))
    if e[0] == 'app' and e[1] == 'F':
        require_hole_last(e)                         # `act` puts `e[2]` in the LAST factor either way
        return act(summand(br, table, norm(e[2])), e[2], obj=obj)
    if e[0] == 'case':                     # `[zero,⊸ zero ∪ plus]`: the component that IS the branch
        s = summand(br, table)
        parts = [x for x in e[1] if spell(x) == br] or [x for x in e[1] if br in spell(x)] \
            or [x for x in e[1] if s != TERM and summand(brname(x), table) == s]
        if len(parts) == 1:
            ops = [x for x in parts[0][1] if br in spell(x)] if parts[0][0] == 'union' else []
            return take_branch(ops[0] if len(ops) == 1 else parts[0], br, obj, table)
    return e


def selfcheck():
    """The two laws the context tail exists to enforce, run by every invocation because two parses
    cost nothing and there is no other harness."""
    assert norm(parse("F(∋,𝟙)F(𝟙,∋)")) != norm(parse("F(∋∋)")), \
        "fuse merged F(∋,𝟙)F(𝟙,∋) into F(∋∋): acting in the first slot and in the last is not acting twice in one"
    try:
        take_branch(parse("F(p,𝟙)"), "cons", False)
    except Unhandled as x:
        assert "slot 1 of 2" in str(x), f"F(p,𝟙) is refused without naming the slot: {x}"
    else:
        raise AssertionError("take_branch read F(p,𝟙) as the last slot and made it 𝟙×p")


def unfold(e, aliases):
    used = []
    for a in aliases:
        lhs, _, rhs = a.partition('=')
        lhs, rhs = parse(lhs.strip()), parse(rhs.strip())
        e2 = subst(e, lhs, rhs)
        if e2 != e:
            used.append(a.strip())
        e = e2
    return e, used


def subst(e, lhs, rhs):
    if e == lhs:
        return rhs
    return rec(e, lambda x: subst(x, lhs, rhs))


def read(s, cert, obj):
    """The cert's OWN expression — aliases unfolded, the panel's `defn:` abbreviations expanded and
    the branch taken, but not normalised, so a mismatch message spells the formula the file states
    and not `norm`'s picture quotient."""
    e, used = unfold(unabbrev(parse(s, obj), defns(cert.get('defn'))), cert.get('alias') or ())
    if cert.get('branch'):
        e = take_branch(e, cert['branch'], obj, typed(sigs(), cert.get('sigs')))
    return e, used


def certify(p):
    """`cert:` against the sweep.  The tool applies a declared law; whether it is TRUE stays the
    author's certificate — the same discipline as `scripts/cite-check`'s markers."""
    c, bad, note = p.cert, [], []
    for key, top in (("src", True), ("tgt", False)):
        if not c.get(key):
            continue
        said, _ = read(c[key], c, True)
        want, got = quot(said), fold_cut(p, ports(p, top))
        if want != quot(got):
            bad.append(f"{p.id}: the {'top' if top else 'bottom'} cut is {spell(got)}, not the"
                       f" stated {key} {c[key]}, which reads {spell(said)} — declare the branch"
                       f" the panel draws, or fix the ports")
    if c.get('expect'):
        said, used = read(c['expect'], c, False)
        want, got = quot(said), quot(p.expr)
        if want == got:
            note.append(f"{p.id}: AGREE{' modulo ' + '; '.join(used) if used else ''}")
        else:
            bad.append(f"{p.id}: the panel denotes {spell(tidy(p.expr))} but states"
                       f" {c['expect']}, which reads {spell(said)}" + first_diff(got, want))
    return bad, note


def fold_cut(p, cut):
    """A cut spelled as one 1-cell: leftmost wire outermost, object wire innermost."""
    e = ('atom', cut[-1][1])
    for (_, l) in reversed(cut[:-1]):
        e = act(l, e, obj=True)
    return e


def first_diff(got, want):
    g = got[1] if got[0] == 'comp' else [got]
    w = want[1] if want[0] == 'comp' else [want]
    for i, (a, b) in enumerate(zip(g, w)):
        if a != b:
            return f"; they first differ at factor {i + 1}: {spell(a)} against {spell(b)}"
    return "" if len(g) == len(w) else f"; the panel has {len(g)} factors, the formula {len(w)}"


def polyrow(p, label):
    """Is this bead's row an arrow AT ANY OBJECT — a free object variable in either port?  The
    panel's own `sigs:` first, as everywhere: a row it overrides is a different arrow."""
    row = ((typed(sigs(), p.cert.get("sigs")) or {}).get("sigs") or {}).get(
        label[:label.find('(')] if label.find('(') > 0 else label)
    if not isinstance(row, dict) or not row.get("src"):
        return False
    return bool(varsof(parse(row["src"])) | varsof(parse(row["tgt"])))


def crosscheck(ps):
    """One bead label, one signature within a display — the cheap catch for a bead moved onto the
    wrong wire.  Across displays the same name is a different arrow, so the scope is the display.

    A bead whose ROW is polymorphic is exempt: `est(R) : x[k]⟶x` collapses whichever index it is
    given and `⦇gen⦈ : x[m][n]⟶x[n][p][m]` stands at `[m]` on one side of a fold equation and at
    `[m+1]` on the other, so the drawn wires are what fixes the instance and not the name.  What
    checks THOSE is the respelling: each panel is read back and compared to its own formula."""
    sigs, wlab, bad = {}, {}, []
    for p in ps:
        for w in p.wires:
            wlab.setdefault(w.label, p.id)
        for b in p.beads:
            if polyrow(p, b.label):
                continue
            cons = tuple(sorted(w.label for w in p.wires if abs(w.ybot - b.y) < EPS
                                and owner(p, w, b.y) is b))
            made = tuple(sorted(w.label for w in p.wires if abs(w.ytop - b.y) < EPS
                                and owner(p, w, b.y) is b))
            key = (p.id.rsplit('.', 1)[0], b.label)
            sigs.setdefault(key, {})[(cons, made, abs(p.col(b) - p.xo) < EPS)] = p.id
    for (disp, label), seen in sigs.items():
        if len(seen) > 1:
            bad.append(f"{disp}: the bead {label} has {len(seen)} signatures — "
                       + "; ".join(f"{pid} {sigline(s)}" for s, pid in seen.items()))
    for label, pid in wlab.items():
        hit = [p.id for p in ps for b in p.beads if b.label == label]
        if hit:
            bad.append(f"{pid}: {label} labels a WIRE here and a BEAD in {hit[0]} — a wire is a"
                       f" functor, and may never carry an arrow's name")
    return bad


def sigline(s):
    cons, made, on = s
    return (("on the object wire" if on else "off the object wire")
            + f", consumes ({', '.join(cons) or '—'}), creates ({', '.join(made) or '—'})")


# ---------------------------------------------------------------- driver
def lit_hashes(path):
    """sha256 of every `dpanel(`/`cpanel(` call in the source, whitespace included.
    `typst query` compiles the whole file regardless of which panel changed, so this is what a
    cache CAN key on cheaply — the set is compared whole, not panel by panel."""
    text = open(path, encoding="utf-8").read()
    return sorted(hashlib.sha256(text[m.start():matching(text, m.end() - 1) + 1].encode()).hexdigest()
                  for m in re.finditer(r'\b(?:dpanel|cpanel)\(', text))


# ---------------------------------------------------------------- per-section acquisition
# The whole 13 s of a `typst query` on the note was the INK: 646 cetz canvases drawn into a document
# that is then thrown away, while every panel computes the lists it emits as `#metadata` outside the
# canvas.  `--input nodraw=1` (`diag/cetz-nodraw.typ`) turns each canvas into an empty box and the
# same records come back byte-identical, in 1.4 s.  What is left is linear in the note's LINES —
# 0.24 s of imports plus 0.12 ms a line — so the last factor of five is to hand typst one section.
GATE = ".lake/build/note-gate.json"
# A dotfile so no `diag/*.typ` glob picks the scratch slice up, and per-process because `make` runs
# `spell` and `scan-strict` in parallel: one fixed path had each removing the other's file mid-query.
SLICE = "diag/.gate-slice-%d.typ" % os.getpid()
MAXSEC = 4                         # more sections than this changed: the whole note is cheaper
HEAD = re.compile(r'(={1,6}) ')
DECL = re.compile(r'#(?:let|show|set|import)\b')
TOP = re.compile(r'[#=]|//')
NAME = re.compile(r'#let\s+([\w-]+)')


def sha(s):
    return hashlib.sha256(s.encode()).hexdigest()


def parts(path):
    """The note cut into (prelude, sections) — an EXACT line partition, asserted below.

    A heading opens a section and its numbers ARE the ids of the panels it draws: `13.3.4` draws
    `13.3.4a.1`.  A top-level `#let`/`#show`/`#set`/`#import` (column 0) runs to the line before the
    next column-0 `#`, `=` or `//`, and is held apart from the body: a slice needs EVERY declaration
    in the note — the section it draws may use any of them — but only ONE section's displays."""
    lines = open(path, encoding="utf-8").read().splitlines(keepends=True)
    pre, secs, nums, i = [], [], [], 0
    while i < len(lines):
        head = HEAD.match(lines[i])
        if head:
            d = len(head.group(1))
            nums = (nums + [0] * d)[:d]
            nums[d - 1] += 1
            secs.append({"num": ".".join(map(str, nums)), "text": [], "body": [], "decls": []})
        j = i + 1
        if DECL.match(lines[i]) and not head:
            while j < len(lines) and not TOP.match(lines[j]):
                j += 1
        blk = "".join(lines[i:j])
        if not secs:
            pre.append(blk)
        else:
            secs[-1]["text"].append(blk)
            (secs[-1]["decls"] if DECL.match(lines[i]) else secs[-1]["body"]).append(blk)
        i = j
    assert "".join(pre) + "".join(b for s in secs for b in s["text"]) \
        == open(path, encoding="utf-8").read(), f"scanline: {path} did not partition"
    return pre, secs


def sliced(pre, secs, sel):
    """The prelude, every declaration in the note, and the selected (consecutive) sections' bodies —
    with the heading counter seeded from the FIRST selected section, so the panel ids come out exactly
    as they do in the whole note (the display counter and the panel counter reset at every heading and
    display, so those need nothing). `#show ref: it => []`: the sections a slice drops take their
    labels with them.

    Only the declarations BEFORE the first selected section, in source order, and the selected
    sections themselves VERBATIM, in source order: one name is bound twice in the note — `mss-pic` at
    :5011 and :5428, both inside §13.3.4 — and every use sees the binding that precedes IT, so hoisting
    a section's own declarations over its own body would let the second definition answer for the
    first's call sites."""
    n = [int(x) for x in sel[0]["num"].split(".")]
    return ("".join(pre) + "#show ref: it => []\n"
            + "".join(b for s in secs[:secs.index(sel[0])] for b in s["decls"])
            + "#counter(heading).update((%s,))\n" % ", ".join(map(str, n[:-1] + [n[-1] - 1]))
            + "".join(b for s in sel for b in s["text"]))


def query(path):
    out = subprocess.run(["typst", "query", "--input", "nodraw=1", path, "metadata",
                          "--field", "value"], capture_output=True, text=True)
    if out.returncode:
        sys.exit(f"scanline: typst query {path}: {out.stderr.strip()}")
    return [v for v in json.loads(out.stdout) if isinstance(v, dict) and v.get("kind") == "scanline"]


def owns(num):
    return re.compile(re.escape(num) + r'[a-z]+\.\d+').fullmatch


def panels(path, frm, full=False):
    """The note's panels — re-querying only the sections whose SOURCE changed, and handing back what
    the last full run stored for the rest, so the checks downstream still see EVERY panel in the note
    (`crosscheck`'s wire-against-bead pass is note-wide, and a partial list would weaken it).

    Falls back to the whole note whenever the incremental answer could differ from it: a changed
    prelude or imported file, a renumbered section, a changed declaration another section names,
    more than `MAXSEC` sections at once, or a slice whose panel ids are not the section's own."""
    if frm:
        return [v for v in json.load(open(frm, encoding="utf-8"))
                if isinstance(v, dict) and v.get("kind") == "scanline"]
    pre, secs = parts(path)
    imp = sha("".join(open(p, encoding="utf-8").read() for p in sorted(glob.glob("diag/*.typ"))
                      if os.path.abspath(p) != os.path.abspath(path)))
    key = {"path": path, "pre": sha("".join(pre)), "imports": imp,
           "order": [s["num"] for s in secs]}
    c = json.load(open(GATE, encoding="utf-8")) if os.path.exists(GATE) else {}
    old = c.get("sections", {})
    for s in secs:
        s["sha"] = sha("".join(s["text"]))
        # name → the block that binds it; `#show`/`#set`/`#import` bind nothing, so they are keyed
        # by position and any change in one is a `@`, which no section can be searched for.
        s["dmap"] = {(NAME.match(b).group(1) if NAME.match(b) else f"@{i}"): sha(b)
                     for i, b in enumerate(s["decls"])}
    stale = [s for s in secs if old.get(s["num"], {}).get("sha") != s["sha"]]
    # A DECLARATION that changed, and that another section names, cannot be re-read section by
    # section: that section's cached records were drawn with the old one.  A `#show`/`#set`/`#import`
    # binds no name to look for, so a change in one is only ever answered by the whole note.
    changed = {k for s in stale for o in (old.get(s["num"], {}).get("decls", {}),)
               for k in set(o) | set(s["dmap"]) if o.get(k) != s["dmap"].get(k)}
    rest = "".join(b for s in secs if s not in stale for b in s["text"])
    ok = (not full and all(c.get(k) == v for k, v in key.items()) and secs
          and len(stale) <= MAXSEC and not any(k.startswith("@") or k in rest for k in changed))
    if ok:
        for s in stale:
            open(SLICE, "w", encoding="utf-8").write(sliced(pre, secs, [s]))
            try:
                s["recs"] = query(SLICE)
            finally:
                os.remove(SLICE)
            if not all(owns(s["num"])(r["id"]) for r in s["recs"]):
                ok = False                        # the slice drew something this section does not own
                break
    if ok:
        for s in secs:
            if "recs" not in s:
                s["recs"] = old[s["num"]]["recs"]
        recs = [r for s in secs for r in s["recs"]]
        print(f"scanline: {len(stale)} section{'s' * (len(stale) != 1)} re-read"
              f" ({', '.join(s['num'] for s in stale) or 'none'}), {len(secs) - len(stale)} cached")
    else:
        recs = query(path)
        for s in secs:
            s["recs"] = [r for r in recs if owns(s["num"])(r["id"])]
    if secs:                                      # a file with no headings has nothing to cache
        os.makedirs(os.path.dirname(GATE), exist_ok=True)
        json.dump(dict(key, sections={s["num"]: {"sha": s["sha"], "decls": s["dmap"],
                                                 "recs": s["recs"]} for s in secs}),
                  open(GATE, "w", encoding="utf-8"), ensure_ascii=False)
    return recs


def respell(recs):
    """`spell(parse(x)) == x` over every string a `cert:` states.  The grammar may grow new nodes
    only while the note's own spelling comes back — a bracket stays ONE bead to the panel."""
    xs = [(r['id'], x) for r in recs for c in (r.get('cert') or {},)
          for x in [c[k] for k in ('expect', 'src', 'tgt') if c.get(k)]
          + [h.strip() for a in c.get('alias') or () for h in a.split('=')]]
    bad = []
    for i, x in xs:
        got = spell(parse(x))
        if got != squeeze(x):
            bad.append(f"{i}: {x} spells back as {got}")
    return len(xs), bad


def locate(path, p):
    """Best effort: the one source line carrying a label unique to this panel."""
    try:
        lines = open(path, encoding="utf-8").read().splitlines()
    except OSError:
        return path
    for b in p.beads:
        hits = [i for i, t in enumerate(lines, 1) if f"`{b.label}`" in t]
        if len(hits) == 1:
            return f"{path}:{hits[0]}"
    return path


def main(argv):
    help_if(argv, __doc__, _HELP_BODY)
    path = next((a for a in argv if not a.startswith("-")), "diag/allegory-axioms.typ")
    view = opt(argv, "--view")
    if view:
        pre, secs = parts(path)
        sel = [s for s in secs if s["num"] == view or s["num"].startswith(view + ".")]
        if not sel:
            sys.exit(f"scanline: no section {view} in {path}")
        out = "diag/.view-slice.typ"
        open(out, "w", encoding="utf-8").write(sliced(pre, secs, sel))
        t0 = time.time()
        r = subprocess.run(["typst", "compile", out, "diag/.view.pdf"], capture_output=True, text=True)
        if r.returncode:
            sys.exit(r.stderr.strip())
        elapsed = time.time() - t0
        info = subprocess.run(["pdfinfo", "diag/.view.pdf"], capture_output=True, text=True)
        pages = next((l.split()[-1] for l in info.stdout.splitlines() if l.startswith("Pages:")), "?")
        print(f"scanline: {view} → diag/.view.pdf  {pages} pages  {elapsed:.2f}s")
        return
    only = opt(argv, "--panel")
    frm = opt(argv, "--from")
    keep = not any(a in argv for a in ("--spell", "--strict")) and not only and not frm
    hs = lit_hashes(path) if keep else None
    if keep and "--full" not in argv:
        c = json.load(open(CACHE, encoding="utf-8")) if os.path.exists(CACHE) else {}
        if c.get("path") == path and c.get("hashes") == hs and c.get("pass"):
            print(f"scanline: {len(hs)} panel literals unchanged since last pass — skipped")
            return
    recs = panels(path, frm, "--full" in argv)
    if "--spell" in argv:
        n, bad = respell(recs)
        print(f"scanline: {n} certified strings respelled, {len(bad)} differ")
        if bad:
            print(*bad, sep="\n", file=sys.stderr)
            sys.exit(f"scanline: {len(bad)} string{'s' * (len(bad) > 1)} the grammar cannot"
                     " write back")
        return
    ps, bad, note, unhandled, drawn = [], [], [], [], []
    warn = {"cut order": [], "ink": []}
    for r in recs:
        if only and r["id"] != only:
            continue
        try:
            p = Panel(r)
            bad += p.kdrift + sweep(p) + labels(p) + natframe(p) + objhue(p) + indexed(p)
            b, n = certify(p)
            bad += b; note += n
            drawn += connect(p)
            warn["cut order"] += inversions(p); warn["ink"] += crossings(p)
            ps.append(p)
        except (Unhandled, ValueError) as e:
            unhandled.append(f"{r['id']} ({r['helper']}): {e}")
    bad += crosscheck(ps)
    # `make p` runs `--strict`, where a crossing IS a build failure.  Without it they stay warnings,
    # so one panel can be swept while another is mid-redraw and naming every crossing is the answer.
    # The note is drawn with bars today, so a broken drawing is a WARNING while stage 4 redraws the
    # panels one at a time; `--strict` is what a redrawn one is held to.
    if "--strict" in argv:
        bad += warn["cut order"] + warn["ink"] + drawn
        warn = {k: [] for k in warn}; drawn = []
    if opt(argv, "--json"):
        json.dump([{"id": p.id, "source": [l for _, l in p.cuts[0]],
                    "target": [l for _, l in p.cuts[-1]], "factors": p.factors,
                    "expr": spell(tidy(p.expr))} for p in ps],
                  open(opt(argv, "--json"), "w", encoding="utf-8"), ensure_ascii=False, indent=1)
    if only or "--list" in argv:
        for p in ps:
            print(f"{p.id:<12} {spell(tidy(p.expr))}")
            if only:
                for f in p.factors:
                    print(f"  y={f['y']:<5} ({', '.join(f['above'])}) --{'+'.join(f['beads'])}-->"
                          f" ({', '.join(f['below'])})   {f['spelled']}")
    print(*note, sep="\n")
    cert = sum(1 for p in ps if p.cert.get("expect") or p.cert.get("src"))
    print(f"scanline: {len(recs)} panels, {len(ps)} swept, {cert} certified,"
          f" {len(unhandled)} unhandled, {len(bad)} failures")
    if keep:
        json.dump({"path": path, "hashes": hs, "pass": not bad and not unhandled},
                  open(CACHE, "w", encoding="utf-8"))
    if drawn:
        hit = sorted({w.split(':')[0].rsplit('.', 1)[0] for w in drawn})
        print(f"drawing ({len(drawn)}):", *drawn, sep="\n  ", file=sys.stderr)
        print(f"scanline: {len(drawn)} drawing defects in {len(hit)} displays"
              f" ({', '.join(hit)}) — warnings; `--strict` makes them failures", file=sys.stderr)
    if any(warn.values()):
        all_ = [w for k in warn for w in warn[k]]
        for k, ws in warn.items():
            if ws:
                print(f"{k} crossings ({len(ws)}):", *ws, sep="\n  ", file=sys.stderr)
        hit = sorted({w.split(':')[0].rsplit('.', 1)[0] for w in all_})
        per = ", ".join(f"{d} ×{sum(1 for w in all_ if w.startswith(d + '.'))}" for d in hit)
        print(f"scanline: {len(all_)} crossings in {len(hit)} displays ({per})"
              f" — warnings; `--strict` makes them failures", file=sys.stderr)
    if unhandled:
        print("unhandled:", *unhandled, sep="\n  ", file=sys.stderr)
    if bad:
        print(*[f"{path}: {b}" for b in bad], sep="\n", file=sys.stderr)
        first = next((p for p in ps if bad[0].startswith(p.id.rsplit('.', 1)[0])), None)
        sys.exit(f"scanline: {len(bad)} check{'s' * (len(bad) > 1)} failed"
                 + (f"; the first is drawn at {locate(path, first)}" if first else ""))
    if unhandled:
        sys.exit(f"scanline: {len(unhandled)} panels the sweep has no rule for")


_HELP_BODY = """usage: scanline [--panel ID] [--from FIELD] [--spell] [--strict] [--full]
       [--json FILE] [--list] [diag/allegory-axioms.typ]

--panel ID     sweep and print only the one panel with this metadata id, with its per-bead factors
--from FIELD   read `#metadata` with this --field name instead of the default "value"
--spell        respell every certified `cert:` string from what the sweep read and report mismatches
--strict       promote today's warnings (cut-order/ink crossings, drawing defects) to failures
--full         ignore the literal-hash cache and re-sweep every panel even if nothing changed
--json FILE    write each panel's source/target/factors/expr as JSON to FILE
--list         print one line per panel: its id and the composite the sweep reads it as

With no flags, sweeps every panel in the file (default diag/allegory-axioms.typ), prints the
`cert:` mismatches, and a summary line "N panels, M swept, C certified, U unhandled, F failures" to
stdout; per-panel warnings and failures go to stderr.  Must be run from a place that resolves
`diag/` (or pass the file explicitly), since panel literals live there.  Exit status is nonzero on
any failed check or unhandled panel.  A pass is cached by literal hash, so a second run with no
changes prints "panel literals unchanged since last pass — skipped" and exits 0."""


if __name__ == "__main__":       # `scripts/diagram` imports the parser, the rewrites and `spell`
    selfcheck()
    main(sys.argv[1:])
