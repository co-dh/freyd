#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""hm-check — our Hinze–Marsden panel beside the book's own picture, as port graphs.

IntroString prints most of its equations next to the string diagram they denote.  A fixture in
`diag/pairs/` records ONE such picture as the book draws it — boundary wires, beads with their arms
and legs, the grey `𝟏` strip — together with the printed formula, the diagram-order form our
generator takes, and the signatures of the letters that form uses.  This runs `scripts/diagram` on that formula, sweeps the panel with
`scripts/scanline`'s own model, and compares the two as PORT GRAPHS: the boundary lists, and each
bead's arms and legs as wire identities.  What the graph forgets is what the book itself agrees to
forget (pp. 21–22): bead heights, stretching, bending.  What it keeps is every mistake worth
catching — a bead's source, the boundary order, a missing merge.

Both sides are canonicalised by the SAME scan-line walk, so a bead free to slide up or down cannot
make the two texts differ.  Interior segments the book leaves unlabelled are `lbl: null` in the
fixture and go unchecked, because the book prints labels only at the boundary; where it does print
one, OURS is now definite — `draw` emits the type at every seam instead of letting the sweep guess
the object wire's label at the lowest bead on it.

`--verify-fixtures` audits the fixture against the page's own vector content instead: the figure's
stroked paths, filled dots, boundary endpoints and grey fill are counted out of `pdftocairo -svg`
inside the fixture's bbox and held against its `counts`.  That is what catches a miscounted
transcription, mechanically, without parsing any topology.

`--geom` compares what the port graph deliberately forgets: the DRAWING.  A fixture carrying a
`geom` block states the book's own figure as `figgeom` measured it — the object edge, the wires with
their control points, the beads and their radii — and the gate renders OUR panel for the same
formula, extracts it with figgeom's own `elements()`, puts both in one panel-local frame and prints
the deltas.  It is a measuring instrument, not a build gate: it exits nonzero only under `--strict`.

usage: hm-check [label…]            every fixture, or the ones whose file name contains a label
       hm-check --show              print both canonical port graphs beside each other
       hm-check --verify-fixtures   count the page's own svg against each fixture's `counts`
       hm-check --verify-sigs       hold `diag/hm-sigs.json` against the declaration index
       hm-check --laws              the equations functoriality gives, on every term already stated
       hm-check --geom [label…]     our render's geometry beside the book's, in one shared frame
       hm-check --geom --strict     the same, exiting nonzero on any delta past 0.02cm
"""
import json, math, os, re, sqlite3, subprocess, sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
sys.path.insert(0, HERE)
from relexpr import load                    # noqa: E402 — the path has to be set first

dg = load("diagram")
sl = dg.sl                                 # THE scanline `draw` raises from: a second copy of the
cc = load("cite-check")                    # module would give `Unhandled` a second, uncatchable class
EPS = sl.EPS


# ---------------------------------------------------------------- the mirror audit
# The one translation step every past bug hid in: the book composes with `⋅`, right to left, and we
# juxtapose left to right.  Only that axis flips — application (`F h`) is applicative on both sides.
def mirror(applicative, ws):
    return " = ".join(
        " ".join(apply(f.strip(), ws) for f in reversed(sl.split_top(side, "⋅")) if f.strip())
        for side in applicative.split("="))


# The one constant the two texts spell differently: the book's `id` is the note's `𝟙`.
SAYS = {"id": sl.UNIT}


def apply(factor, ws):
    ts = factor.split()
    return f"{ts[0]}({' '.join(ts[1:])})" if len(ts) > 1 and ts[0] in ws \
        else SAYS.get(factor, factor)


def words(s):
    return " ".join(s.split())


# ---------------------------------------------------------------- the port graph
# A side is (top tokens, bottom tokens, beads as (name, arm tokens, leg tokens), token labels,
# grey1, crossing label-pairs).  Tokens are opaque: `canon` renumbers them, so the fixture's names
# and the panel's lane positions cannot leak into the comparison.
def ours(r):
    """The port graph of a panel we drew: swept by scanline's own model, then read off the sweep."""
    p = sl.Panel(r)
    bad = sl.sweep(p)
    if bad:
        raise sl.Unhandled(bad[0])
    front = [(x, l) for (x, l) in p.cuts[0]]                 # the top ports, left to right
    tok = list(range(len(front)))
    lbl = {t: l for t, (_, l) in zip(tok, front)}
    top, beads, nxt = list(tok), [], len(tok)
    for y in sorted({b.y for b in p.beads}, reverse=True):
        i = next(k for k in range(len(p.levels)) if abs(p.levels[k] - y) < EPS)
        above, below = p.cuts[i], p.cuts[i + 1]
        if [x for x, _ in above] != [x for x, _ in front]:
            raise sl.Unhandled(f"the cut above y={y} is not the front the walk carries")
        for b in [b for b in p.beads if abs(b.y - y) < EPS]:
            hit = sl.touched(p, b, above)
            ai = [k for k, (x, _) in enumerate(above) if any(abs(x - t) < EPS for t in hit)]
            if ai and ai != list(range(ai[0], ai[-1] + 1)):
                raise sl.Unhandled(f"the bead {b.label} reaches columns {ai}, which are not adjacent")
            # a unit consumes nothing: its legs are INSERTED at the column the picture gives it
            at = ai[0] if ai else sum(x < min(hit) - EPS for (x, _) in above)
            hi = ai[-1] + 1 if ai else at
            legs = [(x, l) for (x, l) in below if any(abs(x - t) < EPS for t in hit)]
            ids = list(range(nxt, nxt + len(legs))); nxt += len(legs)
            lbl.update({t: l for t, (_, l) in zip(ids, legs)})
            beads.append((b.label, [tok[k] for k in ai], ids, at))
            tok = tok[:at] + ids + tok[hi:]
            front = above[:at] + legs + above[hi:]
    if [x for x, _ in front] != [x for x, _ in p.cuts[-1]]:
        raise sl.Unhandled("the walk does not end at the panel's bottom ports")
    pairs = sorted(tuple(sorted(m.groups())) for m in
                   (re.search(r": (\S+)@\S+ crosses (\S+)@", c) for c in sl.crossings(p)) if m)
    # `dpan` paints `luma(226)` right of the object wire and nothing else does, so the strip is
    # there exactly when the panel has an object wire.
    return (top, list(tok), beads, lbl, True, pairs)


def book(side, where):
    ws, bs = side["wires"], side["beads"]
    for i, b in enumerate(bs):                                # the fixture's own integrity
        for kind, ends in (("arm", b["arms"]), ("leg", b["legs"])):
            for j, w in enumerate(ends):
                end = ws[w]["to" if kind == "arm" else "from"]
                if end != f"bead:{i}/{kind}:{j}":
                    raise ValueError(f"{where}: wire {w} says {kind} end {end}, but bead {i}"
                                     f" ({b['name']}) lists it as its {kind} {j}")
    top = [next(w for w, v in ws.items() if v["from"] == f"top:{i}") for i in range(len(side["top"]))]
    bot = [next(w for w, v in ws.items() if v["to"] == f"bot:{i}") for i in range(len(side["bot"]))]
    for ends, names, edge in ((top, side["top"], "top"), (bot, side["bot"], "bottom")):
        for w, l in zip(ends, names):
            if ws[w]["lbl"] != l:
                raise ValueError(f"{where}: the {edge} port {l} is carried by {w},"
                                 f" which is labelled {ws[w]['lbl']}")
    return (top, bot, [(b["name"], b["arms"], b["legs"], b.get("at")) for b in bs],
            {w: v["lbl"] for w, v in ws.items()}, side["grey1"],
            sorted(tuple(sorted(c)) for c in side["crossings"]))


def canon(side, where):
    """The scan-line walk: fire the bead whose arms are all live and leftmost, renumbering as we go.
    Bead HEIGHT never enters, so two pictures differing only by a slide canonicalise the same."""
    top, bot, beads, lbl, grey, cross = side
    front, num, out, left = list(top), {}, [], list(beads)
    for i, t in enumerate(front):
        num[t] = i
    while left:
        ready = [b for b in left if b[1] and all(a in front for a in b[1])]
        if ready:
            b = min(ready, key=lambda b: min(front.index(a) for a in b[1]))
            i, j = min(front.index(a) for a in b[1]), max(front.index(a) for a in b[1])
            if sorted(front.index(a) for a in b[1]) != list(range(i, j + 1)):
                raise ValueError(f"{where}: the bead {b[0]} reaches wires that are not adjacent")
        else:
            free = [b for b in left if not b[1] and b[3] is not None]
            if not free:
                raise ValueError(f"{where}: the bead {left[0][0]} has no arms and no `at` —"
                                 f" nothing says which column its wire stands in")
            b = min(free, key=lambda b: b[3])
            i, j = b[3], b[3] - 1            # a unit consumes nothing: its legs are INSERTED
        for t in b[2]:
            num[t] = len(num)
        out.append((b[0], [num[a] for a in b[1]], [num[t] for t in b[2]]))
        front = front[:i] + list(b[2]) + front[j + 1:]
        left.remove(b)
    if front != list(bot):
        raise ValueError(f"{where}: the walk ends on {[num[t] for t in front]},"
                         f" not the bottom ports {[num.get(t) for t in bot]}")
    return (list(side[0] and [lbl[t] for t in top]), [lbl[t] for t in bot], out,
            {num[t]: lbl[t] for t in num}, grey, cross)


def diff(a, b, side):
    """The first disagreement, named down to the element.  `a` is ours, `b` the book's."""
    at, ab, abd, alb, ag, ac = a
    bt, bb, bbd, blb, bg, bc = b
    if at != bt:
        return f"side {side}: top boundary ours [{', '.join(at)}] book [{', '.join(bt)}]"
    if ab != bb:
        return f"side {side}: bottom boundary ours [{', '.join(ab)}] book [{', '.join(bb)}]"
    if len(abd) != len(bbd):
        return (f"side {side}: {len(abd)} beads ours ({', '.join(x[0] for x in abd)}),"
                f" {len(bbd)} book ({', '.join(x[0] for x in bbd)})")
    for k, (x, y) in enumerate(zip(abd, bbd)):
        if x[0] != y[0]:
            return f"side {side}: bead {k} named {x[0]} by us, {y[0]} in the book"
        if x[1] != y[1]:
            return f"side {side}: bead {x[0]} arms ours w{x[1]} book w{y[1]}"
        if x[2] != y[2]:
            return f"side {side}: bead {x[0]} legs ours w{x[2]} book w{y[2]}"
    for k in sorted(blb):                        # a label the book does not print goes unchecked
        if blb[k] is not None and alb.get(k) != blb[k]:
            return f"side {side}: wire w{k} labelled {alb.get(k)} by us, {blb[k]} in the book"
    if ag != bg:
        return f"side {side}: the grey 𝟏 strip is {'ours' if ag else 'the book'}'s alone"
    return None


# ---------------------------------------------------------------- the page's own vector content
NUM = re.compile(r"[-+]?[0-9]*\.?[0-9]+(?:e[-+]?[0-9]+)?")
GREY, BLACK = "rgb(79.998779%, 79.998779%, 79.998779%)", "rgb(0%, 0%, 0%)"


def svg_paths(pdf, page):
    out = os.path.join(os.environ.get("TMPDIR", "/tmp"), f"hm-{os.path.basename(pdf)}.{page}.svg")
    if not os.path.exists(out):
        subprocess.run(["pdftocairo", "-svg", "-f", str(page), "-l", str(page), pdf, out],
                       check=True)
    ps = []
    for tag in re.findall(r"<path\b[^>]*/>", open(out, encoding="utf-8").read()):
        d = re.search(r'\sd="([^"]*)"', tag)
        if not d:
            continue
        n = [float(v) for v in NUM.findall(d.group(1))]
        pts = list(zip(n[0::2], n[1::2]))
        m = re.search(r'transform="matrix\(([^)]*)\)"', tag)
        if m:
            a, b, c, e, tx, ty = [float(v) for v in m.group(1).split(",")]
            pts = [(a * x + c * y + tx, b * x + e * y + ty) for (x, y) in pts]
        fill = (re.search(r'\sfill="([^"]*)"', tag) or re.search(r"(none)", "none")).group(1)
        ps.append((fill, "stroke=" in tag, pts))
    return ps


def counts(pdf, page, bbox):
    x0, y0, x1, y1 = bbox
    inside = [(f, s, p) for (f, s, p) in svg_paths(pdf, page)
              if p and all(x0 <= x <= x1 and y0 <= y <= y1 for (x, y) in p)]
    strokes = [p for (f, s, p) in inside if f == "none" and s]
    dots = [p for (f, s, p) in inside if f == BLACK
            and max(x for x, _ in p) - min(x for x, _ in p) < 5]
    if not strokes:
        return {"strokes": 0, "dots": len(dots), "top_ends": 0, "bot_ends": 0,
                "grey": sum(f == GREY for (f, _, _) in inside)}
    ys = [y for p in strokes for (_, y) in p]
    ends = [p[i] for p in strokes for i in (0, -1)]
    return {"strokes": len(strokes), "dots": len(dots),
            "top_ends": sum(abs(y - min(ys)) < 1 for (_, y) in ends),
            "bot_ends": sum(abs(y - max(ys)) < 1 for (_, y) in ends),
            "grey": sum(f == GREY for (f, _, _) in inside)}


def verify(fx, path):
    pdf = os.path.join(ROOT, fx["book"])
    bad = []
    for i, s in enumerate(fx["sides"]):
        got = counts(pdf, fx["pdf_page"], s["bbox"])
        for k, v in s["counts"].items():
            if got[k] != v:
                bad.append(f"{os.path.basename(path)} side {i}: {k} claims {v},"
                           f" the page's svg has {got[k]}")
        if not UNPAINTED & set(fx.get("norm", [])) and s["grey1"] != (got["grey"] > 0):
            bad.append(f"{os.path.basename(path)} side {i}: grey1 is {s['grey1']},"
                       f" the page's svg has {got['grey']} grey fills")
    return bad


# ---------------------------------------------------------------- the signature table
def spelt(l, say):
    """How Lean writes one wire letter, or None where the table says nothing.  EVERY index functor
    is one entry: `[n]`, `[3p]` and `[m+1]` are all `Vec`, so the table names the shape `[]` once
    rather than a row per index the note happens to write."""
    return say.get("[]" if sl.idxhead(l) else l)


def stmt_of(db, mark):
    """The declaration a marker names, and the statement the index holds for it."""
    user, mod = cc.resolve(db, mark)[0][:2]
    (stmt,) = db.execute("select stmt from decl_info where internal = 0 and module = ?"
                         " and user_name = ?", (mod, user)).fetchone()
    return user, stmt or ""


def sigrow(db, say, proofs, name, row, where):
    """One signature row against the declaration its marker names, wherever the row is stated.
    `cite-check` says the statement still has the key the row was read against; then the letters the
    row's objects use must be spelled somewhere in that statement — a projection carries none, so it
    goes unchecked.  A row STATING a `nat` is held to the same standard: the mark it draws is a
    theorem, so `nat-lean` must name the declaration behind it — `"strict"` and `"lax"` the proof of
    the square, `"no"` the counterexample refuting it — and that declaration must be ABOUT the row's
    own arrow: the constant its `lean` names has to be spelled in the cited statement, or the verdict
    is drawn on a theorem about something else.  A row with no `nat` claims nothing, which for
    a polymorphic row is not an option — `diagram` refuses to draw one — and which stops being honest
    the moment Lean proves the square anyway, so the corpus is swept for a proof the table never took
    up.  A row that cites no declaration at all — a panel typing a letter of its own display — has no
    statement to read the letters off, and only the `nat` half is auditable."""
    bad, user = [], None
    if row.get("lean"):
        mark, _, k = row["lean"].partition("@")
        moved = cc.check(db, mark, k or None, where)
        if moved:
            return [moved]
        user, stmt = stmt_of(db, mark)
        used = set().union(*(dg.letters(sl.norm(sl.parse(row[e]))) for e in ("src", "tgt")))
        miss = [f"{l} as {'/'.join(spelt(l, say))}" for l in sorted(used)
                if spelt(l, say) and not any(w in stmt for w in spelt(l, say))]
        # A declaration polymorphic in its OBJECTS — `relTop (a b : RelSet) : a ⟶ b` — names no
        # structure at all, so it can spell none of the note's wires and there is nothing here to
        # check: the objects are the panel's, not the declaration's.  Same reason a projection goes
        # unchecked, one level up.  A statement that names SOME structure is still held to all of it.
        if stmt and miss and any(w in stmt for ws in say.values() for w in ws):
            bad.append(f"{where}: {user} spells no {', no '.join(miss)} —"
                       f" it is `{' '.join(stmt.split())}`")
    if "nat" not in row:
        # A row with no `nat` claims nothing — but silence is only honest while Lean says
        # nothing either.  Once the corpus proves `<name>_natural`, `<name>_lax_natural` or
        # refutes it, the row is out of date, and no one would find that by reading the table.
        # The proof names its arrow: `ListRel.partition_natural` is about `ListRel.partition`, so a
        # row citing `Paragraph.partition` — §14.5's own, a different arrow wearing the same word —
        # is not the row that theorem is missing from.  A row citing nothing has only the word to go
        # on and takes every proof of it.
        ns = user.rpartition(".")[0] if user else None
        free = [f"{m}.{u}" for u, m in proofs if u.split(".")[-1].split("_")[0] == name
                and (ns is None or u.rpartition(".")[0] == ns)]
        if free:
            bad.append(f'{where}: no `nat`, but Lean has {free[0]} — state the mark and cite it'
                       f' in `nat-lean`, or rename that theorem if it is a different arrow')
        return bad
    marks = row.get("nat-lean")
    if not marks:
        return bad + [f'{where}: nat is "{row["nat"]}" with no nat-lean — add the marker of the'
                      f' declaration that proves it, as `Mod.decl@key`']
    # And the theorem must be about the row's OWN arrow.  The key only says the cited statement has
    # not moved under the author, so a verdict could be drawn on a theorem refuting some other
    # arrow's naturality — one counterexample about `sum` stood behind four folds that are not
    # `sum`.  Lean writes the arrow as the last component of the declaration the row's `lean` names,
    # or as the notation the spelling table gives its note name (`∋`, never `eps`); one of those
    # must occur in the cited statement.  A row citing no `lean` has no arrow to hold it to.
    spells = ([user.rpartition(".")[2]] + list(say.get(name) or ())) if user else []
    for m in [marks] if isinstance(marks, str) else marks:
        mark, _, k = m.partition("@")
        moved = cc.check(db, mark, k or None, f"{where} nat-lean")
        if moved:
            bad.append(moved)
            continue
        nu, nstmt = stmt_of(db, mark)
        if spells and not any(w in nstmt for w in spells):
            bad.append(f"{where}: nat-lean {nu} is not about {user} — it is"
                       f" `{' '.join(nstmt.split())}`, which names no {' and no '.join(spells)};"
                       f" cite a theorem about the arrow, or fix the row's `lean`")
    return bad


def own_rows():
    """The rows the NOTE's own panels state, `(where, name, row)` each.  A panel types a letter of
    its one display, which no `hm-sigs.json` row could — and the claims it hangs on that letter are
    the same claims, so they are audited in the same place and not on the author's word."""
    t = sl.sigs()
    return [(f"{r['id']} sigs {k} : {v}", k, sl.typed(t, own)["sigs"][k])
            for r in sl.panels(NOTE, None)
            for own in [(r.get("cert") or {}).get("sigs") or {}]
            for k, v in own.items()]


def drawn(tbl):
    """Every bead DRAWN in the note, and the ones no row types — the OBLIGATIONS, against which the
    rows are only the RECORDS.  Auditing the rows finds a wrong one and cannot find a MISSING one: a
    bead drawn with no row anywhere is never asked what it is an arrow between, never asked for a
    naturality verdict, and the gate exits 0.  Deleting a row must therefore fail HERE.

    The arrow is resolved by `diagram`'s own `signature`, never by a second copy of the head rule, so
    the labels that key no row of their own are exempt for the reasons that rule already states:
      · a CONVERSE is its arrow read backwards — `R°` is `R`'s row with the ports swapped;
      · a PRODUCT is typed factor by factor, and `𝟙` is the identity on whatever it is handed;
      · a one-letter SCHEMATIC name (`R`, `p`, the `𝟙` of `𝟙%∋`) is endo on the object wire by
        construction: it names no arrow the corpus could cite, and the display's own formula is
        where it is introduced — the panel may still type it in `cert: sigs:`, and `own_rows` audits
        that as a row like any other;
      · a BRANCH of a bracket algebra is still the ALGEBRA's arrow and keys the bracket (`[,]`) —
        the panel's `cert: branch:` names the arm drawn, which the label alone cannot say."""
    out, bad = [], []
    for r in sl.panels(NOTE, None):
        p = sl.Panel(r)
        c = p.cert
        own = c.get("sigs") or {}
        t = sl.typed(tbl, own)
        # The globals `signature` reads, set exactly as `draw` sets them for this panel: a fold's
        # initial algebra and a panel's own `defn:` both change what a label is an arrow between.
        dg.SPLIT = frozenset((c.get("split") or dg.DEFSPLIT).split())
        dg.OWN, dg.TBL, dg.BR = frozenset(own), t, None
        dg.NAT = {k: v["nat"] for k, v in t["sigs"].items() if isinstance(v, dict) and "nat" in v}
        dg.MU = {f: (o, None) for f, o in t.get("mu", {}).items()} \
            | (dg.parse_mu(c["mu"]) if c.get("mu") else {})
        ds = sl.defns(c.get("defn"))
        sigs = {k: (dg.norm(sl.unabbrev(dg.parse(v["src"]), ds)),
                    dg.norm(sl.unabbrev(dg.parse(v["tgt"]), ds)))
                for k, v in t["sigs"].items()}
        for b in p.beads:
            lab = sl.deindex(b.label or "")[0]   # a fold's carrier is the object wire, not the key
            if not lab:
                continue
            out.append((p.id, lab))
            if lab == c.get("branch"):
                continue
            try:
                dg.signature(dg.parse(lab, False), sigs, "b")
            except (sl.Unhandled, ValueError, KeyError, StopIteration, RecursionError) as ex:
                bad.append(f"{p.id}: the bead {lab} is drawn with no signature row — every bead"
                           f" drawn is an arrow between two things, and the row is where that is"
                           f" stated and cited [{type(ex).__name__}: {ex}]")
    return out, bad


def verify_sigs():
    """Every row of `diag/hm-sigs.json` against the declaration its marker names.  `cite-check` says
    the statement still has the key the row was read against; then the letters the row's objects use
    must be spelled somewhere in that statement — a projection carries none, so it goes unchecked.
    A row STATING a `nat` is held to the same standard: the mark it draws is a theorem, so `nat-lean`
    must name the declaration behind it — `"strict"` and `"lax"` the proof of the square, `"no"` the
    counterexample refuting it — and it must be ABOUT that arrow, its statement naming the constant
    the row's `lean` names.  A row with no `nat` claims nothing, which for a polymorphic row is
    not an option — `diagram` refuses to draw one — and which stops being honest the moment Lean
    proves the square anyway, so the corpus is swept for a proof the table never took up."""
    t = sl.sigs()
    db = sqlite3.connect(f"file:{os.path.join(ROOT, cc.DB)}?mode=ro", uri=True)
    say = {k: v for k, v in t["spelling"].items() if k != "//"}
    proofs = [(u, m) for u, m in
              db.execute("select user_name, module from decl_info where internal = 0 and"
                         " user_name like '%natural'")
              if u.split(".")[-1].endswith(("_natural", "_lax_natural", "_not_lax_natural"))]
    # The sweep for a proof nobody took up runs over a panel's OWN rows too.  It was once put to the
    # table alone, on the grounds that a panel types one display's letter — but a panel types named
    # arrows as well, and a row that pins one at `Int` while Lean states it for every type is exactly
    # the row that quietly needs no `nat`: `diagram` asks for a verdict only where the SIGNATURE
    # carries a variable, so the object the note happens to draw at decided whether the question got
    # asked.  A one-letter key stays exempt, since a schematic `R` of one display is not the arrow
    # some module's `R_not_lax_natural` refutes.
    rows = [(f"hm-sigs.json {n} : {r['src']} ⟶ {r['tgt']}", n, r, proofs)
            for n, r in t["sigs"].items()] + [w + (proofs if len(w[1]) > 1 else (),)
                                              for w in own_rows()]
    bad = [b for where, name, row, pf in rows for b in sigrow(db, say, pf, name, row, where)]
    beads, unrowed = drawn(t)
    bad += unrowed
    print(*bad, sep="\n", file=sys.stderr)
    print(f"hm-check: {len(beads)} beads drawn, each asked what it is an arrow between, and"
          f" {len(rows)} signature rows audited against the declaration index, {len(bad)} adrift")
    return 1 if bad else 0


# ---------------------------------------------------------------- the free laws
# Functoriality states equations no book page has to supply: they hold of EVERY typed term, so the
# terms the repository already carries — the note's certified panels, the fixtures' own sides — test
# them for nothing.  Each is an equality of canonical port graphs, which is where `draw` lands.
NOTE = os.path.join(ROOT, "diag", "allegory-axioms.typ")


def how(c):
    """The `cert:` fields that pick one of the panels a formula denotes, as `draw` takes them: a
    formula alone says neither which functors split off the object wire nor what a fold runs on."""
    return {k: c[k] for k in ("split", "slope") if k in c} | ({"ini": c["mu"]} if c.get("mu") else {})


def terms(paths, tbl):
    """Every typed term already stated, with the table its labels are typed by and the `cert:`
    fields that say which of its panels the note draws."""
    out = [(r["id"], r["cert"]["expect"], *dg.endpoints(sl.Panel(r)),
            sl.typed(tbl, r["cert"].get("sigs")), how(r["cert"]))
           for r in sl.panels(NOTE, None) if (r.get("cert") or {}).get("expect")]
    for p in paths:
        fx = json.load(open(p, encoding="utf-8"))
        t = {**tbl, "sigs": {**tbl["sigs"],
                             **{k: v for k, v in fx.get("sigs", {}).items() if k != "//"}}}
        out += [(f"{fx['label']}.{i}", f.strip(), fx["src"], fx["tgt"], t, {})
                for i, f in enumerate(fx["mirrored"].split("="))]
    return out


def laws(paths, tbl):
    ts = terms(paths, tbl)
    bad, n, skip = [], 0, []
    for (nm, f, src, tgt, t, pick) in ts:
        try:                               # a term whose own panel the reader cannot canonicalise
            g = canon(ours(dg.draw(f, src, tgt, t, **pick)), nm)  # states no law: it is reported apart
        except (sl.Unhandled, ValueError, KeyError, StopIteration) as ex:
            skip.append(f"{nm}: {ex}"); continue
        for law, h in (("identity", f"𝟙 ({f}) 𝟙"),
                       ("spelling", sl.spell(sl.tidy(sl.norm(sl.parse(f)))))):
            n += 1
            try:
                d = diff(g, canon(ours(dg.draw(h, src, tgt, t, **pick)), f"{law} {nm}"), law)
            except (sl.Unhandled, ValueError, KeyError, StopIteration) as ex:
                d = f"{h}: {type(ex).__name__}: {ex}"
            if d:
                bad.append(f"FAIL  {nm}   {f}: {d}")
    print(*bad, sep="\n", file=sys.stderr)
    print(*(f"  unread {s}" for s in skip), sep="\n")
    print(f"hm-check: {n} free-law checks over {len(ts) - len(skip)} stated terms,"
          f" {len(bad)} broken, {len(skip)} unreadable")
    return 1 if bad else 0


# ---------------------------------------------------------------- the geometry gate
# Everything above compares TOPOLOGY, which is what the book itself agrees to forget.  This compares
# what it does not: the drawing.  The book side was measured once, by `scripts/figgeom`, and sits in
# the fixture's `geom` block; ours is measured from OUR OWN render of the same panel through
# figgeom's `elements()` — one extractor for both sides, so a difference can never be the reader's.
fg = load("figgeom")
UNIT = 0.8                  # cetz `length: 0.8cm`: one canvas unit, in cm
BCOL = (0x0e, 0x74, 0x90)   # `draw.typ`'s object-wire colour — what NAMES that wire in our svg
TOL = 0.02                  # cm; under it a delta is the renderer's own rounding

# THE SHARED FRAME — a uniform scale and a translation, nothing else.  `dpan` lays its two region
# fills over exactly [0,w]×[0,h] canvas units, so their rendered width fixes pt-per-unit and `P`'s
# 74% shrink divides out; one canvas unit is then `0.8cm`, cetz's own `length:`.  The origin is the
# object edge's TOP end on both sides, y downward.  A per-axis fit is refused on purpose: it would
# absorb exactly the gradient error this gate exists to see.


def palette():
    """The lane names `FCOL` (`diag/draw.typ`) knows.  It has no `default:`, so a lane it does not
    name is a compile error rather than a black wire — which is what stops us rendering a monad."""
    s = open(os.path.join(ROOT, "diag", "draw.typ"), encoding="utf-8").read()
    return re.findall(r'"([^"]+)":\s*rgb', s.split("#let FCOL = (", 1)[1].split("\n\n", 1)[0])


def alias(fx, tbl):
    """The rename OUR render needs and the book's page does not: `M`, the monad these figures are
    about, is a functor the note never draws, so `FCOL` cannot colour its lane and the panel will
    not compile at all.  Substitute a palette name the fixture and the note's table both leave
    free.  The lookup is the only thing that reads it: no wire moves, so nothing measured shifts."""
    said = set(re.findall(r"\w+", json.dumps(fx, ensure_ascii=False)))
    free = [c for c in palette() if c not in said and c not in tbl["sigs"] and c not in tbl.get("mu", {})]
    applied = set().union(*(re.findall(r"(\w+)\(", fx[k]) for k in ("mirrored", "src", "tgt")))
    return {w: free[0] for w in sorted(applied - set(palette()))}


def renamed(s, a):
    return re.sub(r"\w+", lambda m: a.get(m.group(0), m.group(0)), s)


def ourgeom(fx, tbl, tag):
    """OUR panel for the fixture's formula, rendered alone and measured: the same `dg.draw` the port
    check runs, `dg.emit`'s own `#dpanel(...)` call, and figgeom's primitives off the svg."""
    a = alias(fx, tbl)
    own = {renamed(k, a): {p: renamed(v, a) if isinstance(v, str) else v for p, v in s.items()}
           for k, s in fx.get("sigs", {}).items() if k != "//"}
    t = {**tbl, "sigs": {**tbl["sigs"], **own}}
    # The fixture's `geom` block states the two things the p.74 construction does not derive — the
    # panel the book set and whether it broke the edge at a riding dot — so `--book` is passed them.
    g = fx["geom"]
    book = tuple(int(v) for v in g["panel"].lower().split("x")) + (bool(g.get("obreak")),)
    rec = dg.draw(renamed(fx["mirrored"].split("=")[0].strip(), a),
                  renamed(fx["src"], a), renamed(fx["tgt"], a), t, book=book)
    # ONE renderer, shared with `diagram --png`: what is measured here is what that command shows.
    pdf = dg.picture([rec], tag=f"geom-{tag}")
    subprocess.run(["pdftocairo", "-svg", "-f", "1", "-l", "1", pdf, pdf[:-4] + ".svg"], check=True)
    els = list(fg.elements(open(pdf[:-4] + ".svg", encoding="utf-8").read()))
    return frame(els, rec), a


def isdot(sub):
    """A cetz circle is ONE closed subpath of four cubics; a glyph outline is not.  `A` at this size
    is as wide as it is tall and as small as a bead, so roundness alone would take it for one."""
    cs = [c for sp in sub for c, _ in sp if c != "Z"]
    return len(sub) == 1 and cs == ["C"] * 4


def frame(els, rec):
    """The panel's ink in the shared frame: cm, origin at the object edge's top end, y downward."""
    # The page's own white ground is a region too, and a bigger one: the panel is the two fills
    # `dpan` lays over exactly [0,w]×[0,h], which are the ambient category's and `𝟏`'s.
    regs = [bb for k, c, _, bb in els if k == "region" and hexrgb(c) != (255, 255, 255)]
    if not regs:
        raise ValueError("our render carries no region fill — the panel drew nothing")
    x0, y0 = min(b[0] for b in regs), min(b[1] for b in regs)
    x1, y1 = max(b[2] for b in regs), max(b[3] for b in regs)
    sx, sy = (x1 - x0) / rec["w"], (y1 - y0) / rec["h"]
    if abs(sx - sy) > 0.05:
        raise ValueError(f"our render is {sx:.3f} pt/unit across and {sy:.3f} down —"
                         f" the frame is not one uniform scale")
    s = (sx + sy) / 2
    wires = [(hexrgb(c), sp) for k, c, sub, _ in els if k == "wire" for sp in sub]
    # ONE edge, but not always one stroke: p.74 breaks it at a riding dot, and the fixture states
    # that break as a second path.  Top to bottom, so the first stroke's upper end is the origin.
    edge = sorted((sp for c, sp in wires if c and dist(c, BCOL) < 24),
                  key=lambda sp: min(p[1] for _, ps in sp for p in ps))
    if not edge:
        raise ValueError("our render has no stroke in the object wire's colour")
    ends = [edge[0][0][1][0], edge[0][-1][1][-1]]
    ox, oy = min(ends, key=lambda q: q[1])
    at = lambda p: [round((p[0] - ox) / s * UNIT, 4), round((p[1] - oy) / s * UNIT, 4)]
    ir = lambda sp: [[c] + [at(p) for p in ps] for c, ps in sp if c != "Z"]
    dots = sorted(((bb[0] + bb[2]) / 2, (bb[1] + bb[3]) / 2, (bb[2] - bb[0]) / 2)
                  for k, _, sub, bb in els if k == "bead" and isdot(sub))
    # `dg.draw`'s own bead list, top first, is what NAMES them: the svg keeps no label.
    nm = [b[1] for b in sorted(rec["beads"], key=lambda b: -b[0])]
    return {"extent": [round(rec["w"] * UNIT, 3), round(rec["h"] * UNIT, 3)],
            "edge": [ir(sp) for sp in edge],
            "wires": [ir(sp) for c, sp in wires if not (c and dist(c, BCOL) < 24)],
            "beads": [{"name": n, "at": at(d), "r": round(d[2] / s * UNIT, 4)}
                      for n, d in zip(nm + ["?"] * len(dots), sorted(dots, key=lambda d: d[1]))]}


def hexrgb(s):
    return tuple(int(s[i:i + 2], 16) for i in (1, 3, 5)) if re.fullmatch(r"#[0-9a-f]{6}", s or "") \
        else None


def dist(a, b):
    return sum(abs(x - y) for x, y in zip(a, b))


def gsegs(paths):
    return [g for p in paths for g in p]


def straight(paths, vertical):
    """The straight runs standing in a column (`vertical`) or lying along a row."""
    a, b = (0, 1) if vertical else (1, 0)
    return [g for g in gsegs(paths) if g[0] == "L"
            and abs(g[1][a] - g[-1][a]) < 5e-3 and abs(g[1][b] - g[-1][b]) > 5e-3]


def columns(paths):
    """The x's a wire STANDS at: the ends of a vertical run, and the end of a bend whose control
    point is straight above or below it.  The tangent and not the run, because our own knees can
    eat a whole row between two beads and leave a column with no straight length at all."""
    xs = []
    for g in straight(paths, True):
        xs += [g[1][0]]
    for g in gsegs(paths):
        if g[0] == "C":
            p0, c1, c2, p1 = g[1:]
            xs += [p0[0]] * (abs(c1[0] - p0[0]) < 5e-3) + [p1[0]] * (abs(c2[0] - p1[0]) < 5e-3)
    out = []
    for x in sorted(xs):
        if not out or x - out[-1] > 2 * TOL:
            out.append(x)
    return tuple(round(x, 3) for x in out)


def handles(paths):
    """Each cubic's two control handles, as a fraction of that bend's OWN chord — the p.74 law."""
    out = []
    for g in gsegs(paths):
        if g[0] == "C":
            p0, c1, c2, p1 = g[1:]
            ch = math.dist(p0, p1)
            out += [math.dist(p0, c1) / ch, math.dist(p1, c2) / ch]
    return out


def gaps(xs):
    return tuple(round(b - a, 3) for a, b in zip(xs, xs[1:]))


def measures(g):
    """One list of named numbers, computed the SAME way from the fixture's block and from ours."""
    e = gsegs(g["edge"])
    a, b = e[0][1], e[-1][-1]
    dy = b[1] - a[1]
    stubs = [min([math.dist(q, d["at"]) for d in g["beads"]] or [0])
             for p in g["wires"] for q in (p[0][1], p[-1][-1])]
    k = handles(g["wires"] + g["edge"])
    ys = sorted({round(d["at"][1], 3) for d in g["beads"]})
    xs = columns(g["wires"])
    hz = straight(g["wires"], False)
    bb = g.get("page_bbox")
    out = [("panel", "width × height", tuple(g["extent"]) if "extent" in g else
            (round((bb[2] - bb[0]) / fg.CM, 3), round((bb[3] - bb[1]) / fg.CM, 3))),
           ("edge", "gradient |dx|/dy", abs(b[0] - a[0]) / dy if abs(dy) > 1e-9 else None),
           ("edge", "bottom end", tuple(b)),
           ("edge", "bends", float(len(handles(g["edge"])) // 2)),
           ("edge", "broken at a bead", len(g["edge"]) > 1),
           ("bead", "radius", g["beads"][0]["r"] if g["beads"] else None)]
    out += [("bead", f"{d['name']} centre", tuple(d["at"])) for d in g["beads"]]
    return out + [("wire", "stub to a bead centre", min(stubs) if stubs else None),
                  ("wire", "bend handle / chord", sum(k) / len(k) if k else None),
                  ("wire", "handle spread min–max", (round(min(k), 3), round(max(k), 3)) if k
                   else ()),
                  ("wire", "bends", float(len(handles(g["wires"])) // 2)),
                  ("wire", "horizontal hold", sum(abs(s[-1][0] - s[1][0]) for s in hz)),
                  ("row", "bead heights", tuple(ys)),
                  ("row", "pitch", gaps(ys)),
                  ("lane", "columns", xs),
                  ("lane", "pitch", gaps(xs))]


def fmt(v):
    if v is None:
        return "—"
    if isinstance(v, bool):
        return str(v).lower()
    if isinstance(v, tuple):
        return "(" + ", ".join(fmt(x) for x in v) + ")" if v else "()"
    return f"{v:.3f}"


def delta(a, b):
    """Ours minus the book's, element by element; `—` where the two are not the same kind."""
    if isinstance(a, bool) or isinstance(b, bool):
        return "same" if a == b else "DIFFERS"
    if a is None or b is None:
        return "—"
    if isinstance(a, tuple) or isinstance(b, tuple):
        if not (isinstance(a, tuple) and isinstance(b, tuple) and len(a) == len(b)):
            return f"{fmt(a)} vs {fmt(b)}"
        return "(" + ", ".join(delta(x, y) for x, y in zip(a, b)) + ")" if a else "()"
    return f"{a - b:+.3f}"


def adrift(a, b):
    if isinstance(a, bool) or isinstance(b, bool) or a is None or b is None:
        return a != b
    if isinstance(a, tuple) or isinstance(b, tuple):
        return not (isinstance(a, tuple) and isinstance(b, tuple) and len(a) == len(b)) \
            or any(adrift(x, y) for x, y in zip(a, b))
    return abs(a - b) > TOL


def geom(paths, tbl, strict):
    n, off = 0, 0
    for p in paths:
        fx = json.load(open(p, encoding="utf-8"))
        if "geom" not in fx:
            continue
        n += 1
        try:
            g, a = ourgeom(fx, tbl, os.path.basename(p)[:-5])
        except (sl.Unhandled, ValueError, KeyError, StopIteration,
                subprocess.CalledProcessError) as ex:
            print(f"{fx['label']}   unrendered: {type(ex).__name__}: {ex}"); off += 1; continue
        print(f"\n{fx['label']}   {fx['title']}\n  the book's own figure, IntroString p.{fx['page']}"
              f" (pdf {fx['pdf_page']}), against our `{fx['mirrored']}` panel"
              + (f" — our lanes rename {' '.join(k + '→' + v for k, v in a.items())}, because"
                 f" `FCOL` colours a lane by name and names no {' or '.join(a)}" if a else "")
              + f"\n  {'kind':6} {'what':22} {'book':24} {'ours':24} delta")
        for (kind, what, bv), (_, _, ov) in zip(measures(fx["geom"]), measures(g)):
            bad = adrift(ov, bv)
            off += bad
            print(f"  {kind:6} {what:22} {fmt(bv):24} {fmt(ov):24} {delta(ov, bv)}"
                  + ("  <" if bad else ""))
    print(f"\nhm-check: {n} fixture{'s' * (n != 1)} measured, {off} readings past {TOL}cm")
    return 1 if strict and off else 0


# ---------------------------------------------------------------- the driver
# A declared normalization says WHY the two pictures may differ by convention.  All four are
# recorded in the fixture as drawn — the transcriber applies them — so none rewrites a graph here;
# an undeclared one is a FAIL, so the list cannot quietly grow into a licence to differ.
NORMS = ("free-end-vs-bent-in", "object-wire-added", "regions-unpainted", "spider-vs-bead")
# Two of them put the grey `𝟏` strip on OUR side alone, so the page cannot be asked for it:
# `object-wire-added` where the book draws a 2-cell with no object under it, and `regions-unpainted`
# where the figure comes before Remark 2.1 and the page paints no region at all.
UNPAINTED = {"object-wire-added", "regions-unpainted"}


def show(g, who):
    top, bot, beads, lbl, grey, _ = g
    print(f"    {who:<4} top [{' '.join(top)}]  bot [{' '.join(bot)}]  grey1 {str(grey).lower()}"
          + "  " + " ".join(f"w{k}={lbl[k] or '·'}" for k in sorted(lbl)))
    for k, (n, a, l) in enumerate(beads):
        print(f"         bead {k} {n}: arms ({', '.join('w%d' % i for i in a)})"
              f" legs ({', '.join('w%d' % i for i in l)})")


def check(fx, tbl, seen=False):
    lab, warn = fx["label"], []
    # The fixture's own letters (`a`, `b`, `h` in 3.6) name nothing outside it, so they are written
    # where they are used and layered over the note's table.
    tbl = {**tbl, "sigs": {**tbl["sigs"], **{k: v for k, v in fx.get("sigs", {}).items() if k != "//"}}}
    odd = [n for n in fx.get("norm", []) if n not in NORMS]
    if odd:
        return f"FAIL  {lab}   undeclared normalization {odd[0]!r}", warn
    ws = dg.alphabet(tbl, sl.norm(sl.parse(fx["src"])), sl.norm(sl.parse(fx["tgt"])))
    got = mirror(fx["book_formula"], ws)
    if words(got) != words(fx["mirrored"]):
        return f"FAIL  {lab}   mirrored is '{fx['mirrored']}', but '{fx['book_formula']}'" \
               f" mirrors to '{got}'", warn
    sides = [s.strip() for s in fx["mirrored"].split("=")]
    if len(sides) != len(fx["sides"]):
        return f"FAIL  {lab}   {len(sides)} formula sides, {len(fx['sides'])} pictures", warn
    for i, (f, s) in enumerate(zip(sides, fx["sides"])):
        try:
            a = canon(ours(dg.draw(f, fx["src"], fx["tgt"], tbl)), f"ours {lab}.{i}")
            b = canon(book(s, f"{lab}.{i}"), f"book {lab}.{i}")
        except (sl.Unhandled, ValueError, KeyError, StopIteration) as ex:
            return f"FAIL  {lab}   side {i}: {type(ex).__name__}: {ex}", warn
        if seen:
            print(f"  {lab} side {i}   {f}"); show(a, "ours"); show(b, "book")
        bad = diff(a, b, i)
        if bad:
            return f"FAIL  {lab}   {bad}", warn
        if a[5] != b[5]:
            warn.append(f"WARN  {lab}   side {i} crossings: ours {a[5] or '{}'} book {b[5] or '{}'}")
    return f"PASS  {lab}   {fx['title']}", warn


def main(argv):
    d = os.path.join(ROOT, "diag", "pairs")
    only = [a for a in argv if not a.startswith("-")]
    paths = [os.path.join(d, f) for f in sorted(os.listdir(d)) if f.endswith(".json")
             and (not only or any(o in f for o in only))]
    if "--verify-sigs" in argv:
        sys.exit(verify_sigs())
    if "--laws" in argv:
        sys.exit(laws(paths, sl.sigs()))
    if "--geom" in argv:
        sys.exit(geom(paths, sl.sigs(), "--strict" in argv))
    if "--verify-fixtures" in argv:
        bad = [b for p in paths for b in verify(json.load(open(p, encoding="utf-8")), p)]
        print(*bad, sep="\n", file=sys.stderr)
        print(f"hm-check: {len(paths)} fixtures audited against the page svg, {len(bad)} miscounts")
        sys.exit(1 if bad else 0)
    tbl = sl.sigs()
    lines = [check(json.load(open(p, encoding="utf-8")), tbl, "--show" in argv)
             for p in paths]
    for line, warn in lines:
        print(line, *warn, sep="\n")
    n = sum(l.startswith("FAIL") for l, _ in lines)
    print(f"{len(lines)} pair{'s' * (len(lines) != 1)}: {len(lines) - n} PASS, {n} FAIL,"
          f" {sum(len(w) for _, w in lines)} WARN")
    sys.exit(1 if n else 0)


if __name__ == "__main__":
    main(sys.argv[1:])
