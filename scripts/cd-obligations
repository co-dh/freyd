#!/usr/bin/env python3
"""cd-obligations — every COMMUTATIVE DIAGRAM the note draws, read off the note's own drawing.

    ./scripts/cd-obligations              # one line per commutative canvas: <number>/<label>#<n>
    ./scripts/cd-obligations --all        # every canvas, commutative or not, with its counts

THE OBLIGATIONS ARE THE NOTE'S CANVASES, not the rows of a manifest: a record can be deleted, a
canvas the note draws cannot.  Nothing here reads the `.typ` as text.  Under `--input cdscan=1`
four helpers drop a queryable mark — the display's show rule its own label (`diag/note-style.typ`),
`cetz.canvas` one per canvas (`diag/cetz-nodraw.typ`), `ar` and `node` one apiece
(`diag/draw.typ`) — beside the `kind: "pic"` metadata `#disp` already stamps with its number.
`typst query` hands the whole stream back in DOCUMENT ORDER, so the marks cut into displays at the
`pic`s and into canvases at the `canvas`es, and a canvas is a COMMUTATIVE DIAGRAM exactly when it
joins nodes by `ar` arrows: at least one `ar` and at least two `node`s.  Any other canvas — a
string-diagram panel, a circuit, a picture of a set — draws no `ar` and is not counted.
"""
import json, os, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
NOTE = "diag/allegory-axioms.typ"


def query(*args):
    p = subprocess.run(["typst", "query", "--root", ".", *args], cwd=ROOT,
                       capture_output=True, text=True, encoding="utf-8")
    if p.returncode:
        sys.exit(f"cd-obligations: typst query {' '.join(args)} failed:\n{p.stderr}")
    return json.loads(p.stdout)


def canvases():
    """Every canvas of the note, in document order: (display number, [labels], el counts)."""
    marks = query("--input", "cdscan=1", NOTE, "metadata", "--field", "value")
    out, disp, lab = [], "(before the first display)", "(unlabelled)"
    for m in marks:
        if not isinstance(m, dict):
            continue
        if m.get("kind") == "cd" and m["el"] == "disp":
            lab = m["label"] or "(unlabelled)"       # the show rule runs ahead of the display's body
        elif m.get("kind") == "pic" and m.get("disp"):
            disp = f"{m['key']}/{lab}"
        elif m.get("kind") == "cd":
            if m["el"] == "canvas":
                out.append((disp, {"ar": 0, "node": 0}))
            elif out:
                out[-1][1][m["el"]] += 1
    return out


def commutative(c):
    """The RULE, not a list of labels: nodes joined by `ar` arrows in `diag/draw.typ`'s vocabulary."""
    return c["ar"] >= 1 and c["node"] >= 2


def main(argv):
    cs = canvases()
    if "--all" in argv:
        for disp, c in cs:
            print(f"{disp}\t{c['ar']} ar\t{c['node']} node\t"
                  f"{'commutative' if commutative(c) else 'other picture'}")
        return
    # `<number>/<label>#<n>`: the canvas's place among the COMMUTATIVE canvases of its display, which
    # is what a record can name — a count per display could not tell two squares of one display apart.
    seen = {}
    for disp, c in cs:
        if commutative(c):
            seen[disp] = seen.get(disp, 0) + 1
            print(f"{disp}#{seen[disp]}")


if __name__ == "__main__":
    main(sys.argv[1:])
