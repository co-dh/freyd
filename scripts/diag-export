#!/bin/sh
# diag-export — draw a declaration's STATEMENT as a string diagram, under `cap`'s address-space
# limit.  Writes diag/generated/<name>.typ and prints the path.
#
#   ./scripts/diag-export Freyd.Diag.dom_cd Freyd.Diag.cv_merge
#   typst compile diag/generated/Freyd.Diag.dom_cd.typ
#
# A handful of declarations go in ONE run: each process imports `Freyd` plus every `diag.*` module,
# about a second.  A whole route does NOT: the exe draws its arguments as tasks over one shared
# environment, and hundreds of them contend on it — the circuits cost eleven times the CPU they
# cost as a process each — so `diag-regen` is what redraws a route.  The cap is here for the same
# reason as in lean-refactor: every long-running Lean process in this repo runs under it — see
# scripts/cap.
cd "$(dirname "$0")/.." || exit 1
# The naturality search takes its candidates from the index and exits on one older than a module the
# exe imports, so the build `lake exe` would do is done first and the index refreshed after it.  Both
# go to stderr: stdout is the records a caller parses.
# `diag.StrDiagNames` is loaded at RUN time, so the exe's build does not reach it: left stale it
# prints the previous spelling of every label and exits 0.
# `--prepare` does those two and draws nothing; `--prepared` as the first word says they are done.
# `diag-regen` spreads a route over many processes, and the index is refreshed under a lock, so a
# refresh per process would queue them behind each other to learn nothing changed.
if [ "$1" = "--prepared" ]; then shift; else
  # `@freyd` is the package's defaultTargets (Freyd, AOP, diag): the exe walks those roots at run time
  # (`libModules`), so a module it imports by name only there — no static import — must be built too.
  ./scripts/cap lake build @freyd diag-export diag.StrDiagNames >&2 || exit 1
  case " $* " in *" --list "*) ;; *)
    ./scripts/lean-refactor index >&2 || exit 1
    [ "$1" = "--prepare" ] && exit 0 ;;
  esac
fi
# `--list` asks TYPST what the note draws: it imports no environment, needs no index, and the
# note's own layout costs far more than the cap an exporter run is held to, which the child
# inherits.  Routed here rather than raising the cap for every route.
# The binary under `lake env`, not `lake exe`: the build is done above or by the caller, and
# `lake exe` re-checks every module per process, which queued behind other builds for up to 26 s.
exe=.lake/build/bin/diag-export
case " $* " in *" --list "*) exec lake env "$exe" "$@" ;; esac
exec ./scripts/cap lake env "$exe" "$@"
