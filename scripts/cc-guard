#!/usr/bin/env python3
"""Claude Code hook guard. Enforces the dispatch/turn/image rules that CLAUDE.md
only advises, measured 2026-09-02 from the 2026-09-01 session (654M cache tokens).

Modes (argv[1]):
  agent  PreToolUse/Agent      deny a dispatch with no turn budget, or a worktree with no base sha
  count  PostToolUse/*         checkpoint an agent at 40 tool calls, stop it at 80
  read   PreToolUse/Read       cap .png reads: 1 in the main thread, 4 in an agent
  stop   Stop                  nudge when a turn asks for review without sending the picture

Never breaks a session: any internal error exits 0 with no output.
"""
import hashlib
import json
import os
import re
import sys
import time

STATE = os.path.expanduser('~/.cache/cc-guard')
CHECKPOINT, HARD_STOP = 40, 80
PNG_MAIN, PNG_AGENT, WINDOW = 2, 4, 1800


def key(ev):
    # transcript_path is unique per subagent; session_id is the whole main thread
    return hashlib.sha1((ev.get('transcript_path') or ev.get('session_id') or 'x').encode()).hexdigest()[:16]


def bump(k, slot, by=1):
    os.makedirs(STATE, exist_ok=True)
    p = os.path.join(STATE, k + '.' + slot)
    try:
        n = int(open(p).read())
    except Exception:
        n = 0
    n += by
    open(p, 'w').write(str(n))
    return n


def once(k, slot, token):
    """True the first time this token is seen for this slot — one nudge per turn, not per session."""
    os.makedirs(STATE, exist_ok=True)
    p = os.path.join(STATE, k + '.' + slot)
    try:
        if open(p).read() == token:
            return False
    except Exception:
        pass
    open(p, 'w').write(token)
    return True


def is_agent(ev):
    return '/subagents/' in (ev.get('transcript_path') or '')


def deny(why):
    print(json.dumps({'hookSpecificOutput': {
        'hookEventName': 'PreToolUse', 'permissionDecision': 'deny', 'permissionDecisionReason': why}}))


def inject(event, text):
    print(json.dumps({'hookSpecificOutput': {'hookEventName': event, 'additionalContext': text}}))


# A dispatch is a mechanical brief ("replace this old_string") while a skill's description is
# conceptual, so the agent never feels the gap: 127 of 159 dispatches on 2026-09-01 named no skill
# and none of those agents loaded one. Naming it worked (28 of 32 did), so name it for them.
SKILLS = ('/home/dh/repo/freyd/.claude/skills', os.path.expanduser('~/.claude/skills'))
TRIGGERS = [  # first match wins, so the specific patterns come before the general one
    (r'type label|object type', 'add-type-circuit'),
    (r'proof table|zline|reason column', 'proof-table'),
    # a bare `circuit` also names `scripts/circuit`, and editing that script needs no drawing convention
    (r'allegory-axioms|dpanel|cpanel|hchain|panel|string diagram|circuit diagram', 'string-diagram'),
]


def skill_hint(inp, p):
    for rx, name in TRIGGERS:
        if name in p or not re.search(rx, p, re.I):
            continue
        if not any(os.path.exists(os.path.join(d, name, 'SKILL.md')) for d in SKILLS):
            continue
        new = dict(inp)
        new['prompt'] = (f'Run Skill({name}) before your first edit and follow it — it holds the '
                         f'conventions this task needs.\n\n') + p
        print(json.dumps({'hookSpecificOutput': {
            'hookEventName': 'PreToolUse', 'updatedInput': new}}))
        return


def mode_agent(ev):
    inp = ev.get('tool_input', {})
    p = inp.get('prompt') or ''
    if not p:
        return
    if not re.search(r'budget of \d+|\d+ tool calls', p):
        deny('This dispatch states no turn budget. Agents given one averaged 21 tool calls yesterday; '
             'agents without one averaged 37. Add: "You have a budget of 40 tool calls. At 40, commit your '
             'work in progress and write a handoff naming what is done, what is left, and the anchors for it. '
             'Stop at 80 whatever the state." Then dispatch again.')
        return
    if re.search(r'worktree|isolation', p, re.I) and not re.search(r'git log --oneline -1|reset --hard [0-9a-f]{7}', p):
        deny('This dispatch puts the agent in a worktree without naming the base commit. A worktree is not '
             'guaranteed to start at current master. Put the actual sha in the prompt and tell the agent to run '
             '`git log --oneline -1` and reset to it before touching anything. Then dispatch again.')
        return
    skill_hint(inp, p)


def mode_count(ev):
    if not is_agent(ev):
        return
    n = bump(key(ev), 'calls')
    if n == CHECKPOINT:
        inject('PostToolUse',
               f'Tool call {n}. Checkpoint now: commit your work in progress to the worktree, then write a short '
               'handoff naming what is done, what is left, and the anchors for it. If that handoff says everything '
               'the remaining work needs, stop and report it. Otherwise keep going; a hard stop lands at 80.')
    elif n >= HARD_STOP and (n - HARD_STOP) % 20 == 0:
        inject('PostToolUse',
               f'Tool call {n}. Past this point an agent produces mostly re-reads, not edits. Commit what you have '
               'and report now: what is done, what is left, and the exact anchors for it. Do not push on.')


def mode_read(ev):
    f = str(ev.get('tool_input', {}).get('file_path') or '')
    if not f.lower().endswith(('.png', '.jpg', '.jpeg', '.webp')):
        return
    # sliding window, not a session total: a 17-hour session must not be capped at its first picture
    cap = PNG_AGENT if is_agent(ev) else PNG_MAIN
    os.makedirs(STATE, exist_ok=True)
    p = os.path.join(STATE, key(ev) + '.png')
    now = int(time.time())
    try:
        seen = [int(x) for x in open(p).read().split() if now - int(x) < WINDOW]
    except Exception:
        seen = []
    if len(seen) >= cap:
        deny(f'{len(seen)} images already read in the last {WINDOW // 60} minutes; the cap here is {cap}. Every '
             'image stays in context and is resent on every later turn. Crop to the changed region, or take a '
             'pixel diff and read the number instead, or hand the looking to a fresh subagent.')
        return
    open(p, 'w').write(' '.join(str(x) for x in seen + [now]))


REVIEW = re.compile(r'\breview\b|\bhave a look\b|让你?看|请看|过目|审阅', re.I)


def mode_stop(ev):
    path = ev.get('transcript_path')
    if not path or not os.path.exists(path):
        return
    with open(path, 'rb') as fh:
        fh.seek(max(0, os.path.getsize(path) - 400000))
        tail = fh.read().decode('utf-8', 'replace').split('\n')
    sent = asked = False
    for line in reversed(tail):
        try:
            o = json.loads(line)
        except Exception:
            continue
        if o.get('type') == 'user' and not o.get('isMeta'):
            c = (o.get('message') or {}).get('content')
            if isinstance(c, str) or (isinstance(c, list) and not any(
                    isinstance(b, dict) and b.get('type') == 'tool_result' for b in c)):
                break  # reached the start of this turn
        if o.get('type') != 'assistant':
            continue
        for b in ((o.get('message') or {}).get('content') or []):
            if not isinstance(b, dict):
                continue
            if b.get('type') == 'tool_use' and b.get('name') in ('SendUserFile', 'Artifact'):
                sent = True
            if b.get('type') == 'text' and REVIEW.search(b.get('text') or ''):
                asked = True
    if asked and not sent and once(key(ev), 'stopnudge', str(os.path.getsize(path))):
        print(json.dumps({'decision': 'block', 'reason':
                          'You asked him to review something without sending the picture. Crop to the changed '
                          'region, send it with SendUserFile, and say what changed. If this turn needs no picture, '
                          'say so in one line and finish.'}))


def main():
    try:
        ev = json.loads(sys.stdin.read() or '{}')
        {'agent': mode_agent, 'count': mode_count, 'read': mode_read, 'stop': mode_stop}[sys.argv[1]](ev)
    except Exception:
        pass


main()
