#!/usr/bin/env python3
"""string-check — the note's string diagrams' gate.  Every Hinze–Marsden panel the note draws is an
obligation `diag/string-panels.txt` states, and this redraws it from LEAN and holds the two to each
other.

    ./scripts/string-check            # every display
    ./scripts/string-check 13.6       # only the displays whose number starts so
    ./scripts/string-check --selectors  # the manifest's selectors, one per line, for `make`
    ./scripts/string-check --marks 14.1 # write Lean's per-panel verdicts into the note's `cert:`s

THREE OBLIGATIONS, each enumerated from what MUST have an answer rather than from what has one:
  every display   the note draws (`typst query`, `kind == "scanline"`) has a line in the file — a
                  display the file does not name fails here rather than going unchecked, and a line
                  naming a display the note no longer holds fails too;
  every panel     of a display whose line names a selector is drawn by `diag-export --string`,
                  swept by `scanline --strict`, and compared to the note's own panel — drawn in
                  THAT DISPLAY's box, since the frame and the bead heights are how a display lines
                  its panels up, so one selector two displays draw is drawn once for each;
  every selector  the file names is drawn, so a declaration whose statement the exporter refuses is
                  reported as CANNOT-DRAW rather than dropped.

WHY THERE IS NO REGEX OVER THE NOTE.  The panels come out of `typst query` as the note's own
metadata — id, `cert`, lanes, beads, ports — so nothing here reads the `.typ` source.  The note side
of each comparison is the panel `scripts/diagram` rebuilds from that same `cert:`, which
`make pairs`/`diagram --compare` already holds to the literal in the note; the Lean side is
`diag-export --string`.  Both are compiled to SVG and put to `scripts/svg-diff`, which compares
drawn PRIMITIVES, not text.  One thing is genuinely out of reach: a display's `lean:` marker is a
Typst COMMENT, invisible to `typst query`, so the selector column of `diag/string-panels.txt` was
authored once (through `scripts/cite-cover`'s own note reader) and is static — the gate never
re-derives it, and a display whose line carries no selector is reported NO-DECL.
"""
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "scripts"))
import panels                                    # noqa: E402  — the manifests' one reader
# The note is one file per chapter (`scripts/note-split`): read a split root as the one document it
# stands for, and write back through the split so a rewritten `cert:` lands in the chapter holding it.
from notesplit import note_root, note_source, note_write, take_chapter    # noqa: E402
# `scripts/diagram` is the note's reader as well as its generator: `literals` and `close` are how a
# `dpanel(` and its `cert:` are cut out of the source, and --marks writes into that same cut rather
# than pattern-matching the note a second time.  It has no `.py`, hence the loader.
diagram = importlib.util.module_from_spec(importlib.util.spec_from_loader(
    "diagram", importlib.machinery.SourceFileLoader("diagram", os.path.join(ROOT, "scripts",
                                                                            "diagram"))))
diagram.__loader__.exec_module(diagram)
# `scripts/svg-diff` IS the primitive matcher, and the band rule below is one more of its matches
# rather than a second reader of SVG: `collect`, `best_offset`, `shift`, `unmatched`, `differs` and
# `NPOS` all come from there, so the two cannot come to disagree about what a primitive is.  It has
# no `.py` either, hence the same loader.
svgdiff = importlib.util.module_from_spec(importlib.util.spec_from_loader(
    "svgdiff", importlib.machinery.SourceFileLoader("svgdiff", os.path.join(ROOT, "scripts",
                                                                           "svg-diff"))))
svgdiff.__loader__.exec_module(svgdiff)
os.chdir(ROOT)
sys.stdout.reconfigure(line_buffering=True)   # a long run's report must be readable while it runs
PANELS = "diag/string-panels.txt"
NOTE = note_root()      # the chapter when `CH`/`--ch` names one, else the whole note
OUT = ".lake/build/string-check"
RECS = f"{OUT}/records.jsonl"
run = lambda *a, **k: subprocess.run(a, capture_output=True, text=True, **k)


def export(sels, frame=None, tops=(), suffix=None):
    """ONE `diag-export --string --records` over `sels`: each selector's record — the file it drew,
    its panels and every bead's types, or why it drew none — keyed by the selector field, and the
    run.  `save_recs` keeps the merged records in `RECS`, which `scanline --records` reads for the
    bead types, so the sweep does not start Lean again to re-read the statements this run drew.

    `frame` is the box every selector of the run is drawn in and `tops` the row each PANEL's first
    bead sits on (`-` for one the exporter places itself), so one run holds only the selectors whose
    note panels ask for the same pair.  `suffix` names the FILES the run writes (`<sel><suffix>`),
    so a selector drawn once per display keeps one file per drawing instead of one they overwrite."""
    if not sels:
        return {}, None                   # nothing to draw starts no Lean
    os.makedirs(OUT, exist_ok=True)
    opt = [] if frame is None else ["--frame", str(frame)]
    if any(t is not None for t in tops):
        opt += ["--top", ",".join("-" if t is None else str(t) for t in tops)]
    if suffix:
        opt += ["--suffix", suffix]
    p = run("./scripts/diag-export", "--string", "--records", *opt, *sels)
    return {o["selector"]: o for o in map(json.loads, p.stdout.splitlines())}, p


def save_recs(recs):
    """The records `scanline --records` reads for the bead types.  Written once, from the MERGED
    records of every export pass, so a selector re-drawn at the display's frame is the one the
    sweep reads — where writing each pass's own stdout left the last pass's subset behind.  One
    line per SELECTOR is enough however many displays draw it: what a bead is an arrow between is
    the statement's, and the box it is drawn in does not move it."""
    os.makedirs(OUT, exist_ok=True)
    open(RECS, "w", encoding="utf-8").write(
        "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in recs.values()))


def rowcount(v):
    """A row count as the NUMBER it is, which the readers hand back as a float: `frame: 3` comes
    back `3.0`, and `--frame`/`--top` take integer counts.  Anything else is no count at all."""
    return int(v) if isinstance(v, (int, float)) else None


def drawn_geom(recs, bases):
    """Each selector's panels' FRAME and TOP row counts, in panel order, off the file it drew — the
    pair the exporter wrote into each panel's own `cert:`, read by `scripts/diagram`'s reader and
    not by a pattern of this script's."""
    out = {}
    for b in bases:
        r = recs.get(b)
        if not r or "file" not in r or not os.path.exists(r["file"]):
            continue
        text = open(r["file"], encoding="utf-8").read()
        out[b] = [(rowcount(c.get("frame")), rowcount(c.get("top")))
                  for _, _, _, c in diagram.literals(text, drawable=False)]
    return out


def redraw_as_noted(recs, rows, live, num, want):
    """THE FRAME AND THE TOP ARE THE DISPLAY'S, AND THE NOTE STATES BOTH.  How deep a panel's box
    is, and which row inside it the first bead sits on, say nothing about which arrow it draws —
    they are how A DISPLAY lines its panels up — so the note's own drawn height is the box, its
    `cert: top` the bead height, and a panel Lean draws one row shallower or one row higher is the
    same picture in the wrong place.  THE UNIT A RE-EXPORT IS KEYED BY IS THEREFORE (DISPLAY,
    SELECTOR), never the selector alone: a statement two displays draw is two drawings, and the one
    that asks for row 4 and the one that asks for row 2 are both right.  Each is re-drawn at the
    frame and the tops ITS display's panels name (`diag-export --frame N --top t,t`, both per run,
    hence one run per distinct (frame, tops, file-suffix)), and only where that differs from what
    the first pass drew.  A panel the note gives no top passes `-` and keeps the exporter's own
    placement.  The runs are returned so a failure in one is reported like the first pass's, with
    the per-(display, selector) records `answer` reads beside them.

    ONE SELECTOR, ONE FILE — until two displays ask it for different boxes, when one name cannot
    hold both pictures and each drawing takes a file carrying its display (`<sel>.<display>.typ`,
    `diag-export --suffix`).  A display whose box is the one the first pass already drew keeps that
    plain file and starts no second run.

    Within ONE display there is still one box and one bead height per panel: the two sides of a
    statement share a box by construction, so two frames there, or two tops at one panel index, is
    a defect of the note's own pair — reported, rather than resolved by picking one.

    EVERY NOTE PANEL THE SELECTOR ANSWERS NEEDS A FRAME DECISION, so the box is read off the panel's
    own DRAWN height (`rows`, which `dpanel` emits for every panel) and not off its `cert: frame`.
    A panel that declares none still HAS a box — `place`'s default, one row deeper than the panel —
    and asking only the panels that declare one enumerated the records instead of the obligations:
    the undeclared panel went unreported and was then compared against the box its PARTNER
    declared (`13.3.2a`'s second panel, drawn 2 deep, against its partner's 6)."""
    geom = drawn_geom(recs, sorted(recs))
    want_at, tops_at, clash, high = {}, {}, [], []
    for n, sels in rows:
        if n not in live or not num(n).startswith(want) or len(sels) != len(live[n]):
            continue
        for sel, panel in zip(sels, live[n]):
            if sel == "-":
                continue
            b, k = route(sel)
            f = rowcount(panel.get("rows"))
            if b not in geom or f is None:
                continue
            if want_at.setdefault((n, b), f) != f:
                clash.append((n, sel, want_at[n, b], f))
            # THE TOP IS PER PANEL, so it is kept per panel and never folded into one value: the two
            # sides of a statement share one box by construction and pick their bead heights apart.
            t = rowcount((panel.get("cert") or {}).get("top"))
            seen = tops_at.setdefault((n, b), {})
            if t is not None and seen.setdefault(k, t) != t:
                high.append((n, sel, seen[k], t))
    for n, sel, a, b in clash:
        print(f"{n} {sel}: FRAME — this display's panels for one selector are drawn {a} and {b}"
              f" rows deep, so there is no one box to redraw it in")
        want_at.pop((n, route(sel)[0]), None)
        tops_at.pop((n, route(sel)[0]), None)
    for n, sel, a, b in high:
        print(f"{n} {sel}: TOP — this display's panels for one selector put its first bead on rows"
              f" {a} and {b}, so there is no one height to redraw it at")
        tops_at.get((n, route(sel)[0]), {}).pop(route(sel)[1], None)
    ask = {(n, b): (m, tuple(tops_at[n, b].get(k) for k in range(len(geom[b]))))
           for (n, b), m in want_at.items()}
    boxes = {}
    for (_, b), g in ask.items():
        boxes.setdefault(b, set()).add(g)
    by = {}
    for (n, b), (m, ts) in ask.items():
        if any(f is not None and f != m or ts[k] is not None and ts[k] != t
               for k, (f, t) in enumerate(geom[b])):
            by.setdefault((m, ts, f".{n}" if len(boxes[b]) > 1 else None), []).append((n, b))
    runs, at = [], {}
    for (m, ts, sfx), ks in sorted(by.items(), key=repr):
        bs = sorted({b for _, b in ks})
        again, p = export(bs, frame=m, tops=ts, suffix=sfx)
        if sfx is None:
            recs.update(again)      # the selector's one drawing, in the file the first pass wrote
        for n, b in ks:
            # NO FALLBACK TO THE PICTURE IT REPLACES: a re-draw that wrote no record leaves the
            # display's panel with a drawing in a box nobody asked for, so the missing record IS
            # this display's answer, and `unanswered` prints the run's own words below.
            at[n, b] = again.get(b, {"selector": b, "error": f"the re-draw at {n}'s own frame wrote"
                                     f" no record for it; its stderr is below"})
        runs.append((again, bs, p))
    return runs, at


def answer(recs, at, disp, base):
    """The picture `base` is drawn in FOR THE DISPLAY `disp`, or why there is none — from the
    record of the re-draw made for that display, and from the first pass's record only where the
    display asked for no re-draw.  A record holds exactly one of `file` and `error`; a selector
    with no record at all is answered by `unanswered`, from the exporter's own words."""
    r = at.get((disp, base), recs.get(base))
    if r is None:
        return None, "the exporter wrote no record for it; its stderr is below"
    return (r["file"], None) if "file" in r else (None, r["error"])


def unanswered(recs, sels, p):
    """The exporter's stderr IN FULL when no record says what went wrong: a selector with no record
    (the run died before it), or a nonzero exit while every record names a file.  1 if printed."""
    lack = [s for s in sels if s not in recs]
    if not sels or not lack and not (p.returncode and all("file" in r for r in recs.values())):
        return 0
    print(f"./scripts/diag-export --string --records exited {p.returncode}"
          + (f" and wrote no record for {', '.join(lack)}" if lack else "") + "; its stderr:")
    print(p.stderr)
    return 1


def note_panels():
    """Every panel the note draws, grouped by the display's NAME, in document order — the note's own
    metadata.  The name is the `#disp` LABEL, which `note-style.typ` emits beside the number every
    display carries, because a number moves with every heading and a manifest keyed by one answers
    for the wrong display without saying so.  A display the note leaves unlabelled has no name to
    key by and is named by its number; `number` says which number each name stands for, `bare` which
    names are numbers for want of a label."""
    p = run(os.path.join(ROOT, "scripts", "note-meta"))
    if p.returncode:
        sys.exit(f"string-check: note-meta failed:\n{p.stderr}")
    ms = [m for m in json.loads(p.stdout) if isinstance(m, dict)]
    name = {d["id"]: (d.get("label") or d["id"]) for d in ms if d.get("kind") == "disp"}
    out = {}
    for m in ms:
        if m.get("kind") == "scanline":
            d = m["disp"]
            out.setdefault(name.get(d, d), []).append(m)
    number = {v: k for k, v in name.items()}
    return out, number, {v for k, v in name.items() if v == k}


def obligations():
    """One line per display: the display's name and one selector per panel, through the reader both
    manifests are read by."""
    return [(name, sels) for sels, name, _ in panels.read(PANELS)]


def route(sel):
    """A selector, and which panel of the file it draws the note's panel must equal: `<sel>@<k>`
    names the k-th, a bare selector the first.  A path that names a STATEMENT draws every part of it
    in ONE frame — which is what a display placing the parts side by side needs, since the frame is
    the statement's and not the part's — so one selector then answers for several note panels."""
    base, _, k = sel.partition("@")
    return base, (int(k) - 1 if k else 0)


def diagram_args(cert):
    """A panel's `cert:` handed to `scripts/diagram` WHOLE.  Re-spelling it as flags means writing
    each mapping field (`sigs`, `tint`, `defn`) back in that flag's own pair syntax, and a field
    whose syntax this got wrong — or did not know about — came back as a parse error naming
    nothing; `--cert` reads the cert with the same code `--compare` does."""
    return ["--cert", json.dumps(cert, ensure_ascii=False)]


def content(path):
    """A compiled panel's own `hm-meta` — lanes, beads, object wire, ports — or the typst error."""
    p = run("typst", "query", "--root", ".", path, "metadata", "--field", "value")
    if p.returncode:
        return None, next((l.strip() for l in p.stderr.splitlines() if l.startswith("error")),
                          "compile failed")
    ms = [m for m in json.loads(p.stdout) if isinstance(m, dict) and m.get("kind") == "scanline"]
    return (ms[0], None) if ms else (None, "the file draws no panel")


def lanelab(rec):
    """A lane's NAME, by `dpanel`'s own `dnm`: its 4th element where the lane carries one, and
    otherwise the label the port list writes at the edge that lane reaches — the two places on the
    page one wire can be read.  A lane's 2nd element is its TOP HEIGHT, so reading it the way a
    bead's label is read compared two coordinates and called a renamed lane equal."""
    port = lambda side, x: next((p[1] for p in rec.get(side) or [] if p[0] == x), None)
    return [l[3] if l[3] is not None else port("top" if l[1] == "top" else "bot", l[0])
            for l in rec.get("lanes") or []]


def why(n, g):
    """What the two panels disagree about, named by the thing that is wrong rather than by a count:
    a lane's label, a bead's, the object wire's, the ports, a bead the generator spiders."""
    lab = lambda xs: [x[1] for x in xs or []]
    out = []
    if lanelab(n) != lanelab(g):
        out.append(f"lanes {lanelab(n)} vs {lanelab(g)}")
    for k in ("beads", "obj"):
        if lab(n.get(k)) != lab(g.get(k)):
            out.append(f"{k} {lab(n.get(k))} vs {lab(g.get(k))}")
    if lab(n.get("top")) != lab(g.get("top")) or lab(n.get("bot")) != lab(g.get("bot")):
        out.append(f"ports {lab(n.get('top'))}->{lab(n.get('bot'))} vs "
                   f"{lab(g.get('top'))}->{lab(g.get('bot'))}")
    # A BEAD'S MARK, bead by bead — the verdict each one is drawn with, `dpanel`'s 6th element,
    # defaulting as the drawing defaults it.  Reading the `cert: nat` rows instead named a spider on
    # every panel that carries any verdict at all, the proved strict ones included, because a row
    # there says the tool LOOKED, not that the bead lost its dot.
    ver = lambda xs: [x[5] if len(x) > 5 else "strict" for x in xs or []]
    if ver(n.get("beads")) != ver(g.get("beads")):
        out.append(f"marks {ver(n.get('beads'))} vs {ver(g.get('beads'))}")
    # A UNIT IS A BEAD TOO, and it is the one bead that is not in `beads`: the wire it is born on
    # carries it, so its name and its mark are the LANE's 5th and 6th elements.  Reading `beads`
    # alone left `𝟙%∋` drawn lax against a `singletonMap_natural` the export cites as strict, on
    # the very panel whose object wire the gate did catch — the same hole, one tuple over.
    unit = lambda xs: [(x[4], x[5] if len(x) > 5 else "strict")
                       for x in xs or [] if len(x) > 4 and x[4] is not None]
    if unit(n.get("lanes")) != unit(g.get("lanes")):
        out.append(f"units {unit(n.get('lanes'))} vs {unit(g.get('lanes'))}")
    return "; ".join(out)


def wrap(path, body):
    # A BOX IS HEADROOM ONLY, so the box is not drawn.  The page is auto-sized to the panel, so a
    # page FILL is a rectangle of the box's own depth, and comparing two panels that state different
    # `cert: frame`s then reported the box as the difference — which says nothing about which arrow
    # the panel draws (the author, 2026-09-13: "bead floor or roof: doesn't matter").  Nothing looks
    # at these files; they are compiled for `svg-diff` and `typst query` alone.
    open(path, "w", encoding="utf-8").write(
        '#set page(width: auto, height: auto, margin: 0.3cm, fill: none)\n' + body)


def svg(src, dst):
    p = run("typst", "compile", "--root", ".", "--format", "svg", src, dst)
    return None if not p.returncode else p.stderr.strip().splitlines()[-1:] or ["compile failed"]


def heights(rec):
    """Every height the panel's own record names — its beads' and its object wire's — as a row
    counted DOWN FROM THE TOP of the box (`h` is `rows` rows of `dpanel`'s own `DY`, measured up).
    From the top because that is the end a display lines its panels up on and what `cert: top`
    states: a box one row deeper with the drawing hanging from its floor has moved the drawing down
    by a row, which measuring up from the floor calls no move at all."""
    dy = rec["h"] / rec["rows"] if rec.get("rows") else None
    ys = [b[0] for b in (rec.get("beads") or [])] + [o[0] for o in (rec.get("obj") or [])]
    return None if not dy or not ys else [rec["rows"] - y / dy for y in ys]


def rowshift(a, b):
    """HOW FAR ONE PANEL'S ROWS SIT ABOVE THE OTHER'S, or None where no ONE number says it: the two
    records name different numbers of heights, or heights that do not all differ by the same amount.
    Which row a bead sits on inside its box is not part of which arrow the panel draws — the author,
    2026-09-13: "bead floor or roof: doesn't matter, they need to align bead with other diagram if
    there is an (in)equation" — and the panels of one display align on the row the DISPLAY gives
    them, which is why the two sides of this comparison legitimately differ by it."""
    p, q = heights(a), heights(b)
    if p is None or q is None or len(p) != len(q):
        return None
    ds = {round(x - y, 6) for x, y in zip(p, q)}
    return ds.pop() if len(ds) == 1 else None


def ymatch(kind, v, w, dy):
    """The heights of `w` that `v` reads as, where every height either stayed or moved by `dy` — or
    None where the two primitives are not the same shape drawn at the same x.  A HEIGHT chooses, not
    a slot: the wire a bead sits on is ONE wire drawn as two segments, so their shared joint moves
    with the bead while each segment's other end, at the panel's edge, does not."""
    n = svgdiff.NPOS[kind]
    n = len(v) if n is None else n
    if len(v) != len(w):
        return None
    m = {}
    for i, (a, b) in enumerate(zip(v, w)):
        if i >= n or i % 2 == 0:      # a size or a name, or an x: a sideways offset is a difference
            if svgdiff.differs(a, b):
                return None
        elif not svgdiff.differs(a, b):
            m[b] = b
        elif not svgdiff.differs(a, b + dy):
            m[b] = a
        else:
            return None
    return m


def band(xs, ys, dy):
    """Every primitive of `xs` paired with one of `ys` under the one shift `dy`, and the height map
    the pairing read — None where anything is left over on either side, or where two primitives read
    one height two ways."""
    left, m = list(ys), {}
    for k, v in xs:
        for i, (j, w) in enumerate(left):
            mm = ymatch(k, v, w, dy) if j == k else None
            if mm is None or any(svgdiff.differs(m[y], z) for y, z in mm.items() if y in m):
                continue
            m.update(mm)
            del left[i]
            break
        else:
            return None
    return None if left else m


def rising(m):
    """The height map keeps the ORDER of the heights.  Without this a free choice per height would
    let one wire end where another's did — a wire drawn short against a wire drawn long reads as the
    shift that happens to span them — where an order-keeping map can only say that one BAND of rows
    slid and the rest stayed."""
    ks = sorted(m)
    return all(m[a] < m[b] for a, b in zip(ks, ks[1:]))


def yvals(xs):
    """Every height a bag of primitives names, once each."""
    return {v[i] for k, v in xs
            for i in range(1, len(v) if svgdiff.NPOS[k] is None else svgdiff.NPOS[k], 2)}


def sameband(note, gen):
    """A PANEL'S ROWS MAY SIT ANYWHERE IN ITS BOX: true where the two compiled panels are the same
    drawing with one band of its heights moved.  The shift is the one that explains the most heights
    the two do not already share, and the panel is accepted only if it then explains ALL of them —
    every primitive of each side paired with one of the other at the same x, every height either
    stayed or moved by that one shift, and the height map keeping the order.  The horizontal offset
    removed is the one `svg-diff` itself removes and nothing more, so a sideways shift stays a
    difference."""
    ga, gb = svgdiff.collect(note)[0], svgdiff.collect(gen)[0]
    # `best_offset`'s VERTICAL component is deliberately dropped: it anchors on whichever band holds
    # the more primitives, so keeping it would make the verdict depend on which side of the shift
    # happened to be larger, where this rule must read the same either way.
    gb = svgdiff.shift(gb, (-svgdiff.best_offset(ga, gb)[0], 0.0))
    la, lb = yvals(svgdiff.unmatched(ga, gb)), yvals(svgdiff.unmatched(gb, ga))
    seen = lambda d: sum(any(not svgdiff.differs(a, b + d) for a in la) for b in lb)
    for dy in sorted({a - b for a in la for b in lb}, key=lambda d: (-seen(d), d)):
        m = band(ga, gb, dy)
        if m is not None and rising(m):
            return True
    return False


def fields(g):
    """A `cert:` group's top-level fields.  Depth-aware and quote-aware, because a value holds both
    brackets and commas of its own (`expect: "⦇[nil,(π₁p→cons,⊸nil)]⦈"`), and a split on every
    comma would cut one field into three that name nothing."""
    out, d, q, s = [], 0, False, 0
    for x, ch in enumerate(g):
        q ^= ch == '"'
        if q:
            continue
        d += (ch == "(") - (ch == ")")
        if ch == "," and d == 0:
            out.append(g[s:x])
            s = x + 1
    return [f.strip() for f in out + [g[s:]] if f.strip()]


def setnat(lit, nat):
    """One `dpanel(` literal with Lean's verdicts written into its `cert:`, replacing whatever `nat`
    it carried.  Only the CERT is touched: the picture itself is rebuilt from it by
    `./scripts/diagram --write`, which is the one place a panel is drawn."""
    k = lit.rfind("cert: (")
    e = diagram.close(lit, k + 6) + 1
    fs = [f for f in fields(lit[k + 7:e - 1]) if not f.startswith("nat: ")]
    q = lambda s: '"' + s.replace("\\", "\\\\") + '"'
    fs.append("nat: (" + ", ".join("(" + ", ".join(q(x) for x in t) + ")" for t in nat)
              + ("," if len(nat) == 1 else "") + ")")
    return lit[:k + 7] + ", ".join(fs) + lit[e - 1:]


def marks(want):
    """WHERE A BEAD'S MARK COMES FROM.  `diag/hm-sigs.json` holds one `nat` per bead LABEL, and a
    verdict belongs to a bead in a REGION: the same `𝟙%∋` is strict on §14.1's `E` and lax on
    §13.6.7a's, so a global row draws one of them wrong whatever it says.  The exporter already
    decides per panel, from the environment (`diag/tool/StringDiagram.lean`), and writes what it
    found into each generated panel's `cert: nat`.  This copies that — verdict and the declaration
    behind it — into the note's own `cert:`, through the SAME pairing the gate checks by, so the
    note's mark and Lean's verdict cannot come from two different readings.

    The note's panels are matched to its source literals by their `cert:` — expect, src and tgt,
    the fields that say which arrow the panel draws — and never by position, so a `dpan` or a
    hand-laid panel between two generated ones cannot shift the whole file by one."""
    live, number, _ = note_panels()
    rows, num = obligations(), lambda n: number.get(n, n)
    sel_of = [(n, sels) for n, sels in rows if n in live and num(n).startswith(want)]
    todo = sorted({route(s)[0] for _, sels in sel_of for s in sels if s != "-"})
    # A selector the exporter REFUSES is one panel's failure, not the run's: it exits non-zero for
    # the whole batch, and the reason its record names is reported against the panel that wanted
    # it, below, the way the gate reports it.  Stopping here would leave every other panel's mark
    # unwritten.
    recs, p = export(todo)
    save_recs(recs)
    nat, miss = {}, 0
    for n, sels in sel_of:
        ps = live[n]
        if len(sels) != len(ps):
            print(f"{n}: MISCOUNT — {PANELS} names {len(sels)} selector(s) for {len(ps)} panels")
            miss += 1
            continue
        for sel, panel in zip(sels, ps):
            if sel == "-":
                continue
            base, which = route(sel)
            # A VERDICT IS NOT GEOMETRY: what a bead's mark is does not move with the box or the
            # bead height, so marks are read off the one drawing per selector and want no re-draw
            # per display — hence no per-(display, selector) records to answer from.
            gen, err = answer(recs, {}, n, base)
            if err:
                print(f"{n} {sel}: CANNOT-DRAW {err}")
                miss += 1
                continue
            gwrap = f"{OUT}/{sel}.gen.typ"
            wrap(gwrap, f'#import "/{gen}": panels\n#panels.at({which})\n')
            drew, err = content(gwrap)
            if err:
                print(f"{n} {sel}: CANNOT-DRAW {err}")
                miss += 1
                continue
            c = panel.get("cert") or {}
            if not all(c.get(f) for f in ("expect", "src", "tgt")):
                print(f"{n} {sel}: UNCERTIFIED — the note's panel names no expect/src/tgt")
                miss += 1
                continue
            nat.setdefault((c["expect"], c["src"], c["tgt"]), []).append(
                [list(t) for t in (drew.get("cert") or {}).get("nat") or []])
    text = note_source(NOTE)
    wrote = 0
    # LAST TO FIRST, so an earlier literal's offsets are still the ones this read; and the note's
    # panels were collected in document order, so a formula drawn twice takes its verdicts from the
    # panel at the same place in that order.
    for i, _, j, c in reversed(diagram.literals(text)):
        got = nat.get((c.get("expect"), c.get("src"), c.get("tgt")))
        if not got:
            continue
        v = got.pop()
        if v:
            text = text[:i] + setnat(text[i:j], v) + text[j:]
            wrote += 1
    left = sum(len(v) for v in nat.values())
    note_write(NOTE, text)
    print(f"string-check --marks: {wrote} panel(s) carry Lean's verdicts; {left} panel(s) the note"
          f" draws no `dpanel(` literal for; {miss} not drawn")
    return 1 if unanswered(recs, todo, p) or miss or left else 0


def main(argv):
    argv = take_chapter(argv)
    if "--marks" in argv:
        return marks(next((a for a in argv if not a.startswith("-")), ""))
    # `make scan-generated`'s obligations are these, and they are read by the SAME reader as this
    # gate's, so the two cannot come to disagree about what the manifest names.
    if "--selectors" in argv:
        print(*sorted({route(s)[0] for _, sels in obligations() for s in sels if s != "-"}),
              sep="\n")
        return 0
    want = argv[0] if argv else ""
    os.makedirs(OUT, exist_ok=True)
    live, number, bare = note_panels()
    rows = obligations()
    # A DISPLAY IS NAMED BY ITS LABEL AND ADDRESSED BY ITS NUMBER: the number is what the reader of
    # the report looks up in the note and what a section argument selects on, the label what the
    # manifest keys by.  `want` therefore filters the NUMBER, not the name.
    num = lambda n: number.get(n, n)
    addr = lambda n: n if num(n) == n else f"{num(n)}/{n}"
    # A section the scoped note does not hold is a MISTAKE, never an empty report: with `CH` naming
    # one chapter, `13.4` asked of chapter 12 would otherwise check nothing and exit 0.
    if want and not any(num(n).startswith(want) for n in live):
        sys.exit(f"string-check: no display {want} in {NOTE} — it draws "
                 + ", ".join(sorted({num(n) for n in live})[:8]) + ", …")
    rc, named = 0, {n for n, _ in rows}
    for n in live:
        if n not in named:
            print(f"{addr(n)}: MISSING — the note draws {len(live[n])} panel(s) here and {PANELS}"
                  f" names no line for it, so nothing is held to them")
            rc = 1
    for n, sels in rows:
        if n not in live:
            print(f"{n}: STALE — {PANELS} names a display the note no longer draws")
            rc = 1
    for n in sorted(bare & named):
        print(f"{n}: UNLABELLED — the note's display carries no `#disp` label, so {PANELS} keys it"
              f" by its number, which the next heading change moves")

    todo = sorted({route(s)[0] for n, sels in rows if n in live and num(n).startswith(want)
                   for s in sels if s != "-"})
    # The RECORD answers "did it draw"; the pictures about to be drawn are still deleted first, so a
    # selector the exporter refuses leaves no LAST run's picture on disk for another sweep to pass.
    for s in todo:
        if os.path.exists(f"diag/generated/string/{s}.typ"):
            os.remove(f"diag/generated/string/{s}.typ")
    recs, exp = export(todo)
    # SECOND PASS: a display whose panels came out in a box or at a bead height the note does not
    # ask for is re-drawn at the note's own — per (display, selector), since the box is the
    # display's, so `at` and not `recs` says which picture a given display's panel is held to.
    again, at = redraw_as_noted(recs, rows, live, num, want)
    save_recs(recs)
    # Each slot answers one line of the report, in DOCUMENT order: a verdict already decided, or one
    # waiting on its selector's drawing and on the sweep of its picture.
    done = lambda line, failed: lambda: (line, failed)

    def pending(head, sel, i, gen):
        def verdict():
            end, v, ok = drew[sel].result()[i]
            if not end:
                r = swept.result()[gen]
                fs = r["failures"] + r["unhandled"] + ["the picture was never drawn"] * r["missing"]
                end = f"SWEEP {len(fs)} failure(s); the first: {fs[0]}" if fs else None
            return f"{head}: {end or v}", bool(end) or not ok
        return verdict

    slots, groups = [], {}
    for n, sels in rows:
        if n not in live or not num(n).startswith(want):
            continue
        ps = live[n]
        if len(sels) != len(ps):
            slots.append(done(f"{addr(n)}: MISCOUNT — {PANELS} names {len(sels)} selector(s) for"
                              f" {len(ps)} panels", True))
            continue
        for k, (sel, panel) in enumerate(zip(sels, ps), 1):
            tag = f"{addr(n)}.{k}"
            if sel == "-":
                slots.append(done(f"{tag}: NO-DECL — no declaration is cited for this panel", False))
                continue
            base, which = route(sel)
            gen, err = answer(recs, at, n, base)
            if err:
                slots.append(done(f"{tag} {sel}: CANNOT-DRAW {err}", True))
                continue
            g = groups.setdefault(sel, [])
            slots.append(pending(f"{tag} {sel}", sel, len(g), gen))
            g.append((panel, which, gen))
    with ThreadPoolExecutor(os.cpu_count()) as pool:
        swept = pool.submit(sweep, sorted({gen for g in groups.values() for _, _, gen in g}))
        # One task per SELECTOR, its panels in order: two displays citing one selector share its
        # wrapper files, so they are drawn one after the other as a serial run drew them.
        drew = {s: pool.submit(lambda s, g: [compare(s, *x) for x in g], s, g)
                for s, g in groups.items()}
        for slot in slots:
            line, failed = slot()
            print(line)
            rc |= failed
    # An export that answered every selector with a file and still exited nonzero is reported by NO
    # line above, so it would leave the gate green on a failure; nor has a selector with no record a
    # reason of its own.  Both are answered by the exporter's stderr — the re-draw pass's runs too,
    # whose failure would otherwise be reported by nothing at all.
    rc |= unanswered(recs, todo, exp)
    for r, bs, p in again:
        rc |= unanswered(r, bs, p)
    return rc


def compare(sel, panel, which, gen):
    """One panel drawn from LEAN and from its `cert:`, and the two compared: the failure that ends
    it, or none and `svg-diff`'s verdict — which stands only once the sweep of `gen` passes.  The
    third field is whether the panel PASSES, because a verdict now names the row shift it accepted
    and a test of the verdict's own text would have read `ok (dy …)` as a failure."""
    gwrap, nwrap = f"{OUT}/{sel}.gen.typ", f"{OUT}/{sel}.note.typ"
    wrap(gwrap, f'#import "/{gen}": panels\n#panels.at({which})\n')
    drew, err = content(gwrap)
    if err:
        return f"CANNOT-DRAW {err}", None, False
    cert = panel.get("cert") or {}
    if not all(cert.get(f) for f in ("expect", "src", "tgt")):
        return (f"UNCERTIFIED — the note's panel's `cert:` names no"
                f" {', '.join(f for f in ('expect', 'src', 'tgt') if not cert.get(f))}, so"
                f" there is nothing to rebuild it from"), None, False
    p = run("./scripts/diagram", *diagram_args(cert))
    if p.returncode or not p.stdout.strip():
        return f"NOTE-UNDRAWABLE {p.stderr.strip().splitlines()[-1:]}", None, False
    # `frc` too: a `%∋` in a label is drawn as the note's own fraction, and `scripts/diagram`
    # emits the call — so the wrapper needs what the NOTE imports, not `dpanel` alone.
    wrap(nwrap, '#import "/diag/dpanel.typ": *\n#import "/diag/circuit.typ": frc\n' + p.stdout)
    e = svg(gwrap, f"{OUT}/{sel}.gen.svg") or svg(nwrap, f"{OUT}/{sel}.note.svg")
    if e:
        return f"CANNOT-DRAW typst {e}", None, False
    v = run("./scripts/svg-diff", "--records", f"{OUT}/{sel}.note.svg", f"{OUT}/{sel}.gen.svg")
    if v.returncode > 1:
        last = (v.stderr.strip().splitlines() or ["no stderr"])[-1]
        return f"CANNOT-CHECK ./scripts/svg-diff exited {v.returncode}: {last}", None, False
    # EVERY OBLIGATION `why` ENUMERATES DECIDES, and the ink is one more of them rather than
    # the gate: a bead's mark is a handful of points (a filled dot against a hollow ring)
    # that `svg-diff` pairs off with each other, so a panel whose one defect was a lax bead
    # drawn strict came back `ok` and the verdict decided nothing.  Either side failing fails.
    d = why(panel, drew)
    # THE ROW THE BEADS SIT ON INSIDE THE BOX IS NOT A DIFFERENCE, and the shift is named rather
    # than swallowed: `sameband` says the two are the same drawing with one band of heights moved,
    # and the panels' own records say by how many ROWS.  Both must answer — a geometry shift no row
    # record states, or a row record no geometry bears out, is the DIFF it always was.
    if v.returncode and not d and sameband(f"{OUT}/{sel}.note.svg", f"{OUT}/{sel}.gen.svg"):
        c = rowshift(panel, drew)
        if c is not None:
            box = "" if panel["rows"] == drew["rows"] else \
                f", box {panel['rows']:g} vs {drew['rows']:g}"
            # `+ 0` because a shift of none comes out of the subtraction as `-0.0`, which prints as
            # a direction it does not have.
            return None, (f"ok (dy {c + 0:+g} row{'' if abs(c) == 1 else 's'}{box})"), True
    if v.returncode or d:
        recs = [json.loads(l) for l in v.stdout.splitlines() if l.strip()]
        n = [r for r in recs if r["layer"] == "geometry"]
        kinds = sorted({r["kind"] for r in n})
        m = [r for r in recs if r["layer"] == "glyph"]
        return None, (f"DIFF {len(n)} unmatched primitive(s)"
                       f"{' ' + '/'.join(kinds) if kinds else ''}"
                       f"{f'; {len(m)} glyph box(es) differ' if m else ''}; {d}"), False
    return None, "ok", True


def sweep(gens):
    """ONE `scanline --strict` over every picture a panel is drawn from — a file holds several
    panels and is swept once for them all — and each file's verdict read from its `--result`
    fields, keyed by the path as given.  Its bead types come from the export's `RECS`."""
    if not gens:
        return {}
    res = f"{OUT}/sweep.json"
    if os.path.exists(res):
        os.remove(res)
    s = run("./scripts/scanline", "--strict", "--result", res, "--records", RECS, *gens)
    rs = json.load(open(res, encoding="utf-8")) if os.path.exists(res) else []
    if not rs or s.returncode and not any(r["failures"] or r["unhandled"] or r["missing"]
                                          for r in rs):
        sys.exit(f"string-check: ./scripts/scanline --strict exited {s.returncode} with no verdict"
                 f" naming a file:\n{s.stderr.strip() or s.stdout.strip()}")
    return {r["path"]: r for r in rs}


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
