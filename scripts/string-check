#!/usr/bin/env python3
"""string-check — the note's string diagrams' gate.  Every Hinze–Marsden panel the note draws is an
obligation `diag/string-panels.txt` states, and this redraws it from LEAN and holds the two to each
other.

    ./scripts/string-check            # every display
    ./scripts/string-check 13.6       # only the displays whose number starts so
    ./scripts/string-check --selectors  # the manifest's selectors, one per line, for `make`
    ./scripts/string-check --marks 14.1 # write Lean's per-panel verdicts into the note's `cert:`s
    ./scripts/string-check --write 14.1 # and Lean's own drawing into every panel graded DIFF
    ./scripts/string-check --lean       # every panel becomes `lean("<selector>")` and nothing else

THREE OBLIGATIONS, each enumerated from what MUST have an answer rather than from what has one:
  every display   the note draws (`typst query`, `kind == "scanline"`) has a line in the file — a
                  display the file does not name fails here rather than going unchecked, and a line
                  naming a display the note no longer holds fails too;
  every panel     of a display whose line names a selector is drawn by `diag-export --string`,
                  swept by `scanline --strict`, and compared to the note's own panel — drawn in
                  THAT DISPLAY's box, since the frame and the bead heights are how a display lines
                  its panels up, so one selector two displays draw is drawn once for each;
  every selector  the file names is drawn, so a declaration whose statement the exporter refuses is
                  reported as CANNOT-DRAW rather than dropped.

WHY THERE IS NO REGEX OVER THE NOTE.  The panels come out of `typst query` as the note's own
metadata — id, `cert`, lanes, beads, ports — so nothing here reads the `.typ` source.  The note side
of each comparison is the panel `scripts/diagram` rebuilds from that same `cert:`, which
`make pairs`/`diagram --compare` already holds to the literal in the note; the Lean side is
`diag-export --string`.  Both are compiled to SVG and put to `scripts/svg-diff`, which compares
drawn PRIMITIVES, not text.  One thing is genuinely out of reach: a display's `lean:` marker is a
Typst COMMENT, invisible to `typst query`, so the selector column of `diag/string-panels.txt` was
authored once (through `scripts/cite-cover`'s own note reader) and is static — the gate never
re-derives it, and a display whose line carries no selector is reported NO-DECL.
"""
import importlib.machinery
import importlib.util
import json
import os
import sqlite3
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "scripts"))
import panels                                    # noqa: E402  — the manifests' one reader
# The note is one file per chapter (`scripts/note-split`): read a split root as the one document it
# stands for, and write back through the split so a rewritten `cert:` lands in the chapter holding it.
from notesplit import note_files, note_root, take_chapter, typst_string    # noqa: E402
# `scripts/diagram` is the note's reader as well as its generator: `literals` and `close` are how a
# `dpanel(` and its `cert:` are cut out of the source, and --marks writes into that same cut rather
# than pattern-matching the note a second time.  It has no `.py`, hence the loader.
diagram = importlib.util.module_from_spec(importlib.util.spec_from_loader(
    "diagram", importlib.machinery.SourceFileLoader("diagram", os.path.join(ROOT, "scripts",
                                                                            "diagram"))))
diagram.__loader__.exec_module(diagram)
# `scripts/svg-diff` IS the primitive matcher, and the band rule below is one more of its matches
# rather than a second reader of SVG: `collect`, `best_offset`, `shift`, `unmatched`, `differs` and
# `NPOS` all come from there, so the two cannot come to disagree about what a primitive is.  It has
# no `.py` either, hence the same loader.
svgdiff = importlib.util.module_from_spec(importlib.util.spec_from_loader(
    "svgdiff", importlib.machinery.SourceFileLoader("svgdiff", os.path.join(ROOT, "scripts",
                                                                           "svg-diff"))))
svgdiff.__loader__.exec_module(svgdiff)
# `scripts/cite-check` is the note's MARKER reader: `MARK` cuts one out of a line and `resolve` turns
# the name it carries into the declaration the index knows, which is the only way a marker and a
# `lean()` selector can be held to name one thing rather than to spell alike.  No `.py`, same loader.
citecheck = importlib.util.module_from_spec(importlib.util.spec_from_loader(
    "citecheck", importlib.machinery.SourceFileLoader("citecheck", os.path.join(ROOT, "scripts",
                                                                               "cite-check"))))
citecheck.__loader__.exec_module(citecheck)
os.chdir(ROOT)
sys.stdout.reconfigure(line_buffering=True)   # a long run's report must be readable while it runs
PANELS = "diag/string-panels.txt"
NOTE = note_root()      # the chapter when `CH`/`--ch` names one, else the whole note
OUT = ".lake/build/string-check"
RECS = f"{OUT}/records.jsonl"
run = lambda *a, **k: subprocess.run(a, capture_output=True, text=True, **k)


def export(sels, frame=None, tops=(), suffix=None):
    """ONE `diag-export --string --records` over `sels`: each selector's record — the file it drew,
    its panels and every bead's types, or why it drew none — keyed by the selector field, and the
    run.  `save_recs` keeps the merged records in `RECS`, which `scanline --records` reads for the
    bead types, so the sweep does not start Lean again to re-read the statements this run drew.

    `frame` is the box every selector of the run is drawn in and `tops` the row each PANEL's first
    bead sits on (`-` for one the exporter places itself), so one run holds only the selectors whose
    note panels ask for the same pair.  `suffix` names the FILES the run writes (`<sel><suffix>`),
    so a selector drawn once per display keeps one file per drawing instead of one they overwrite."""
    if not sels:
        return {}, None                   # nothing to draw starts no Lean
    os.makedirs(OUT, exist_ok=True)
    opt = [] if frame is None else ["--frame", str(frame)]
    if any(t is not None for t in tops):
        opt += ["--top", ",".join("-" if t is None else str(t) for t in tops)]
    if suffix:
        opt += ["--suffix", suffix]
    p = run("./scripts/diag-export", "--string", "--records", *opt, *sels)
    return {o["selector"]: o for o in map(json.loads, p.stdout.splitlines())}, p


def save_recs(recs):
    """The records `scanline --records` reads for the bead types.  Written once, from the MERGED
    records of every export pass, so a selector re-drawn at the display's frame is the one the
    sweep reads — where writing each pass's own stdout left the last pass's subset behind.  One
    line per SELECTOR is enough however many displays draw it: what a bead is an arrow between is
    the statement's, and the box it is drawn in does not move it."""
    os.makedirs(OUT, exist_ok=True)
    open(RECS, "w", encoding="utf-8").write(
        "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in recs.values()))


def rowcount(v):
    """A row count as the NUMBER it is, which the readers hand back as a float: `frame: 3` comes
    back `3.0`, and `--frame`/`--top` take integer counts.  Anything else is no count at all."""
    return int(v) if isinstance(v, (int, float)) else None


def drawn_geom(recs, bases):
    """Each selector's panels' FRAME and TOP row counts, in panel order, off the file it drew — the
    pair the exporter wrote into each panel's own `cert:`, read by `scripts/diagram`'s reader and
    not by a pattern of this script's."""
    out = {}
    for b in bases:
        r = recs.get(b)
        if not r or "file" not in r or not os.path.exists(r["file"]):
            continue
        text = open(r["file"], encoding="utf-8").read()
        out[b] = [(rowcount(c.get("frame")), rowcount(c.get("top")))
                  for _, _, _, c in diagram.literals(text, drawable=False)]
    return out


def redraw_as_noted(recs, rows, live, hasdisp):
    """THE FRAME AND THE TOP ARE THE DISPLAY'S, AND THE NOTE STATES BOTH.  How deep a panel's box
    is, and which row inside it the first bead sits on, say nothing about which arrow it draws —
    they are how A DISPLAY lines its panels up — so the note's own drawn height is the box, its
    `cert: top` the bead height, and a panel Lean draws one row shallower or one row higher is the
    same picture in the wrong place.  THE UNIT A RE-EXPORT IS KEYED BY IS THEREFORE (DISPLAY,
    SELECTOR), never the selector alone: a statement two displays draw is two drawings, and the one
    that asks for row 4 and the one that asks for row 2 are both right.  Each is re-drawn at the
    frame and the tops ITS display's panels name (`diag-export --frame N --top t,t`, both per run,
    hence one run per distinct (frame, tops, file-suffix)), and only where that differs from what
    the first pass drew.  A panel the note gives no top passes `-` and keeps the exporter's own
    placement.  The runs are returned so a failure in one is reported like the first pass's, with
    the per-(display, selector) records `answer` reads beside them.

    ONE SELECTOR, ONE FILE — until two displays ask it for different boxes, when one name cannot
    hold both pictures and each drawing takes a file carrying its display (`<sel>.<display>.typ`,
    `diag-export --suffix`).  A display whose box is the one the first pass already drew keeps that
    plain file and starts no second run.

    Within ONE display there is still one box and one bead height per panel: the two sides of a
    statement share a box by construction, so two frames there, or two tops at one panel index, is
    a defect of the note's own pair — reported, rather than resolved by picking one.

    EVERY NOTE PANEL THE SELECTOR ANSWERS NEEDS A FRAME DECISION, so the box is read off the panel's
    own DRAWN height (`rows`, which `dpanel` emits for every panel) and not off its `cert: frame`.
    A panel that declares none still HAS a box — `place`'s default, one row deeper than the panel —
    and asking only the panels that declare one enumerated the records instead of the obligations:
    the undeclared panel went unreported and was then compared against the box its PARTNER
    declared (`13.3.2a`'s second panel, drawn 2 deep, against its partner's 6)."""
    geom = drawn_geom(recs, sorted(recs))
    want_at, tops_at, clash, high = {}, {}, [], []
    for n, sels in rows:
        if n not in live or not hasdisp(n) or len(sels) != len(live[n]):
            continue
        for sel, panel in zip(sels, live[n]):
            if sel == "-":
                continue
            b, k = route(sel)
            f = rowcount(panel.get("rows"))
            if b not in geom or f is None:
                continue
            if want_at.setdefault((n, b), f) != f:
                clash.append((n, sel, want_at[n, b], f))
            # THE TOP IS PER PANEL, so it is kept per panel and never folded into one value: the two
            # sides of a statement share one box by construction and pick their bead heights apart.
            t = rowcount((panel.get("cert") or {}).get("top"))
            seen = tops_at.setdefault((n, b), {})
            if t is not None and seen.setdefault(k, t) != t:
                high.append((n, sel, seen[k], t))
    for n, sel, a, b in clash:
        print(f"{n} {sel}: FRAME — this display's panels for one selector are drawn {a} and {b}"
              f" rows deep, so there is no one box to redraw it in")
        want_at.pop((n, route(sel)[0]), None)
        tops_at.pop((n, route(sel)[0]), None)
    for n, sel, a, b in high:
        print(f"{n} {sel}: TOP — this display's panels for one selector put its first bead on rows"
              f" {a} and {b}, so there is no one height to redraw it at")
        tops_at.get((n, route(sel)[0]), {}).pop(route(sel)[1], None)
    ask = {(n, b): (m, tuple(tops_at[n, b].get(k) for k in range(len(geom[b]))))
           for (n, b), m in want_at.items()}
    boxes = {}
    for (_, b), g in ask.items():
        boxes.setdefault(b, set()).add(g)
    by = {}
    for (n, b), (m, ts) in ask.items():
        if any(f is not None and f != m or ts[k] is not None and ts[k] != t
               for k, (f, t) in enumerate(geom[b])):
            by.setdefault((m, ts, f".{n}" if len(boxes[b]) > 1 else None), []).append((n, b))
    runs, at = [], {}
    for (m, ts, sfx), ks in sorted(by.items(), key=repr):
        bs = sorted({b for _, b in ks})
        again, p = export(bs, frame=m, tops=ts, suffix=sfx)
        if sfx is None:
            recs.update(again)      # the selector's one drawing, in the file the first pass wrote
        for n, b in ks:
            # NO FALLBACK TO THE PICTURE IT REPLACES: a re-draw that wrote no record leaves the
            # display's panel with a drawing in a box nobody asked for, so the missing record IS
            # this display's answer, and `unanswered` prints the run's own words below.
            at[n, b] = again.get(b, {"selector": b, "error": f"the re-draw at {n}'s own frame wrote"
                                     f" no record for it; its stderr is below"})
        runs.append((again, bs, p))
    return runs, at


def answer(recs, at, disp, base):
    """The picture `base` is drawn in FOR THE DISPLAY `disp`, or why there is none — from the
    record of the re-draw made for that display, and from the first pass's record only where the
    display asked for no re-draw.  A record holds exactly one of `file` and `error`; a selector
    with no record at all is answered by `unanswered`, from the exporter's own words."""
    r = at.get((disp, base), recs.get(base))
    if r is None:
        return None, "the exporter wrote no record for it; its stderr is below"
    return (r["file"], None) if "file" in r else (None, r["error"])


def unanswered(recs, sels, p):
    """The exporter's stderr IN FULL when no record says what went wrong: a selector with no record
    (the run died before it), or a nonzero exit while every record names a file.  1 if printed."""
    lack = [s for s in sels if s not in recs]
    if not sels or not lack and not (p.returncode and all("file" in r for r in recs.values())):
        return 0
    print(f"./scripts/diag-export --string --records exited {p.returncode}"
          + (f" and wrote no record for {', '.join(lack)}" if lack else "") + "; its stderr:")
    print(p.stderr)
    return 1


def note_panels():
    """Every panel the note draws, grouped by the display's NAME, in document order — the note's own
    metadata.  The name is the `#disp` LABEL, which `note-style.typ` emits beside the number every
    display carries, because a number moves with every heading and a manifest keyed by one answers
    for the wrong display without saying so.  A display the note leaves unlabelled has no name to
    key by and is named by its number; `number` says which number each name stands for, `bare` which
    names are numbers for want of a label."""
    p = run(os.path.join(ROOT, "scripts", "note-meta"))
    if p.returncode:
        sys.exit(f"string-check: note-meta failed:\n{p.stderr}")
    ms = [m for m in json.loads(p.stdout) if isinstance(m, dict)]
    name = {d["id"]: (d.get("label") or d["id"]) for d in ms if d.get("kind") == "disp"}
    out = {}
    for m in ms:
        if m.get("kind") == "scanline":
            d = m["disp"]
            out.setdefault(name.get(d, d), []).append(m)
    number = {v: k for k, v in name.items()}
    return out, number, {v for k, v in name.items() if v == k}


def obligations():
    """One line per display: the display's name and one selector per panel, through the reader both
    manifests are read by."""
    return [(name, sels) for sels, name, _ in panels.read(PANELS)]


def route(sel):
    """A selector, and which panel of the file it draws the note's panel must equal: `<sel>@<k>`
    names the k-th, a bare selector the first.  A path that names a STATEMENT draws every part of it
    in ONE frame — which is what a display placing the parts side by side needs, since the frame is
    the statement's and not the part's — so one selector then answers for several note panels."""
    base, _, k = sel.partition("@")
    return base, (int(k) - 1 if k else 0)


def picks(want, addr):
    """WHAT A PREFIX NAMES IS A ROW — `<number>/<display>.<k>`, the line the report prints — so `14`
    takes a chapter, `14.1.2e/thin-thm81` a display and `14.1.2e/thin-thm81.3` one panel of it.  The
    gate, `--marks` and `--write` all select by this one rule, because a mode with a prefix rule of
    its own answers for a different set of panels than the report it is read beside.  Two tests: a
    DISPLAY is live when the prefix reaches into it or past it — a row prefix names a display it is
    longer than — and a ROW when the prefix starts it."""
    return (lambda n: addr(n).startswith(want) or want.startswith(addr(n)),
            lambda n, k: f"{addr(n)}.{k}".startswith(want))


def diagram_args(cert):
    """A panel's `cert:` handed to `scripts/diagram` WHOLE.  Re-spelling it as flags means writing
    each mapping field (`sigs`, `tint`, `defn`) back in that flag's own pair syntax, and a field
    whose syntax this got wrong — or did not know about — came back as a parse error naming
    nothing; `--cert` reads the cert with the same code `--compare` does."""
    return ["--cert", json.dumps(cert, ensure_ascii=False)]


def content(path):
    """A compiled panel's own `hm-meta` — lanes, beads, object wire, ports — or the typst error."""
    p = run("typst", "query", "--root", ".", path, "metadata", "--field", "value")
    if p.returncode:
        return None, next((l.strip() for l in p.stderr.splitlines() if l.startswith("error")),
                          "compile failed")
    ms = [m for m in json.loads(p.stdout) if isinstance(m, dict) and m.get("kind") == "scanline"]
    return (ms[0], None) if ms else (None, "the file draws no panel")


def lanelab(rec):
    """A lane's NAME, by `dpanel`'s own `dnm`: its 4th element where the lane carries one, and
    otherwise the label the port list writes at the edge that lane reaches — the two places on the
    page one wire can be read.  A lane's 2nd element is its TOP HEIGHT, so reading it the way a
    bead's label is read compared two coordinates and called a renamed lane equal."""
    port = lambda side, x: next((p[1] for p in rec.get(side) or [] if p[0] == x), None)
    return [l[3] if l[3] is not None else port("top" if l[1] == "top" else "bot", l[0])
            for l in rec.get("lanes") or []]


def why(n, g):
    """What the two panels disagree about, named by the thing that is wrong rather than by a count:
    a lane's label, a bead's, the object wire's, the ports, a bead the generator spiders."""
    lab = lambda xs: [x[1] for x in xs or []]
    out = []
    if lanelab(n) != lanelab(g):
        out.append(f"lanes {lanelab(n)} vs {lanelab(g)}")
    for k in ("beads", "obj"):
        if lab(n.get(k)) != lab(g.get(k)):
            out.append(f"{k} {lab(n.get(k))} vs {lab(g.get(k))}")
    if lab(n.get("top")) != lab(g.get("top")) or lab(n.get("bot")) != lab(g.get("bot")):
        out.append(f"ports {lab(n.get('top'))}->{lab(n.get('bot'))} vs "
                   f"{lab(g.get('top'))}->{lab(g.get('bot'))}")
    # A BEAD'S MARK, bead by bead — the verdict each one is drawn with, `dpanel`'s 6th element,
    # defaulting as the drawing defaults it.  Reading the `cert: nat` rows instead named a spider on
    # every panel that carries any verdict at all, the proved strict ones included, because a row
    # there says the tool LOOKED, not that the bead lost its dot.
    ver = lambda xs: [x[5] if len(x) > 5 else "strict" for x in xs or []]
    if ver(n.get("beads")) != ver(g.get("beads")):
        out.append(f"marks {ver(n.get('beads'))} vs {ver(g.get('beads'))}")
    # A UNIT IS A BEAD TOO, and it is the one bead that is not in `beads`: the wire it is born on
    # carries it, so its name and its mark are the LANE's 5th and 6th elements.  Reading `beads`
    # alone left `𝟙%∋` drawn lax against a `singletonMap_natural` the export cites as strict, on
    # the very panel whose object wire the gate did catch — the same hole, one tuple over.
    unit = lambda xs: [(x[4], x[5] if len(x) > 5 else "strict")
                       for x in xs or [] if len(x) > 4 and x[4] is not None]
    if unit(n.get("lanes")) != unit(g.get("lanes")):
        out.append(f"units {unit(n.get('lanes'))} vs {unit(g.get('lanes'))}")
    return "; ".join(out)


def wrap(path, body):
    # A BOX IS HEADROOM ONLY, so the box is not drawn.  The page is auto-sized to the panel, so a
    # page FILL is a rectangle of the box's own depth, and comparing two panels that state different
    # `cert: frame`s then reported the box as the difference — which says nothing about which arrow
    # the panel draws (the author, 2026-09-13: "bead floor or roof: doesn't matter").  Nothing looks
    # at these files; they are compiled for `svg-diff` and `typst query` alone.
    open(path, "w", encoding="utf-8").write(
        '#set page(width: auto, height: auto, margin: 0.3cm, fill: none)\n' + body)


def svg(src, dst):
    p = run("typst", "compile", "--root", ".", "--format", "svg", src, dst)
    return None if not p.returncode else p.stderr.strip().splitlines()[-1:] or ["compile failed"]


def heights(rec):
    """Every height the panel's own record names — its beads' and its object wire's — as a row
    counted DOWN FROM THE TOP of the box (`h` is `rows` rows of `dpanel`'s own `DY`, measured up).
    From the top because that is the end a display lines its panels up on and what `cert: top`
    states: a box one row deeper with the drawing hanging from its floor has moved the drawing down
    by a row, which measuring up from the floor calls no move at all."""
    dy = rec["h"] / rec["rows"] if rec.get("rows") else None
    ys = [b[0] for b in (rec.get("beads") or [])] + [o[0] for o in (rec.get("obj") or [])]
    return None if not dy or not ys else [rec["rows"] - y / dy for y in ys]


def rowshift(a, b):
    """HOW FAR ONE PANEL'S ROWS SIT ABOVE THE OTHER'S, or None where no ONE number says it: the two
    records name different numbers of heights, or heights that do not all differ by the same amount.
    Which row a bead sits on inside its box is not part of which arrow the panel draws — the author,
    2026-09-13: "bead floor or roof: doesn't matter, they need to align bead with other diagram if
    there is an (in)equation" — and the panels of one display align on the row the DISPLAY gives
    them, which is why the two sides of this comparison legitimately differ by it."""
    p, q = heights(a), heights(b)
    if p is None or q is None or len(p) != len(q):
        return None
    ds = {round(x - y, 6) for x, y in zip(p, q)}
    return ds.pop() if len(ds) == 1 else None


def ymatch(kind, v, w, dy):
    """The heights of `w` that `v` reads as, where every height either stayed or moved by `dy` — or
    None where the two primitives are not the same shape drawn at the same x.  A HEIGHT chooses, not
    a slot: the wire a bead sits on is ONE wire drawn as two segments, so their shared joint moves
    with the bead while each segment's other end, at the panel's edge, does not."""
    n = svgdiff.NPOS[kind]
    n = len(v) if n is None else n
    if len(v) != len(w):
        return None
    m = {}
    for i, (a, b) in enumerate(zip(v, w)):
        if i >= n or i % 2 == 0:      # a size or a name, or an x: a sideways offset is a difference
            if svgdiff.differs(a, b):
                return None
        elif not svgdiff.differs(a, b):
            m[b] = b
        elif not svgdiff.differs(a, b + dy):
            m[b] = a
        else:
            return None
    return m


def band(xs, ys, dy):
    """Every primitive of `xs` paired with one of `ys` under the one shift `dy`, and the height map
    the pairing read — None where anything is left over on either side, or where two primitives read
    one height two ways."""
    left, m = list(ys), {}
    for k, v in xs:
        for i, (j, w) in enumerate(left):
            mm = ymatch(k, v, w, dy) if j == k else None
            if mm is None or any(svgdiff.differs(m[y], z) for y, z in mm.items() if y in m):
                continue
            m.update(mm)
            del left[i]
            break
        else:
            return None
    return None if left else m


def rising(m):
    """The height map keeps the ORDER of the heights.  Without this a free choice per height would
    let one wire end where another's did — a wire drawn short against a wire drawn long reads as the
    shift that happens to span them — where an order-keeping map can only say that one BAND of rows
    slid and the rest stayed."""
    ks = sorted(m)
    return all(m[a] < m[b] for a, b in zip(ks, ks[1:]))


def yvals(xs):
    """Every height a bag of primitives names, once each."""
    return {v[i] for k, v in xs
            for i in range(1, len(v) if svgdiff.NPOS[k] is None else svgdiff.NPOS[k], 2)}


def sameband(note, gen):
    """A PANEL'S ROWS MAY SIT ANYWHERE IN ITS BOX: true where the two compiled panels are the same
    drawing with one band of its heights moved.  The shift is the one that explains the most heights
    the two do not already share, and the panel is accepted only if it then explains ALL of them —
    every primitive of each side paired with one of the other at the same x, every height either
    stayed or moved by that one shift, and the height map keeping the order.  The horizontal offset
    removed is the one `svg-diff` itself removes and nothing more, so a sideways shift stays a
    difference."""
    ga, gb = svgdiff.collect(note)[0], svgdiff.collect(gen)[0]
    # `best_offset`'s VERTICAL component is deliberately dropped: it anchors on whichever band holds
    # the more primitives, so keeping it would make the verdict depend on which side of the shift
    # happened to be larger, where this rule must read the same either way.
    gb = svgdiff.shift(gb, (-svgdiff.best_offset(ga, gb)[0], 0.0))
    la, lb = yvals(svgdiff.unmatched(ga, gb)), yvals(svgdiff.unmatched(gb, ga))
    seen = lambda d: sum(any(not svgdiff.differs(a, b + d) for a in la) for b in lb)
    for dy in sorted({a - b for a in la for b in lb}, key=lambda d: (-seen(d), d)):
        m = band(ga, gb, dy)
        if m is not None and rising(m):
            return True
    return False


EPS = 1e-6
Y = lambda v: round(float(v), 6)        # a row, as `dpanel` wrote it and `scanline` reads it


class Ill(Exception):
    """A record whose beads and strands do not make a graph.  The message names the panel's own
    primitive — which strand, at which x, at which row — so such a panel is REPORTED rather than
    passed as the same diagram or dropped from the count."""


def port(rec, side, x):
    """WHICH PORT a strand reaching an edge is: the edge's ports left to right, and this one's place
    among them with its label.  Boundary order is invariant under isotopy where a row number is not,
    so a port is identified by that place and never by its x."""
    ps = sorted((float(p[0]), p[1]) for p in rec.get(side) or [])
    for i, (px, lab) in enumerate(ps):
        if abs(px - x) < EPS:
            return (side, i, lab)
    raise Ill(f"the strand at x={x:g} reaches the {side} edge, where the panel writes no port")


def only(at, y, what, end):
    """The one bead at a row.  Two beads there — or none — leave the strand's end naming no node,
    which is the graph the comparison cannot be read off."""
    ks = at.get(y) or []
    if len(ks) != 1:
        raise Ill(f"{what} is {end} at row {y:g}, where the panel draws {len(ks)} bead(s)")
    return ks[0]


def graph(rec):
    """THE PANEL AS A PLANAR GRAPH — its beads the nodes, its strands the edges — off the ONE record
    `dpanel` emits, the same the status line is read from.  A bead's ARMS are the strands ending at
    its row and its LEGS those starting there (IntroString Ex 2.13: a bead's arms are its source's
    functors, its legs its target's).  A unit is a bead too, and the one bead the record writes on
    the lane it is born on rather than in `beads`.  A bead with no dot x of its own (`dpanel`'s 5th
    element) rides the OBJECT wire, the one strand alive the panel's whole height: it eats the
    segment above it and makes the one below, so two beads on it share a strand and do not commute.

    TOTALITY: every strand's two ends and every bead land in the graph, or `Ill` names the one that
    did not."""
    ns = [{"y": Y(b[0]), "lab": b[1], "unit": False, "obj": len(b) < 5 or b[4] is None,
           "arms": [], "legs": []} for b in rec.get("beads") or []]
    lanes = rec.get("lanes") or []
    unit = {}
    for k, l in enumerate(lanes):
        if len(l) > 4 and l[4] is not None:
            unit[k] = len(ns)
            ns.append({"y": Y(l[1]), "lab": l[4], "unit": True, "obj": False,
                       "arms": [], "legs": []})
    at = {}
    for i, n in enumerate(ns):        # a unit is born on its own lane and eats nothing, so it is
        if not n["unit"]:             # never what a strand's row names
            at.setdefault(n["y"], []).append(i)
    src, dst = {}, {}
    for k, l in enumerate(lanes):
        x = float(l[0])
        what = f"the strand at x={x:g}"
        if l[1] == "top":
            if k in unit:
                raise Ill(f"{what} carries the unit {l[4]} and is born at the top edge as well")
            s = port(rec, "top", x)
        else:
            s = ("bead", unit[k] if k in unit else only(at, Y(l[1]), what, "born"))
        e = port(rec, "bot", x) if l[2] == "bot" else ("bead", only(at, Y(l[2]), what, "eaten"))
        src[k], dst[k] = s, e
        if s[0] == "bead":
            ns[s[1]]["legs"].append(k)
        if e[0] == "bead":
            ns[e[1]]["arms"].append(k)
    xo = float(rec["xo"])
    ride = sorted((i for i, n in enumerate(ns) if n["obj"]), key=lambda i: -ns[i]["y"])
    chain = [port(rec, "top", xo)] + [("bead", i) for i in ride] + [port(rec, "bot", xo)]
    for j, i in enumerate(ride):
        ns[i]["oarm"], ns[i]["oleg"] = chain[j], chain[j + 2]
    for n in ns:
        if not n["arms"] and not n["legs"] and not n["obj"]:
            raise Ill(f"the bead {n['lab']} at row {n['y']:g} is on no strand the panel draws")
    return ns, src, dst


def nform(rec):
    """THE PANEL'S NORMAL FORM — what two panels must share to be the SAME DIAGRAM.  These are
    progressive planar string diagrams (every wire runs top to bottom, none turns back), so by
    Joyal–Street the isotopy class IS this combinatorial graph, and the row a bead is drawn on is
    not part of it: two beads sharing no strand commute, so the record's row order is layout.

    A bead's LAYER is 1 + the greatest layer among the beads whose legs it eats, an edge port
    counting 0; within one layer beads stand in the left-to-right order of their leftmost strand,
    which is the planar order at one height and so invariant.  In that order each bead is written
    with its label and its strands' STRUCTURAL identities — the place in this order of the bead that
    made each arm and of the bead that eats each leg, an edge strand naming its port instead — plus
    the object labels down the object wire and the two port lists.  A bead's MARK is not here: `why`
    holds the verdicts, and a mark difference is a difference of the diagram it always was."""
    ns, src, dst = graph(rec)
    lanes, xo = rec.get("lanes") or [], float(rec["xo"])
    lx = lambda k: float(lanes[k][0])
    up = lambda i: [src[k][1] for k in ns[i]["arms"] if src[k][0] == "bead"] + \
        ([ns[i]["oarm"][1]] if ns[i]["obj"] and ns[i]["oarm"][0] == "bead" else [])
    lay = {}
    # A strand is born above where it dies, so descending row order is already a topological one.
    for i in sorted(range(len(ns)), key=lambda i: -ns[i]["y"]):
        lay[i] = 1 + max([0] + [lay[j] for j in up(i)])
    left = lambda i: min([lx(k) for k in ns[i]["arms"] + ns[i]["legs"]]
                         + ([xo] if ns[i]["obj"] else []))
    canon = sorted(range(len(ns)), key=lambda i: (lay[i], left(i), ns[i]["lab"]))
    pos = {i: r for r, i in enumerate(canon)}
    ref = lambda e: f"#{pos[e[1]]}" if e[0] == "bead" else f"{e[0]}{e[1]}:{e[2]}"
    def side(i, ks, end, o):
        xs = [(lx(k), ref(end[k])) for k in ks] + ([(xo, ref(ns[i][o]))] if ns[i]["obj"] else [])
        return ",".join(r for _, r in sorted(xs))
    entry = lambda i: (f"{ns[i]['lab']}({side(i, ns[i]['arms'], src, 'oarm')}"
                       f"|{side(i, ns[i]['legs'], dst, 'oleg')})")
    edge = lambda s: "[" + ",".join(p[1] for p in sorted(rec.get(s) or [],
                                                         key=lambda p: float(p[0]))) + "]"
    obj = "[" + ",".join(o[1] for o in sorted(rec.get("obj") or [],
                                              key=lambda o: -float(o[0]))) + "]"
    return f"top{edge('top')} " + " ".join(entry(i) for i in canon) + f" obj{obj} bot{edge('bot')}"


def layout(recs, panel, drew, note, gen):
    """WHAT THE TWO PICTURES DIFFER BY, once the normal forms have already said they are the same
    diagram.  It decides nothing — the author, 2026-09-13: "isotopic diagrams should be deemed
    equal" — and is printed so a layout drift stays visible: the row shift where one band of heights
    explains every primitive (`sameband`), and otherwise the primitives `svg-diff` could not pair."""
    if sameband(note, gen):
        c = rowshift(panel, drew)
        if c is not None:
            box = "" if panel["rows"] == drew["rows"] else \
                f", box {panel['rows']:g} vs {drew['rows']:g}"
            # `+ 0` because a shift of none comes out of the subtraction as `-0.0`, which prints as
            # a direction it does not have.
            return f"dy {c + 0:+g} row{'' if abs(c) == 1 else 's'}{box}"
    n = [r for r in recs if r["layer"] == "geometry"]
    kinds = sorted({r["kind"] for r in n})
    m = [r for r in recs if r["layer"] == "glyph"]
    return (f"{len(n)} primitive(s){' ' + '/'.join(kinds) if kinds else ''}"
            + (f", {len(m)} glyph box(es)" if m else ""))


def fields(g):
    """A `cert:` group's top-level fields.  Depth-aware and quote-aware, because a value holds both
    brackets and commas of its own (`expect: "⦇[nil,(π₁p→cons,⊸nil)]⦈"`), and a split on every
    comma would cut one field into three that name nothing."""
    out, d, q, s = [], 0, False, 0
    for x, ch in enumerate(g):
        q ^= ch == '"'
        if q:
            continue
        d += (ch == "(") - (ch == ")")
        if ch == "," and d == 0:
            out.append(g[s:x])
            s = x + 1
    return [f.strip() for f in out + [g[s:]] if f.strip()]


def setnat(lit, nat):
    """One `dpanel(` literal with Lean's verdicts written into its `cert:`, replacing whatever `nat`
    it carried.  Only the CERT is touched: the picture itself is rebuilt from it by
    `./scripts/diagram --write`, which is the one place a panel is drawn.  A panel Lean grades no
    bead in carries NO `nat` field, rather than an empty one that would read as a reading made and
    nothing found."""
    k = lit.rfind("cert: (")
    e = diagram.close(lit, k + 6) + 1
    fs = [f for f in fields(lit[k + 7:e - 1]) if not f.startswith("nat: ")]
    q = lambda s: '"' + s.replace("\\", "\\\\") + '"'
    if nat:
        fs.append("nat: (" + ", ".join("(" + ", ".join(q(x) for x in t) + ")" for t in nat)
                  + ("," if len(nat) == 1 else "") + ")")
    return lit[:k + 7] + ", ".join(fs) + lit[e - 1:]


def generated(gen):
    """One generated file's panels, in the order it drew them, each as (its own `dpanel(` LITERAL,
    its `cert:`) — by the same reader `drawn_geom` reads the frame with.  BOTH payloads a note panel
    is written from are read here and in one place: the verdict is `nat:`, a field of that `cert:`,
    and the drawing is the literal itself, so neither is a second compile of the picture and the two
    cannot come off two different drawings.  The count of panels is what the note's `@k` must fall
    inside."""
    text = open(gen, encoding="utf-8").read()
    return [(text[i:j], c) for i, _, j, c in diagram.literals(text, drawable=False)]


def drawing(c):
    """A `cert:` as THE DRAWING IT SPECIFIES, which is what a `dpanel(` literal in the note is:
    every field but `nat`, the one field this writes.  A count is normalised to a number, because
    the two readers spell `frame: 4` as `4` and as `4.0` and the same drawing must not read as
    two."""
    num = lambda v: float(v) if isinstance(v, (int, float)) and not isinstance(v, bool) else v
    return json.dumps({k: num(v) for k, v in (c or {}).items() if k != "nat"},
                      ensure_ascii=False, sort_keys=True)


def args(lit):
    """One `dpanel(` call's arguments, by the same depth- and quote-aware reader a `cert:` group's
    fields are cut by — a positional tuple carries brackets and commas of its own."""
    i = lit.index("(")
    return fields(lit[i + 1:diagram.close(lit, i)])


def argname(f):
    """An argument's NAME, or None where it is positional: an identifier and a colon before any
    bracket or quote of the argument's own, which is what Typst's call syntax allows and what tells
    `obj:` from the tuple it takes."""
    k = 0
    while k < len(f) and (f[k].isalnum() or f[k] == "_"):
        k += 1
    return f[:k] if k and k < len(f) and f[k] == ":" else None


def redrawn(lit, glit):
    """One note `dpanel(` literal carrying THE GENERATED PANEL'S DRAWING.  What the generator emits
    IS the drawing — the lanes, beads and ports it passes positionally, the object wire it passes as
    `obj:` — so the generated call is kept WHOLE, its formatting with it, and the one argument of it
    that is not a drawing is dropped: `cert:` is the author's formula and signatures, and so is
    every argument of the note's own call the generator writes none of (`s:`, `names:`)."""
    k = glit.rfind("cert: (")
    made = {argname(a) for a in args(glit)}
    mine = [f for f in args(lit) if argname(f) == "cert" or argname(f) and argname(f) not in made]
    return glit[:k] + ", ".join(mine) + glit[diagram.close(glit, k + 6) + 1:]


def note_texts():
    """THE FILES A NOTE PANEL'S LITERAL CAN BE WRITTEN IN: the root and every file it `#include`s, in
    order, through `notesplit`'s own include reader.  Reading the JOIN instead misses
    `diag/allegory-appendix.typ` — a chapter includes it and the join does not inline it, so its
    panels were in the query and their literals nowhere, and every §17.3 panel read as NO-LITERAL."""
    return [[p, open(p, encoding="utf-8").read()] for p in note_files()]


def leanimport(path, text):
    """`lean` PUT IN SCOPE of a file that draws with it, as the file's new text or None when it is
    there already.  A chapter takes the prelude whole (`#import "../note-prelude.typ": *`);
    `diag/allegory-appendix.typ` is `#include`d into a scope it does not share and re-imports every
    helper by name, so a `lean(` written into it draws nothing until this one is named too."""
    lines, last = text.split("\n"), -1
    for k, ln in enumerate(lines):
        if not ln.startswith("#import "):
            continue
        last, inc = k, typst_string(ln)
        if inc and os.path.basename(inc) == "note-prelude.typ":
            got = ln.rpartition(":")[2].strip()
            if got == "*" or "lean" in [s.strip() for s in got.split(",")]:
                return None
            sys.exit(f"string-check: {path} imports the prelude as `{got}`, which brings no `lean`;"
                     f" add it there and re-run")
    if last < 0:
        sys.exit(f"string-check: {path} draws a panel and imports nothing, so there is no import"
                 f" list to name `lean` in")
    rel = os.path.relpath(os.path.join(os.path.dirname(NOTE), "note-prelude.typ"),
                          os.path.dirname(path) or ".")
    lines.insert(last + 1, f'#import "{rel}": lean')
    return "\n".join(lines)


def splice(texts, edits):
    """Every edit placed in the file it was cut from, one forward pass per file.  A span carries its
    file, so a note that is one file and a note that is sixteen take the same pass."""
    for fi, (path, text) in enumerate(texts):
        es = sorted((sp, new) for sp, (new, _) in edits.items() if sp[0] == fi and new is not None)
        if not es:
            continue
        out, end = [], 0
        for (_, i, j), new in es:
            out += [text[end:i], new]
            end = j
        open(path, "w", encoding="utf-8").write("".join(out + [text[end:]]))


def cellonly(text, aj, bi):
    """THE ONE THING A MERGE MAY SWALLOW between two panels of one statement: the grid cell the note
    writes its relation symbol in, with the commas either side and the `#` of the second call where
    the cell sits in content.  Anything else between them is the display saying something the
    statement does not, so the two panels are not one drawing and the merge does not happen."""
    s = text[aj:bi].rstrip()
    s = (s[:-1] if s.endswith("#") else s).lstrip()
    if not s.startswith(","):
        return False
    s = s[1:].lstrip()
    if not s.startswith("["):
        return False
    t = s[diagram.close(s, 0) + 1:].lstrip()
    return t.startswith(",") and not t[1:].strip()


def declof(db, name):
    """THE DECLARATION A NAME STANDS FOR, through `cite-check`'s own resolver.  A marker names a
    module and a suffix (`AOP.A8_1.thinRel_comp_eps_le`), a selector the full Lean name with a side
    (`@2`), a binder (`#h`) and a path into the statement (`.lhs.inr`) after it.  Dropping trailing
    components until the INDEX knows the name is what makes the two comparable — a rule of my own
    about which suffixes are paths would guess where the index already answers."""
    n = name.split("@")[0].split("#")[0]
    while n:
        hits = citecheck.resolve(db, n)
        if hits:
            return hits[0][:2] if len(hits) == 1 else None
        n = n.rpartition(".")[0]
    return None


def dispblock(text, name, labelled, spans):
    """THE `#disp[` … `]<label>` BLOCK a display's markers are written in, as (start, end).

    FOUND BY THE DISPLAY'S LABEL, which is its name: the `#disp[` whose closing `]` is the one that
    label is written after.  Neither the nearest `#disp[` before its panels nor the innermost block
    around them answers in general — §11.6.4b binds its panels with `#let` ahead of the block, and
    another display's block closes in between — so a display the note leaves UNLABELLED, having no
    label to be found by, falls back to the innermost block that does hold its panels."""
    ends = {}
    k = text.find("#disp[")
    while k >= 0:
        ends[diagram.close(text, k + 5)] = k
        k = text.find("#disp[", k + 6)
    if labelled:
        at = text.find(f"<{name}>")
        while at >= 0:
            j = text.rfind("]", 0, at)
            if j in ends and not text[j + 1:at].strip():
                return ends[j], j + 1
            at = text.find(f"<{name}>", at + 1)
        return None, None
    i, j = min(s[1] for s in spans), max(s[2] for s in spans)
    inner = [(s, e + 1) for e, s in ends.items() if s < i and e >= j]
    return max(inner) if inner else (None, None)


def markerlines(text, fi, spans, name, labelled, drawn, db):
    """THE MARKERS A CONVERTED DISPLAY NO LONGER NEEDS, as the line spans to cut, and why not.  A
    `lean:` marker inside the `#disp[` block holding the display's panels cites a declaration; where
    that declaration is one the display's `lean()` calls now DRAW, the picture is the citation and
    the comment repeats it.  A marker citing anything else — a reason, not a drawing — is kept."""
    k, end = dispblock(text, name, labelled, spans)
    if k is None:
        return [], ("no `#disp[` block is written round its panels, so which markers are the"
                    " display's own cannot be said and every one of them stands")
    out, at = [], text.find("\n", k)
    while 0 <= at < end:
        nxt = text.find("\n", at + 1)
        line = text[at + 1:nxt if 0 <= nxt < end else end]
        ms = citecheck.MARK.findall(line)
        if line.lstrip().startswith("//") and ms and all(declof(db, m.rstrip(".")) in drawn
                                                         for m, _ in ms):
            out.append((fi, at, nxt))         # the line, cut with the newline that starts it
        at = nxt
    return out, None


def lean_convert(want):
    """THE NOTE'S STRING PANELS AS LEAN NAMES.  Every `dpanel(` literal of a display the manifest
    names becomes `lean("<selector>")` — a declaration and nothing else, no `cert:`, no `frame:`, no
    `top:` — and a `lean:` marker the display's own pictures now draw goes with it.

    THE OBLIGATIONS ARE THE MANIFEST'S DISPLAYS, and each is answered from the same three readers the
    gate answers it from: `obligations()` gives a display its selector per panel, `sources` that
    panel's own literal, `route` which side of a statement it draws.  A display the pairing cannot
    settle is REFUSED by name and left byte for byte; the run converts every other one and exits
    non-zero listing the refusals, because a shape converted by hand is a shape the next note change
    breaks again."""
    # BEFORE THE QUERY: a file already holding a `lean(` it cannot resolve compiles to nothing, so
    # `note-meta` would answer `unknown variable: lean` for the whole note and name no display.
    for f in note_texts():
        new = leanimport(*f) if "lean(" in f[1] else None
        if new:
            open(f[0], "w", encoding="utf-8").write(new)
            print(f"{f[0]}: `lean` imported — the file draws with it")
    live, number, _ = note_panels()
    rows, num = obligations(), lambda n: number.get(n, n)
    addr = lambda n: n if num(n) == n else f"{num(n)}/{n}"
    hasdisp, _ = picks(want, addr)
    texts = note_texts()
    atlit, bad = sources(texts, live)
    db = sqlite3.connect(f"file:{citecheck.DB}?mode=ro", uri=True)
    edits, plan, refused, nodecl, stale, done, merged, cut = {}, [], [], [], [], 0, 0, 0
    for n, sels in rows:
        if n not in live or not hasdisp(n):
            continue
        ids = [p.get("id") for p in live[n]]
        spans = [atlit.get(i) for i in ids]
        # ALREADY A `lean()`: the display draws panels and not one of them is a `dpanel(` literal
        # the note holds, and none was reported ill — a second run over it changes nothing.
        if not any(spans) and not any(i in bad for i in ids):
            done += 1
            continue
        if len(sels) != len(ids):
            refused.append((addr(n), f"{PANELS} names {len(sels)} selector(s) for {len(ids)} panel(s)"))
            continue
        k = next((x for x, s in enumerate(spans) if s is None), None)
        if k is not None:
            refused.append((addr(n), f"panel {k + 1}: " + (bad.get(ids[k]) or
                            f"the note draws it by `{live[n][k].get('helper')}`, which is no"
                            f" `dpanel(` literal")))
            continue
        if len({s[0] for s in spans}) > 1:
            refused.append((addr(n), "its panels are written in two files, so the display is not one"
                                     " block and its markers have no home"))
            continue
        mine, x = [], 0
        while x < len(sels):
            s = sels[x]
            if s == "-":
                nodecl.append(f"{addr(n)}.{x + 1}")
                x += 1
                continue
            b, w = route(s)
            nxt = route(sels[x + 1]) if x + 1 < len(sels) and sels[x + 1] != "-" else None
            # TWO SIDES AND THE SYMBOL BETWEEN THEM ARE ONE STATEMENT: `lean("N")` draws the whole
            # of it, relation symbol included, so the note keeps no cell of its own to say it.
            if (w, nxt) == (0, (b, 1)) and cellonly(texts[spans[x][0]][1], spans[x][2],
                                                    spans[x + 1][1]):
                mine.append(((spans[x][0], spans[x][1], spans[x + 1][2]), b,
                             f"{addr(n)}.{x + 1}+{x + 2}"))
                merged += 1
                x += 2
                continue
            mine.append((spans[x], s, f"{addr(n)}.{x + 1}"))
            x += 1
        if mine:
            plan.append((n, mine))
    # ONE LITERAL, ONE NAME.  A `#let` panel two displays draw is ONE span reached twice, so a
    # manifest naming the two apart would have that span drawing one display's declaration inside
    # the other's picture: both displays are refused and NEITHER is written, where writing whichever
    # came first leaves the other silently drawing a statement nobody wrote it for.
    seen = {}
    for n, mine in plan:
        for sp, s, t in mine:
            seen.setdefault(sp, {}).setdefault(s, []).append((n, t))
    clash = {n for byt in seen.values() if len(byt) > 1 for v in byt.values() for n, _ in v}
    for sp, byt in sorted(seen.items()):
        if len(byt) > 1:
            ns = sorted({addr(n) for v in byt.values() for n, _ in v})
            ts = sorted(t for v in byt.values() for _, t in v)
            refused.append((" and ".join(ns), f"{' and '.join(ts)} are drawn from ONE `dpanel(`"
                                              f" literal and {PANELS} names them apart, so neither"
                                              f" display is written"))
    for n, mine in plan:
        if n in clash:
            continue
        drawn = {d for sp, s, t in mine for d in [declof(db, s)] if d}
        dels, why = markerlines(texts[mine[0][0][0]][1], mine[0][0][0], [sp for sp, _, _ in mine],
                                n, num(n) != n, drawn, db)
        # A DISPLAY STILL CONVERTS WITH ITS MARKERS IN PLACE: the pictures are the payload and the
        # markers a second reading of the same declaration, so a block not found is said, not fatal.
        if why:
            stale.append((addr(n), why))
        for sp, s, t in mine:
            edits[sp] = (f'lean("{s}")', t)
        for sp in dels:
            edits[sp] = ("", f"{addr(n)}'s marker")
        cut += len(dels)
    # NO EDIT MAY EAT ANOTHER: a merged span reaches across the cell between two panels, and a `#let`
    # literal two displays share is one span reached twice, so two edits that overlap are two
    # readings of one piece of the note — reported, and neither written.
    keys = sorted(edits)
    for a, b in zip(keys, keys[1:]):
        if a[0] == b[0] and a[2] > b[1]:
            refused.append((edits[a][1], f"its span overlaps {edits[b][1]}'s, so neither is written"))
            edits[a], edits[b] = (None, edits[a][1]), (None, edits[b][1])
    splice(texts, edits)
    for name, why in refused:
        print(f"{name}: REFUSED — {why}")
    for name, why in stale:
        print(f"{name}: MARKERS — {why}")
    for t in nodecl:
        print(f"{t}: NO-DECL — the manifest names no declaration, so the literal stands")
    print(f"string-check --lean: {sum(1 for v in edits.values() if v[0])} span(s) written"
          f" ({merged} merged from two sides), {cut} marker(s) cut, {done} display(s) already"
          f" converted, {len(refused)} refused, {len(stale)} with markers left, {len(nodecl)} with"
          f" no declaration")
    return 1 if refused or stale else 0


def sources(texts, live):
    """EVERY NOTE PANEL'S OWN `dpanel(` LITERAL — the place a verdict for it is written, keyed by
    the panel's own `id` (`<display>.<k>`), which `hm-meta` stamps on every panel it emits.  A
    `#dpanel(` call is exactly what emits a panel stamped `helper: "dpanel"`; a `dpan` or a
    hand-laid panel emits another helper's name and is not asked for here.

    A PANEL IS FOUND BY ITS DRAWING, and where one drawing is written out several times, by ORDER
    WITHIN THOSE.  Position alone cannot do it: §11.6.4b binds its panels with `#let` and draws
    each of them two and three times, so the source's literals and the document's panels are
    neither the same list nor the same length.  Two cases, and nothing else is answered:
      one literal, any number of panels — the note draws them all from that one `#let`, so they
                   share the literal, and a verdict they do not agree on is a defect of the note's
                   own reuse, reported by the writer rather than settled by picking one;
      as many literals as panels — they pair in order, the panels in document order and the
                   literals in source order, which is how §14.1.1a.6, §14.1.2d.4 and §14.1.2e.5
                   are told apart: their `cert:`s differ in `nat` alone, which is what is written.
    Anything else is named, panel by panel, in the `bad` returned beside the spans."""
    # THE CERT GROUP ALONE, cut at the end `literals` hands back: `literals` parses from `cert: (`
    # to the end of the whole `dpanel(` call, so a `, s: 100%)` written after the group comes back
    # as a field `s` no compiled panel has — which matched §11's literals against nothing at all.
    byc = {}
    for fi, (_, text) in enumerate(texts):
        for i, e, j, _ in diagram.literals(text):
            k = text.rfind("cert: (", i, e)
            byc.setdefault(drawing(diagram.certof(text[k:e])), []).append((fi, i, j))
    ps = {}
    for ms in live.values():
        for m in ms:
            c = m.get("cert") or {}
            if m.get("helper") == "dpanel" and all(c.get(f) for f in ("expect", "src", "tgt")):
                ps.setdefault(drawing(c), []).append(m["id"])
    at, bad = {}, {}
    for d, ids in ps.items():
        spans = byc.get(d, [])
        if len(spans) == 1:
            at.update(dict.fromkeys(ids, spans[0]))
        elif len(spans) == len(ids):
            at.update(zip(ids, spans))
        else:
            bad.update(dict.fromkeys(ids, (
                f"no `dpanel(` literal of {NOTE} carries this panel's `cert:`, so the note draws it"
                f" from a file the split does not hold and there is nowhere to write a verdict"
                if not spans else
                f"the note draws {len(ids)} panel(s) from this `cert:` and {NOTE} holds"
                f" {len(spans)} literal(s) of it, so which one is this panel's cannot be said")))
    return at, bad


def rewrite(want, drawing):
    """WHERE A BEAD'S MARK COMES FROM.  `diag/hm-sigs.json` holds one `nat` per bead LABEL, and a
    verdict belongs to a bead in a REGION: the same `𝟙%∋` is strict on §14.1's `E` and lax on
    §13.6.7a's, so a global row draws one of them wrong whatever it says.  The exporter already
    decides per panel, from the environment (`diag/tool/StringDiagram.lean`), and writes what it
    found into each generated panel's `cert: nat`.  This copies that — verdict and the declaration
    behind it — into the note's own `cert:`, through the SAME pairing the gate checks by, so the
    note's mark and Lean's verdict cannot come from two different readings.

    THE OBLIGATIONS ARE THE NOTE'S PANELS, one loop over them, and each is answered from the
    drawing made for IT: `obligations()` gives a display its selector per panel, `route` which
    panel of that drawing answers it, and `sources` that note panel's own literal.

    ONE WRITER, TWO PAYLOADS — `--marks` writes the generated panel's VERDICTS, `--write` its
    DRAWING and its verdicts — because they are one pairing: which generated panel answers a note
    panel is the question both ask, and a second writer asking it again is how a panel's mark and
    its picture come to be taken off two different drawings.  `--write` adds the gate's verdict to
    it and nothing else: the author's isotopic layout stands, so only a `DIFF` panel is redrawn."""
    live, number, _ = note_panels()
    rows, num = obligations(), lambda n: number.get(n, n)
    addr = lambda n: n if num(n) == n else f"{num(n)}/{n}"
    hasdisp, hasrow = picks(want, addr)
    sel_of = [(n, sels) for n, sels in rows if n in live and hasdisp(n)]
    todo = sorted({route(s)[0] for n, sels in sel_of
                   for k, s in enumerate(sels, 1) if s != "-" and hasrow(n, k)})
    # A selector the exporter REFUSES is one panel's failure, not the run's: it exits non-zero for
    # the whole batch, and the reason its record names is reported against the panel that wanted
    # it, below, the way the gate reports it.  Stopping here would leave every other panel's mark
    # unwritten.
    recs, p = export(todo)
    # THE BOX IS THE DISPLAY'S, and only a drawing about to be SPLICED into the note must sit in it:
    # a verdict is not geometry, so `--marks` reads the one drawing per selector and asks for no
    # re-draw, where `--write` is held to the very picture the gate compares the note against.
    again, at = redraw_as_noted(recs, rows, live, hasdisp) if drawing else ([], {})
    save_recs(recs)
    texts = note_texts()
    atlit, bad = sources(texts, live)
    jobs, edits, carried, kept, miss, ungraded = [], {}, 0, 0, 0, 0
    for n, sels in sel_of:
        ps = live[n]
        if len(sels) != len(ps):
            print(f"{addr(n)}: MISCOUNT — {PANELS} names {len(sels)} selector(s) for {len(ps)}"
                  f" panels")
            miss += 1
            continue
        for k, (sel, panel) in enumerate(zip(sels, ps), 1):
            tag = f"{addr(n)}.{k}"
            if sel == "-" or not hasrow(n, k):
                continue
            base, which = route(sel)
            # A VERDICT IS NOT GEOMETRY: what a bead's mark is does not move with the box or the
            # bead height, so `--marks` reads them off the one drawing per selector and wants no
            # re-draw per display — `at` is empty there, and the first pass's record answers.
            gen, err = answer(recs, at, n, base)
            if err:
                print(f"{tag} {sel}: CANNOT-DRAW {err}")
                miss += 1
                continue
            drawn = generated(gen)
            if which >= len(drawn):
                print(f"{tag} {sel}: MISCOUNT — {gen} draws {len(drawn)} panel(s) and this panel"
                      f" asks for its {which + 1}")
                miss += 1
                continue
            span = atlit.get(panel.get("id"))
            if span is None:
                print(f"{tag} {sel}: NO-LITERAL — " + (bad.get(panel.get("id")) or
                      f"the note draws this panel by `{panel.get('helper')}`, which carries no"
                      f" `cert:` for a verdict to be written into"))
                miss += 1
                continue
            jobs.append((tag, sel, panel, which, gen, drawn[which], span))
    # THE PICTURE A DRAWING COMES FROM IS SWEPT FIRST — one `scanline --strict` over every file the
    # jobs draw from, the same sweep the gate stands its verdicts on — because a drawing no cut can
    # read is a defect written into the note, where a MARK is a word the exporter read off Lean.
    swept = sweep(sorted({j[4] for j in jobs})) if drawing else {}
    for tag, sel, panel, which, gen, (glit, gcert), span in jobs:
        lit, v = texts[span[0]][1][span[1]:span[2]], [list(t) for t in gcert.get("nat") or []]
        if drawing:
            stop, _, _, st = compare(sel, panel, which, gen)
            if not stop:
                r = swept[gen]
                fs = r["failures"] + r["unhandled"] + ["the picture was never drawn"] * r["missing"]
                if fs:
                    stop = f"SWEEP {len(fs)} failure(s); the first: {fs[0]}"
            if stop:
                print(f"{tag} {sel}: {stop}")
                miss += 1
                continue
            # THE AUTHOR'S LAYOUT STANDS: `ok` and `ok (layout: …)` are Lean's own diagram drawn
            # elsewhere on the page, so that panel is left byte for byte as it is.
            if st != "DIFF":
                kept += 1
                continue
            new = setnat(redrawn(lit, glit), v)
        else:
            if not v:
                ungraded += 1
                continue
            new = setnat(lit, v)
        # ONE LITERAL, ONE PANEL: a `#let` panel the note draws in two places is ONE `cert:`, so two
        # displays Lean writes apart is a defect of the note's own reuse — reported, and the literal
        # left as it stands, rather than settled by writing whichever came last.
        was = edits.get(span)
        if was is not None and was[0] != new:
            print(f"{tag} {sel}: SHARED — this panel and {was[1]} are drawn from one `cert:` and"
                  f" Lean writes them apart, so neither is written")
            miss += 1
            edits[span] = (None, was[1])
            continue
        edits[span] = (new, tag)
        carried += 1
    # THE KEY IS (DISPLAY, SELECTOR), NEVER THE FORMULA: two panels of one display may draw one
    # `(expect, src, tgt)`, and one selector may be drawn by two displays, so a verdict looked up
    # by the formula lands on whichever panel spells the same arrow rather than on the one it was
    # drawn for.  Each edit carries its own panel's span, so ONE FORWARD pass places them all.
    splice(texts, edits)
    print(f"string-check --{'write' if drawing else 'marks'}: {carried} panel(s) carry Lean's "
          + (f"drawing; {kept} panel(s) the gate already reads as Lean's own diagram; "
             if drawing else
             f"verdicts; {ungraded} panel(s) Lean grades no bead in; ") + f"{miss} not written")
    rc = miss or unanswered(recs, todo, p)
    for r, bs, q in again:
        rc |= unanswered(r, bs, q)
    return 1 if rc else 0


def main(argv):
    argv = take_chapter(argv)
    # THE LAST WRITE THIS SCRIPT MAKES: every panel of the note becomes the Lean name it draws, and
    # this file and `diag/string-panels.txt` go with the last `dpanel(` literal (see `lean_convert`).
    if "--lean" in argv:
        return lean_convert(next((a for a in argv if not a.startswith("-")), ""))
    # ONE WRITER, TWO PAYLOADS — the panel's mark, or its drawing and its mark (see `rewrite`).
    if "--marks" in argv or "--write" in argv:
        return rewrite(next((a for a in argv if not a.startswith("-")), ""), "--write" in argv)
    # `make scan-generated`'s obligations are these, and they are read by the SAME reader as this
    # gate's, so the two cannot come to disagree about what the manifest names.
    if "--selectors" in argv:
        print(*sorted({route(s)[0] for _, sels in obligations() for s in sels if s != "-"}),
              sep="\n")
        return 0
    want = argv[0] if argv else ""
    os.makedirs(OUT, exist_ok=True)
    live, number, bare = note_panels()
    rows = obligations()
    # A DISPLAY IS NAMED BY ITS LABEL AND ADDRESSED BY ITS NUMBER: the number is what the reader of
    # the report looks up in the note and what a section argument selects on, the label what the
    # manifest keys by.  `want` therefore filters the NUMBER, not the name.
    num = lambda n: number.get(n, n)
    addr = lambda n: n if num(n) == n else f"{num(n)}/{n}"
    hasdisp, hasrow = picks(want, addr)
    # A section the scoped note does not hold is a MISTAKE, never an empty report: with `CH` naming
    # one chapter, `13.4` asked of chapter 12 would otherwise check nothing and exit 0.
    if want and not any(hasdisp(n) for n in live):
        sys.exit(f"string-check: no display {want} in {NOTE} — it draws "
                 + ", ".join(sorted({num(n) for n in live})[:8]) + ", …")
    rc, named = 0, {n for n, _ in rows}
    for n in live:
        if n not in named:
            print(f"{addr(n)}: MISSING — the note draws {len(live[n])} panel(s) here and {PANELS}"
                  f" names no line for it, so nothing is held to them")
            rc = 1
    for n, sels in rows:
        if n not in live:
            print(f"{n}: STALE — {PANELS} names a display the note no longer draws")
            rc = 1
    for n in sorted(bare & named):
        print(f"{n}: UNLABELLED — the note's display carries no `#disp` label, so {PANELS} keys it"
              f" by its number, which the next heading change moves")

    todo = sorted({route(s)[0] for n, sels in rows if n in live and hasdisp(n)
                   for k, s in enumerate(sels, 1) if s != "-" and hasrow(n, k)})
    # The RECORD answers "did it draw"; the pictures about to be drawn are still deleted first, so a
    # selector the exporter refuses leaves no LAST run's picture on disk for another sweep to pass.
    for s in todo:
        if os.path.exists(f"diag/generated/string/{s}.typ"):
            os.remove(f"diag/generated/string/{s}.typ")
    recs, exp = export(todo)
    # SECOND PASS: a display whose panels came out in a box or at a bead height the note does not
    # ask for is re-drawn at the note's own — per (display, selector), since the box is the
    # display's, so `at` and not `recs` says which picture a given display's panel is held to.
    again, at = redraw_as_noted(recs, rows, live, hasdisp)
    save_recs(recs)
    # Each slot answers one line of the report, in DOCUMENT order: a verdict already decided, or one
    # waiting on its selector's drawing and on the sweep of its picture.
    done = lambda line, failed, st: lambda: (line, failed, st)

    def pending(head, sel, i, gen):
        def verdict():
            end, v, ok, st = drew[sel].result()[i]
            if not end:
                r = swept.result()[gen]
                fs = r["failures"] + r["unhandled"] + ["the picture was never drawn"] * r["missing"]
                if fs:
                    end, st = f"SWEEP {len(fs)} failure(s); the first: {fs[0]}", "SWEEP"
            return f"{head}: {end or v}", bool(end) or not ok, st
        return verdict

    slots, groups = [], {}
    for n, sels in rows:
        if n not in live or not hasdisp(n):
            continue
        ps = live[n]
        if len(sels) != len(ps):
            slots.append(done(f"{addr(n)}: MISCOUNT — {PANELS} names {len(sels)} selector(s) for"
                              f" {len(ps)} panels", True, "MISCOUNT"))
            continue
        for k, (sel, panel) in enumerate(zip(sels, ps), 1):
            tag = f"{addr(n)}.{k}"
            if not hasrow(n, k):
                continue
            if sel == "-":
                slots.append(done(f"{tag}: NO-DECL — no declaration is cited for this panel", False,
                                  "NO-DECL"))
                continue
            base, which = route(sel)
            gen, err = answer(recs, at, n, base)
            if err:
                slots.append(done(f"{tag} {sel}: CANNOT-DRAW {err}", True, "CANNOT-DRAW"))
                continue
            g = groups.setdefault(sel, [])
            slots.append(pending(f"{tag} {sel}", sel, len(g), gen))
            g.append((panel, which, gen))
    with ThreadPoolExecutor(os.cpu_count()) as pool:
        swept = pool.submit(sweep, sorted({gen for g in groups.values() for _, _, gen in g}))
        # One task per SELECTOR, its panels in order: two displays citing one selector share its
        # wrapper files, so they are drawn one after the other as a serial run drew them.
        drew = {s: pool.submit(lambda s, g: [compare(s, *x) for x in g], s, g)
                for s, g in groups.items()}
        tally = {}
        for slot in slots:
            line, failed, st = slot()
            print(line)
            tally[st] = tally.get(st, 0) + 1
            rc |= failed
    # THE SUMMARY COUNTS THE OBLIGATIONS, one per panel line above, and each line's status is the
    # one the verdict NAMED rather than one cut back out of its text.  Every status that occurred is
    # listed, so a status added here is counted without an edit and none can go unreported.
    print("string-check: " + ", ".join(f"{n} {s}" for s, n in sorted(tally.items()))
          + f" over {sum(tally.values())} panel(s)")
    # An export that answered every selector with a file and still exited nonzero is reported by NO
    # line above, so it would leave the gate green on a failure; nor has a selector with no record a
    # reason of its own.  Both are answered by the exporter's stderr — the re-draw pass's runs too,
    # whose failure would otherwise be reported by nothing at all.
    rc |= unanswered(recs, todo, exp)
    for r, bs, p in again:
        rc |= unanswered(r, bs, p)
    return rc


def compare(sel, panel, which, gen):
    """One panel drawn from LEAN and from its `cert:`, and the two compared: the failure that ends
    it, or none and the verdict — which stands only once the sweep of `gen` passes.  The third field
    is whether the panel PASSES, because a verdict now names the layout shift it accepted and a test
    of the verdict's own text would have read `ok (layout: …)` as a failure; the fourth is the
    STATUS the summary counts, named here rather than cut back out of the line's text."""
    gwrap, nwrap = f"{OUT}/{sel}.gen.typ", f"{OUT}/{sel}.note.typ"
    wrap(gwrap, f'#import "/{gen}": panels\n#panels.at({which})\n')
    drew, err = content(gwrap)
    if err:
        return f"CANNOT-DRAW {err}", None, False, "CANNOT-DRAW"
    cert = panel.get("cert") or {}
    if not all(cert.get(f) for f in ("expect", "src", "tgt")):
        return (f"UNCERTIFIED — the note's panel's `cert:` names no"
                f" {', '.join(f for f in ('expect', 'src', 'tgt') if not cert.get(f))}, so"
                f" there is nothing to rebuild it from"), None, False, "UNCERTIFIED"
    p = run("./scripts/diagram", *diagram_args(cert))
    if p.returncode or not p.stdout.strip():
        return (f"NOTE-UNDRAWABLE {p.stderr.strip().splitlines()[-1:]}", None, False,
                "NOTE-UNDRAWABLE")
    # `frc` too: a `%∋` in a label is drawn as the note's own fraction, and `scripts/diagram`
    # emits the call — so the wrapper needs what the NOTE imports, not `dpanel` alone.
    wrap(nwrap, '#import "/diag/dpanel.typ": *\n#import "/diag/circuit.typ": frc\n' + p.stdout)
    e = svg(gwrap, f"{OUT}/{sel}.gen.svg") or svg(nwrap, f"{OUT}/{sel}.note.svg")
    if e:
        return f"CANNOT-DRAW typst {e}", None, False, "CANNOT-DRAW"
    v = run("./scripts/svg-diff", "--records", f"{OUT}/{sel}.note.svg", f"{OUT}/{sel}.gen.svg")
    if v.returncode > 1:
        last = (v.stderr.strip().splitlines() or ["no stderr"])[-1]
        return (f"CANNOT-CHECK ./scripts/svg-diff exited {v.returncode}: {last}", None, False,
                "CANNOT-CHECK")
    # EVERY OBLIGATION `why` ENUMERATES DECIDES, and the ink is one more of them rather than
    # the gate: a bead's mark is a handful of points (a filled dot against a hollow ring)
    # that `svg-diff` pairs off with each other, so a panel whose one defect was a lax bead
    # drawn strict came back `ok` and the verdict decided nothing.  Either side failing fails.
    d = why(panel, drew)
    # WHAT THE GATE DECIDES IS THE DIAGRAM, NOT THE PICTURE — the author, 2026-09-13: "isotopic
    # diagrams should be deemed equal".  The two normal forms are the two panels' isotopy classes,
    # so a panel drawn a row lower, at another scale or with its independent beads in the other
    # order is the SAME diagram and passes; what `svg-diff` and `sameband` found is then reported on
    # the `ok` line as layout and never as a difference.  A panel neither of them can be read out of
    # is CANNOT-CHECK, named by the strand or bead that did not land in the graph.
    form = []
    for side, rec in (("the note's panel", panel), ("the generated panel", drew)):
        try:
            form.append(nform(rec))
        except Ill as x:
            return f"CANNOT-CHECK {side}: {x}", None, False, "CANNOT-CHECK"
    recs = [json.loads(l) for l in v.stdout.splitlines() if l.strip()]
    if d or form[0] != form[1]:
        n = [r for r in recs if r["layer"] == "geometry"]
        kinds = sorted({r["kind"] for r in n})
        m = [r for r in recs if r["layer"] == "glyph"]
        return None, (f"DIFF {len(n)} unmatched primitive(s)"
                       f"{' ' + '/'.join(kinds) if kinds else ''}"
                       f"{f'; {len(m)} glyph box(es) differ' if m else ''}; {d}"), False, "DIFF"
    if not v.returncode:
        return None, "ok", True, "ok"
    lay = layout(recs, panel, drew, f"{OUT}/{sel}.note.svg", f"{OUT}/{sel}.gen.svg")
    return None, f"ok (layout: {lay})", True, "ok (layout)"


def sweep(gens):
    """ONE `scanline --strict` over every picture a panel is drawn from — a file holds several
    panels and is swept once for them all — and each file's verdict read from its `--result`
    fields, keyed by the path as given.  Its bead types come from the export's `RECS`."""
    if not gens:
        return {}
    res = f"{OUT}/sweep.json"
    if os.path.exists(res):
        os.remove(res)
    s = run("./scripts/scanline", "--strict", "--result", res, "--records", RECS, *gens)
    rs = json.load(open(res, encoding="utf-8")) if os.path.exists(res) else []
    if not rs or s.returncode and not any(r["failures"] or r["unhandled"] or r["missing"]
                                          for r in rs):
        sys.exit(f"string-check: ./scripts/scanline --strict exited {s.returncode} with no verdict"
                 f" naming a file:\n{s.stderr.strip() or s.stdout.strip()}")
    return {r["path"]: r for r in rs}


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
