#!/usr/bin/env python3
"""diagram — the Hinze–Marsden panel a formula denotes, drawn mechanically.

`scripts/scanline` reads a panel and prints the composite it denotes; this runs that backwards.  A
formula in the note's notation — diagram order, juxtaposition, `°`, `F(R)`, `𝟙`, `×` — plus the
panel's source and target objects (a formula alone does not fix the ports) come in, a `dpanel(...)`
call goes out, ready to paste into the note and be swept unchanged.  The output carries a `cert:`
whose `expect` is the input, so the picture certifies itself the moment `make scan` sees it.

The model is scanline's, read the other way.  A cut is the live wires in `x` order — leftmost the
outermost functor, the object wire last — and a factor is one bead with the wires that run PAST it
as its context.  So: peel each factor into the wires that wrap it and the bead at its core, walk the
factors top to bottom keeping the cut, and give every wire a lane from where it is born to where it
dies.  A wire the formula needs and the cut has not got is OPENED out of the object (`[A]` is
`list` over `A`).

A bead's own signature comes from `diag/hm-sigs.json`, so the cut is a TYPE.  `elaborate` matches
the bead's source scheme against the cut by unification — what matches is its arms, the unmatched
prefix passes — and the target scheme says which wires it makes.  A wire therefore dies at the bead
that CONSUMES it (`α : F([A])⟶[A]` eats the `F` wire, `choose` the `Δ`), and a factor that does not
fit is a type error naming the bead and the cut rather than a mis-drawn wire.  `layout` is the
second half and deliberately not part of the first: lane x's and bead heights are ONE picture out of
the many the book calls equal (pp. 21–22).

`--roundtrip` is the acceptance test: every panel in the note that carries a `cert:` with an
`expect` is regenerated from that `expect` alone and swept again, and the printed composite must
come back the same — cut down to the one branch it draws, where the formula states a choice.
`--compare` rebuilds every `dpanel(` literal the note holds from its own `cert:` and fails on any
drift, and `--write` splices the rebuilt ones over them, the note's own trailing arguments kept.
"""
import difflib, importlib.machinery, importlib.util, json, os, re, subprocess, sys

sys.dont_write_bytecode = True                 # no `scripts/__pycache__` beside the two scripts
_P = os.path.join(os.path.dirname(os.path.abspath(__file__)), "scanline")
_S = importlib.util.spec_from_loader("scanline", importlib.machinery.SourceFileLoader("scanline", _P))
sl = importlib.util.module_from_spec(_S)
_S.loader.exec_module(sl)
norm, spell, tidy, rec, Unhandled = sl.norm, sl.spell, sl.tidy, sl.rec, sl.Unhandled


# Which operand of a `∪`/`[f,g]` gets drawn, as a RULE and not a taste: a branch that throws its
# source away (`⊸`) draws nothing, then the most factors, then the longer spelling breaks the tie.
def rank(e):
    return (0 if '⊸' in spell(e) else 1, len(e[1]) if e[0] == 'comp' else 1, len(spell(e)))


def cut(e, obj, br):
    """A formula down to the ONE branch the panel draws: each `∪`/`[f,g]` down to the operand `rank`
    calls the most complicated, and `F` down to that branch's summand (`scanline.BRANCH`).  This
    model has one bead per factor and no picture for a choice — the honest picture is one branch,
    and the `cert:`'s `branch:` tells the sweep, and the reader, which one it is."""
    if e[0] == 'app' and e[1] == 'F' and br:
        return sl.act(sl.BRANCH[br]["F"], cut(e[2], obj, br), obj=obj)
    if e[0] in ('union', 'case'):
        p = max([cut(x, obj, br) for x in e[1]], key=rank)
        # The bracket stays a NODE where the display writes one: the bead wears the branch's name
        # and keeps the algebra's signature, which a bare operand would not have.
        return ('case', [p], spell(p)) if e[0] == 'case' else p
    return rec(e, lambda x: cut(x, obj, br))


BR = None                   # the branch `draw` picked, as `scanline.BRANCH` names it


def bead(e):
    """`∩`, `⦇⦈` and `(g→x,y)` are wirings of the CIRCUIT calculus (`scripts/circuit`) — this model
    has no picture for any of them, so each folds back to the one bead it was before the parser
    could read it.  Folded BEFORE `cut` runs, so that `branch` — which asks whether `cut` CHANGED
    the tree — does not read a fold as a branch having been picked."""
    if e[0] in ('cap', 'cond', 'cata'):
        return ('atom', e[2])
    if e[0] in ('union', 'case'):
        return (e[0], [bead(x) for x in e[1]], e[2])
    return rec(e, bead)


def parse(s, obj=True):
    """The shared parser, every choice in it cut down to the branch being drawn."""
    return cut(bead(sl.parse(s)), obj, BR)


def branch(formula):
    """The name `scanline.BRANCH` gives the branch `cut` picks, or None where the formula states no
    choice at all.  The `cert:` declares it and `scanline.read` cuts the STATED formula down the
    same way, so the picture and the sweep that reads it back agree on what is being drawn."""
    e = bead(sl.parse(formula))
    drawn = cut(e, False, None)
    if drawn == e:
        return None
    ks = [k for k, v in sl.BRANCH.items() if v["pick"] in spell(drawn)]
    if len(ks) != 1:
        raise Unhandled(f"the branch {spell(drawn)} is {'none' if not ks else 'more than one'} of"
                        f" the branches {list(sl.BRANCH)} the sweep knows")
    return ks[0]


# The note's own geometry: `hm` columns 1.15 apart from 0.55, the `𝟏` region 2.85 wide.
X0, DX, DY, PAD = 0.55, 1.15, 1.0, 2.85
# Slope mode: the object wire is a polyline hugging the live lanes.  "right": legs sit right of the
# arms they replace and drop straight from the dot, so the wire runs away rightward (6c26635).
# "left": legs sit LEFT of the arms, so the wire sweeps top-right to bottom-left and absorbs the
# innermost arm at its own column where it slides (IntroString p.79, 3.8b); a death that would move
# it ONE gap it sits out, the arm bending in (user, 2026-09-01).  None = the old vertical.
SLOPE = "left"
SIGS = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "diag",
                    "hm-sigs.json")


def sigs():
    """`diag/hm-sigs.json` — what each bead's label is an arrow BETWEEN, keyed by the label's head."""
    return json.load(open(SIGS, encoding="utf-8"))


def typed(table, own):
    """The table with a panel's own `sigs:` laid over it: `R: "F(A)⟶A"` types an abstract letter of
    one display, which no `hm-sigs.json` row could — there is no declaration to cite for it."""
    if not own:
        return table
    return {**table, "sigs": {**table["sigs"], **{k: dict(zip(("src", "tgt"), v.split("⟶")))
                                                  for k, v in own.items()}}}


def letters(e):
    """The wire letters an object names.  A product is one letter `×` whatever its components are:
    the wire a product opens is a context (`A×−`, `Δ`), and the letter is what Lean must spell."""
    if e[0] == 'app':
        return {e[1]} | letters(e[2])
    if e[0] == 'prod':
        return {'×'}.union(*(letters(x) for x in e[1]))
    return letters(e[1]) if e[0] == 'conv' else set()


# ---------------------------------------------------------------- objects as wire stacks
# The functors drawn as a wire of their own instead of folded into the object wire's label.  `list`
# splits by DEFAULT: one bead name must have one signature across a display, and a `[A]` folded in
# one panel makes `cons` CREATE the `list` its neighbour already carries.  A panel's own `cert:`
# `split:` still overrides — `split: ""` folds it back.
DEFSPLIT = "list"
SPLIT = frozenset(DEFSPLIT.split())


def render(e):
    """The ONE label a cut's object may carry, or None.  `norm` reads `[X]` back as `list(X)`, so a
    list of a renderable object needs no wire of its own; nothing else survives the round trip."""
    if e[0] == 'atom':
        return e[1]
    if e[0] == 'app' and e[1] == 'list' and 'list' not in SPLIT:
        inner = render(e[2])
        if inner is not None and sl.listable(e[2]):
            return f"[{inner}]"
    return None


def peel(e):
    """A normalised object as (wires outermost first, the object the object wire itself carries)."""
    ws = []
    while render(e) is None:
        if e[0] == 'prod' and len(e[1]) == 2 and e[1][0] == e[1][1]:
            ws.append('Δ'); e = e[1][0]
        elif e[0] == 'prod' and len(e[1]) == 2 and render(e[1][0]) is not None:
            ws.append(render(e[1][0]) + '×−'); e = e[1][1]
        elif e[0] == 'app':
            ws.append(e[1]); e = e[2]
        else:
            raise Unhandled(f"no wire stack for the object {spell(e)}")
        if len(ws) > 8:
            raise Unhandled(f"the object {spell(e)} nests deeper than a panel can draw")
    return ws, e


# ---------------------------------------------------------------- factors as bead + context
def peel_arrow(e, cut, rel):
    """A factor split into the wires that run PAST the bead and the bead itself.  The cut says which
    wire a `𝟙`-slot context or a doubled arrow stands on: `Δ(R°)` is `R°` under the live `Δ`."""
    ws = []
    while True:
        d, live = len(ws), cut[len(ws)] if len(ws) < len(cut) else None
        if e[0] == 'app' and e[1] in rel:
            ws.append(e[1]); e = e[2]
        elif e[0] == 'prod' and len(e[1]) == 2 and e[1][0] == e[1][1] and live == 'Δ':
            ws.append('Δ'); e = e[1][0]
        elif e[0] == 'prod' and live is not None and '−' in live \
                and len(e[1]) == len(live.split('×')) \
                and sum(x != ('atom', sl.UNIT) for x in e[1]) == 1 \
                and e[1][live.split('×').index('−')] != ('atom', sl.UNIT):
            ws.append(live); e = next(x for x in e[1] if x != ('atom', sl.UNIT))
        else:
            return ws, e


def across(e, rel):
    """`s∘t` split at its one bead: the identity letters LEFT of it are wires it runs under, the
    ones right of it are kept by its own variable tail — left is outermost, as in the cut."""
    if e[0] != 'hc':
        return [], e, []
    k = [i for i, x in enumerate(e[1]) if not (x[0] == 'atom' and x[1] in rel)]
    if len(k) != 1:
        raise Unhandled(f"{spell(e)} composes {len(k)} beads across; one height draws one bead")
    return e[1][:k[0]], e[1][k[0]], e[1][k[0] + 1:]


def expand(e, rel):
    """One written factor as the rows it draws.  A context wire runs past EVERY row of what it
    wraps, which is the `∘` clause on a composite — `F(RS)` and `𝟙×(RS)` are how the display
    spells `F∘(RS)`, and `norm` merged those beads that each need their own height back."""
    if e[0] == 'comp':
        return [y for x in e[1] for y in expand(x, rel)]
    if e == ('atom', sl.UNIT):
        return []                          # bare wires: the identity draws no bead
    if e[0] == 'hc':
        pre, core, post = across(e, rel)
        return [('hc', pre + [x] + post) for x in expand(core, rel)]
    if e[0] == 'app' and e[1] in rel:      # `E(E(RS))`: the context wraps each row however deep
        return [('app', e[1], y) for y in expand(e[2], rel)]
    if e[0] == 'case' and len(e[1]) == 1 and e[1][0][0] == 'comp':
        # `[nil,⊸ nil ∪ (p×list(p)) cons]` cut to its branch: the bracket is the LAST factor's node,
        # the algebra's own arrow; the factors before it are beads of their own (user, 2026-09-01).
        xs = e[1][0][1]
        return expand(('comp', xs[:-1]), rel) + [('case', [xs[-1]], spell(xs[-1]))]
    if e[0] == 'prod' and len({spell(x) for x in e[1] if x != ('atom', sl.UNIT)}) > 1:
        # `f×g` is `(f×𝟙)(𝟙×g)`, one height each: `f×−` is natural, so `f` is a bead ON the `A×−`
        # wire and `g` sits under it.  `R×R` stays whole — that is `Δ(R)`, one bead under `Δ`.
        return [y for k, x in enumerate(e[1]) if x != ('atom', sl.UNIT) for y in expand(
            ('prod', [x if j == k else ('atom', sl.UNIT) for j in range(len(e[1]))]), rel)]
    if e[0] == 'prod' and sum(x != ('atom', sl.UNIT) for x in e[1]) == 1:
        k = next(i for i, x in enumerate(e[1]) if x != ('atom', sl.UNIT))
        if e[1][k][0] == 'comp':
            return [y for x in e[1][k][1]
                    for y in expand(('prod', e[1][:k] + [x] + e[1][k + 1:]), rel)]
    return [e]


# ---------------------------------------------------------------- the elaborator
# A signature's variables are single lower-case letters, renamed apart per factor (`x@3`) so two
# beads may both say `x`.  A variable stands for a whole TAIL of the cut: wires, and the object
# under them.  Everything else in a signature is a constant — a wire letter or a named object.
VARS, TOP = set("stuvwxyz"), -1


def isvar(e):
    return e[0] == 'atom' and '@' in e[1] and e[1].split('@')[0] in VARS


def fresh(e, n):
    return ('atom', f"{e[1]}@{n}") if e[0] == 'atom' and e[1] in VARS \
        else rec(e, lambda x: fresh(x, n))


def loose(e):
    return isvar(e) or (e[0] in ('comp', 'prod') and any(loose(x) for x in e[1])) \
        or (e[0] == 'app' and loose(e[2])) or (e[0] == 'conv' and loose(e[1]))


def fold(lanes, obj):
    """The object a cut denotes — every wire applied, outermost first, to what the object wire holds."""
    for l in reversed(lanes):
        obj = sl.act(l.label, obj, True)
    return obj


def deref(e, sub):
    while isvar(e) and e[1] in sub:
        e = fold(*sub[e[1]])
    return e


def settle(e, sub):
    return rec(deref(e, sub), lambda x: settle(x, sub))


def unify(a, b, sub, why):
    """Two objects made equal, binding variables on either side."""
    a, b = deref(a, sub), deref(b, sub)
    if isvar(a) or isvar(b):
        sub[a[1] if isvar(a) else b[1]] = ([], b if isvar(a) else a)
    elif a[0] != b[0] or (a[0] in ('atom', 'app') and a[1] != b[1]) \
            or (a[0] in ('comp', 'prod') and len(a[1]) != len(b[1])):
        raise Unhandled(f"{why}: {spell(a)} is not {spell(b)}")
    elif a[0] in ('comp', 'prod'):
        for x, y in zip(a[1], b[1]):
            unify(x, y, sub, why)
    elif a[0] != 'atom':
        unify(a[1 if a[0] == 'conv' else 2], b[1 if a[0] == 'conv' else 2], sub, why)


def layer(e):
    """`peel`'s step read on a scheme: the outermost wire an object names, and what is under it."""
    if e[0] == 'prod' and len(e[1]) == 2:
        return ('Δ', e[1][0]) if e[1][0] == e[1][1] else \
            (render(e[1][0]) and render(e[1][0]) + '×−', e[1][1])
    return (e[1], e[2]) if e[0] == 'app' else (None, None)


def matches(pat, lane, sub):
    """A scheme's wire against a live one: `x×−` takes the `A×−` context and binds `x` to `A`."""
    ps, ws = pat.split('×'), lane.split('×')
    if pat == lane:
        return True
    if len(ps) != len(ws):
        return False
    for p, w in zip(ps, ws):
        if p != w and not (isvar(('atom', p)) and sub.setdefault(p, ([], parse(w)))[1] == parse(w)):
            return False
    return True


def eat(pat, lanes, obj, sub, why):
    """A source scheme against the cut: how many of its wires the bead consumes, the wires it eats
    that the cut carried FOLDED, and what is left on the object wire.  The context the formula names
    is peeled off before this — it never reaches here."""
    k, opened = 0, []
    while True:
        if isvar(pat) and pat[1] not in sub:
            sub[pat[1]] = (lanes[k:], obj)
            return k, opened, obj
        w, inner = layer(deref(pat, sub))
        if k >= len(lanes):
            # past the end of the cut the scheme still names a wire: open it here rather than unify
            # it away, since a wire eaten unopened is drawn nowhere at all.  What stays folded: a
            # wire the scheme only names by a variable, and a port the panel's `split:` folds.
            e = deref(obj, sub)
            if w is None or '@' in w or (not isvar(e) and render(e) is not None):
                unify(pat, obj, sub, why)
                return k, opened, obj
            opened.append((w, obj))
            obj, pat = open_out(obj, w, sub, why), inner
            continue
        if w is None or not matches(w, lanes[k].label, sub):
            raise Unhandled(f"{why} wants {spell(settle(pat, sub))} where the cut has the"
                            f" {lanes[k].label} wire")
        pat, k = inner, k + 1


def grow(pat, sub, why):
    """A target scheme as a cut: the wires it opens, then the tail its variable still carries.  A
    target that renders whole folds into the object wire's label, as `peel` folds `list(A)` to `[A]`."""
    v = pat
    while not isvar(v):
        v = layer(v)[1]
        if v is None:
            break
    keep = sub[v[1]][0] if v is not None and v[1] in sub else []
    ws = []
    while True:
        e = settle(pat, sub)
        if not keep and not loose(e) and render(e) is not None:
            return ws, [], e
        if isvar(pat):
            return ws, keep, sub[pat[1]][1] if pat[1] in sub else pat
        w, inner = layer(pat)
        if w is None:
            return ws, [], e
        ws.append(w); pat = inner


def own_comma(body):
    """A comma of the bracket's own sits at depth 0 of its body: `[zero,⊕]` is a `[,]`, `⦇[zero,⊕]⦈`
    a `⦇⦈`."""
    d = 0
    for c in body:
        d += (c in sl.OPENERS) - (c in sl.CLOSERS)
        if c == ',' and d == 0:
            return True
    return False


def row(core, sigs, n):
    """The row a bead's label keys, or None.  A bracket cut to one branch is still the ALGEBRA's
    arrow (`[,]`); a catamorphism runs on the initial algebra of the functor its step consumes —
    `list` for an `F`-algebra, `F(X)=𝟏+A×X`, the row's own otherwise — and lands on the step's carrier."""
    lab = core[1] if core[0] == 'app' else spell(core)
    if lab in sigs:                        # a row of the label's own beats the bracket's inference
        return sigs[lab]
    k = lab[:-2] if lab.endswith('%∋') else lab
    if core[0] == 'case':
        k = '[,]'
    elif k and k[0] in sl.OPENERS:
        body = k[1:-1]
        k = k[0] + (',' if own_comma(body) else '') + sl.CLOSERS[sl.OPENERS.index(k[0])]
        r, step = sigs.get(lab) or sigs.get(k), row(bead(sl.parse(body)), sigs, n)
        if r and step:                         # `[,]`'s `x` is the carrier, so `list`'s element is a
            lst = step[0][:2] == ('app', 'F')  # letter of its own; `tree(x)` keeps the step's `x`
            return (('app', 'list', ('atom', f"x@{n}s")) if lst else r[0]), step[1]
        return r
    return sigs.get(lab) or sigs.get(k)


def signature(core, sigs, n):
    """What a bead's label is an arrow between.  `R°` is `R` read backwards, `R%∋` is `R` with the
    division's own `E` wire on its target, and a label with no row touches the object wire alone."""
    if core[0] == 'conv':
        s, t = signature(core[1], sigs, n)
        return t, s
    lab = core[1] if core[0] == 'app' else spell(core)
    s, t = row(core, sigs, n) or (('atom', 'x'), ('atom', 'x'))
    return fresh(s, n), fresh(('app', 'E', t) if lab.endswith('%∋') else t, n)


def open_out(obj, w, sub, why):
    """The wire `w` lifted off the object — `[A]` is `list` over `A`, and an object still unknown
    becomes whatever the factor asks it to be."""
    e = deref(obj, sub)
    if isvar(e):
        inner = ('atom', f"{e[1]}^{w}")
        sub[e[1]] = ([], sl.act(w, inner, True))
        return inner
    a, inner = layer(e)
    if a != w:
        raise Unhandled(f"{why} runs under {w}, which does not lift off {spell(e)}")
    return inner


class Lane:
    """One wire, from the factor that makes it to the factor that eats it."""
    def __init__(self, label, born=None):
        self.label, self.born, self.dies = label, born, None
        self.x = None


class Row:
    def __init__(self, label, arms, legs, reach, obj, on=None):
        self.label, self.arms, self.legs, self.reach = label, arms, legs, reach
        self.obj = obj                     # what the object wire carries BELOW this row
        self.on = on                       # the functor lane the bead sits ON, if not the object


def alphabet(table, *objs):
    """The wire letters, as data: what the signatures and the panel's own ports name between them.
    A name is a wire because a signature uses it as one — there is no list of relators to keep."""
    ws = {l for v in table["sigs"].values()
          for e in (v["src"], v["tgt"]) for l in letters(norm(parse(e)))}
    return {w for w in ws.union(*(peel(o)[0] for o in objs)) if '−' not in w and w != '×'}


def born_at(rows, tail, sub, dflt):
    """Which bead a wire comes off.  A wire IS the object-tail hanging below it, so it is born at the
    first row whose object already carries that tail — `⦇S⦈`'s target is the free `y`, so which row
    that is is known only once `sub` is solved.  Identifying the wire by its tail and not by its
    depth is what lets a wire keep its lane across a bead that eats the wire OUTSIDE it."""
    def carries(e):
        while e != tail:
            if render(e) is not None:
                return False
            w, e = layer(e)
            if w is None:
                return False
        return True
    return next((i for i, r in enumerate(rows) if carries(settle(r.obj, sub))), dflt)


def elaborate(formula, src, tgt, table):
    """The typed reading of a formula: one row per bead, carrying the wires its signature eats and
    the wires it makes.  A wire dies where it is CONSUMED — what a formula alone cannot say."""
    sigs = {k: (norm(parse(v["src"])), norm(parse(v["tgt"]))) for k, v in table["sigs"].items()}
    stack, obj = peel(norm(parse(src)))
    want = norm(parse(tgt))
    rel = alphabet(table, norm(parse(src)), want)
    made = [Lane(w, born=TOP) for w in stack]
    lanes, sub, rows, atop, pending = list(made), {}, [], obj, []
    for i, e in enumerate(expand(norm(parse(formula, False)), rel)):
        pre, e, _ = across(e, rel)         # `∘`'s left letters are context; its right ones the tail keeps
        wrap, core = peel_arrow(e, [l.label for l in lanes[len(pre):]], rel)
        wrap = [x[1] for x in pre] + wrap
        why = f"factor {i + 1} ({spell(tidy(core))})"
        for k, w in enumerate(wrap):
            if k < len(lanes) and lanes[k].label != w:
                raise Unhandled(f"{why} runs under {w} where the cut has {lanes[k].label}")
            if k >= len(lanes):                # a wire the formula names and the cut has not got is
                obj = open_out(obj, w, sub, why)   # opened out of the object, at the bead above —
                made.append(Lane(w, born=i - 1 if rows else TOP))   # or at the top edge if there is
                lanes.append(made[-1])             # none, where the source itself opens further
                if rows:
                    rows[-1].legs.append(made[-1])
                else:
                    atop = obj
        reach = lanes[len(wrap)] if len(wrap) < len(lanes) else None
        if core[0] == 'prod' and reach is not None and '−' in reach.label \
                and len(core[1]) == len(reach.label.split('×')) \
                and sum(x != ('atom', sl.UNIT) for x in core[1]) == 1:
            # `f×𝟙` under the `A×−` wire is `f×−`, natural in the hole: `f` is a bead ON that wire.
            # The lane has one label, so `f` may not change the `A` it carries.
            f = next(x for x in core[1] if x != ('atom', sl.UNIT))
            a = norm(parse(next(q for q in reach.label.split('×') if q != '−')))
            s, t = signature(f, sigs, i)
            unify(s, a, sub, why)
            if settle(t, sub) != a:
                raise Unhandled(f"{why} turns the {reach.label} wire into"
                                f" {spell(settle(t, sub))}×−, which one lane cannot carry")
            rows.append(Row(spell(tidy(f)), [], [], None, obj, on=reach))
            continue
        s, t = signature(core, sigs, i)
        k, opened, obj = eat(s, lanes[len(wrap):], obj, sub, why)
        arms = lanes[len(wrap):len(wrap) + k]
        for w, e in opened:                # a wire opened HERE was born further up, where the object
            made.append(Lane(w))           # first carried it; it is drawn down to the bead eating it
            pending.append((made[-1], e, i)); arms.append(made[-1])
        if reach is None and opened:       # a bead with no lane of its own still reaches the wires
            reach = arms[k]                # it opened — a bead is a point, and every reach is an arm
        ws, keep, obj = grow(t, sub, why)
        legs = [Lane(w, born=i) for w in ws]
        for l in arms:
            l.dies = i
        # `made` is COLUMN order, not birth order: `η∘M` opens its wire left of the one it keeps.
        at = made.index(arms[0]) if arms and SLOPE == "left" else \
            made.index(keep[0]) if keep else len(made)
        made[at:at] = legs
        lanes = lanes[:len(wrap)] + legs + keep
        rows.append(Row(spell(tidy(core)), arms, legs, reach, obj))
    k, opened, obj = eat(want, lanes, obj, sub, f"the target {tgt}")
    if k != len(lanes):
        raise Unhandled(f"the target {tgt} leaves the {lanes[k].label} wire live")
    for w, e in opened:
        made.append(Lane(w)); pending.append((made[-1], e, len(rows))); lanes.append(made[-1])
    for l in lanes:
        l.dies = len(rows)
    # The bottom edge is a wire stack too, not one label: a target the beads only pin by unification
    # reaches here still wrapped, so peel it and give each wire the bead it comes off.
    ws, ob = peel(settle(obj, sub))
    for k, w in enumerate(ws):
        tail = ob
        for x in reversed(ws[k:]):
            tail = sl.act(x, tail, True)
        made.append(Lane(w, born=born_at(rows, tail, sub, len(rows) - 1)))
        made[-1].dies = len(rows)
    for l, e, i in pending:
        l.born = born_at(rows[:i], settle(e, sub), sub, TOP)
    obot, otop = render(ob), render(settle(atop, sub))
    if otop is None:
        raise Unhandled(f"the object wire carries {spell(settle(atop, sub))}, which has no label")
    for r in rows:                         # the seam labels: what a formula alone cannot say either
        r.obj = render(settle(r.obj, sub))
    return rows, made, otop, obot


# ---------------------------------------------------------------- the panel a term denotes
def layout(rows, made, otop, obot, cert):
    """ONE panel of the many the book calls equal (pp. 21–22): a lane per wire in birth order, a
    height per factor.  Nothing here is functorial — gluing two terms renumbers every lane."""
    n = len(rows)
    ys = [(n - i) * DY for i in range(n)]
    for k, l in enumerate(made):
        l.x = round(X0 + k * DX, 2)
    xo = round(X0 + len(made) * DX, 2)
    beads, unit = [], {}
    for i, r in enumerate(rows):
        # `𝟙%∋` is the unit `Id⟹E`, a 2-cell between FUNCTORS with no object wire to sit on, so
        # `dpanel` heads the lane it opens with it; `S° : B⟶F(B)` is a relation and stays a bead.
        if not r.arms and r.legs and r.label == f"{sl.UNIT}%∋":
            if len(r.legs) != 1:
                raise Unhandled(f"the unit {r.label} opens {len(r.legs)} wires; a lane heads one")
            unit[r.legs[0]] = r.label
            ys[i] -= DY / 2                # half a step, so the knees above sweep clear of it
            continue
        if r.on is not None:               # on a functor wire: the dot at that lane's x, no reach
            beads.append([ys[i], r.label, "#000000", None, r.on.x]); continue
        # how far left the bead reaches: every lane from there to the dot bends onto it, arms and
        # crossed wires alike, because a bead is a POINT and there is no such thing as a straight bar
        reach = r.reach.x if r.reach is not None else None
        beads.append([ys[i], r.label] if reach is None else [ys[i], r.label, "#000000", reach])
    hh = (n + 1) * DY

    def xat(y, dying=True):
        """The object wire's x at a height.  "right": one lane-gap right of every lane already born
        there, and AT the innermost leg born at that height — it never comes back after a death.
        "left": one gap right of every lane alive there or NOT YET BORN — a column is held from the
        top, else the wire's own `xo` could be a lane's column and the sweep would read one for the
        other — and AT the innermost arm dying at that height: the wire absorbs it at its own
        column.  With `dying` off the arms dying there are already gone: where the wire would sit
        just below the bead."""
        c = [X0]
        for l in made:
            yb = hh if l.born == TOP else ys[l.born]
            yd = 0.0 if l.dies == n else ys[l.dies]
            if SLOPE == "left":
                if yd > y + 1e-9:
                    continue                   # already dead
                if l.dies != n and abs(yd - y) <= 1e-9:
                    if dying:
                        c.append(l.x)
                else:
                    c.append(l.x + DX)
            elif l.born == TOP or yb > y + 1e-9 or (l in unit and abs(yb - y) <= 1e-9):
                c.append(l.x + DX)
            elif abs(yb - y) <= 1e-9:
                c.append(l.x)
        return round(max(c), 2)

    op, hs = None, [hh] + sorted({b[0] for b in beads}, reverse=True) + [0.0]
    if SLOPE == "left":
        # The wire holds its column across a death that would move it ONE gap — the arm bends into
        # it, as the note draws by hand (2026-09-01) — and slopes only where it is left further adrift.
        op, x = [], xat(hh)
        for y in hs:
            if x - xat(y, False) > DX + 1e-6:
                x = xat(y)
            op.append([x, y])
    elif SLOPE:
        op = [[xat(y), y] for y in hs]
    if op and all(q[0] == op[0][0] for q in op):
        op = None
    if SLOPE == "left":                # the wire's top x, which the sweep and both ports key on
        xo = xat(hh)
    rec = {"kind": "scanline", "id": "gen.1", "helper": "dpanel", "h": (n + 1) * DY,
            "w": (max(q[0] for q in op) if op else xo) + PAD,
            "xo": xo,
            "lanes": [[l.x, "top" if l.born == TOP else ys[l.born],
                       "bot" if l.dies == n else ys[l.dies],
                       None if l.born == TOP or l.dies == n else l.label,
                       unit.get(l)] for l in made],
            "beads": beads,
            # the object wire's type at every seam.  `dpanel` takes no such argument, so `emit`
            # drops it: a panel pasted into the note is read back by the sweep's own guess.
            "obj": [[ys[i], r.obj] for i, r in enumerate(rows) if r.obj is not None],
            "top": [[l.x, l.label] for l in made if l.born == TOP] + [[xo, otop]],
            "bot": [[l.x, l.label] for l in made if l.dies == n] + [[xo, obot]],
            "cert": cert}
    if op:
        rec["opath"] = op
    return rec


def draw(formula, src, tgt, table=None, split=DEFSPLIT, own=None):
    """The panel a formula denotes, typed: `elaborate` says what the picture IS, `layout` chooses
    one of the pictures the book calls equal.  `split` and `own` ride in the `cert:` beside `src`
    and `tgt`, for the same reason they do — a formula alone does not say which picture of it the
    note wants.  Only a panel that DIFFERS from `DEFSPLIT` states it, so the default costs the note
    no field; `sigs:` likewise appears only where the panel types a letter itself."""
    global SPLIT, BR
    SPLIT = frozenset(split.split())
    BR = branch(formula)
    cert = {"expect": formula, "src": src, "tgt": tgt} | ({"branch": BR} if BR else {})
    rows, made, otop, obot = elaborate(formula, src, tgt, typed(table or sigs(), own))
    return layout(rows, made, otop, obot, cert | ({"split": split} if split != DEFSPLIT else {})
                  | ({"sigs": own} if own else {}))


# ---------------------------------------------------------------- the typst call
def num(v):
    return f"{v:g}"


def labelcode(v):
    """The one spelling of a bead or lane label: `X%∋` is the note's own fraction, `frc([X])`;
    everything else is today's inline code."""
    if v.endswith("%∋"):
        return f"frc([`{v[:-2]}`])"
    return f"[`{v}`]"


def cell(v):
    return "none" if v is None else f'"{v}"' if isinstance(v, str) and v in ("top", "bot") \
        else labelcode(v) if isinstance(v, str) else num(v)


def tup(xs):
    return "(" + ", ".join(cell(x) for x in xs) + ("," if len(xs) == 1 else "") + ")"


def lst(xs):
    return "(" + ", ".join(tup(x) for x in xs) + ("," if len(xs) == 1 else "") + ")"


def quoted(v):
    """A `cert:` string as Typst source, where `\\` is an escape and so must be doubled."""
    return '"' + v.replace("\\", "\\\\") + '"'


def emit(r):
    c = r["cert"]
    beads = [b[:2] + [None] + b[3:] for b in r["beads"]]
    return (f'#dpanel({num(r["h"])}, {num(r["w"])}, {num(r["xo"])},\n'
            f'  {lst(r["lanes"])},\n'
            + "  (" + ", ".join("(" + num(b[0]) + ", " + labelcode(b[1])
                                + (", black, " + cell(b[3]) if len(b) > 3 else "")
                                + (", " + num(b[4]) if len(b) > 4 else "") + ")"
                                for b in beads) + ("," if len(beads) == 1 else "") + "),\n"
            + f'  {lst(r["top"])},\n  {lst(r["bot"])},\n'
            + (f'  opath: {lst(r["opath"])},\n' if r.get("opath") else "")
            + "  cert: (" + ", ".join(f'{k}: ' + (quoted(v) if isinstance(v, str) else
                "(" + ", ".join(f'{quoted(a)}: {quoted(b)}' for a, b in v.items()) + ")")
                                     for k, v in c.items()) + "))")


# ---------------------------------------------------------------- the round trip
def shown(formula, br):
    """What a panel must sweep back as.  A panel drawing ONE branch of a `∪` denotes that branch,
    not the whole formula, so the formula is cut down to it — the reading the sweep certifies by."""
    return spell(tidy(parse(formula, False))) if br else formula


def swept(r):
    """The composite the generated panel denotes, read by the same sweep `make scan` runs."""
    p = sl.Panel(r)
    bad = sl.sweep(p)
    b, _ = sl.certify(p)
    return spell(tidy(p.expr)), bad + b


def endpoints(p):
    """The panel's stated ports, or — where the `cert:` names none — the ones it draws."""
    c = p.cert
    return (c.get("src") or spell(sl.fold_cut(p, sl.ports(p, True))),
            c.get("tgt") or spell(sl.fold_cut(p, sl.ports(p, False))))


def roundtrip(path, frm, show, out, tbl):
    recs = sl.panels(path, frm)
    ok, printer, law, fail, gen = 0, 0, 0, [], []
    for r in recs:
        if not (r.get("cert") or {}).get("expect"):
            continue
        want = r["cert"]["expect"]
        try:
            src, tgt = endpoints(sl.Panel(r))
            g = draw(want, src, tgt, tbl, r["cert"].get("split", DEFSPLIT), r["cert"].get("sigs"))
            g["id"] = r["id"]
            got, bad = swept(g)
            gen.append(g)
        except (Unhandled, ValueError, KeyError, StopIteration) as ex:
            fail.append(f"{r['id']}: {type(ex).__name__}: {ex}"); continue
        drawn = shown(want, g["cert"].get("branch"))
        if bad:
            fail.append(f"{r['id']}: the generated panel fails its own sweep — {bad[0]}")
        elif got == drawn:
            ok += 1
        elif got == spell(tidy(parse(want))):
            printer += 1                       # differs only where `spell` spaces a bracket
        elif norm(sl.parse(got)) == sl.read(want, g["cert"], False)[0]:
            law += 1                           # `F(R)F(S)=F(RS)`, `f×g=(f×𝟙)(𝟙×g)`: heights the
        # display writes as one — the sweep's own reading, which also cuts `[,]` to the branch drawn
        else:
            fail.append(f"{r['id']}: {drawn}  ->  {got}")
        if show:
            print(f"// {r['id']}  {want}"); print(emit(g)); print()
    print(f"diagram: {ok + printer + law + len(fail)} certified panels, {ok} verbatim,"
          f" {printer} modulo the printer's spacing, {law} modulo a relator law,"
          f" {len(fail)} failed")
    if out:
        json.dump(gen, open(out, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
    if fail:
        print(*fail, sep="\n", file=sys.stderr)
        sys.exit(f"diagram: {len(fail)} panel{'s' * (len(fail) > 1)} did not come back")


# ---------------------------------------------------------------- the note's own literals
def close(text, i):
    """The index of the `)` matching the `(` at `i`.  A `"…"` is opaque and ends at the next `"` —
    `quoted` never escapes one — because an `expect` carries brackets of its own."""
    j, depth = i, 0
    while True:
        c = text[j]
        if c == '"':
            j = text.index('"', j + 1)
        elif c in "([{":
            depth += 1
        elif c in ")]}":
            depth -= 1
            if not depth:
                return j
        j += 1


def certof(s):
    """A literal's `cert:` group as `draw` takes it: the string fields, and `sigs` as a dict."""
    c = {k: v.replace("\\\\", "\\") for k, v in re.findall(r'(\w+): "([^"]*)"', s)}
    k = s.find("sigs: (")
    if k >= 0:
        c["sigs"] = dict(re.findall(r'"([^"]*)": "([^"]*)"', s[k:close(s, k + 6) + 1]))
    return c


def literals(text):
    """Every `dpanel(…)` in a file that carries a drawable `cert:`, as (start, cert end, end, cert):
    the text after the `cert:` group — `names:`, `s:` — is the note's own and rides along unchanged."""
    out, i = [], text.find("dpanel(")
    while i >= 0:
        j = close(text, i + 6)
        k = text.rfind("cert: (", i, j)
        c = certof(text[k:j]) if k >= 0 else {}
        if all(c.get(x) for x in ("expect", "src", "tgt")):
            out.append((i, close(text, k + 6) + 1, j + 1, c))
        i = text.find("dpanel(", j)
    return out


def regen(path, tbl, write):
    """Each literal rebuilt from its own `cert:` and held against the text: `--compare` prints the
    drift as a diff and fails, `--write` splices the rebuilt literal over it, last to first."""
    text = open(path, encoding="utf-8").read()
    lits = literals(text)
    fail, drift, msgs = 0, 0, []
    for i, e, j, c in reversed(lits):
        ln = text.count("\n", 0, i) + 1
        head = f"{path}:{ln}  {c['expect']}   [{c['src']} ⟶ {c['tgt']}]"
        try:
            new = emit(draw(c["expect"], c["src"], c["tgt"], tbl, c.get("split", DEFSPLIT),
                            c.get("sigs")))[1:-1]
        except (Unhandled, ValueError, KeyError, StopIteration) as ex:
            fail += 1; msgs.append(f"{head}\n  {ex}"); continue
        if new == text[i:e]:
            continue
        drift += 1
        if write:
            text = text[:i] + new + text[e:]; msgs.append(f"{head}\n  rewritten")
        else:
            msgs.append("\n".join([head] + list(difflib.unified_diff(
                text[i:e].splitlines(), new.splitlines(), "note", "generated", lineterm=""))))
    if write:
        open(path, "w", encoding="utf-8").write(text)
    if msgs:
        print(*reversed(msgs), sep="\n")
    print(f"diagram: {len(lits)} literals in {path}, {len(lits) - drift - fail} verbatim, {drift}"
          f" {'rewritten' if write else 'drifted'}, {fail} undrawable", file=sys.stderr)
    sys.exit((fail or drift and not write)
             and f"diagram: {path} does not hold what the generator draws")


def main(argv):
    frm, out = sl.opt(argv, "--from"), sl.opt(argv, "--json")
    src, tgt = sl.opt(argv, "--src"), sl.opt(argv, "--tgt")
    own = sl.opt(argv, "--sigs")           # `R:F(A)⟶A S:F(B)⟶B`: the key is left of the LAST colon
    own = dict(x.rsplit(":", 1) for x in own.split()) if own else None
    taken = {i for o in ("--from", "--json", "--src", "--tgt", "--sigs") if o in argv
             for i in (argv.index(o), argv.index(o) + 1)}
    free = [a for i, a in enumerate(argv) if i not in taken and not a.startswith("-")]
    path = next((a for a in free if a.endswith(".typ")), None)
    tbl = sigs()
    if "--roundtrip" in argv or "--compare" in argv or "--write" in argv:
        path = path or "diag/allegory-axioms.typ"
        if "--roundtrip" in argv:
            roundtrip(path, frm, "--show" in argv, out, tbl)
        else:
            regen(path, tbl, "--write" in argv)
        return
    formula = next((a for a in free if not a.endswith(".typ")), None)
    if not (formula and src and tgt):
        sys.exit(__doc__.strip().splitlines()[0]
                 + '\nusage: diagram [--fold-list] [--sigs "R:F(A)⟶A S:F(B)⟶B"]'
                 + ' --src "F([A])" --tgt "[A]" "α prefix list(p)"'
                 + '\n       diagram --roundtrip [--show] [diag/allegory-axioms.typ]'
                 + '\n       diagram --compare [diag/allegory-axioms.typ]'
                 + '\n       diagram --write [diag/allegory-axioms.typ]')
    r = draw(formula, src, tgt, tbl, "" if "--fold-list" in argv else DEFSPLIT, own)
    got, bad = swept(r)
    print(emit(r))
    if bad:
        print(*bad, sep="\n", file=sys.stderr); sys.exit("diagram: the panel fails its own sweep")
    if got != shown(formula, BR):
        print(f"// the sweep reads it back as {got}", file=sys.stderr)


if __name__ == "__main__":
    main(sys.argv[1:])
