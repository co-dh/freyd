#!/usr/bin/env python3
"""diagram — the Hinze–Marsden panel a formula denotes, drawn mechanically.

`scripts/scanline` reads a panel and prints the composite it denotes; this runs that backwards.  A
formula in the note's notation — diagram order, juxtaposition, `°`, `F(R)`, `𝟙`, `×` — plus the
panel's source and target objects (a formula alone does not fix the ports) come in, a `dpanel(...)`
call goes out, ready to paste into the note and be swept unchanged.  The output carries a `cert:`
whose `expect` is the input, so the picture certifies itself the moment `make scan` sees it.

The model is scanline's, read the other way.  A cut is the live wires in `x` order — leftmost the
outermost functor, the object wire last — and a factor is one bead with the wires that run PAST it
as its context.  So: peel each factor into the wires that wrap it and the bead at its core, walk the
factors top to bottom keeping the cut, and give every wire a lane from where it is born to where it
dies.  A wire the formula needs and the cut has not got is OPENED out of the object (`[A]` is
`list` over `A`).

A bead's own signature comes from `diag/hm-sigs.json`, so the cut is a TYPE.  `elaborate` matches
the bead's source scheme against the cut by unification — what matches is its arms, the unmatched
prefix passes — and the target scheme says which wires it makes.  A wire therefore dies at the bead
that CONSUMES it (`α : F([A])⟶[A]` eats the `F` wire, `choose` the `Δ`), and a factor that does not
fit is a type error naming the bead and the cut rather than a mis-drawn wire.  `layout` is the
second half and deliberately not part of the first: lane x's and bead heights are ONE picture out of
the many the book calls equal (pp. 21–22).

`--roundtrip` is the acceptance test: every panel in the note that carries a `cert:` with an
`expect` is regenerated from that `expect` alone and swept again, and the printed composite must
come back the same — cut down to the one branch it draws, where the formula states a choice.
`--compare` rebuilds every `dpanel(` literal the note holds from its own `cert:` and fails on any
drift, and `--write` splices the rebuilt ones over them, the note's own trailing arguments kept.
"""
import difflib, importlib.machinery, importlib.util, json, os, re, subprocess, sys

sys.dont_write_bytecode = True                 # no `scripts/__pycache__` beside the two scripts
_P = os.path.join(os.path.dirname(os.path.abspath(__file__)), "scanline")
_S = importlib.util.spec_from_loader("scanline", importlib.machinery.SourceFileLoader("scanline", _P))
sl = importlib.util.module_from_spec(_S)
_S.loader.exec_module(sl)
norm, spell, tidy, rec, Unhandled = sl.norm, sl.spell, sl.tidy, sl.rec, sl.Unhandled


# Which operand of a `∪`/`[f,g]` gets drawn, as a RULE and not a taste: a branch that throws its
# source away (`⊸`) draws nothing, then the one whose summand still holds the carrier — the branch
# that RECURSES — then the most factors, then the longer spelling breaks the tie.
def rank(e):
    return (0 if '⊸' in spell(e) else 1, '−' in sl.summand(sl.brname(e), TBL),
            len(e[1]) if e[0] == 'comp' else 1, len(spell(e)))


def cut(e, obj, br):
    """A formula down to the ONE branch the panel draws: each `∪`/`[f,g]` down to the operand `rank`
    calls the most complicated, and `F` down to that branch's summand (`scanline.summand`).  This
    model has one bead per factor and no picture for a choice — the honest picture is one branch,
    and the `cert:`'s `branch:` tells the sweep, and the reader, which one it is."""
    if e[0] == 'atom':
        d = sl.dun(e)                      # a choice inside a division: `([wrap,cat]°)%∋` is one
        c = d if d is None else cut(d, obj, br)        # token until the numerator is reparsed
        return e if d is None or c == d else c
    if e[0] == 'app' and e[1] == 'F' and br:
        x = cut(e[2], obj, br)
        return sl.act(sl.summand(br, TBL, norm(x)), x, obj=obj)
    if e[0] in ('union', 'case'):
        p = max([cut(x, obj, br) for x in e[1]], key=rank)
        # The bracket stays a NODE where the display writes one: the bead wears the branch's name
        # and keeps the algebra's signature, which a bare operand would not have.
        return ('case', [p], spell(p)) if e[0] == 'case' else p
    return rec(e, lambda x: cut(x, obj, br))


BR = None                   # the branch `draw` picked, as `scanline.brname` spells it
TBL = None                  # the signatures `draw` types by, the panel's own `sigs:` laid over
MU = {}                     # and the initial algebra each functor folds from, `diag/hm-sigs.json`'s
                            # `mu` with the panel's own `mu:` laid over it the same way
NAT = {}                    # the rows that STATE whether their bead is natural — `"strict"` or
                            # `"lax"` — which `natural` takes ahead of its own reading of the signature


def bead(e):
    """`∩`, `⦇⦈`, `(g→x,y)` and `⟨x,y⟩` are wirings of the CIRCUIT calculus (`scripts/circuit`) — this
    model
    has no picture for any of them, so each folds back to the one bead it was before the parser
    could read it.  Folded BEFORE `cut` runs, so that `branch` — which asks whether `cut` CHANGED
    the tree — does not read a fold as a branch having been picked."""
    if e[0] in ('cap', 'cond', 'cata', 'fork'):
        return ('atom', e[2])
    if e[0] in ('union', 'case'):
        return (e[0], [bead(x) for x in e[1]], e[2])
    return rec(e, bead)


def parse(s, obj=True, sobj=False):
    """The shared parser, every choice in it cut down to the branch being drawn.  `sobj` says the
    string is an OBJECT, where a binary functor's last slot is the wire and the rest is the lane's
    name — `F(A,E B)` is `F(A,−)` over `E B`, which an arrow's `𝟙`-marked slot rule cannot see."""
    return cut(bead(sl.parse(s, sobj)), obj, BR)


def picks(e, out):
    """The branch every choice in the formula is cut to, OUTERMOST first.  A choice inside the
    chosen operand is that same branch again — `[nil,⊸ nil ∪ cons]` is the `cons` branch twice over
    — so only the outermost is named, and a second BRACKET names an arrow of its own."""
    d = sl.dun(e) if e[0] == 'atom' else None
    if d is not None:
        return picks(d, out)
    if e[0] in ('union', 'case'):
        out.append(sl.brname(max([cut(x, False, None) for x in e[1]], key=rank)))
    else:
        rec(e, lambda x: (picks(x, out), x)[1])
    return out


def branch(formula):
    """The branch `cut` picks, spelled as the arrow its component ends in, or None where the formula
    states no choice at all.  Every choice in one formula must cut to the SAME summand — that is
    what makes them one branch of one case split.  The `cert:` declares it and `scanline.read` cuts
    the STATED formula down the same way, so the picture and the sweep agree on what is drawn."""
    e = bead(sl.parse(formula))
    if cut(e, False, None) == e:
        return None
    ks = picks(e, [])
    if len({sl.summand(k, TBL) for k in ks}) != 1:
        raise Unhandled(f"the choices {ks} cut to the summands {[sl.summand(k, TBL) for k in ks]};"
                        f" one panel draws one branch, so they must be the same summand")
    return ks[0]


# The note's own geometry: `hm` columns 1.15 apart from 0.55, the `𝟏` region 2.85 wide.
X0, DX, DY, PAD = 0.55, 1.15, 1.0, 2.85
OKNEE = 0.88                                   # the note's `oknee`: the bow a sloped object edge has


def letters(e):
    """The wire letters an object names.  A product is one letter `×` whatever its components are:
    the wire a product opens is a context (`A×−`, `Δ`), and the letter is what Lean must spell."""
    if e[0] == 'app':
        return {e[1]} | letters(e[2])
    if e[0] == 'prod':
        return {'×'}.union(*(letters(x) for x in e[1]))
    return letters(e[1]) if e[0] == 'conv' else set()


def varsof(e):
    """The signature's free variables — the letters that make it polymorphic.  `letters` gives the
    functors and stops at the bottom atom, which is exactly the one that says `for any object`."""
    if isinstance(e, (list, tuple)):
        if e and e[0] == 'atom':
            return {e[1]} & VARS
        return set().union(set(), *(varsof(x) for x in e if isinstance(x, (list, tuple))))
    return set()


class Undecided(Exception):
    """A polymorphic row that states no `nat:`.  The picture cannot be drawn from it either way."""


def natural(core, sigs):
    """Is this bead a natural transformation, and so barred from the object wire (IntroString p. 36)?
    Only where its row SAYS so, in `nat`, with the Lean proof of it named in `nat-lean`.  No
    signature decides it: `α : F(x)⟶x` is an algebra at ONE carrier and `τ : C(B(x))⟶B(C(x))` a
    natural transformation, and both read polymorphic, so a polymorphic row that states nothing is
    an ERROR rather than a default — drawing it either way is a claim nobody checked.  A row with no
    variable at all needs no statement: it is one arrow between two named objects."""
    if core[0] == 'conv':
        return natural(core[1], sigs)
    lab = core[1] if core[0] == 'app' else spell(core)
    if lab in NAT:                     # `"strict"` or `"lax"`: the dot's fill draws which.  `"no"` is
        return NAT[lab] != "no" and NAT[lab]   # the third answer — a REFUTED row, on the wire with a
                                       # counterexample behind it, not an undecided one
    # An APPLICATION names one object: `est(R) : E(x)⟶x` reads polymorphic, but the `R` it is given
    # is one relation at one object, and naturality would need `E(f) est(R_B) = est(R_A) f` for every
    # `f`, which fails — `f` need not be monotone.  A schematic one-letter name is endo by construction.
    if core[0] == 'app' or len(spell(core).removesuffix('%∋')) == 1:
        return False
    r = row(core, sigs, 0)
    if r is not None and (varsof(r[0]) | varsof(r[1])):
        raise Undecided(f'{lab} : {spell(r[0])}⟶{spell(r[1])} is polymorphic and states no `nat:` — '
                        f'add `nat` and the Lean proof in `nat-lean` to its row, or name the object '
                        f'it is an arrow at')
    return False


# ---------------------------------------------------------------- objects as wire stacks
# The functors drawn as a wire of their own instead of folded into the object wire's label.  `list`
# splits by DEFAULT: one bead name must have one signature across a display, and a `[A]` folded in
# one panel makes `cons` CREATE the `list` its neighbour already carries.  A panel's own `cert:`
# `split:` still overrides — `split: ""` folds it back.
DEFSPLIT = "list"
SPLIT = frozenset(DEFSPLIT.split())


def render(e):
    """The ONE label a cut's object may carry, or None.  `norm` reads `[X]` back as `list(X)`, so a
    list of a renderable object needs no wire of its own; nothing else survives the round trip."""
    if e[0] == 'atom':
        return e[1]
    if e[0] == 'app' and e[1] == 'list' and 'list' not in SPLIT:
        inner = render(e[2])
        if inner is not None and sl.listable(e[2]):
            return f"[{inner}]"
    return None


def peel(e):
    """A normalised object as (wires outermost first, the object the object wire itself carries)."""
    ws = []
    while render(e) is None:
        w, inner = layer(e)
        if w is None:
            raise Unhandled(f"no wire stack for the object {spell(e)}")
        ws.append(w); e = inner
        if len(ws) > 8:
            raise Unhandled(f"the object {spell(e)} nests deeper than a panel can draw")
    return ws, e


# ---------------------------------------------------------------- factors as bead + context
def peel_arrow(e, cut, rel):
    """A factor split into the wires that run PAST the bead and the bead itself.  The cut says which
    wire a `𝟙`-slot context or a doubled arrow stands on: `Δ(R°)` is `R°` under the live `Δ`."""
    ws = []
    while True:
        d, live = len(ws), cut[len(ws)] if len(ws) < len(cut) else None
        if e[0] == 'app' and e[1] in rel:
            sl.require_hole_last(e)
            if len(sl.split_top(spell(e[2]), ',')) > 1:
                # a many-slot bead is opaque: hand it back whole so `signature` names its head
                return ws, e
            ws.append(e[1]); e = e[2]
        elif e[0] == 'prod' and len(e[1]) == 2 and e[1][0] == e[1][1] and live == 'Δ':
            ws.append('Δ'); e = e[1][0]
        elif e[0] == 'prod' and live is not None and '−' in live \
                and len(e[1]) == len(live.split('×')) \
                and sum(x != ('atom', sl.UNIT) for x in e[1]) == 1 \
                and e[1][live.split('×').index('−')] != ('atom', sl.UNIT):
            ws.append(live); e = next(x for x in e[1] if x != ('atom', sl.UNIT))
        else:
            return ws, e


def across(e, rel):
    """`s∘t` split at its one bead: the identity letters LEFT of it are wires it runs under, the
    ones right of it are kept by its own variable tail — left is outermost, as in the cut."""
    if e[0] != 'hc':
        return [], e, []
    k = [i for i, x in enumerate(e[1]) if not (x[0] == 'atom' and x[1] in rel)]
    if len(k) != 1:
        raise Unhandled(f"{spell(e)} composes {len(k)} beads across; one height draws one bead")
    return e[1][:k[0]], e[1][k[0]], e[1][k[0] + 1:]


def expand(e, rel):
    """One written factor as the rows it draws.  A context wire runs past EVERY row of what it
    wraps, which is the `∘` clause on a composite — `F(RS)` and `𝟙×(RS)` are how the display
    spells `F∘(RS)`, and `norm` merged those beads that each need their own height back."""
    if e[0] == 'comp':
        return [y for x in e[1] for y in expand(x, rel)]
    if e == ('atom', sl.UNIT):
        return []                          # bare wires: the identity draws no bead
    if e[0] == 'hc':
        pre, core, post = across(e, rel)
        return [('hc', pre + [x] + post) for x in expand(core, rel)]
    if e[0] == 'app' and e[1] in rel:      # `E(E(RS))`: the context wraps each row however deep
        # The slot travels with each row — `norm` has already dropped the hole-last contexts, so a
        # surviving one is hole-first and must reach `peel_arrow`, which is where it is refused.
        return [('app', e[1], y) + e[3:] for y in expand(e[2], rel)]
    if e[0] == 'case' and len(e[1]) == 1 and e[1][0][0] == 'comp':
        # `[nil,⊸ nil ∪ (p×list(p)) cons]` cut to its branch: the bracket is the LAST factor's node,
        # the algebra's own arrow; the factors before it are beads of their own (user, 2026-09-01).
        xs = e[1][0][1]
        return expand(('comp', xs[:-1]), rel) + [('case', [xs[-1]], spell(xs[-1]))]
    if e[0] == 'prod' and len({spell(x) for x in e[1] if x != ('atom', sl.UNIT)}) > 1:
        # `f×g` is `(f×𝟙)(𝟙×g)`, one height each: `f×−` is natural, so `f` is a bead ON the `A×−`
        # wire and `g` sits under it.  `R×R` stays whole — that is `Δ(R)`, one bead under `Δ`.
        return [y for k, x in enumerate(e[1]) if x != ('atom', sl.UNIT) for y in expand(
            ('prod', [x if j == k else ('atom', sl.UNIT) for j in range(len(e[1]))]), rel)]
    if e[0] == 'prod' and sum(x != ('atom', sl.UNIT) for x in e[1]) == 1:
        k = next(i for i, x in enumerate(e[1]) if x != ('atom', sl.UNIT))
        if e[1][k][0] == 'comp':
            return [y for x in e[1][k][1]
                    for y in expand(('prod', e[1][:k] + [x] + e[1][k + 1:]), rel)]
    return [e]


# ---------------------------------------------------------------- the elaborator
# A signature's variables are single lower-case letters, renamed apart per factor (`x@3`) so two
# beads may both say `x`.  A variable stands for a whole TAIL of the cut: wires, and the object
# under them.  Everything else in a signature is a constant — a wire letter or a named object.
VARS, TOP = sl.VARS, -1
# How far a block of legs may slide off its dot to clear a wire beside it: half steps, out from zero.
SLIDE = [0.0] + [0.5 * DX * (i // 2 + 1) * (-1 if i % 2 else 1) for i in range(12)]


def isvar(e):
    return e[0] == 'atom' and '@' in e[1] and e[1].split('@')[0] in VARS


def fresh(e, n):
    return ('atom', f"{e[1]}@{n}") if e[0] == 'atom' and e[1] in VARS \
        else rec(e, lambda x: fresh(x, n))


def loose(e):
    return isvar(e) or (e[0] in ('comp', 'prod') and any(loose(x) for x in e[1])) \
        or (e[0] == 'app' and loose(e[2])) or (e[0] == 'conv' and loose(e[1]))


def fold(lanes, obj):
    """The object a cut denotes — every wire applied, outermost first, to what the object wire holds."""
    for l in reversed(lanes):
        obj = sl.act(l.label, obj, True)
    return obj


def deref(e, sub):
    while isvar(e) and e[1] in sub:
        e = fold(*sub[e[1]])
    return e


def settle(e, sub):
    return rec(deref(e, sub), lambda x: settle(x, sub))


def unify(a, b, sub, why):
    """Two objects made equal, binding variables on either side."""
    a, b = deref(a, sub), deref(b, sub)
    if isvar(a) or isvar(b):
        sub[a[1] if isvar(a) else b[1]] = ([], b if isvar(a) else a)
    elif a[0] != b[0] or (a[0] in ('atom', 'app') and a[1] != b[1]) \
            or (a[0] in ('comp', 'prod') and len(a[1]) != len(b[1])):
        raise Unhandled(f"{why}: {spell(a)} is not {spell(b)}")
    elif a[0] in ('comp', 'prod'):
        for x, y in zip(a[1], b[1]):
            unify(x, y, sub, why)
    elif a[0] != 'atom':
        unify(a[1 if a[0] == 'conv' else 2], b[1 if a[0] == 'conv' else 2], sub, why)


def layer(e):
    """`peel`'s step read on a scheme: the outermost wire an object names, and what is under it.  A
    product's wire is the factor that needs no wire of its own, LEFT end first — `A×[X]` keeps the
    `A×−` context, and `[X]×A`, whose left factor is a wire stack, opens `−×A` over `[X]` instead of
    staying folded on the object wire.  `norm` flattens nested products, so one end comes off and
    the rest is still a product: `Op×[C]×[C]` is `Op×−` over `[C]×[C]`.  A variable factor is a tail
    still to be unified, not a name a lane can be labelled with, so it is taken only when neither end
    is a constant — that is what lets `𝟙×g`'s `z×Char` meet a `−×Char` lane."""
    if e[0] == 'prod':
        xs = e[1]
        if len(xs) == 2 and xs[0] == xs[1]:
            return 'Δ', xs[0]
        for var in (False, True):
            if render(xs[0]) is not None and isvar(xs[0]) == var:
                return render(xs[0]) + '×−', xs[1] if len(xs) == 2 else ('prod', xs[1:])
            if render(xs[-1]) is not None and isvar(xs[-1]) == var:
                return '−×' + render(xs[-1]), xs[0] if len(xs) == 2 else ('prod', xs[:-1])
        return None, None
    return ((e[3] if len(e) > 3 else e[1]), e[2]) if e[0] == 'app' else (None, None)


def matches(pat, lane, sub):
    """A scheme's wire against a live one: `x×−` takes the `A×−` context and binds `x` to `A`."""
    ps, ws = pat.split('×'), lane.split('×')
    if wire_eq(pat, lane):
        return True
    if len(ps) != len(ws):
        return False
    for p, w in zip(ps, ws):
        if p != w and not (isvar(('atom', p)) and sub.setdefault(p, ([], parse(w)))[1] == parse(w)):
            return False
    return True


def wire_eq(w, lane):
    """The wire a formula names against the lane it runs under.  An arrow spells the functor with
    its other slot at `𝟙` — `F(𝟙,∋)` — so what peels off it is the bare head `F`, where the lane,
    read off an object, says which object that slot holds: `F(A,−)`.  One wire, two spellings.
    `P` and `E` are one wire too — same objects, different arrows — so either may run on the other."""
    return sl.ALIAS.get(w, w) == sl.ALIAS.get(lane, lane) \
        or (w is not None and lane.startswith(w + '(') and lane.endswith('−)'))


def eat(pat, lanes, obj, sub, why):
    """A source scheme against the cut: how many of its wires the bead consumes, the wires it eats
    that the cut carried FOLDED, and what is left on the object wire.  The context the formula names
    is peeled off before this — it never reaches here."""
    k, opened = 0, []
    while True:
        if isvar(pat) and pat[1] not in sub:
            sub[pat[1]] = (lanes[k:], obj)
            return k, opened, obj
        w, inner = layer(deref(pat, sub))
        if k >= len(lanes):
            # past the end of the cut the scheme still names a wire: open it here rather than unify
            # it away, since a wire eaten unopened is drawn nowhere at all.  What stays folded: a
            # wire the scheme only names by a variable, and a port the panel's `split:` folds.
            e = deref(obj, sub)
            if w is None or '@' in w or (not isvar(e) and render(e) is not None):
                unify(pat, obj, sub, why)
                return k, opened, obj
            opened.append((w, obj))
            obj, pat = open_out(obj, w, sub, why), inner
            continue
        if w is None or not matches(w, lanes[k].label, sub):
            raise Unhandled(f"{why} wants {spell(settle(pat, sub))} where the cut has the"
                            f" {lanes[k].label} wire")
        pat, k = inner, k + 1


def grow(pat, sub, why):
    """A target scheme as a cut: the wires it opens, then the tail its variable still carries.  A
    target that renders whole folds into the object wire's label, as `peel` folds `list(A)` to `[A]`."""
    v = pat
    while not isvar(v):
        v = layer(v)[1]
        if v is None:
            break
    keep = sub[v[1]][0] if v is not None and v[1] in sub else []
    ws = []
    while True:
        e = settle(pat, sub)
        if not keep and not loose(e) and render(e) is not None:
            return ws, [], e
        if isvar(pat):
            return ws, keep, sub[pat[1]][1] if pat[1] in sub else pat
        w, inner = layer(pat)
        if w is None:
            return ws, [], e
        ws.append(w); pat = inner


def own_comma(body):
    """A comma of the bracket's own sits at depth 0 of its body: `[zero,⊕]` is a `[,]`, `⦇[zero,⊕]⦈`
    a `⦇⦈`."""
    d = 0
    for c in body:
        d += (c in sl.OPENERS) - (c in sl.CLOSERS)
        if c == ',' and d == 0:
            return True
    return False


def parse_mu(s):
    """`--mu "F:list⁺(x)⟶Para"` — space-separated `functor:object[⟶carrier]` triples, the same flag
    `scripts/circuit` takes.  The object is the functor's INITIAL ALGEBRA, laid over
    diag/hm-sigs.json's `mu`; the optional carrier is what the fold lands on when its algebra is a
    composite and so keys no row that could say (§14.3's `⦇(F(∋)S)%∋ thin Q⦈`, carrier `E(A)`)."""
    out = {}
    for p in s.split():
        f, sep, rest = p.partition(":")
        o, _, c = rest.partition("⟶")
        if not (f and sep and o):
            raise Unhandled(f"--mu: `{p}` is not a `functor:object[⟶carrier]` triple")
        out[f] = (o, c or None)
    return out


def mu(step, n):
    """The initial algebra a fold of `step` runs on and the carrier it lands on, or `(None, None)`.
    Keyed by the FUNCTOR the algebra consumes — `F` is `list` unless the panel says otherwise."""
    f = step[0][1] if step and step[0][0] == 'app' else None
    if f is None:
        # A composite algebra (`(F(∋)S)%∋ thin Q`) keys no row at all, so the panel's own `mu:` is
        # the only declaration there is and there must be exactly one of it.
        ds = [k for k, (_, c) in MU.items() if c]
        if len(ds) > 1:
            raise Unhandled(f"`mu:` declares the carriers {ds}; a fold whose algebra is a composite"
                            f" takes its carrier from exactly one")
        f = ds[0] if ds else None
    o, c = MU.get(f, (None, None))
    return (fresh(norm(parse(o)), f"{n}s") if o else None,
            fresh(norm(parse(c)), n) if c else None)


def row(core, sigs, n):
    """The row a bead's label keys, or None.  A bracket cut to one branch is still the ALGEBRA's
    arrow (`[,]`); a catamorphism runs on the initial algebra of the functor its step consumes —
    `mu`'s row for that functor, the bracket's own source otherwise — and lands on the step's carrier."""
    lab = core[1] if core[0] == 'app' else spell(core)
    if lab in sigs:                        # a row of the label's own beats the bracket's inference
        return sigs[lab]
    k = lab
    if core[0] == 'case':
        k = '[,]'
    # A bracket node is a label the bracket ENCLOSES, not one that merely opens with a bracket:
    # `⦇(F(∋)S)%∋ thin(Q)⦈`'s body and `[nil,cons]within(w) ∪ [nil,π₂]` both start with an opener
    # whose closer is in the middle, and stripping the ends there cuts the label in half.
    elif k and k[0] in sl.OPENERS and k[-1] == sl.CLOSERS[sl.OPENERS.index(k[0])] \
            and sl.matching(k, 0) == len(k) - 1:
        body = k[1:-1]
        k = k[0] + (',' if own_comma(body) else '') + sl.CLOSERS[sl.OPENERS.index(k[0])]
        r, step = sigs.get(lab) or sigs.get(k), row(bead(sl.parse(body)), sigs, n)
        o, c = mu(step, n)                     # `[,]`'s `x` is the carrier, so the initial algebra's
        s = o or (r and r[0])                  # element is a letter of its own; a functor with no
        t = c or (step and step[1])            # `mu` row keeps the bracket's own source (`tree(x)`)
        return (s, t) if s and t else r
    return sigs.get(lab) or sigs.get(k)


def signature(core, sigs, n):
    """What a bead's label is an arrow between.  `R°` is `R` read backwards, `R%∋` is `R` with the
    division's own `E` wire on its target, and a SCHEMATIC label touches the object wire alone."""
    if core[0] == 'conv':
        s, t = signature(core[1], sigs, n)
        return t, s
    lab = core[1] if core[0] == 'app' else spell(core)
    # A many-slot application names its own head: `F(∋,∋)` is live in two slots, and a wire passes
    # ONE argument, so no lane and no bead can stand for it — a `sigs` row for `F` does not either.
    if core[0] == 'app' and len(sl.split_top(spell(core[2]), ',')) > 1:
        raise Unhandled(f"{lab} is live in more than one slot of {spell(core)}; a wire passes"
                        f' one argument, so write {lab}(𝟙,−) with a single non-𝟙 slot')
    sl.require_hole_last(core)
    r = row(core, sigs, n)
    if r is None:
        # A bare one-letter name is the note's abstract relation — `R`, `p`, the `𝟙` of `𝟙%∋` — and a
        # letter can only be endo on the object wire, so the schematic reading IS its signature.  Any
        # other name is a real arrow: guessing `x⟶x` for it draws an identity bead spanning every
        # live wire, which is a picture of a different arrow and no error says so.
        if core[0] != 'atom' or len(lab.removesuffix('%∋')) != 1:
            raise Unhandled(f"the bead {lab} has no signature in diag/hm-sigs.json and is not a"
                            f' schematic letter; pass --sigs "{lab}:SRC⟶TGT"')
        r = (('atom', 'x'), ('atom', 'x'))
    s, t = r
    return fresh(s, n), fresh(('app', 'E', t) if lab.endswith('%∋') else t, n)


def open_out(obj, w, sub, why):
    """The wire `w` lifted off the object — `[A]` is `list` over `A`, and an object still unknown
    becomes whatever the factor asks it to be."""
    e = deref(obj, sub)
    if isvar(e):
        inner = ('atom', f"{e[1]}^{w}")
        sub[e[1]] = ([], sl.act(w, inner, True))
        return inner
    a, inner = layer(e)
    if not wire_eq(w, a):
        raise Unhandled(f"{why} runs under {w}, which does not lift off {spell(e)}")
    return inner


class Lane:
    """One wire, from the factor that makes it to the factor that eats it."""
    def __init__(self, label, born=None):
        self.label, self.born, self.dies = label, born, None
        self.x = None


class Row:
    def __init__(self, label, arms, legs, reach, obj, nat=False):
        self.label, self.arms, self.legs, self.reach = label, arms, legs, reach
        self.nat = nat                     # a natural transformation: its dot may not touch the wire
        self.obj = obj                     # what the object wire carries BELOW this row


def alphabet(table, *objs):
    """The wire letters, as data: what the signatures and the panel's own ports name between them.
    A name is a wire because a signature uses it as one — there is no list of relators to keep,
    beyond the aliases, whose whole point is that no signature spells them (`P A = E A`)."""
    ws = set(sl.ALIAS) | {l for v in table["sigs"].values()
                          for e in (v["src"], v["tgt"]) for l in letters(norm(parse(e)))}
    return {w for w in ws.union(*(peel(o)[0] for o in objs)) if '−' not in w and w != '×'}


def born_at(rows, tail, sub, dflt):
    """Which bead a wire comes off.  A wire IS the object-tail hanging below it, so it is born at the
    first row whose object already carries that tail — `⦇S⦈`'s target is the free `y`, so which row
    that is is known only once `sub` is solved.  Identifying the wire by its tail and not by its
    depth is what lets a wire keep its lane across a bead that eats the wire OUTSIDE it."""
    def carries(e):
        while e != tail:
            if render(e) is not None:
                return False
            w, e = layer(e)
            if w is None:
                return False
        return True
    return next((i for i, r in enumerate(rows) if carries(settle(r.obj, sub))), dflt)


def elaborate(formula, src, tgt, table):
    """The typed reading of a formula: one row per bead, carrying the wires its signature eats and
    the wires it makes.  A wire dies where it is CONSUMED — what a formula alone cannot say."""
    sigs = {k: (norm(parse(v["src"])), norm(parse(v["tgt"]))) for k, v in table["sigs"].items()}
    stack, obj = peel(norm(parse(src, sobj=True)))
    want = norm(parse(tgt, sobj=True))
    rel = alphabet(table, norm(parse(src, sobj=True)), want)
    made = [Lane(w, born=TOP) for w in stack]
    lanes, sub, rows, atop, pending = list(made), {}, [], obj, []
    for i, e in enumerate(expand(norm(parse(formula, False)), rel)):
        pre, e, _ = across(e, rel)         # `∘`'s left letters are context; its right ones the tail keeps
        wrap, core = peel_arrow(e, [l.label for l in lanes[len(pre):]], rel)
        wrap = [x[1] for x in pre] + wrap
        why = f"factor {i + 1} ({spell(tidy(core))})"
        for k, w in enumerate(wrap):
            if k < len(lanes) and not wire_eq(w, lanes[k].label):
                raise Unhandled(f"{why} runs under {w} where the cut has {lanes[k].label}")
            # An aliased wire is named by the FORMULA where the port is all the cut has to go on:
            # `E(E A)` says nothing about which relator its outer wire is, and `P(est(R))` does.  A
            # lane a bead made keeps its maker's letter — `(T°)%∋` builds an existential image, and
            # the `P` a display writes over it is that panel's own law, not a different wire.
            if k < len(lanes) and lanes[k].born == TOP and w != lanes[k].label \
                    and sl.ALIAS.get(w, w) == sl.ALIAS.get(lanes[k].label, lanes[k].label):
                lanes[k].label = w
            if k >= len(lanes):                # a wire the formula names and the cut has not got is
                obj = open_out(obj, w, sub, why)   # opened out of the object, at the bead above —
                made.append(Lane(w, born=i - 1 if rows else TOP))   # or at the top edge if there is
                lanes.append(made[-1])             # none, where the source itself opens further
                if rows:
                    rows[-1].legs.append(made[-1])
                else:
                    atop = obj
        reach = lanes[len(wrap)] if len(wrap) < len(lanes) else None
        if core[0] == 'prod' and reach is not None and '−' in reach.label \
                and len(core[1]) == len(reach.label.split('×')) \
                and sum(x != ('atom', sl.UNIT) for x in core[1]) == 1:
            # `p×𝟙 : A×X⟶A×X` is an arrow of the object the `A×−` wire is applied to, so it is a
            # bead on the object wire that eats the lane and makes it again, as `thin : E(x)⟶E(x)`
            # eats `E` and makes `E`.  A bead ON the lane would be a natural transformation, which
            # the note never draws (user, 2026-09-01).
            k = next(j for j, x in enumerate(core[1]) if x != ('atom', sl.UNIT))
            s, t = signature(core[1][k], sigs, i)
            unify(s, norm(parse(reach.label.split('×')[k])), sub, why)
            if render(settle(t, sub)) is None:
                raise Unhandled(f"{why} lands the {reach.label} wire on"
                                f" {spell(settle(t, sub))}×−, which is no wire label")
            s, t = (('prod', [settle(v, sub) if j == k else ('atom', f"z@{i}−")
                              for j in range(len(core[1]))]) for v in (s, t))
        else:
            s, t = signature(core, sigs, i)
        k, opened, obj = eat(s, lanes[len(wrap):], obj, sub, why)
        arms = lanes[len(wrap):len(wrap) + k]
        for w, e in opened:                # a wire opened HERE was born further up, where the object
            made.append(Lane(w))           # first carried it; it is drawn down to the bead eating it
            pending.append((made[-1], e, i)); arms.append(made[-1])
        if reach is None and opened:       # a bead with no lane of its own still reaches the wires
            reach = arms[k]                # it opened — a bead is a point, and every reach is an arm
        ws, keep, obj = grow(t, sub, why)
        # A wire the source only bound to a tail VARIABLE, which the target then does not carry, is
        # eaten here too: `⦇−⦈ : L(xs)⟶E(L(A))` swallows the `E` inside its `L`.  Left out of `arms`
        # it would be dropped from the cut with no closing row at all, and nothing draws its end.
        arms = arms + [l for l in lanes[len(wrap) + k:] if l not in keep]
        legs = [Lane(w, born=i) for w in ws]
        for l in arms:
            l.dies = i
        # `made` is COLUMN order, not birth order: `η∘M` opens its wire left of the one it keeps.
        # Legs sit LEFT of the arms they replace, so the object wire's column is the rightmost.
        at = made.index(arms[0]) if arms else made.index(keep[0]) if keep else len(made)
        made[at:at] = legs
        lanes = lanes[:len(wrap)] + legs + keep
        rows.append(Row(spell(tidy(core)), arms, legs, reach, obj, natural(core, sigs)))
    k, opened, obj = eat(want, lanes, obj, sub, f"the target {tgt}")
    if k != len(lanes):
        raise Unhandled(f"the target {tgt} leaves the {lanes[k].label} wire live")
    for w, e in opened:
        made.append(Lane(w)); pending.append((made[-1], e, len(rows))); lanes.append(made[-1])
    for l in lanes:
        l.dies = len(rows)
    # The bottom edge is a wire stack too, not one label: a target the beads only pin by unification
    # reaches here still wrapped, so peel it and give each wire the bead it comes off.
    ws, ob = peel(settle(obj, sub))
    for k, w in enumerate(ws):
        tail = ob
        for x in reversed(ws[k:]):
            tail = sl.act(x, tail, True)
        made.append(Lane(w, born=born_at(rows, tail, sub, len(rows) - 1)))
        made[-1].dies = len(rows)
    for l, e, i in pending:
        l.born = born_at(rows[:i], settle(e, sub), sub, TOP)
    obot, otop = render(ob), render(settle(atop, sub))
    if otop is None:
        raise Unhandled(f"the object wire carries {spell(settle(atop, sub))}, which has no label")
    for r in rows:                         # the seam labels: what a formula alone cannot say either
        r.obj = render(settle(r.obj, sub))
    return rows, made, otop, obot


# ---------------------------------------------------------------- the panel a term denotes
def isunit(r):
    """`layout`'s own test, stated once: `𝟙%∋` heads the lane it opens, where `S° : B⟶F(B)` is a
    relation with a bead of its own even though it too eats nothing."""
    return not r.arms and r.legs and r.label == f"{sl.UNIT}%∋"


def columns(rows, made):
    """A column per lane.  `made` is already column order; this says how far apart the columns sit.
    The top-born lanes take the grid, and a bead's legs are a contiguous `DX` block CENTRED on the
    arms it replaces — which is what makes a merge's two arms symmetric and drops its survivor
    vertically from between them (IntroString p. 74) — so a 1-in-1-out bead keeps its own column and
    a 2-in-1-out drops to a half step.  Columns come out relative and are slid right at the end."""
    for l in made:
        l.x = None
    for k, l in enumerate(l for l in made if l.born == TOP):
        l.x = k * DX
    for i, r in enumerate(rows):
        if not r.legs or isunit(r):    # a unit row is placed in the pass below
            continue
        live = [l for l in made if l.x is not None and l.born < i < l.dies]
        # Not every arm is placed yet — one opened at the bead that eats it has no column until the
        # pass below — and a row whose arms are all still pending falls back to the unit's rule.
        xs = [a.x for a in r.arms if a.x is not None]
        # A bead with no arms of its own opens its wire AT the object wire, so that wire is born
        # east of every lane already live — born west, it would cross each of them on the way out.
        # The one that goes west instead is `𝟙%∋`, a 2-cell between functors, placed in the pass
        # below because it touches no object wire at all.
        c = ((min(xs) + max(xs)) / 2 if xs
             else max((l.x for l in live), default=X0 - DX) + DX)
        # A bead that gives back as many wires as it takes moves nothing sideways, so its legs KEEP
        # the arms' own columns: a swap becomes two straight lines crossing, and a wire that meets
        # several of them runs down ONE line instead of a staircase of knees — IntroString p.48 draws
        # exactly that run as a single straight diagonal.  Only a merge or a split needs new columns.
        if xs and len(r.legs) == len(r.arms) == len(xs):
            for g, x in zip(r.legs, sorted(xs)):
                g.x = x
            continue
        # The DOT stays at the arms' centre; the block of legs slides off it by half steps until it
        # fits BETWEEN the arms' own neighbours — the legs replace the arms in the cut, so a lane
        # west of the arms must stay west of the legs and one east must stay east, or the ink claims
        # an exchange the formula does not (`inversions`).  Clearing columns alone is not enough.
        oth = [o for o in live if o not in r.arms]
        lo = max([o.x for o in oth if o.x < min(xs, default=c)], default=-1e9)
        hi = min([o.x for o in oth if o.x > max(xs, default=c)], default=1e9)
        for d in SLIDE:
            got = [c + d + (j - (len(r.legs) - 1) / 2) * DX for j in range(len(r.legs))]
            if lo + 1e-6 < got[0] and got[-1] < hi - 1e-6:
                break
        for g, x in zip(r.legs, got):
            g.x = x
    # A unit opens a wire out of nothing, and that wire goes LEFT of every lane it is live beside —
    # otherwise it falls inside some bead's reach, and a reach is drawn by BENDING each spanned wire
    # onto the dot, which a unit lane (born at its own column, no bead) has no shape for.  Shortest
    # span first, so a unit outliving another ends up further left and the two never trade columns.
    for r in sorted((r for r in rows if isunit(r)),
                    key=lambda r: max(g.dies for g in r.legs) - min(g.born for g in r.legs)):
        b0, d0 = min(g.born for g in r.legs), max(g.dies for g in r.legs)
        ov = [o.x for o in made if o.x is not None and o.born < d0 and b0 < o.dies]
        base = min(ov, default=DX) - DX
        for j, g in enumerate(r.legs):
            g.x = base - (len(r.legs) - 1 - j) * DX
    # A lane OPENED at the bead that eats it is born above and has no row of legs to space it; it
    # takes the free column beside the neighbour `made` already puts it next to.
    for i, l in enumerate(made):
        if l.x is None:
            nxt = next((q.x for q in made[i + 1:] if q.x is not None), None)
            prv = next((q.x for q in reversed(made[:i]) if q.x is not None), None)
            l.x = nxt - DX if nxt is not None else (prv + DX if prv is not None else 0.0)
    # A lane's own NAME is written west of it, and `scanline` reads a strand through that box as a
    # collision.  One `DX` holds two characters; a wider name needs the gap widened, so every lane
    # west of it moves west by the deficit — the relative order, and the dots computed from it, are
    # untouched.  The name may not be drawn on this very lane (`dnamed` picks one of a chain), so the
    # room is reserved on all of them, which is the same rule stated without the chain.
    for _ in range(len(made)):
        for l in made:
            if not l.label or len(l.label) < 2:
                continue
            w = sl.LDX + sl.LCW * len(l.label)
            west = [o for o in made if o.x < l.x - 1e-6 and o.born < l.dies and l.born < o.dies]
            if not west or l.x - max(o.x for o in west) >= w - 1e-6:
                continue
            d = w - (l.x - max(o.x for o in west))
            for o in made:
                if o.x < l.x - 1e-6:
                    o.x -= d
            break
        else:
            break
    off = X0 - min(l.x for l in made) if made else 0.0
    for l in made:
        l.x = round(l.x + off, 3)
    live = {}
    for l in made:
        for o in live.get(l.x, ()):
            if o.born < l.dies and l.born < o.dies:
                raise Unhandled(f"the {l.label} and {o.label} wires are both live at x={l.x:g}")
        live.setdefault(l.x, []).append(l)


def layout(rows, made, otop, obot, cert):
    """ONE panel of the many the book calls equal (pp. 21–22): a lane per wire in birth order, a
    height per factor.  Nothing here is functorial — gluing two terms renumbers every lane."""
    n = len(rows)
    ys = [(n - i) * DY for i in range(n)]
    columns(rows, made)
    xo = round(max(l.x for l in made) + DX, 2) if made else X0
    beads, unit = [], {}
    for i, r in enumerate(rows):
        # `𝟙%∋` is the unit `Id⟹E`, a 2-cell between FUNCTORS with no object wire to sit on, so
        # `dpanel` heads the lane it opens with it; `S° : B⟶F(B)` is a relation and stays a bead.
        if isunit(r):
            if len(r.legs) != 1:
                raise Unhandled(f"the unit {r.label} opens {len(r.legs)} wires; a lane heads one")
            unit[r.legs[0]] = r.label
            ys[i] -= DY / 2                # half a step, so the knees above sweep clear of it
            continue
        # how far left the bead reaches: every lane from there to the dot bends onto it, arms and
        # crossed wires alike, because a bead is a POINT and there is no such thing as a straight bar
        reach = r.reach.x if r.reach is not None else None
        # Where the DOT sits.  A bead that leaves the object wire's label alone names no object, so
        # it is a transformation between FUNCTORS and may not sit on that wire (IntroString p. 36);
        # it goes at the centre of the arms it eats, which is what makes a merge's two arms
        # symmetric and drops its survivor vertically from their midpoint (p. 74).
        xs = [l.x for l in (r.arms or r.legs)]
        dot = round((min(xs) + max(xs)) / 2, 4) if xs and r.nat else None
        beads.append([ys[i], r.label, "#000000", reach, dot] + (["lax"] if r.nat == "lax" else [])
                     if dot is not None
                     else [ys[i], r.label] if reach is None else [ys[i], r.label, "#000000", reach])
    hh = (n + 1) * DY

    def xat(y, dying=True):
        """The sloped object wire's x at a height: one gap right of every lane alive there or NOT
        YET BORN — a column is held from the top, else the wire's own `xo` could be a lane's column
        and the sweep would read one for the other — and AT the innermost arm dying at that height:
        the wire absorbs it at its own column.  With `dying` off the arms dying there are already
        gone: where the wire would sit just below the bead."""
        c = [X0]
        for l in made:
            yd = 0.0 if l.dies == n else ys[l.dies]
            if yd > y + 1e-9:
                continue                       # already dead
            if l.dies != n and abs(yd - y) <= 1e-9:
                if dying:
                    c.append(l.x)
            else:
                c.append(l.x + DX)
        return round(max(c), 2)

    # The object edge SLOPES exactly when an arrow of the base category travels along it, and then it
    # is one straight line at 2 across : 1 down — IntroString p. 74 draws every such figure that way
    # (`L 56.694 -28.346`, measured), and p. 73 keeps the edge vertical in the figures where no arrow
    # rides it.  It leans wherever a bead has no dot of its own, and `--slope left` is the caller
    # asking for the lean where no bead does; the clearance is `xat`'s, height by height.
    op = None
    if cert.get("slope") == "left" or any(len(b) < 5 or b[4] is None for b in beads):
        # The lean runs the WHOLE height, not down to the topmost bead and vertical from there:
        # a bead riding the edge must sit on a SLOPING wire, which is what makes the lane arriving
        # at it read as standing on the edge (IntroString p. 79's bed).  A bead on the vertical run
        # below has the edge passing it end-on instead.
        # The book's gradient is 2 across : 1 down, which a composite five rows tall cannot hold —
        # ten columns of run would be wider than the page.  Take the steepest line that fits: the
        # run is the lanes' own span, so the edge crosses the whole picture and is never a stair.
        xl = min([l.x for l in made], default=X0)
        xb = round(max([l.x for l in made], default=X0 - DX) + DX, 2)
        ry = ys + [0.0, hh]            # liveness changes only at a row, so those heights decide it

        def fits(x):
            # the note bows the edge and the sweep reads its chord; the bow is left of the chord
            # below the midpoint and right of it above, so the clearance must hold for both
            xt = round(x + min(2 * hh, max(DX, x - xl)), 2)
            return all(min(sl.obez([xt, hh], [x, 0.0], OKNEE, y), x + (xt - x) * y / hh)
                       >= xat(y) - 1e-9 for y in ry)
        # `run` is measured FROM `xb`, so a step left buys clearance the step itself changes: no
        # closed form, step and re-test, keeping the last bottom whose bow clears every row.
        while round(xb - 0.05, 2) >= xl and fits(round(xb - 0.05, 2)):
            xb = round(xb - 0.05, 2)
        run = min(2 * hh, max(DX, xb - xl))
        op, xo = [[round(xb + run, 2), hh], [xb, 0.0]], round(xb + run, 2)
    rec = {"kind": "scanline", "id": "gen.1", "helper": "dpanel", "h": (n + 1) * DY,
            "w": (max(q[0] for q in op) if op else xo) + PAD,
            "xo": xo,
            "lanes": [[l.x, "top" if l.born == TOP else ys[l.born],
                       "bot" if l.dies == n else ys[l.dies],
                       None if l.born == TOP or l.dies == n else l.label,
                       unit.get(l)] for l in made],
            "beads": beads,
            # the object wire's type at every seam.  `dpanel` takes no such argument, so `emit`
            # drops it: a panel pasted into the note is read back by the sweep's own guess.
            "obj": [[ys[i], r.obj] for i, r in enumerate(rows) if r.obj is not None],
            "top": [[l.x, l.label] for l in made if l.born == TOP] + [[xo, otop]],
            "bot": [[l.x, l.label] for l in made if l.dies == n] + [[xo, obot]],
            "cert": cert}
    if op:
        rec["opath"] = op
    return rec


# ---------------------------------------------------------------- the book's own construction
ROW = 0.625      # one book ROW: IntroString p.74's 0.5cm, in cetz's own `length: 0.8cm` canvas unit


def booklayout(rows, made, otop, obot, cert, wr, hr, obreak):
    """IntroString p.74's own construction, in ROW UNITS (1 row = 0.5cm, one lane pitch = 2 rows).
    The lanes alive at the TOP stand in columns `0, 2, 4, …` in cut order, leftmost the outermost
    functor, and the object edge holds the column one lane pitch right of the last of them, running
    VERTICALLY while nothing rides it (IntroString p.79's (3.8b): the object wire keeps its own
    column above the first bead on it).  It is then a STRAIGHT polyline descending to the RIGHT at
    2 across : 1 down, advancing one lane pitch per bead that RETYPES it, over that bead's own row,
    the riding bead at the middle of its own advance; it leaves through the RIGHT side if that
    advance carries it to the boundary and through the bottom otherwise.  A lane born on a bead
    drops vertically in that bead's own column, so — the edge moving right as it descends — no lane
    ever crosses it.  `wr` x `hr` is p.74's own typesetting where a fixture states it, else the one
    derivation `2·(top lanes) + 2·(riding beads) + 2` wide by `beads + 1` high; `obreak`, whether
    the edge is broken at the dots riding it, is the book's too (p.74 breaks it in the one-bead `f`
    figure and runs it through the dots in the two figures beside it)."""
    n = len(rows)
    tops = [l for l in made if l.born == TOP]
    # A bead RIDES the edge exactly when it retypes the object wire: `f : A⟶M(B)` carries A to B and
    # the edge steps right under it, where `μ : M(M(x))⟶M(x)` leaves the object alone and hangs clear.
    carried = [otop]
    for r in rows:
        carried.append(r.obj if r.obj is not None else carried[-1])
    ride = [carried[i] != carried[i + 1] for i in range(n)]
    free = [i for i in range(n) if not ride[i]]
    hr = n + 1 if hr is None else hr
    wr = 2 * len(tops) + 2 * (n - len(free)) + 2 if wr is None else wr
    x0 = 2 * len(tops)                         # the edge's column, one lane pitch right of the last
    for j, l in enumerate(tops):               # top lane; those stand one pitch apart in cut order
        l.x = 2 * j * ROW
    bx, by, k = {}, {}, 0
    for i, r in enumerate(rows):
        if ride[i]:
            bx[i], by[i] = (x0 + 2 * k + 1) * ROW, (hr - k - 0.5) * ROW
            k += 1
        else:
            # Off the edge the beads stack up from the BOTTOM, one row apart, so the lowest keeps a
            # row for its lane to drop in.  Across, such a bead sits at the centre of the columns it
            # eats — and one that eats nothing, a unit, on the panel's own midline, which is where
            # p.74 puts `η` between the left boundary and the point the edge leaves at.
            xs = [a.x if a.born == TOP else bx[a.born] for a in r.arms]
            by[i] = (len(free) - free.index(i)) * ROW
            bx[i] = (min(xs) + max(xs)) / 2 if xs else wr / 2 * ROW
    for l in made:
        if l.born != TOP:
            l.x = bx[l.born]
    # With no top lane the edge starts at the panel's left boundary and has no column of its own to
    # hold, which is p.74's case: there it sweeps the whole width the book set, at 2 across : 1 down
    # until it runs out of height.  With top lanes it holds `x0` and advances only for what rides it.
    xe = min(2 * (n - len(free)), wr - x0) if tops else min(wr - x0, 2 * hr)
    ye, xo, xb = hr - xe / 2, round(x0 * ROW, 4), round((x0 + xe) * ROW, 4)
    side = x0 + xe >= wr                       # the edge leaves through the RIGHT side only if its
    op = [[xo, round(hr * ROW, 4)]]                          # advance reached the panel's boundary
    if xe:
        op.append([xb, round(ye * ROW, 4)])
    if not side:
        op.append([xb, 0.0])
    rec = {"kind": "scanline", "id": "gen.1", "helper": "dpanel",
           "h": round(hr * ROW, 4), "w": round(wr * ROW, 4), "xo": xo,
           "lanes": [[l.x, "top" if l.born == TOP else by[l.born],
                      "bot" if l.dies == n else by[l.dies],
                      None if l.born == TOP or l.dies == n else l.label, None] for l in made],
           "beads": [[by[i], r.label, "#000000",
                      r.reach.x if r.reach is not None else None, bx[i]]
                     for i, r in enumerate(rows)],
           "obj": [[by[i], r.obj] for i, r in enumerate(rows) if r.obj is not None],
           # `dpanel` reads an object port by its x being `xo` and then DRAWS it where the edge is,
           # so both object ports carry `xo` however far the advance has moved the edge's foot.
           "top": [[l.x, l.label] for l in tops] + [[xo, otop]],
           "bot": [[l.x, l.label] for l in made if l.dies == n] + ([] if side else [[xo, obot]]),
           "opath": op,
           "ostraight": True,
           "cert": cert}
    if side:
        rec["right"] = [[round(ye * ROW, 4), obot]]
    if obreak:
        rec["obreak"] = [by[i] for i in range(n) if ride[i]]
    return rec


def draw(formula, src, tgt, table=None, split=DEFSPLIT, own=None, slope=None, ini=None, book=None):
    """The panel a formula denotes, typed: `elaborate` says what the picture IS, `layout` chooses
    one of the pictures the book calls equal.  `split` and `own` ride in the `cert:` beside `src`
    and `tgt`, for the same reason they do — a formula alone does not say which picture of it the
    note wants.  Only a panel that DIFFERS from `DEFSPLIT` states it, so the default costs the note
    no field; `sigs:` likewise appears only where the panel types a letter itself, and `slope:`
    only where the object wire is not the straight default (see `layout`)."""
    global SPLIT, BR, TBL, MU, NAT
    SPLIT = frozenset(split.split())
    TBL = sl.typed(table or sl.sigs(), own)
    NAT = {k: v["nat"] for k, v in TBL["sigs"].items()
           if isinstance(v, dict) and "nat" in v}
    MU = {f: (o, None) for f, o in TBL.get("mu", {}).items()} | (parse_mu(ini) if ini else {})
    BR = branch(formula)
    cert = {"expect": formula, "src": src, "tgt": tgt} | ({"branch": BR} if BR else {})
    rows, made, otop, obot = elaborate(formula, src, tgt, TBL)
    cert = (cert | ({"split": split} if split != DEFSPLIT else {})
            | ({"mu": ini} if ini else {}) | ({"sigs": own} if own else {})
            | ({"slope": slope} if slope else {}))
    if book:
        return booklayout(rows, made, otop, obot, cert, *book)
    return layout(rows, made, otop, obot, cert)


# ---------------------------------------------------------------- the typst call
def num(v):
    return f"{v:g}"


def labelcode(v):
    """The one spelling of a bead or lane label: `X%∋` is the note's own fraction, `frc([X])`;
    everything else is today's inline code."""
    if v.endswith("%∋"):
        return f"frc([`{v[:-2]}`])"
    return f"[`{v}`]"


def cell(v):
    return "none" if v is None else f'"{v}"' if isinstance(v, str) and v in ("top", "bot") \
        else labelcode(v) if isinstance(v, str) else num(v)


def tup(xs):
    return "(" + ", ".join(cell(x) for x in xs) + ("," if len(xs) == 1 else "") + ")"


def lst(xs):
    return "(" + ", ".join(tup(x) for x in xs) + ("," if len(xs) == 1 else "") + ")"


def quoted(v):
    """A `cert:` string as Typst source, where `\\` is an escape and so must be doubled."""
    return '"' + v.replace("\\", "\\\\") + '"'


def emit(r):
    c = r["cert"]
    beads = [b[:2] + [None, b[3]] + b[4:] if len(b) > 3 else b for b in r["beads"]]
    return (f'#dpanel({num(r["h"])}, {num(r["w"])}, {num(r["xo"])},\n'
            f'  {lst(r["lanes"])},\n'
            + "  (" + ", ".join("(" + num(b[0]) + ", " + labelcode(b[1])
                                + (", black, " + (num(b[3]) if b[3] is not None else "none")
                                   if len(b) > 3 else "")
                                + (", " + num(b[4]) if len(b) > 4 and b[4] is not None else "")
                                + (f', "{b[5]}"' if len(b) > 5 else "") + ")"
                                for b in beads) + ("," if len(beads) == 1 else "") + "),\n"
            + f'  {lst(r["top"])},\n  {lst(r["bot"])},\n'
            + (f'  opath: {lst(r["opath"])},\n' if r.get("opath") else "")
            + (f'  right: {lst(r["right"])},\n' if r.get("right") else "")
            + (f'  obreak: {tup(r["obreak"])},\n' if r.get("obreak") else "")
            + ("  ostraight: true,\n" if r.get("ostraight") else "")
            + "  cert: (" + ", ".join(f'{k}: ' + (quoted(v) if isinstance(v, str) else
                "(" + ", ".join(f'{quoted(a)}: {quoted(b)}' for a, b in v.items()) + ")")
                                     for k, v in c.items()) + "))")


# ---------------------------------------------------------------- the round trip
def shown(formula, br):
    """What a panel must sweep back as.  A panel drawing ONE branch of a `∪` denotes that branch,
    not the whole formula, so the formula is cut down to it — the reading the sweep certifies by."""
    return spell(tidy(parse(formula, False))) if br else formula


def swept(r):
    """The composite the generated panel denotes, read by the same sweep `make scan` runs."""
    p = sl.Panel(r)
    bad = sl.sweep(p)
    b, _ = sl.certify(p)
    return spell(tidy(p.expr)), bad + b


def endpoints(p):
    """The panel's stated ports, or — where the `cert:` names none — the ones it draws."""
    c = p.cert
    return (c.get("src") or spell(sl.fold_cut(p, sl.ports(p, True))),
            c.get("tgt") or spell(sl.fold_cut(p, sl.ports(p, False))))


def roundtrip(path, frm, show, out, tbl):
    recs = sl.panels(path, frm)
    ok, printer, law, fail, gen = 0, 0, 0, [], []
    for r in recs:
        if not (r.get("cert") or {}).get("expect"):
            continue
        want = r["cert"]["expect"]
        try:
            src, tgt = endpoints(sl.Panel(r))
            g = draw(want, src, tgt, tbl, r["cert"].get("split", DEFSPLIT), r["cert"].get("sigs"),
                     r["cert"].get("slope"), r["cert"].get("mu"))
            g["id"] = r["id"]
            got, bad = swept(g)
            gen.append(g)
        except (Unhandled, ValueError, KeyError, StopIteration) as ex:
            fail.append(f"{r['id']}: {type(ex).__name__}: {ex}"); continue
        drawn = shown(want, g["cert"].get("branch"))
        if bad:
            fail.append(f"{r['id']}: the generated panel fails its own sweep — {bad[0]}")
        elif got == drawn:
            ok += 1
        elif got == spell(tidy(parse(want))):
            printer += 1                       # differs only where `spell` spaces a bracket
        elif sl.quot(sl.parse(got)) == sl.quot(sl.read(want, g["cert"], False)[0]):
            law += 1                           # `F(R)F(S)=F(RS)`, `f×g=(f×𝟙)(𝟙×g)`: heights the
        # display writes as one — the sweep's own reading, which also cuts `[,]` to the branch drawn
        else:
            fail.append(f"{r['id']}: {drawn}  ->  {got}")
        if show:
            print(f"// {r['id']}  {want}"); print(emit(g)); print()
    print(f"diagram: {ok + printer + law + len(fail)} certified panels, {ok} verbatim,"
          f" {printer} modulo the printer's spacing, {law} modulo a relator law,"
          f" {len(fail)} failed")
    if out:
        json.dump(gen, open(out, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
    if fail:
        print(*fail, sep="\n", file=sys.stderr)
        sys.exit(f"diagram: {len(fail)} panel{'s' * (len(fail) > 1)} did not come back")


# ---------------------------------------------------------------- the note's own literals
def close(text, i):
    """The index of the `)` matching the `(` at `i`.  A `"…"` is opaque and ends at the next `"` —
    `quoted` never escapes one — because an `expect` carries brackets of its own."""
    j, depth = i, 0
    while True:
        c = text[j]
        if c == '"':
            j = text.index('"', j + 1)
        elif c in "([{":
            depth += 1
        elif c in ")]}":
            depth -= 1
            if not depth:
                return j
        j += 1


def certof(s):
    """A literal's `cert:` group as `draw` takes it: the string fields, and `sigs` as a dict."""
    c = {k: v.replace("\\\\", "\\") for k, v in re.findall(r'(\w+): "([^"]*)"', s)}
    k = s.find("sigs: (")
    if k >= 0:
        c["sigs"] = dict(re.findall(r'"([^"]*)": "([^"]*)"', s[k:close(s, k + 6) + 1]))
    return c


def literals(text):
    """Every `dpanel(…)` in a file that carries a drawable `cert:`, as (start, cert end, end, cert):
    the text after the `cert:` group — `names:`, `s:` — is the note's own and rides along unchanged."""
    out, i = [], text.find("dpanel(")
    while i >= 0:
        j = close(text, i + 6)
        k = text.rfind("cert: (", i, j)
        c = certof(text[k:j]) if k >= 0 else {}
        if all(c.get(x) for x in ("expect", "src", "tgt")):
            out.append((i, close(text, k + 6) + 1, j + 1, c))
        i = text.find("dpanel(", j)
    return out


def regen(path, tbl, write):
    """Each literal rebuilt from its own `cert:` and held against the text: `--compare` prints the
    drift as a diff and fails, `--write` splices the rebuilt literal over it, last to first."""
    text = open(path, encoding="utf-8").read()
    lits = literals(text)
    fail, drift, msgs = 0, 0, []
    for i, e, j, c in reversed(lits):
        ln = text.count("\n", 0, i) + 1
        head = f"{path}:{ln}  {c['expect']}   [{c['src']} ⟶ {c['tgt']}]"
        try:
            new = emit(draw(c["expect"], c["src"], c["tgt"], tbl, c.get("split", DEFSPLIT),
                            c.get("sigs"), c.get("slope"), c.get("mu")))[1:-1]
        except (Unhandled, ValueError, KeyError, StopIteration) as ex:
            fail += 1; msgs.append(f"{head}\n  {ex}"); continue
        if new == text[i:e]:
            continue
        drift += 1
        if write:
            text = text[:i] + new + text[e:]; msgs.append(f"{head}\n  rewritten")
        else:
            msgs.append("\n".join([head] + list(difflib.unified_diff(
                text[i:e].splitlines(), new.splitlines(), "note", "generated", lineterm=""))))
    if write:
        open(path, "w", encoding="utf-8").write(text)
    if msgs:
        print(*reversed(msgs), sep="\n")
    print(f"diagram: {len(lits)} literals in {path}, {len(lits) - drift - fail} verbatim, {drift}"
          f" {'rewritten' if write else 'drifted'}, {fail} undrawable", file=sys.stderr)
    sys.exit((fail or drift and not write)
             and f"diagram: {path} does not hold what the generator draws")


def sigpair(x):
    """One `--sigs` word: `NAME:SRC⟶TGT[!nat[=lean:Mod.decl@key]]`, cut at the SIGNATURE's last
    colon.  Not the word's — a marker carries colons of its own, and they come after `!nat`."""
    head, nat, mark = x.partition("!nat")
    k, _, v = head.rpartition(":")
    return k, v + nat + mark


# A formula to a PICTURE in one command.  The scratch lives beside the note because its `#import`
# resolves from its own directory, and it is removed whether or not typst succeeded.
def picture(recs, out=None, tag="render", dpi=200):
    """The panels' pdf, or the png at `out` when given.  One panel is emitted alone, so a caller
    measuring the page — `hm-check --geom` — gets the same ink as pasting the literal into the note."""
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    src = os.path.join(root, "diag", f".diagram-{tag}.typ")
    pdf = os.path.join(os.environ.get("TMPDIR", "/tmp"), f"diagram-{tag}.pdf")
    body = (emit(recs[0]) if len(recs) == 1 else "#stack(dir: ltr, spacing: 30pt,\n"
            + ",\n".join(emit(r).lstrip("#") for r in recs) + ")")
    with open(src, "w", encoding="utf-8") as f:
        f.write(f"// SCRATCH — written and removed by `diagram.picture`.\n"
                '#import "allegory-axioms.typ": dpanel, frc\n'
                "#set page(width: auto, height: auto, margin: 0.8cm, fill: white)\n"
                "#set text(11pt)\n\n" + body + "\n")
    try:
        subprocess.run(["typst", "compile", "--root", root, src, pdf], check=True)
    finally:
        os.remove(src)
    if out is None:
        return pdf
    subprocess.run(["pdftoppm", "-r", str(dpi), "-png", "-singlefile", pdf,
                    out[:-4] if out.endswith(".png") else out], check=True)
    return out


_HELP_BODY = ('usage: diagram [--fold-list] [--sigs "R:F(A)⟶A S:F(B)⟶B"] [--slope left] [--png OUT]'
              ' --src "F([A])" --tgt "[A]" "α prefix list(p)"'
              '\n       diagram --roundtrip [--show] [--from FIELD] [--json FILE] [diag/allegory-axioms.typ]'
              '\n       diagram --compare [diag/allegory-axioms.typ]'
              '\n       diagram --write [diag/allegory-axioms.typ]'
              '\n\n--src/--tgt   the panel'"'"'s source/target objects; required in default mode — a'
              " formula alone does not fix the ports"
              '\n--sigs        extra bead signatures beyond diag/hm-sigs.json, `NAME:SRC⟶TGT` pairs'
              " separated by spaces; the key is left of the LAST colon"
              '\n--mu          the initial algebra this row folds from, `FUNCTOR:OBJECT[⟶CARRIER]`'
              ' pairs — `--mu "F:list⁺(x)"` folds the `list⁺` §14.5 writes, laid over'
              " diag/hm-sigs.json's `mu`, and gives the carrier when the algebra is a composite with"
              " no row of its own.  The same flag `scripts/circuit` takes, spelled the same way"
              '\n--slope left  lean the layout left instead of the default lane placement'
              '\n--png OUT     also render the panel to OUT (200 dpi); the `dpanel` literal still'
              " goes to stdout and the written path to stderr"
              '\n--book        lay the panel out as IntroString p.74 does: a STRAIGHT object edge'
              " descending to the right at 2 across : 1 down, one lane pitch per bead that retypes"
              " it, in ROW units of 0.5cm, held vertical in its own column above the first bead"
              " riding it.  Takes --panel and --obreak"
              '\n--panel WxH   the panel\'s outer size in rows, e.g. `--panel 4x4` — p.74\'s own'
              " typesetting, for a fixture that states it; without it the one derivation"
              " `2·(top lanes) + 2·(riding beads) + 2` wide by `beads + 1` high"
              '\n--obreak      break the object edge at each bead riding it, as p.74\'s one-bead'
              " figure does and the two beside it do not"
              '\n--fold-list   keep a composite object as one wire instead of splitting it (e.g. `[A]`'
              " stays folded, not `list` beside `A`)"
              '\n--roundtrip   the acceptance test: regenerate every certified panel in the note from'
              " its own `cert: expect` and sweep it again; --show prints each rebuilt panel, --json"
              " FILE writes the results, --from FIELD reads a non-default metadata field"
              '\n--compare     rebuild every `dpanel(` literal in the note from its own `cert:` and'
              " fail on any drift from the note's text"
              '\n--write       like --compare, but splices the rebuilt literals back over the note'
              " (trailing arguments kept)"
              '\n\nDefault mode prints one `#dpanel(...)` call on stdout, ready to paste into the note;'
              " diagnostics (a failed self-sweep, a formula the sweep reads back differently) go to"
              " stderr.  Exit status is nonzero if the drawn panel fails its own sweep.")


def main(argv):
    sl.help_if(argv, __doc__, _HELP_BODY)
    frm, out = sl.opt(argv, "--from"), sl.opt(argv, "--json")
    src, tgt = sl.opt(argv, "--src"), sl.opt(argv, "--tgt")
    own = sl.opt(argv, "--sigs")
    own = dict(sigpair(x) for x in own.split()) if own else None
    slope, ini = sl.opt(argv, "--slope"), sl.opt(argv, "--mu")
    pan, png = sl.opt(argv, "--panel"), sl.opt(argv, "--png")
    taken = {i for o in ("--from", "--json", "--src", "--tgt", "--sigs", "--slope", "--mu",
                         "--panel", "--png") if o in argv for i in (argv.index(o), argv.index(o) + 1)}
    free = [a for i, a in enumerate(argv) if i not in taken and not a.startswith("-")]
    path = next((a for a in free if a.endswith(".typ")), None)
    tbl = sl.sigs()
    if "--roundtrip" in argv or "--compare" in argv or "--write" in argv:
        path = path or "diag/allegory-axioms.typ"
        if "--roundtrip" in argv:
            roundtrip(path, frm, "--show" in argv, out, tbl)
        else:
            regen(path, tbl, "--write" in argv)
        return
    formula = next((a for a in free if not a.endswith(".typ")), None)
    if not (formula and src and tgt):
        sys.exit(__doc__.strip().splitlines()[0]
                 + '\nusage: diagram [--fold-list] [--sigs "R:F(A)⟶A S:F(B)⟶B"] [--slope left]'
                 + ' [--png OUT] --src "F([A])" --tgt "[A]" "α prefix list(p)"'
                 + '\n       diagram --roundtrip [--show] [diag/allegory-axioms.typ]'
                 + '\n       diagram --compare [diag/allegory-axioms.typ]'
                 + '\n       diagram --write [diag/allegory-axioms.typ]')
    book = None
    if "--book" in argv:
        book = (tuple(int(v) for v in pan.lower().split("x")) if pan else (None, None)) \
            + ("--obreak" in argv,)
    r = draw(formula, src, tgt, tbl, "" if "--fold-list" in argv else DEFSPLIT, own, slope, ini,
             book)
    if png:
        print("wrote", picture([r], png), file=sys.stderr)
    if book:                    # the sweep reads the bottom edge for the target, and a `--book`
        print(emit(r))          # panel lets the object wire out through the RIGHT side instead
        return
    got, bad = swept(r)
    print(emit(r))
    if bad:
        print(*bad, sep="\n", file=sys.stderr); sys.exit("diagram: the panel fails its own sweep")
    if got != shown(formula, BR):
        print(f"// the sweep reads it back as {got}", file=sys.stderr)


if __name__ == "__main__":
    main(sys.argv[1:])
